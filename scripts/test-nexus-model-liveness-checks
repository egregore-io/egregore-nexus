#!/usr/bin/env python3
"""Smoke tests for liveness checks using temporary SQLite DBs and no host probes."""

from __future__ import annotations

import sqlite3
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
LIVE_SCRIPT = ROOT / "scripts" / "nexus-liveness-check"
NOW_MS = 1_783_160_000_000


def init_daemon(path: Path, cwd: Path) -> None:
    con = sqlite3.connect(path)
    try:
        con.executescript(
            f"""
            CREATE TABLE sessions (
              session_id TEXT PRIMARY KEY,
              name TEXT,
              agent TEXT,
              transport TEXT,
              presence TEXT,
              last_heartbeat INTEGER,
              client_key TEXT,
              cwd TEXT,
              project TEXT,
              harness_session_id TEXT
            );
            INSERT INTO sessions VALUES
              ('s_oc', 'dean', 'opencode', 'acp', 'online', {NOW_MS - 1000}, 'ck_dean', '{cwd}', 'default', 'ses_dean'),
              ('s_old', 'oscar', 'opencode', 'acp', 'offline', {NOW_MS - 1000}, 'ck_oscar', '{cwd}', 'default', 'ses_oscar');
            """
        )
        con.commit()
    finally:
        con.close()


def init_opencode(path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    con = sqlite3.connect(path)
    try:
        con.executescript(
            """
            CREATE TABLE session (
              id TEXT PRIMARY KEY
            );
            INSERT INTO session VALUES
              ('ses_dean'),
              ('ses_oscar');
            """
        )
        con.commit()
    finally:
        con.close()


def run(check: bool, *cmd: str) -> subprocess.CompletedProcess[str]:
    # Keep CLI parsing and SQLite/classification behavior real, but prevent
    # temporary fixtures from probing the operator's tmux sockets or processes.
    isolated_main = """
import runpy
import sys

sys.argv = sys.argv[1:]
main = runpy.run_path(sys.argv[0])["main"]
main.__globals__.update(
    tmux_alive=lambda session_id: None,
    proc_ids=lambda: [],
    proc_bound=lambda client_key, name: False,
)
main()
"""
    return subprocess.run(
        [sys.executable, "-c", isolated_main, *cmd],
        cwd=ROOT,
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def main() -> int:
    with tempfile.TemporaryDirectory() as tmp:
        tmp_path = Path(tmp)
        daemon = tmp_path / "nexus.db"
        cwd = tmp_path / "project"
        init_daemon(daemon, cwd)
        init_opencode(cwd / ".nexus" / "opencode" / "acp" / "default" / "dean" / "opencode.db")
        init_opencode(cwd / ".nexus" / "opencode" / "acp" / "default" / "oscar" / "opencode.db")

        live = run(
            False,
            str(LIVE_SCRIPT),
            "--db",
            str(daemon),
            "--now-ms",
            str(NOW_MS),
        )
        assert live.returncode == 1
        assert "NOTE: excluding 1 offline session(s)" in live.stdout
        assert "dean" in live.stdout
        assert "DEGRADED" in live.stdout
        assert "oscar" in live.stdout  # appears in the explicit exclusion note

        all_live = run(
            False,
            str(LIVE_SCRIPT),
            "--db",
            str(daemon),
            "--now-ms",
            str(NOW_MS),
            "--all",
        )
        assert all_live.returncode == 1
        assert "oscar" in all_live.stdout
        assert "OFFLINE" in all_live.stdout

    print("nexus liveness smoke tests passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
