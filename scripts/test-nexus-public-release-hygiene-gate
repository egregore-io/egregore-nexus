#!/usr/bin/env python3
"""Regression tests for the public release hygiene gate."""

from __future__ import annotations

import subprocess
import tempfile
import unittest
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
GATE = ROOT / "scripts/nexus-public-release-hygiene-gate"


class PublicReleaseHygieneGateTests(unittest.TestCase):
    def run_gate(self, files: dict[str, str]) -> subprocess.CompletedProcess[str]:
        with tempfile.TemporaryDirectory(prefix="nexus-public-hygiene-") as raw:
            root = Path(raw)
            paths = root / "paths.txt"
            for relative, content in files.items():
                target = root / relative
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text(content, encoding="utf-8")
            paths.write_text("".join(f"{path}\n" for path in files), encoding="utf-8")
            return subprocess.run(
                [str(GATE), "--root", str(root), "--paths-file", str(paths)],
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
            )

    def test_accepts_public_product_language(self) -> None:
        result = self.run_gate(
            {
                "README.md": "Nexus supports Claude Code, Codex, OpenCode, and Hermes.\n",
                "src/generated.ts": (
                    "// Generated by typeshare.\n"
                    "// Unknown approval methods return an empty result.\n"
                    "// Delivery decision for an explicit redirect request.\n"
                ),
                "AGENTS.md": "Do not add attribution trailers to commits.\n",
            }
        )
        self.assertEqual(result.returncode, 0, result.stdout)
        self.assertIn("PASS public release hygiene gate", result.stdout)

    def test_rejects_private_paths_and_release_artifacts(self) -> None:
        result = self.run_gate(
            {
                "CLAUDE.md": "private assistant entry point\n",
                "docs/superpowers/plan.md": "private plan\n",
                "evidence.zip": "not really an archive\n",
            }
        )
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertIn("forbidden_path", result.stdout)
        self.assertIn("forbidden_archive", result.stdout)

    def test_rejects_private_content_and_candidate_narration(self) -> None:
        result = self.run_gate(
            {
                "README.md": (
                    "Read /home/earldennison/private and .config/superpowers first.\n"
                    "See internal/plans/runtime.md. Earl ruling: use candidate 73.\n"
                ),
                "src/test.rs": (
                    'let reviewer = "Bob"; let runtime = "wren";\n'
                    'let agent_id = "a_bob"; let session_id = "s_paul";\n'
                ),
            }
        )
        self.assertEqual(result.returncode, 1, result.stdout)
        for code in (
            "operator_local_path",
            "private_workflow_reference",
            "internal_persona",
            "candidate_narration",
        ):
            self.assertIn(code, result.stdout)

    def test_rejects_a_legacy_support_contract_in_public_docs(self) -> None:
        result = self.run_gate(
            {
                "README.md": (
                    "Legacy clients remain supported during a compatibility window.\n"
                ),
                "src/compatibility.rs": (
                    "// Internal compatibility naming does not define a release contract.\n"
                ),
            }
        )
        self.assertEqual(result.returncode, 1, result.stdout)
        self.assertIn("legacy_release_contract", result.stdout)

    def test_ignores_generic_names_in_third_party_code_but_still_scans_secrets(self) -> None:
        generic_name = self.run_gate(
            {"core/vendor/example/src/lib.rs": 'let email = "bob@test.com";\n'}
        )
        self.assertEqual(generic_name.returncode, 0, generic_name.stdout)

        private_key = self.run_gate(
            {
                "core/vendor/example/src/lib.rs": (
                    "-----BEGIN PRIVATE KEY-----\nthird-party-secret\n"
                )
            }
        )
        self.assertEqual(private_key.returncode, 1, private_key.stdout)
        self.assertIn("embedded_private_key", private_key.stdout)


if __name__ == "__main__":
    unittest.main()
