#!/usr/bin/env python3
from __future__ import annotations

import hashlib
import hmac
import io
import json
import os
import runpy
import subprocess
import tempfile
import threading
import unittest
from contextlib import redirect_stdout
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from unittest.mock import patch


ROOT = Path(__file__).resolve().parent.parent
COMMAND = ROOT / "scripts" / "nexus-notify-smoke"


class NotificationHelpTests(unittest.TestCase):
    def test_help_discloses_side_effects_without_cli_network_or_state_writes(self) -> None:
        with tempfile.TemporaryDirectory() as raw_tmp:
            home = Path(raw_tmp)
            output = io.StringIO()
            with (
                patch.dict(os.environ, {"HOME": str(home)}, clear=True),
                patch("sys.argv", [str(COMMAND), "--help"]),
                patch("subprocess.run", side_effect=AssertionError("CLI invoked")) as cli,
                patch("urllib.request.urlopen", side_effect=AssertionError("network invoked")) as network,
                patch("socket.socket", side_effect=AssertionError("socket opened")) as socket,
                redirect_stdout(output),
            ):
                runpy.run_path(str(COMMAND), run_name="__main__")
            cli.assert_not_called()
            network.assert_not_called()
            socket.assert_not_called()
            self.assertEqual(list(home.iterdir()), [], "help must not write operator state")
            help_text = output.getvalue()
            for disclosure in (
                "maintainer utility",
                "not an isolated test",
                "$HOME/.nexus/nexus-endurance-smoke.json",
                "NEXUS_NOTIFY_STATE",
                "registers or rotates source credentials",
                "installed Nexus Gateway",
                "NEXUS_GATEWAY_URL",
            ):
                self.assertIn(disclosure, help_text)


class CaptureHandler(BaseHTTPRequestHandler):
    requests: list[dict[str, object]] = []

    def do_POST(self) -> None:  # noqa: N802 - stdlib callback name
        body = self.rfile.read(int(self.headers["content-length"])).decode()
        self.requests.append(
            {
                "path": self.path,
                "headers": dict(self.headers),
                "body": body,
            }
        )
        self.send_response(201)
        self.send_header("content-type", "application/json")
        self.end_headers()
        self.wfile.write(b'{"commandId":"cmd_test","state":"pending"}')

    def log_message(self, _format: str, *_args: object) -> None:
        return


class NotificationSmokeTests(unittest.TestCase):
    def setUp(self) -> None:
        CaptureHandler.requests = []
        self.server = ThreadingHTTPServer(("127.0.0.1", 0), CaptureHandler)
        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
        self.thread.start()

    def tearDown(self) -> None:
        self.server.shutdown()
        self.server.server_close()
        self.thread.join(timeout=2)

    def test_registers_once_then_uses_signed_gateway_pushes(self) -> None:
        with tempfile.TemporaryDirectory() as raw_tmp:
            tmp = Path(raw_tmp)
            capture = tmp / "capture.jsonl"
            nexus = tmp / "nexus"
            nexus.write_text(
                "#!/usr/bin/env python3\n"
                "import json, os, sys\n"
                "with open(os.environ['CAPTURE'], 'a') as out:\n"
                "    out.write(json.dumps({'argv': sys.argv[1:]}) + '\\n')\n"
                "if sys.argv[1:3] == ['source', 'show']:\n"
                "    raise SystemExit(1)\n"
                "if sys.argv[1:3] == ['source', 'register']:\n"
                "    print(json.dumps({'source': {\n"
                "        'name': 'nexus-endurance-smoke',\n"
                "        'topic': 'nexus.endurance.smoke',\n"
                "        'enabled': True, 'createdAt': 1, 'lastFiredAt': None},\n"
                "        'token': 'source-secret'}))\n"
                "    raise SystemExit(0)\n"
                "raise SystemExit(2)\n",
                encoding="utf-8",
            )
            nexus.chmod(0o755)
            env = os.environ | {
                "CAPTURE": str(capture),
                "HOME": str(tmp),
                "NEXUS_NOTIFY_STATE": str(tmp / ".nexus" / "nexus-endurance-smoke.json"),
                "PATH": f"{tmp}:{os.environ['PATH']}",
                "NEXUS_GATEWAY_URL": f"http://127.0.0.1:{self.server.server_port}",
            }

            first = subprocess.run(
                [str(COMMAND), "First milestone"],
                cwd=ROOT,
                env=env,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            self.assertEqual(first.returncode, 0, first.stderr)
            second = subprocess.run(
                [str(COMMAND), "Second milestone"],
                cwd=ROOT,
                env=env,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            self.assertEqual(second.returncode, 0, second.stderr)

            invocations = [
                json.loads(line)["argv"]
                for line in capture.read_text(encoding="utf-8").splitlines()
            ]
            self.assertEqual(
                invocations,
                [
                    ["source", "show", "nexus-endurance-smoke", "--json"],
                    [
                        "source",
                        "register",
                        "nexus-endurance-smoke",
                        "--topic",
                        "nexus.endurance.smoke",
                        "--json",
                    ],
                ],
                "the durable source must be registered only once",
            )
            secret = tmp / ".nexus" / "nexus-endurance-smoke.json"
            self.assertEqual(secret.stat().st_mode & 0o777, 0o600)
            self.assertEqual(len(CaptureHandler.requests), 2)
            for request, expected_message in zip(
                CaptureHandler.requests,
                ["First milestone", "Second milestone"],
                strict=True,
            ):
                self.assertEqual(
                    request["path"],
                    "/api/v1/sources/nexus-endurance-smoke/push?topic=nexus.endurance.smoke",
                )
                body = str(request["body"])
                payload = json.loads(body)
                self.assertEqual(
                    payload["body"].split("\n\nMarker:", 1)[0], expected_message
                )
                timestamp = str(request["headers"]["X-Nexus-Timestamp"])
                expected_signature = "sha256=" + hmac.new(
                    b"source-secret",
                    f"{timestamp}.{body}".encode(),
                    hashlib.sha256,
                ).hexdigest()
                self.assertEqual(
                    request["headers"]["X-Nexus-Signature"], expected_signature
                )
            self.assertIn("NEXUS_NOTIFICATION_SMOKE_", first.stdout)
            self.assertIn("NEXUS_NOTIFICATION_SMOKE_", second.stdout)


if __name__ == "__main__":
    unittest.main(verbosity=1)
