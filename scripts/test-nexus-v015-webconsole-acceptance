        "NEXUS_V015_GATEWAY_BIN_SHA256": digest(umbrella / "bin/nexus-gateway.mjs"),
        "NEXUS_V015_WEBUI_BIN": str(prefix / "bin/nexus-webui"),
        "NEXUS_V015_WEBUI_BIN_RESOLVED": str(umbrella / "bin/nexus-webui.mjs"),
