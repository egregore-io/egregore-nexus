INSTALL_TREE_SHA256=$(python3 - "$PREFIX" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path, PurePosixPath

root = Path(os.path.abspath(sys.argv[1]))
inventory = {}


def visit(directory, relative):
    for entry in sorted(os.scandir(directory), key=lambda item: item.name):
        child = relative / entry.name
        key = child.as_posix()
        info = entry.stat(follow_symlinks=False)
        if stat.S_ISLNK(info.st_mode):
            inventory[key] = {
                "kind": "symlink",
                "target": os.readlink(entry.path),
                "mode": stat.S_IMODE(info.st_mode),
            }
        elif stat.S_ISDIR(info.st_mode):
            inventory[key] = {"kind": "directory", "mode": stat.S_IMODE(info.st_mode)}
            visit(Path(entry.path), child)
        elif stat.S_ISREG(info.st_mode):
            raw = Path(entry.path).read_bytes()
            inventory[key] = {
                "kind": "file",
                "sha256": hashlib.sha256(raw).hexdigest(),
                "size": len(raw),
                "mode": stat.S_IMODE(info.st_mode),
            }
        else:
            raise SystemExit(f"unsupported fixture install entry: {key}")


visit(root, PurePosixPath())
body = json.dumps(
    inventory,
    sort_keys=True,
    separators=(",", ":"),
    ensure_ascii=False,
    allow_nan=False,
).encode("utf-8")
print(hashlib.sha256(body).hexdigest())
PY
)
