# Gateway status/discovery and a live PID are not sufficient: the exact PID
# must own the advertised TCP listener and serve the canonical health route
# before and after every Webconsole operation.
prepare_run_fixture gateway-no-listener
kill "$GATEWAY_PID"
wait "$GATEWAY_PID" 2>/dev/null || true
GATEWAY_PORT=$(python3 - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)
"$PREFIX/bin/nexus-gateway" \
  --fixture-runtime \
  --port "$GATEWAY_PORT" \
  --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
  --install-root "$PREFIX" \
  --no-listen &
GATEWAY_PID=$!
printf '{"pid":%s,"url":"http://127.0.0.1:%s"}\n' "$GATEWAY_PID" "$GATEWAY_PORT" \
  >"$TMP/home/gateway.json"
set +e
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
  FIXTURE_COMMANDS="$TMP/commands" \
  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id gateway-no-listener \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/gateway-no-listener.stdout" 2>"$TMP/gateway-no-listener.stderr"
gateway_no_listener_status=$?
set -e
test "$gateway_no_listener_status" -ne 0
grep -Fq 'Gateway listener or health endpoint is not owned by the live Gateway process' \
  "$TMP/gateway-no-listener.stderr"
test ! -e "$TMP/evidence/gateway-no-listener/results/D2-webconsole-cli.result.sha256"

kill "$GATEWAY_PID"
wait "$GATEWAY_PID" 2>/dev/null || true
GATEWAY_PORT=$(python3 - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)
"$PREFIX/bin/nexus-gateway" \
  --fixture-runtime \
  --port "$GATEWAY_PORT" \
  --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
  --install-root "$PREFIX" &
GATEWAY_PID=$!
printf '{"pid":%s,"url":"http://127.0.0.1:%s"}\n' "$GATEWAY_PID" "$GATEWAY_PORT" \
  >"$TMP/home/gateway.json"
deadline=$((SECONDS + 5))
until curl -fsS --max-time 1 "http://127.0.0.1:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1; do
  [ "$SECONDS" -lt "$deadline" ] || exit 1
  sleep 0.05
done

# Merely mentioning the candidate launcher in an inert argument cannot bind a
# different process to the packed entrypoint. The supported Node/Python shape
# is interpreter argv[0], exact packed launcher argv[1].
prepare_run_fixture inert-gateway-argv
kill "$GATEWAY_PID"
wait "$GATEWAY_PID" 2>/dev/null || true
cp "$UMBRELLA/bin/nexus-gateway.mjs" "$TMP/bin/inert-gateway"
chmod +x "$TMP/bin/inert-gateway"
GATEWAY_PORT=$(python3 - <<'PY'
import socket
with socket.socket() as sock:
    sock.bind(("127.0.0.1", 0))
    print(sock.getsockname()[1])
PY
)
"$TMP/bin/inert-gateway" \
  --fixture-runtime \
  --port "$GATEWAY_PORT" \
  --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
  --install-root "$PREFIX" \
  --inert "$PREFIX/bin/nexus-gateway" &
GATEWAY_PID=$!
printf '{"pid":%s,"url":"http://127.0.0.1:%s"}\n' "$GATEWAY_PID" "$GATEWAY_PORT" \
  >"$TMP/home/gateway.json"
deadline=$((SECONDS + 5))
until curl -fsS --max-time 1 "http://127.0.0.1:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1; do
  [ "$SECONDS" -lt "$deadline" ] || exit 1
  sleep 0.05
done
set +e
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
