# Runtime identity is optional only as a whole. A Gateway that reports none of
# the three facets remains an honest false/null observation, while any partial,
# malformed, or mismatched identity must fail before Webconsole lifecycle work.
start_gateway_variant none
prepare_run_fixture runtime-identity-none
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
  FIXTURE_COMMANDS="$TMP/commands" \
  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id runtime-identity-none \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/runtime-identity-none.stdout" 2>"$TMP/runtime-identity-none.stderr"
RUNTIME_NONE_RESULT="$TMP/evidence/runtime-identity-none/results/D2-webconsole-cli/result.json"
RUNTIME_NONE_TRANSCRIPT="$TMP/evidence/runtime-identity-none/$(jq -r '.artifacts.cliTranscript.path' "$RUNTIME_NONE_RESULT")"
jq -s -e '
  length > 20 and all(.[];
    .gateway.runtimeIdentityReported == false and
    .gateway.runtimeIdentityMatched == null
  )
' "$RUNTIME_NONE_TRANSCRIPT" >/dev/null

for runtime_case in partial malformed mismatch; do
  start_gateway_variant "$runtime_case"
  run_gateway_baseline_negative \
    "runtime-identity-$runtime_case" \
    'live Gateway health runtime identity'
done

# Port equality is insufficient ownership evidence. The owned socket must use
# the same address family and exact loopback address advertised by Gateway.
start_gateway_variant full 0.0.0.0 127.0.0.1
run_gateway_baseline_negative \
  gateway-wildcard-listener \
  'Gateway listener or health endpoint is not owned by the live Gateway process'

stop_fixture_gateways
GATEWAY_PORT=$(allocate_gateway_port)
"$PREFIX/bin/nexus-gateway" \
  --fixture-runtime \
  --port "$GATEWAY_PORT" \
  --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
  --install-root "$PREFIX" \
  --bind-host 127.0.0.2 &
GATEWAY_PID=$!
"$PREFIX/bin/nexus-gateway" \
  --fixture-runtime \
  --port "$GATEWAY_PORT" \
  --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
  --install-root "$PREFIX" \
  --bind-host 127.0.0.1 &
GATEWAY_AUX_PID=$!
printf '{"pid":%s,"url":"http://127.0.0.1:%s"}\n' \
  "$GATEWAY_PID" "$GATEWAY_PORT" >"$TMP/home/gateway.json"
deadline=$((SECONDS + 5))
until curl -fsS --max-time 1 \
  "http://127.0.0.1:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1; do
  [ "$SECONDS" -lt "$deadline" ] || {
    echo "wrong-address Gateway fixture did not become healthy" >&2
    exit 1
  }
  sleep 0.05
done
run_gateway_baseline_negative \
  gateway-wrong-address-listener \
  'Gateway listener or health endpoint is not owned by the live Gateway process'

# A release-attested discovery URL must name one numeric loopback endpoint.
# `localhost` can select a different address family on another machine, so it
# is rejected even when one of its resolutions happens to reach the owner.
stop_fixture_gateways
start_gateway_variant full 127.0.0.1 localhost
run_gateway_baseline_negative \
  gateway-localhost-ambiguous \
  'Gateway listener or health endpoint is not owned by the live Gateway process'

# The ownership probe emits one explicit RFC Host authority for IPv4.  The
# positive is pinned by the fixture server itself; wrong and absent Host modes
# must both fail the canonical health proof before lifecycle work begins.
start_gateway_variant full 127.0.0.1 127.0.0.1 auto
run_gateway_baseline_negative \
  gateway-ipv4-host-wrong \
  'Gateway listener or health endpoint is not owned by the live Gateway process' \
  wrong
run_gateway_baseline_negative \
  gateway-ipv4-host-missing \
  'Gateway listener or health endpoint is not owned by the live Gateway process' \
  missing

# IPv6 is a production contract, not an unconditional CI assumption. Skip only
# when this kernel cannot bind ::1 at all; otherwise prove bracketed Webconsole
# URLs, exact IPv6 Gateway ownership, wildcard rejection, and cross-family
# health-decoy rejection.
if python3 - <<'PY'
import socket
with socket.socket(socket.AF_INET6) as sock:
    sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
    sock.bind(("::1", 0))
PY
then
  start_gateway_variant full ::1 ::1 auto
  prepare_run_fixture ipv6-positive
  invoke_fixture_gate_host ipv6-positive ::1 \
    >"$TMP/ipv6-positive.stdout" 2>"$TMP/ipv6-positive.stderr"
  test -f "$TMP/evidence/ipv6-positive/results/D2-webconsole-cli.result.sha256"
  jq -e '.primaryPort > 0 and .status == "PASS"' \
    "$TMP/evidence/ipv6-positive/results/D2-webconsole-cli/result.json" >/dev/null
  grep -Fq 'http://[::1]:' \
    "$TMP/evidence/ipv6-positive/results/D2-webconsole-cli/status-plain.stdout"

  start_gateway_variant full :: ::1 auto
  run_gateway_baseline_negative \
    gateway-ipv6-wildcard-listener \
    'Gateway listener or health endpoint is not owned by the live Gateway process'

  stop_fixture_gateways
  GATEWAY_PORT=$(python3 - <<'PY'
import socket
for _ in range(100):
    with socket.socket(socket.AF_INET) as ipv4:
        ipv4.bind(("127.0.0.1", 0))
        port = ipv4.getsockname()[1]
        with socket.socket(socket.AF_INET6) as ipv6:
            ipv6.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
            try:
                ipv6.bind(("::1", port))
            except OSError:
                continue
            print(port)
            break
else:
    raise SystemExit("cannot allocate dual-family loopback fixture port")
PY
  )
  "$PREFIX/bin/nexus-gateway" \
    --fixture-runtime \
    --port "$GATEWAY_PORT" \
    --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
    --install-root "$PREFIX" \
    --bind-host 127.0.0.1 \
    --runtime-identity full &
  GATEWAY_PID=$!
  "$PREFIX/bin/nexus-gateway" \
    --fixture-runtime \
    --port "$GATEWAY_PORT" \
    --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
    --install-root "$PREFIX" \
    --bind-host ::1 \
    --runtime-identity full &
  GATEWAY_AUX_PID=$!
  printf '{"pid":%s,"url":"http://localhost:%s"}\n' \
    "$GATEWAY_PID" "$GATEWAY_PORT" >"$TMP/home/gateway.json"
  deadline=$((SECONDS + 5))
  until curl --noproxy '*' -g -fsS --max-time 1 \
    "http://127.0.0.1:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1 \
    && curl --noproxy '*' -g -fsS --max-time 1 \
      "http://[::1]:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] || {
      echo "cross-family Gateway fixture did not become healthy" >&2
      exit 1
    }
    sleep 0.05
  done
  run_gateway_baseline_negative \
    gateway-cross-family-health-decoy \
    'Gateway listener or health endpoint is not owned by the live Gateway process'
else
  printf 'SKIP: kernel IPv6 loopback is unavailable; IPv6 production gate not exercised\n' >&2
fi

bash -n "$TARGET"
printf 'v0.1.5 Webconsole acceptance contract: ok\n'
