python3 - "$TMP/evidence/fixture" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
result_path = root / "results/D2-webconsole-cli/result.json"
result = json.loads(result_path.read_text(encoding="utf-8"))
transcript_path = root / result["artifacts"]["cliTranscript"]["path"]
output_path = root / "results/D2-webconsole-cli/start-first.stdout"
for path in (result_path, transcript_path, output_path):
    path.chmod(stat.S_IRUSR | stat.S_IWUSR)
output_path.write_bytes(output_path.read_bytes() + b"coordinated rewrite\n")
rows = [json.loads(line) for line in transcript_path.read_text(encoding="utf-8").splitlines()]
output_relative = output_path.relative_to(root).as_posix()
for row in rows:
    if row.get("stdout") == output_relative:
        raw = output_path.read_bytes()
        row["stdoutSha256"] = hashlib.sha256(raw).hexdigest()
        row["stdoutSize"] = len(raw)
        break
else:
    raise SystemExit("start-first output is absent from the transcript")
transcript_raw = b"".join(
    json.dumps(row, separators=(",", ":"), sort_keys=True).encode() + b"\n"
    for row in rows
)
transcript_path.write_bytes(transcript_raw)
result["artifacts"]["cliTranscript"]["sha256"] = hashlib.sha256(transcript_raw).hexdigest()
for record in result["evidenceInventory"]:
    path = root / record["path"]
    raw = path.read_bytes()
    record["sha256"] = hashlib.sha256(raw).hexdigest()
    record["size"] = len(raw)
result_path.write_text(
    json.dumps(result, separators=(",", ":"), sort_keys=True) + "\n",
    encoding="utf-8",
)
for path in (result_path, transcript_path, output_path):
    path.chmod(stat.S_IRUSR)
PY
