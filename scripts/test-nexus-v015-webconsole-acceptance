# Cleanup authority is the discovery-selected process tuple captured before a
# later failure.  If that owner A exits and an otherwise identical owner B
# takes the same argv/discovery/port, cleanup must not recapture and kill B.
prepare_run_fixture cleanup-same-shape-replacement
rm -f "$TMP/replacement.pid" "$TMP/replaced-during-gateway-status"
set +e
invoke_fixture_gate cleanup-same-shape-replacement \
  FIXTURE_REPLACE_WEBCONSOLE_DURING_GATEWAY_STATUS=1 \
  FIXTURE_REPLACE_WEBCONSOLE_MARKER="$TMP/replaced-during-gateway-status" \
  >"$TMP/cleanup-same-shape-replacement.stdout" \
  2>"$TMP/cleanup-same-shape-replacement.stderr"
cleanup_same_shape_status=$?
set -e
test "$cleanup_same_shape_status" -ne 0
CLEANUP_REPLACEMENT_PID=$(cat "$TMP/replacement.pid")
kill -0 "$CLEANUP_REPLACEMENT_PID"
