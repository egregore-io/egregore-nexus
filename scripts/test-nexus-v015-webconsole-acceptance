until curl -fsS --max-time 1 "http://127.0.0.1:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1; do
  [ "$SECONDS" -lt "$deadline" ] || {
    echo "fixture Gateway did not become healthy" >&2
    exit 1
  }
  sleep 0.05
