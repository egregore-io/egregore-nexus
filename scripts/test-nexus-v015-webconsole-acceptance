schema=1
containerId=$(printf 'c%.0s' {1..64})
mode=packed
runId=fixture
installRoot=$PREFIX
installNonce=fixtureABC
nativeResolved=$CLI_PACKAGE/native/linux-x64-gnu/nexus
nativeSha256=$(sha256sum "$CLI_PACKAGE/native/linux-x64-gnu/nexus" | cut -d' ' -f1)
nexusLink=$PREFIX/bin/nexus
nexusResolved=$UMBRELLA/bin/nexus.mjs
nexusSha256=$(sha256sum "$UMBRELLA/bin/nexus.mjs" | cut -d' ' -f1)
