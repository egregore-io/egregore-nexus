tr '\0' '\n' <"/proc/$CLEANUP_REPLACEMENT_PID/cmdline" \
  | grep -Fx "$(readlink -f "$PREFIX/bin/nexus-webui")" >/dev/null
kill -KILL "$CLEANUP_REPLACEMENT_PID"
wait "$CLEANUP_REPLACEMENT_PID" 2>/dev/null || true
CLEANUP_REPLACEMENT_PID=""
rm -f "$TMP/home/webconsole.json"

# The fallback authority is the immutable process tuple captured before the
# validated stop.  If that PID execs a different executable, or keeps the same
# interpreter but replaces its complete argv, cleanup must preserve it.
for exec_mode in executable argv; do
  run_id="cleanup-process-$exec_mode-replaced"
  prepare_run_fixture "$run_id"
  rm -f "$TMP/mutated"
  set +e
  invoke_fixture_gate "$run_id" \
    FIXTURE_MUTATE_GATEWAY_ON_START=1 \
    FIXTURE_MUTATION_MARKER="$TMP/mutated" \
    FIXTURE_REEXEC_WEBUI_ON_FORCE_STOP="$exec_mode" \
    >"$TMP/$run_id.stdout" 2>"$TMP/$run_id.stderr"
  exec_replacement_status=$?
  set -e
  test "$exec_replacement_status" -ne 0
  CLEANUP_REPLACEMENT_PID=$(cat "$TMP/webconsole.pid")
  kill -0 "$CLEANUP_REPLACEMENT_PID"
  if [ "$exec_mode" = executable ]; then
    test "$(readlink -f "/proc/$CLEANUP_REPLACEMENT_PID/exe")" = "$(readlink -f /bin/sleep)"
  else
    test "$(readlink -f "/proc/$CLEANUP_REPLACEMENT_PID/exe")" = "$(readlink -f "$(command -v python3)")"
    tr '\0' '\n' <"/proc/$CLEANUP_REPLACEMENT_PID/cmdline" \
      | grep -Fx 'fixture-reexec-argv' >/dev/null
  fi
  kill -KILL "$CLEANUP_REPLACEMENT_PID"
  wait "$CLEANUP_REPLACEMENT_PID" 2>/dev/null || true
  CLEANUP_REPLACEMENT_PID=""
  rm -f "$TMP/home/webconsole.json"
done

