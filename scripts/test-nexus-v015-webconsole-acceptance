        "OCULAR_LAB": "1",
        "NEXUS_V015_RUN_ID": "fixture",
        "NEXUS_V015_PACKED_PREFIX": str(prefix),
        "NEXUS_V015_NEXUS_BIN": str(prefix / "bin/nexus"),
        "NEXUS_V015_NEXUS_BIN_RESOLVED": str(umbrella / "bin/nexus.mjs"),
        "NEXUS_V015_NEXUS_BIN_SHA256": digest(umbrella / "bin/nexus.mjs"),
        "NEXUS_V015_GATEWAY_BIN": str(prefix / "bin/nexus-gateway"),
