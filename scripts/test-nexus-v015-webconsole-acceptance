# The live process cannot be attested against candidate bytes changed after it
# started: those bytes were not the module this process loaded.
prepare_run_fixture stale-loaded-module
touch "$GATEWAY_PACKAGE/dist-gateway/headless.mjs"
set +e
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
  FIXTURE_COMMANDS="$TMP/commands" \
  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id stale-loaded-module \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/stale-loaded-module.stdout" 2>"$TMP/stale-loaded-module.stderr"
stale_loaded_module_status=$?
set -e
test "$stale_loaded_module_status" -ne 0
grep -Fq 'candidate Gateway module changed after the live process started' \
  "$TMP/stale-loaded-module.stderr"
test ! -e "$TMP/evidence/stale-loaded-module/results/D2-webconsole-cli.result.sha256"

