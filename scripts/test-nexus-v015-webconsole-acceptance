}
sources = {}
for index, name in enumerate(("nexus", "lens", "egregore", "pactree", "pactreePython", "pactreeFs"), 1):
    sources[name] = {"revision": f"{index:x}" * 40, "dirty": False, "dirtyPaths": []}
manifest = {
