# A prefix that still claims 0.1.5 but differs from the candidate tarballs is
# not the release candidate. Reject it before any Webconsole command executes.
prepare_run_fixture forged
cp "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" "$TMP/headless.mjs.before-forgery"
printf '%s\n' 'export const forgedSameVersionPrefix = true;' \
  >>"$GATEWAY_PACKAGE/dist-gateway/headless.mjs"
COMMAND_COUNT_BEFORE_FORGERY=$(wc -l <"$TMP/commands")
set +e
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
  FIXTURE_COMMANDS="$TMP/commands" \
  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id forged \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/forged.stdout" 2>"$TMP/forged.stderr"
forged_status=$?
set -e
test "$forged_status" -ne 0
grep -Fq "candidate manifest binding NEXUS_V015_GATEWAY_MODULE_SHA256" "$TMP/forged.stderr"
test "$(wc -l <"$TMP/commands")" -eq "$COMMAND_COUNT_BEFORE_FORGERY"
test ! -e "$TMP/evidence/forged/results/D2-webconsole-cli"
cp "$TMP/headless.mjs.before-forgery" "$GATEWAY_PACKAGE/dist-gateway/headless.mjs"
kill "$GATEWAY_PID"
wait "$GATEWAY_PID" 2>/dev/null || true
"$PREFIX/bin/nexus-gateway" \
  --fixture-runtime \
  --port "$GATEWAY_PORT" \
  --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs" \
  --install-root "$PREFIX" &
GATEWAY_PID=$!
printf '{"pid":%s,"url":"http://127.0.0.1:%s"}\n' "$GATEWAY_PID" "$GATEWAY_PORT" \
  >"$TMP/home/gateway.json"
deadline=$((SECONDS + 5))
until curl -fsS --max-time 1 "http://127.0.0.1:$GATEWAY_PORT/api/v1/health" >/dev/null 2>&1; do
  [ "$SECONDS" -lt "$deadline" ] || exit 1
  sleep 0.05
done

