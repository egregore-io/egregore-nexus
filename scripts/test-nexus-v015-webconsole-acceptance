grep -Fq -- "webconsole launch --no-open --host 127.0.0.1 --port $PRIMARY_PORT" "$TMP/commands"
grep -Fq -- "webconsole logs --follow --lines 1" "$TMP/commands"
grep -Fq -- "webconsole restart --host 127.0.0.1 --port $PRIMARY_PORT" "$TMP/commands"
test "$(grep -Fc -- "webconsole stop" "$TMP/commands")" -ge 4
grep -Fq -- "webconsole stop --force" "$TMP/commands"

prepare_run_fixture() {
  run_id=$1
  run_root="$TMP/evidence/$run_id"
  run_readiness="$READINESS"
  mkdir -p "$run_root"
  cp -R "$TMP/evidence/fixture/artifacts" "$run_root/artifacts"
  rm -f "$run_readiness"
  cp "$READINESS_TEMPLATE" "$run_readiness"
  chmod 0644 "$run_readiness"
  sed -i "s/^runId=fixture$/runId=$run_id/" "$run_readiness"
  chmod 0444 "$run_readiness"
  export NEXUS_V015_RUN_ID=$run_id
  python3 - \
    "$TMP/evidence/fixture/manifest.json" \
    "$run_root/manifest.json" \
    "$run_id" \
    "$run_readiness" <<'PY'
import hashlib
import json
import sys

source, destination, run_id, readiness = sys.argv[1:]
manifest = json.load(open(source, encoding="utf-8"))
manifest["runId"] = run_id
manifest["environment"]["NEXUS_V015_RUN_ID"] = run_id
manifest["environment"]["NEXUS_V015_READINESS_LEDGER"] = readiness
manifest["environment"]["NEXUS_V015_READINESS_LEDGER_SHA256"] = hashlib.sha256(
    open(readiness, "rb").read()
).hexdigest()
open(destination, "w", encoding="utf-8").write(json.dumps(manifest))
PY
}

invoke_fixture_gate() {
  local run_id=$1
  shift
  invoke_fixture_gate_host "$run_id" 127.0.0.1 "$@"
}

invoke_fixture_gate_host() {
  local run_id=$1 host=$2
  shift 2
  env \
    PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
    OCULAR_LAB=1 \
    NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
    NEXUS_HOME="$TMP/home" \
    NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
    NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
    FIXTURE_COMMANDS="$TMP/commands" \
    FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
    FIXTURE_PID="$TMP/webconsole.pid" \
    FIXTURE_REPLACEMENT_PID="$TMP/replacement.pid" \
    "$@" \
    "$TARGET" \
      --nexus-bin "$PREFIX/bin/nexus" \
      --packed-prefix "$PREFIX" \
      --host "$host" \
      --port 0 \
      --run-id "$run_id" \
      --evidence-dir "$TMP/evidence"
}

assert_fixture_webconsole_cleaned() {
  local pid port deadline
  pid=$(cat "$TMP/webconsole.pid")
  port=$(cat "$TMP/webconsole.pid.port")
  deadline=$((SECONDS + 5))
  while kill -0 "$pid" 2>/dev/null; do
    if [ -r "/proc/$pid/stat" ] \
      && [ "$(sed 's/^.*) //' "/proc/$pid/stat" | cut -d' ' -f1)" = Z ]; then
      break
    fi
    [ "$SECONDS" -lt "$deadline" ] || {
      echo "fixture Webconsole process $pid survived failed-gate cleanup" >&2
      tr '\0' ' ' <"/proc/$pid/cmdline" >&2 || true
      echo >&2
      cat "/proc/$pid/stat" >&2 || true
      return 1
    }
    sleep 0.05
  done
  python3 - "$port" <<'PY'
import socket
import sys

with socket.socket() as sock:
    sock.settimeout(0.2)
    if sock.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0:
        raise SystemExit("fixture Webconsole listener survived failed-gate cleanup")
PY
  test ! -e "$TMP/home/webconsole.json"
}

stop_fixture_gateways() {
  if [ -n "$GATEWAY_AUX_PID" ]; then
    kill "$GATEWAY_AUX_PID" 2>/dev/null || true
    wait "$GATEWAY_AUX_PID" 2>/dev/null || true
    GATEWAY_AUX_PID=""
  fi
  if [ -n "$GATEWAY_PID" ]; then
    kill "$GATEWAY_PID" 2>/dev/null || true
    wait "$GATEWAY_PID" 2>/dev/null || true
    GATEWAY_PID=""
  fi
}

allocate_gateway_port() {
  python3 - "${1:-127.0.0.1}" <<'PY'
import socket
import sys

host = sys.argv[1]
family = socket.AF_INET6 if ":" in host else socket.AF_INET
with socket.socket(family) as sock:
    if family == socket.AF_INET6:
        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
    sock.bind((host, 0))
    print(sock.getsockname()[1])
PY
}

gateway_url() {
  local host=$1 port=$2
  if [[ "$host" == *:* ]]; then
    printf 'http://[%s]:%s' "$host" "$port"
  else
    printf 'http://%s:%s' "$host" "$port"
  fi
}

start_gateway_variant() {
  local runtime_identity=$1 bind_host=${2:-127.0.0.1} advertised_host=${3:-127.0.0.1}
  local expected_host_header=${4:-} advertised_url
  local -a gateway_args
  stop_fixture_gateways
  GATEWAY_PORT=$(allocate_gateway_port "$bind_host")
  advertised_url=$(gateway_url "$advertised_host" "$GATEWAY_PORT")
  if [ "$expected_host_header" = auto ]; then
    if [[ "$advertised_host" == *:* ]]; then
      expected_host_header="[$advertised_host]:$GATEWAY_PORT"
    else
      expected_host_header="$advertised_host:$GATEWAY_PORT"
    fi
  fi
  gateway_args=(
    --fixture-runtime
    --port "$GATEWAY_PORT"
    --module "$GATEWAY_PACKAGE/dist-gateway/headless.mjs"
    --install-root "$PREFIX"
    --bind-host "$bind_host"
    --runtime-identity "$runtime_identity"
  )
  if [ -n "$expected_host_header" ]; then
    gateway_args+=(--expected-host-header "$expected_host_header")
  fi
  "$PREFIX/bin/nexus-gateway" "${gateway_args[@]}" &
  GATEWAY_PID=$!
  printf '{"pid":%s,"url":"%s"}\n' \
    "$GATEWAY_PID" "$advertised_url" >"$TMP/home/gateway.json"
  deadline=$((SECONDS + 5))
  until curl --noproxy '*' -g -fsS --max-time 1 \
    "$advertised_url/api/v1/health" >/dev/null 2>&1; do
    [ "$SECONDS" -lt "$deadline" ] || {
      echo "fixture Gateway variant did not become healthy" >&2
      return 1
    }
    sleep 0.05
  done
}

run_gateway_baseline_negative() {
  local run_id=$1 expected_error=$2 host_mode=${3:-}
  prepare_run_fixture "$run_id"
  set +e
  PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
    OCULAR_LAB=1 \
    NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
    NEXUS_HOME="$TMP/home" \
    NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
    NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
    FIXTURE_COMMANDS="$TMP/commands" \
    FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
    FIXTURE_PID="$TMP/webconsole.pid" \
    NEXUS_V015_FIXTURE_GATEWAY_HOST_MODE="$host_mode" \
    "$TARGET" \
      --nexus-bin "$PREFIX/bin/nexus" \
      --packed-prefix "$PREFIX" \
      --host 127.0.0.1 \
      --port 0 \
      --run-id "$run_id" \
      --evidence-dir "$TMP/evidence" \
      >"$TMP/$run_id.stdout" 2>"$TMP/$run_id.stderr"
  status=$?
  set -e
  test "$status" -ne 0
  grep -Fq "$expected_error" "$TMP/$run_id.stderr"
  test ! -e "$TMP/evidence/$run_id/results/D2-webconsole-cli.result.sha256"
}

