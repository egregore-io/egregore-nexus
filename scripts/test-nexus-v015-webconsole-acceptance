# The manifest may attest only the one current lab readiness path. A copied,
# self-consistent ledger elsewhere is stale even when every byte matches.
prepare_run_fixture stale-readiness
STALE_READINESS="$TMP/stale/candidate-ready.v1"
mkdir -p "$(dirname "$STALE_READINESS")"
cp "$READINESS" "$STALE_READINESS"
python3 - "$TMP/evidence/stale-readiness/manifest.json" "$STALE_READINESS" <<'PY'
import hashlib
import json
import sys

manifest_path, readiness_path = sys.argv[1:]
manifest = json.load(open(manifest_path, encoding="utf-8"))
manifest["environment"]["NEXUS_V015_READINESS_LEDGER"] = readiness_path
manifest["environment"]["NEXUS_V015_READINESS_LEDGER_SHA256"] = hashlib.sha256(
    open(readiness_path, "rb").read()
).hexdigest()
open(manifest_path, "w", encoding="utf-8").write(json.dumps(manifest))
PY
set +e
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
  FIXTURE_COMMANDS="$TMP/commands" \
  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id stale-readiness \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/stale-readiness.stdout" 2>"$TMP/stale-readiness.stderr"
stale_readiness_status=$?
set -e
test "$stale_readiness_status" -ne 0
grep -Fq 'current lab readiness ledger' "$TMP/stale-readiness.stderr"
test ! -f "$TMP/evidence/stale-readiness/results/D2-webconsole-cli/result.json"

# Ambient lab identity is independent authority. CLI flags and copied manifest
# fields cannot override the current run or container.
prepare_run_fixture current-run
set +e
PATH="$PREFIX/bin:$TMP/bin:/usr/bin:/bin" \
  OCULAR_LAB=1 \
  NEXUS_V015_ALLOW_FIXTURE_HOME=1 \
  NEXUS_V015_RUN_ID=other-run \
  NEXUS_HOME="$TMP/home" \
  NEXUS_WEBUI_BIN="$PREFIX/bin/nexus-webui" \
  NEXUS_GATEWAY_BIN="$PREFIX/bin/nexus-gateway" \
  FIXTURE_COMMANDS="$TMP/commands" \
  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id current-run \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/current-run.stdout" 2>"$TMP/current-run.stderr"
current_run_status=$?
set -e
test "$current_run_status" -ne 0
grep -Fq 'current lab run id' "$TMP/current-run.stderr"
test ! -f "$TMP/evidence/current-run/results/D2-webconsole-cli/result.json"

