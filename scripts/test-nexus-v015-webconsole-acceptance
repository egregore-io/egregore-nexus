#!/usr/bin/env bash
set -euo pipefail

# This deterministic fixture suite is a contract pre-gate only. The v0.1.5
# release still requires the genuine clean-prefix packed lab run and the
# execution-level Windows .cmd/.bat lifecycle gate; neither is waivable by a
# passing fixture run here.

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
TARGET="$SCRIPT_DIR/nexus-v015-webconsole-acceptance"
TMP=$(mktemp -d)
GATEWAY_PID=""
GATEWAY_AUX_PID=""
INERT_WEBUI_PID=""
CLEANUP_REPLACEMENT_PID=""

cleanup() {
  if [ -f "$TMP/home/webconsole.json" ]; then
    pid=$(jq -r '.pid // empty' "$TMP/home/webconsole.json" 2>/dev/null || true)
    if [ -n "$pid" ]; then kill -KILL "$pid" 2>/dev/null || true; fi
  fi
  if [ -f "$TMP/webconsole.pid" ]; then
    pid=$(cat "$TMP/webconsole.pid" 2>/dev/null || true)
    if [ -n "$pid" ]; then kill -KILL "$pid" 2>/dev/null || true; fi
  fi
  if [ -n "$GATEWAY_PID" ]; then kill "$GATEWAY_PID" 2>/dev/null || true; fi
  if [ -n "$GATEWAY_AUX_PID" ]; then kill "$GATEWAY_AUX_PID" 2>/dev/null || true; fi
  if [ -n "$INERT_WEBUI_PID" ]; then kill -KILL "$INERT_WEBUI_PID" 2>/dev/null || true; fi
  if [ -n "$CLEANUP_REPLACEMENT_PID" ]; then
    kill -KILL "$CLEANUP_REPLACEMENT_PID" 2>/dev/null || true
  fi
  rm -rf "$TMP"
}
trap cleanup EXIT

mkdir -p "$TMP/bin" "$TMP/home" "$TMP/evidence/fixture/artifacts" "$TMP/cgroup"
printf '%s\n' '600000 100000' >"$TMP/cgroup/cpu.max"
printf '%s\n' '8589934592' >"$TMP/cgroup/memory.max"
printf '%s\n' '0' >"$TMP/cgroup/memory.swap.max"
printf '%s\n' '1024' >"$TMP/cgroup/pids.max"
export NEXUS_V015_FIXTURE_CGROUP_ROOT="$TMP/cgroup"

cat >"$TMP/bin/nexus-webui-fixture" <<'PY'
#!/usr/bin/env python3
import argparse
import json
import os
import signal
import socket
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

if sys.argv[1:] == ["--transient-probe"]:
    raise SystemExit(0)

parser = argparse.ArgumentParser()
parser.add_argument("--host", required=True)
parser.add_argument("--port", required=True, type=int)
parser.add_argument("--gateway-url", required=True)
parser.add_argument("--discovery", required=True)
args = parser.parse_args()

executable = str(Path(__file__).resolve())
url_host = f"[{args.host}]" if ":" in args.host else args.host
url = f"http://{url_host}:{args.port}"


class Handler(BaseHTTPRequestHandler):
    def log_message(self, _format, *_values):
        return

    def do_GET(self):
        if self.path == "/health":
            body = json.dumps({
                "ok": True,
                "service": "nexus-webui",
                "pid": os.getpid(),
                "host": args.host,
                "port": args.port,
                "url": url,
                "gateway": args.gateway_url,
                "executable": executable,
            }).encode()
            self.send_response(200)
            self.send_header("content-type", "application/json")
            self.send_header("content-length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        body = b"nexus-webui-fixture\n"
        self.send_response(200)
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


discovery = {
    "pid": os.getpid(),
    "host": args.host,
    "port": args.port,
    "url": url,
    "gatewayUrl": args.gateway_url,
    "executable": executable,
}
path = Path(args.discovery)
path.parent.mkdir(parents=True, exist_ok=True)
temporary = path.with_suffix(".json.tmp")
temporary.write_text(json.dumps(discovery), encoding="utf-8")
temporary.replace(path)

class Server(ThreadingHTTPServer):
    address_family = socket.AF_INET6 if ":" in args.host else socket.AF_INET


server = Server((args.host, args.port), Handler)


def reexec_executable(_signum, _frame):
    os.execv("/bin/sleep", ["/bin/sleep", "300"])


def reexec_argv(_signum, _frame):
    os.execv(
        sys.executable,
        [sys.executable, "-c", "import time; time.sleep(300)", "fixture-reexec-argv"],
    )


signal.signal(signal.SIGUSR1, reexec_executable)
signal.signal(signal.SIGUSR2, reexec_argv)
server.serve_forever()
PY
chmod +x "$TMP/bin/nexus-webui-fixture"

cat >"$TMP/bin/nexus-fixture" <<'PY'
#!/usr/bin/env python3
import json
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

args = sys.argv[1:]
with open(os.environ["FIXTURE_COMMANDS"], "a", encoding="utf-8") as stream:
    stream.write(" ".join(args) + "\n")
with open(os.environ["FIXTURE_ENVIRONMENTS"], "a", encoding="utf-8") as stream:
    stream.write(json.dumps({
        "args": args,
        "native": os.environ.get("NEXUS_NATIVE_BIN"),
    }) + "\n")
if os.environ.get("NEXUS_NATIVE_BIN") == os.environ.get("FIXTURE_DECOY_NATIVE"):
    Path(os.environ["FIXTURE_DECOY_NATIVE_MARKER"]).touch()

json_mode = bool(args and args[0] == "--json")
if json_mode:
    args.pop(0)

home = Path(os.environ["NEXUS_HOME"])
discovery_path = home / "webconsole.json"
log_path = home / "webconsole.log"
gateway_path = home / "gateway.json"


def process_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False


def read_discovery():
    try:
        return json.loads(discovery_path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def probe(host, port):
    try:
        url_host = f"[{host}]" if ":" in host else host
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(f"http://{url_host}:{port}/health", timeout=0.5) as response:
            return "response", response.status, json.loads(response.read())
    except urllib.error.HTTPError as error:
        return "response", error.code, None
    except (urllib.error.URLError, TimeoutError, ConnectionError, json.JSONDecodeError):
        return "absent", None, None


def runtime():
    discovery = read_discovery()
    if discovery and process_alive(int(discovery["pid"])):
        kind, status, body = probe(discovery["host"], int(discovery["port"]))
        if kind == "response" and status == 200 and body and body.get("service") == "nexus-webui":
            return discovery
    return None


def report(discovery=None):
    discovery = discovery or runtime()
    if discovery:
        value = {
            "installed": True,
            "gatewayHealthy": True,
            "runtime": {
                "state": "live",
                "pid": int(discovery["pid"]),
                "url": discovery["url"],
                "host": discovery["host"],
                "port": int(discovery["port"]),
                "gatewayUrl": discovery["gatewayUrl"],
            },
            "logPath": str(log_path),
        }
    else:
        value = {
            "installed": True,
            "gatewayHealthy": True,
            "runtime": {"state": "down"},
            "logPath": str(log_path),
        }
    if json_mode:
        print(json.dumps(value))
    elif discovery:
        print(f"Nexus Webconsole live pid={discovery['pid']} url={discovery['url']}")
    else:
        print("Nexus Webconsole down")


def fail(message, code="WEBCONSOLE_LIFECYCLE_FAILED", data=None):
    if json_mode:
        print(json.dumps({"error": {
            "code": code,
            "message": message,
            "hint": None,
            "data": data,
        }}))
    else:
        print(f"error: {message}", file=sys.stderr)
    raise SystemExit(1)


def option(name, default=None):
    try:
        return args[args.index(name) + 1]
    except (ValueError, IndexError):
        return default


def stop(force):
    discovery = read_discovery()
    if discovery and process_alive(int(discovery["pid"])):
        pid = int(discovery["pid"])
        os.kill(pid, signal.SIGTERM)
        deadline = time.monotonic() + 2
        while process_alive(pid) and time.monotonic() < deadline:
            time.sleep(0.02)
        if force and process_alive(pid):
            os.kill(pid, signal.SIGKILL)
    discovery_path.unlink(missing_ok=True)


def start(host, port):
    current = runtime()
    if current:
        return current
    kind, status, health = probe(host, port)
    if kind == "response":
        if status == 200 and health and health.get("service") == "nexus-webui":
            adopted = {
                "pid": int(health["pid"]),
                "host": health["host"],
                "port": int(health["port"]),
                "url": health["url"],
                "gatewayUrl": health["gateway"],
                "executable": health["executable"],
            }
            discovery_path.write_text(json.dumps(adopted), encoding="utf-8")
            return adopted
        if os.environ.get("FIXTURE_SPAWN_TRANSIENT_ON_OCCUPIED") == "1":
            subprocess.run(
                [os.environ["NEXUS_WEBUI_BIN"], "--transient-probe"],
                check=False,
                timeout=2,
            )
        fail(
            f"Webconsole port {port} is occupied by an unverified process",
            "WEBCONSOLE_PORT_OCCUPIED",
            {"host": host, "port": port},
        )
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log = open(log_path, "a", encoding="utf-8")
    gateway_url = json.loads(gateway_path.read_text(encoding="utf-8"))["url"]
    process = subprocess.Popen([
        os.environ["NEXUS_WEBUI_BIN"],
        "--host", host,
        "--port", str(port),
        "--gateway-url", gateway_url,
        "--discovery", str(discovery_path),
    ], stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)
    Path(os.environ["FIXTURE_PID"]).write_text(str(process.pid), encoding="utf-8")
    Path(os.environ["FIXTURE_PID"] + ".port").write_text(str(port), encoding="utf-8")
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        current = runtime()
        if current:
            return current
        time.sleep(0.05)
    fail("Webconsole did not become healthy")


if args == ["--version"]:
    print(os.environ.get("FIXTURE_VERSION_OUTPUT", "nexus 0.1.5"))
    raise SystemExit(0)

if args[:2] == ["gateway", "status"]:
    replacement_marker = os.environ.get("FIXTURE_REPLACE_WEBCONSOLE_MARKER")
    if (
        os.environ.get("FIXTURE_REPLACE_WEBCONSOLE_DURING_GATEWAY_STATUS") == "1"
        and replacement_marker
        and discovery_path.exists()
        and not Path(replacement_marker).exists()
    ):
        previous = read_discovery()
        if previous and process_alive(int(previous["pid"])):
            os.kill(int(previous["pid"]), signal.SIGKILL)
            deadline = time.monotonic() + 2
            while time.monotonic() < deadline:
                kind, _status, _body = probe(previous["host"], int(previous["port"]))
                if kind == "absent":
                    break
                time.sleep(0.01)
            replacement = subprocess.Popen(
                [
                    os.environ["NEXUS_WEBUI_BIN"],
                    "--host", previous["host"],
                    "--port", str(previous["port"]),
                    "--gateway-url", previous["gatewayUrl"],
                    "--discovery", str(discovery_path),
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            Path(os.environ["FIXTURE_REPLACEMENT_PID"]).write_text(
                str(replacement.pid), encoding="utf-8"
            )
            Path(replacement_marker).touch()
            deadline = time.monotonic() + 5
            while time.monotonic() < deadline:
                current = runtime()
                if current and int(current["pid"]) == replacement.pid:
                    break
                time.sleep(0.02)
            fail("fixture replaced Webconsole with a same-shaped owner")
    fail_when_result_exists = os.environ.get("FIXTURE_FAIL_GATEWAY_STATUS_WHEN_RESULT_EXISTS")
    if fail_when_result_exists and Path(fail_when_result_exists).exists():
        print("fixture forced final Gateway status failure", file=sys.stderr)
        raise SystemExit(91)
    gateway = json.loads(gateway_path.read_text(encoding="utf-8"))
    value = {
        "installed": True,
        "daemonRunning": True,
        "runtime": {"state": "live", "pid": gateway["pid"], "url": gateway["url"]},
        "logPath": str(home / "gateway.log"),
    }
    print(json.dumps(value) if json_mode else f"gateway: live pid={gateway['pid']} url={gateway['url']}")
    raise SystemExit(0)

if args[:2] == ["webconsole", "--help"]:
    print("Usage: nexus webconsole <COMMAND>")
    raise SystemExit(0)
if len(args) >= 3 and args[0] == "webconsole" and args[2] == "--help":
    print(f"Usage: nexus webconsole {args[1]}")
    raise SystemExit(0)
if len(args) < 2 or args[0] != "webconsole":
    raise SystemExit(64)

action = args[1]
host = option("--host", "127.0.0.1")
port = int(option("--port", "4200"))

if action in {"start", "launch"}:
    started = start(host, port)
    mutation_marker = os.environ.get("FIXTURE_MUTATION_MARKER")
    if (
        action == "start"
        and os.environ.get("FIXTURE_MUTATE_GATEWAY_ON_START") == "1"
        and mutation_marker
        and not Path(mutation_marker).exists()
    ):
        gateway_path.write_text(gateway_path.read_text(encoding="utf-8") + " ", encoding="utf-8")
        Path(mutation_marker).touch()
    entrypoint_marker = os.environ.get("FIXTURE_ENTRYPOINT_MUTATION_MARKER")
    if (
        action == "start"
        and os.environ.get("FIXTURE_REPLACE_WEBUI_ENTRYPOINT_ON_START") == "1"
        and entrypoint_marker
        and not Path(entrypoint_marker).exists()
    ):
        entrypoint = Path(os.environ["NEXUS_WEBUI_BIN"])
        replacement = entrypoint.with_name(entrypoint.name + ".replacement")
        replacement.write_bytes(entrypoint.read_bytes() + b"\n# replaced after launch\n")
        replacement.chmod(entrypoint.stat().st_mode & 0o777)
        replacement.replace(entrypoint)
        Path(entrypoint_marker).touch()
    report(started)
elif action == "restart":
    stop(False)
    restarted = start(host, port)
    if os.environ.get("FIXTURE_MUTATE_GATEWAY_ON_RESTART") == "1":
        gateway_path.write_text(gateway_path.read_text(encoding="utf-8") + " ", encoding="utf-8")
    report(restarted)
elif action == "stop":
    if "--force" in args and os.environ.get("FIXTURE_REEXEC_WEBUI_ON_FORCE_STOP"):
        discovery = read_discovery()
        if discovery and process_alive(int(discovery["pid"])):
            pid = int(discovery["pid"])
            mode = os.environ["FIXTURE_REEXEC_WEBUI_ON_FORCE_STOP"]
            os.kill(pid, signal.SIGUSR1 if mode == "executable" else signal.SIGUSR2)
            deadline = time.monotonic() + 2
            while time.monotonic() < deadline:
                try:
                    executable = os.path.realpath(f"/proc/{pid}/exe")
                    argv = [
                        raw.decode("utf-8", "surrogateescape")
                        for raw in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
                        if raw
                    ]
                except OSError:
                    break
                if mode == "executable" and executable == os.path.realpath("/bin/sleep"):
                    break
                if mode == "argv" and "fixture-reexec-argv" in argv:
                    break
                time.sleep(0.01)
            fail("fixture re-execed Webconsole before cleanup fallback")
    if (
        "--force" in args
        and os.environ.get("FIXTURE_REMOVE_DISCOVERY_AND_FAIL_FORCE_STOP") == "1"
    ):
        discovery_path.unlink(missing_ok=True)
        fail("fixture removed discovery before cleanup fallback")
    if "--force" in args and os.environ.get("FIXTURE_REPLACE_DISCOVERY_ON_FORCE_STOP") == "1":
        stop(True)
        replacement = subprocess.Popen(
            [
                sys.executable,
                "-c",
                "import time; time.sleep(300)",
                os.environ["NEXUS_WEBUI_BIN"],
                "--discovery",
                str(discovery_path),
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        Path(os.environ["FIXTURE_REPLACEMENT_PID"]).write_text(
            str(replacement.pid), encoding="utf-8"
        )
        discovery_path.write_text(
            json.dumps(
                {
                    "pid": replacement.pid,
                    "host": host,
                    "port": port,
                    "url": f"http://{host}:{port}",
                    "gatewayUrl": json.loads(gateway_path.read_text(encoding="utf-8"))["url"],
                    "executable": str(Path(os.environ["NEXUS_WEBUI_BIN"]).resolve()),
                }
            ),
            encoding="utf-8",
        )
        fail("fixture replaced discovery before cleanup fallback")
    if "--force" in args and os.environ.get("FIXTURE_FAIL_FORCE_STOP") == "1":
        fail("fixture forced cleanup stop failure")
    stop("--force" in args)
    report()
elif action == "status":
    current = runtime()
    report(current)
    if current is None:
        raise SystemExit(2)
elif action == "url":
    current = runtime()
    if current is None:
        fail("Webconsole is not running")
    print(json.dumps({"url": current["url"]}) if json_mode else current["url"])
elif action == "logs":
    lines = int(option("--lines", option("-n", "80")))
    content = log_path.read_text(encoding="utf-8").splitlines() if log_path.exists() else []
    for line in content[-lines:]:
        print(line, flush=True)
    if "--follow" in args:
        position = log_path.stat().st_size if log_path.exists() else 0
        while True:
            time.sleep(0.05)
            if not log_path.exists():
                continue
            with log_path.open(encoding="utf-8") as stream:
                stream.seek(position)
                for line in stream:
                    print(line.rstrip("\n"), flush=True)
                position = stream.tell()
else:
    raise SystemExit(64)
PY
chmod +x "$TMP/bin/nexus-fixture"

set +e
"$TARGET" --help >"$TMP/help" 2>"$TMP/help.err"
help_status=$?
set -e
test "$help_status" -eq 0
grep -Fq -- "--nexus-bin" "$TMP/help"
grep -Fq -- "--evidence-dir" "$TMP/help"
grep -Fq -- "--port" "$TMP/help"
grep -Fq -- "--packed-prefix" "$TMP/help"
grep -Fq -- "--verify-result-seal" "$TMP/help"

PREFIX="$TMP/nexus-lab-install.fixtureABC"
UMBRELLA="$PREFIX/lib/node_modules/@egregore/nexus"
CLI_PACKAGE="$UMBRELLA/node_modules/@egregore/nexus-cli"
GATEWAY_PACKAGE="$UMBRELLA/node_modules/@egregore/nexus-gateway"
mkdir -p \
  "$PREFIX/bin" \
  "$UMBRELLA/bin" \
  "$CLI_PACKAGE/bin" \
  "$CLI_PACKAGE/native/linux-x64-gnu" \
  "$GATEWAY_PACKAGE/dist-gateway" \
  "$GATEWAY_PACKAGE/webconsole/bin"
cp "$TMP/bin/nexus-fixture" "$UMBRELLA/bin/nexus.mjs"
cp "$TMP/bin/nexus-webui-fixture" "$UMBRELLA/bin/nexus-webui.mjs"
cat >"$UMBRELLA/bin/nexus-gateway.mjs" <<'PY'
#!/usr/bin/env python3
import argparse
import json
import socket
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

parser = argparse.ArgumentParser()
parser.add_argument("--fixture-runtime", action="store_true")
parser.add_argument("--port", required=True, type=int)
parser.add_argument("--module", required=True)
parser.add_argument("--install-root", required=True)
parser.add_argument("--no-listen", action="store_true")
parser.add_argument("--inert")
parser.add_argument("--bind-host", default="127.0.0.1")
parser.add_argument("--expected-host-header")
parser.add_argument(
    "--runtime-identity",
    choices=("full", "none", "partial", "malformed", "mismatch"),
    default="full",
)
args = parser.parse_args()

if args.no_listen:
    time.sleep(300)
    raise SystemExit(0)


class Handler(BaseHTTPRequestHandler):
    def log_message(self, _format, *_values):
        return

    def do_GET(self):
        if self.path != "/api/v1/health":
            self.send_response(404)
            self.end_headers()
            return
        if args.expected_host_header and self.headers.get("Host") != args.expected_host_header:
            self.send_response(421)
            self.end_headers()
            return
        document = {
            "status": "ok",
            "store": "gateway",
        }
        if args.runtime_identity == "full":
            document["runtime"] = {
                "entrypoint": str(Path(__file__).resolve()),
                "loadedModule": str(Path(args.module).resolve()),
                "installRoot": str(Path(args.install_root).resolve()),
            }
        elif args.runtime_identity == "partial":
            document["runtime"] = {"entrypoint": str(Path(__file__).resolve())}
        elif args.runtime_identity == "malformed":
            document["runtime"] = "malformed"
        elif args.runtime_identity == "mismatch":
            document["runtime"] = {
                "entrypoint": str(Path(__file__).resolve()),
                "loadedModule": str(Path(args.module).resolve()) + ".other",
                "installRoot": str(Path(args.install_root).resolve()),
            }
        body = json.dumps(document).encode()
        self.send_response(200)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


class Server(ThreadingHTTPServer):
    address_family = socket.AF_INET6 if ":" in args.bind_host else socket.AF_INET

    def server_bind(self):
        if self.address_family == socket.AF_INET6:
            self.socket.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
        super().server_bind()


Server((args.bind_host, args.port), Handler).serve_forever()
PY
chmod +x "$UMBRELLA/bin/"*.mjs
cp "$UMBRELLA/bin/nexus.mjs" "$CLI_PACKAGE/bin/nexus.mjs"
printf '%s\n' '#!/usr/bin/env bash' 'exit 0' >"$CLI_PACKAGE/native/linux-x64-gnu/nexus"
chmod +x "$CLI_PACKAGE/bin/nexus.mjs" "$CLI_PACKAGE/native/linux-x64-gnu/nexus"
printf '%s\n' 'export const fixtureGateway = true;' >"$GATEWAY_PACKAGE/dist-gateway/headless.mjs"
cp "$TMP/bin/nexus-webui-fixture" "$GATEWAY_PACKAGE/webconsole/bin/nexus-webui.mjs"
chmod +x "$GATEWAY_PACKAGE/webconsole/bin/nexus-webui.mjs"
ln -s ../lib/node_modules/@egregore/nexus/bin/nexus.mjs "$PREFIX/bin/nexus"
ln -s ../lib/node_modules/@egregore/nexus/bin/nexus-gateway.mjs "$PREFIX/bin/nexus-gateway"
ln -s ../lib/node_modules/@egregore/nexus/bin/nexus-webui.mjs "$PREFIX/bin/nexus-webui"
cat >"$UMBRELLA/package.json" <<'JSON'
{
  "name": "@egregore/nexus",
  "version": "0.1.5",
  "bin": {
    "nexus": "bin/nexus.mjs",
    "nexus-gateway": "bin/nexus-gateway.mjs",
    "nexus-webui": "bin/nexus-webui.mjs"
  },
  "dependencies": {
    "@egregore/nexus-cli": "0.1.5",
    "@egregore/nexus-gateway": "0.1.5"
  }
}
JSON
