webuiLink=$PREFIX/bin/nexus-webui
webuiResolved=$UMBRELLA/bin/nexus-webui.mjs
webuiSha256=$(sha256sum "$UMBRELLA/bin/nexus-webui.mjs" | cut -d' ' -f1)
