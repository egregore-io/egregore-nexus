  FIXTURE_ENVIRONMENTS="$TMP/command-environments.jsonl" \
  FIXTURE_PID="$TMP/webconsole.pid" \
  "$TARGET" \
    --nexus-bin "$PREFIX/bin/nexus" \
    --packed-prefix "$PREFIX" \
    --host 127.0.0.1 \
    --port 0 \
    --run-id inert-gateway-argv \
    --evidence-dir "$TMP/evidence" \
    >"$TMP/inert-gateway-argv.stdout" 2>"$TMP/inert-gateway-argv.stderr"
inert_gateway_status=$?
set -e
test "$inert_gateway_status" -ne 0
grep -Fq 'not launched through the validated packed Gateway entrypoint at argv[1]' \
  "$TMP/inert-gateway-argv.stderr"
test ! -e "$TMP/evidence/inert-gateway-argv/results/D2-webconsole-cli.result.sha256"

