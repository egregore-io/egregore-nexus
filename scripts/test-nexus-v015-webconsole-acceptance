        "NEXUS_V015_GATEWAY_MODULE": str(gateway / "dist-gateway/headless.mjs"),
        "NEXUS_V015_GATEWAY_MODULE_SHA256": digest(gateway / "dist-gateway/headless.mjs"),
        "NEXUS_V015_NATIVE_BIN": str(cli / "native/linux-x64-gnu/nexus"),
        "NEXUS_V015_NATIVE_BIN_SHA256": digest(cli / "native/linux-x64-gnu/nexus"),
        "NEXUS_V015_CONTAINER_ID": "c" * 64,
        "NEXUS_V015_INSTALL_NONCE": "fixtureABC",
        "NEXUS_V015_READINESS_LEDGER": str(readiness),
        "NEXUS_V015_READINESS_LEDGER_SHA256": digest(readiness),
    },
}
(root / "manifest.json").write_text(json.dumps(manifest), encoding="utf-8")
PY

