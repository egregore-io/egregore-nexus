        tree = hashlib.sha256()
        for relative in sorted(payload_paths, key=lambda item: item.as_posix()):
            absolute = self.root / relative
            tree.update(
                relative.as_posix().encode("utf-8")
                + b"\0"
                + str(stat.S_IMODE(absolute.stat().st_mode)).encode("ascii")
