    def test_duplicate_JSON_keys_and_nonfinite_numbers_are_rejected(self) -> None:
        duplicate = self.fixture("duplicate-json-key")
        text = duplicate.manifest_path.read_text(encoding="utf-8")
        text = text.replace(
            f'"runId": "{RUN_ID}"',
            f'"runId": "{RUN_ID}",\n  "runId": "other-run"',
            1,
        )
        os.chmod(duplicate.manifest_path, 0o600)
        duplicate.manifest_path.write_text(text, encoding="utf-8")
        os.chmod(duplicate.manifest_path, 0o400)
        self.assert_invalid(duplicate, "JSON_DUPLICATE_KEY")

        nan = self.fixture("nan-json")
        document = read_json(nan.result_paths["F3"])
        document["elapsedSeconds"] = float("nan")
        write_json(nan.result_paths["F3"], document)
        self.assert_invalid(nan, "JSON_NONFINITE")

        overflow = self.fixture("overflow-json")
        path = overflow.result_paths["F3"]
        text = path.read_text(encoding="utf-8").replace('"elapsedSeconds": 1800.0', '"elapsedSeconds": 1e999')
        path.write_text(text, encoding="utf-8")
        self.assert_invalid(overflow, "JSON_NONFINITE")

    def test_parent_symlinks_are_rejected_for_documents_and_artifacts(self) -> None:
        document_link = self.fixture("document-parent-link")
        original_parent = document_link.result_paths["B1"].parent
        real_parent = original_parent.with_name(original_parent.name + "-real")
        original_parent.rename(real_parent)
        original_parent.symlink_to(real_parent.name, target_is_directory=True)
        self.assert_invalid(document_link, "DOCUMENT_SYMLINK")

        artifact_link = self.fixture("artifact-parent-link")
        document = read_json(artifact_link.case_meta["O5"])
        artifact = artifact_link.root / document["artifacts"]["dom"]["path"]
        real_artifact = artifact.with_name(artifact.name + "-real")
        artifact.rename(real_artifact)
        artifact.symlink_to(real_artifact.name)
        self.assert_invalid(artifact_link, "ARTIFACT_SYMLINK")

        root_link = self.fixture("run-parent-link")
        real_base = self.base / "real-parent"
        real_base.mkdir()
        moved_root = real_base / root_link.root.name
        root_link.root.rename(moved_root)
        linked_base = self.base / "linked-parent"
        linked_base.symlink_to(real_base, target_is_directory=True)
        result = self.run_validator(linked_base / moved_root.name)
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn("EVIDENCE_RUN_DIR_SYMLINK:", result.stderr)

    def test_cross_case_hardlink_reuse_is_rejected(self) -> None:
        fixture = self.fixture("hardlink-reuse")
        first = read_json(fixture.case_meta["O1"])
        second = read_json(fixture.case_meta["O2"])
