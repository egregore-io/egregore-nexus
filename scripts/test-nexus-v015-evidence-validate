        self.assert_invalid(reserved, "D2_INVENTORY")

    def test_D2_detached_seal_is_mandatory_and_candidate_bound(self) -> None:
        missing = self.fixture("d2-seal-missing")
        (missing.root / D2_SEAL_RELATIVE).unlink()
        self.assert_invalid(missing, "D2_SEAL_MISSING")

        mutations = (
            ("run-id", "runId", "different-run"),
            ("candidate", "candidateDigest", "sha256:" + "f" * 64),
            ("gate", "gate", "D1"),
            ("result-path", "resultPath", "results/D2-webconsole-cli/other.json"),
            ("result-hash", "resultSha256", "0" * 64),
            ("result-size", "resultSize", 1),
        )
        for name, field, value in mutations:
            with self.subTest(name=name):
                fixture = self.fixture(f"d2-seal-{name}")
                seal_path = fixture.root / D2_SEAL_RELATIVE
                document = read_json(seal_path)
                document[field] = value
                rewrite_readonly_json(seal_path, document)
                self.assert_invalid(fixture, "D2_SEAL_MISMATCH")

    def test_D2_detached_seal_requires_canonical_modes_and_strict_json(self) -> None:
        wrong_result_mode = self.fixture("d2-seal-result-mode")
        os.chmod(wrong_result_mode.result_paths["D2"], 0o600)
        self.assert_invalid(wrong_result_mode, "D2_SEAL_MODE")

        wrong_seal_mode = self.fixture("d2-seal-seal-mode")
        os.chmod(wrong_seal_mode.root / D2_SEAL_RELATIVE, 0o600)
        self.assert_invalid(wrong_seal_mode, "D2_SEAL_MODE")

        invalid_documents = (
            ("invalid", b"{not-json}\n"),
            ("duplicate", b'{"schemaVersion":1,"schemaVersion":1}\n'),
            ("nonfinite", b'{"schemaVersion":1,"resultSize":NaN}\n'),
        )
        for name, raw in invalid_documents:
            with self.subTest(name=name):
                fixture = self.fixture(f"d2-seal-json-{name}")
                seal_path = fixture.root / D2_SEAL_RELATIVE
                os.chmod(seal_path, 0o600)
                seal_path.write_bytes(raw)
                os.chmod(seal_path, 0o400)
                self.assert_invalid(fixture, "D2_SEAL_INVALID")

    def test_D2_detached_seal_rejects_symlink_and_hardlink_aliases(self) -> None:
        symlink = self.fixture("d2-seal-symlink")
        seal_path = symlink.root / D2_SEAL_RELATIVE
        replacement = symlink.root / "detached-seal-copy"
        replacement.write_bytes(seal_path.read_bytes())
        seal_path.unlink()
        seal_path.symlink_to(replacement)
        self.assert_invalid(symlink, "D2_SEAL_TYPE")

        hardlink = self.fixture("d2-seal-hardlink")
        seal_path = hardlink.root / D2_SEAL_RELATIVE
        os.link(seal_path, hardlink.root / "detached-seal-alias")
        self.assert_invalid(hardlink, "D2_SEAL_TYPE")

    def test_D2_detached_seal_rejects_coordinated_result_rewrite(self) -> None:
        fixture = self.fixture("d2-seal-coordinated-rewrite")
        result_path = fixture.result_paths["D2"]
        output_path = result_path.parent / "version.stdout"
        output_path.write_text("nexus 0.1.5 rewritten\n", encoding="utf-8")

        result = read_json(result_path)
        output_relative = output_path.relative_to(fixture.root).as_posix()
        for record in result["evidenceInventory"]:
            if record["path"] == output_relative:
                record["sha256"] = sha256(output_path)
                record["size"] = output_path.stat().st_size
                break
        else:
            self.fail("fixture D2 inventory did not include version.stdout")
        rewrite_readonly_json(result_path, result)

        self.assert_invalid(fixture, "D2_SEAL_MISMATCH")

