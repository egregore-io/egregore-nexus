        document["requiredArtifacts"].remove("finalListeners")
        document["artifacts"].pop("finalListeners")
        write_json(missing_final.result_paths["F3"], document)
        self.assert_invalid(missing_final, "ARTIFACT_REQUIRED")

    def test_soak_requires_every_explicit_release_invariant(self) -> None:
        for key in (
            "duration",
            "restartCount",
            "restartStraddle",
            "traffic",
            "sessionCorrelation",
            "delivery",
            "websocketReconnect",
            "resources",
            "topology",
            "diagnostics",
        ):
            fixture = self.fixture(f"soak-invariant-{key}")
            document = read_json(fixture.result_paths["F3"])
            document["invariants"][key] = False
            write_json(fixture.result_paths["F3"], document)
            self.assert_invalid(fixture, "SOAK_INVARIANT")

    def test_soak_requires_resource_health_and_topology_summaries(self) -> None:
        samples = self.fixture("soak-resource-samples")
        document = read_json(samples.result_paths["F3"])
        document["resourceHealth"]["sampleCount"] = 59
        write_json(samples.result_paths["F3"], document)
        self.assert_invalid(samples, "SOAK_RESOURCE_HEALTH")

        oom = self.fixture("soak-resource-oom")
        document = read_json(oom.result_paths["F3"])
        document["resourceHealth"]["memoryEventDeltas"]["oom_kill"] = 1
        write_json(oom.result_paths["F3"], document)
        self.assert_invalid(oom, "SOAK_RESOURCE_HEALTH")

        topology = self.fixture("soak-topology")
        document = read_json(topology.result_paths["F3"])
        document["topology"]["tcpPorts"].remove(4200)
        write_json(topology.result_paths["F3"], document)
        self.assert_invalid(topology, "SOAK_TOPOLOGY")

    def test_soak_requires_exact_restart_counts_and_positive_cursors(self) -> None:
        excessive = self.fixture("soak-restart-excessive")
        document = read_json(excessive.result_paths["F3"])
        document["checkpoints"]["daemonReconnects"] = 3
        write_json(excessive.result_paths["F3"], document)
        self.assert_invalid(excessive, "SOAK_CHECKPOINT")

        zero_cursor = self.fixture("soak-zero-cursor")
        document = read_json(zero_cursor.result_paths["F3"])
        document["checkpoints"]["developerWebSocket"]["lastAcceptedCursor"] = 0
        write_json(zero_cursor.result_paths["F3"], document)
        self.assert_invalid(zero_cursor, "SOAK_CHECKPOINT")


if __name__ == "__main__":
    if os.geteuid() != 0 and os.environ.get("NEXUS_V015_VALIDATOR_TEST_USERNS") != "1":
        environment = dict(os.environ)
        environment["NEXUS_V015_VALIDATOR_TEST_USERNS"] = "1"
        os.execvpe(
            "unshare",
            ["unshare", "-Ur", sys.executable, str(Path(__file__).resolve()), *sys.argv[1:]],
            environment,
        )
    unittest.main(verbosity=2)
