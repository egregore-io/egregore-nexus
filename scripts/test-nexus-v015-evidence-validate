        )
        os.chmod(seal_path, 0o400)

    def _build_cases(self) -> None:
        for case_id in EXPECTED_CASES:
            ocular = case_id.startswith("O")
            surface = "ocular" if ocular else "webui"
            required = list(OCULAR_ARTIFACTS if ocular else WEBUI_ARTIFACTS)
            if case_id in {"O3", "O4"}:
                required.append("mechanism")
            case_directory = Path(f"{case_id}-20260720T000000Z")
            artifacts = {}
            for name in required:
                artifact_path = case_directory / f"{name}.json"
                if name == "preScreenshot":
                    artifact_path = case_directory / "preScreenshot.jpeg"
                    artifact_data = b"\xff\xd8\xff\xe0pre-action-jpeg"
                elif name == "postScreenshot":
                    artifact_path = case_directory / "postScreenshot.jpeg"
                    artifact_data = b"\xff\xd8\xff\xe0post-action-jpeg"
                elif name == "dom":
                    artifact_path = case_directory / "dom.html"
                    artifact_data = b"<!DOCTYPE html>\n<html><body>fixture</body></html>\n"
                elif name == "console":
                    artifact_data = b'{"messages":[],"violations":[]}\n'
                elif name == "network":
                    artifact_data = b"[]\n"
                elif name == "websocket":
                    artifact_data = (
                        b'[{"payload":"input.ack"}]\n'
                        if case_id in {"O3", "O4"}
                        else b"[]\n"
                    )
                elif name == "processLogs":
                    artifact_data = json.dumps(
                        {
                            "capturedAt": "2026-07-20T00:00:00Z",
                            "runnerPid": 4242,
                            "rendererTarget": {
                                "id": "fixture-target",
                                "url": "http://127.0.0.1:1422/",
                            },
                            "logs": {
                                "daemon": {
                                    "path": str(self.lab_root / "nexus/daemon.log"),
                                    "tail": "daemon ok",
                                },
                                "gateway": {
                                    "path": str(self.lab_root / "lab/gateway-start.log"),
                                    "tail": "gateway ok",
                                },
                                "lens": {
                                    "path": str(self.lab_root / "lab/lens.log"),
                                    "tail": "lens ok",
                                },
                            },
                        }
                    ).encode("utf-8") + b"\n"
                elif name == "health":
                    artifact_data = json.dumps(
                        {
                            "capturedAt": "2026-07-20T00:00:00Z",
                            "url": "http://127.0.0.1:4100/api/v1/health",
                            "status": 200,
                            "body": '{"ok":true}',
                        }
                    ).encode("utf-8") + b"\n"
                elif name == "pactbin2":
                    artifact_path = case_directory / "pactbin2.pact"
                    artifact_data = b"PACTBIN2" + b"\0" * 4088
                elif name == "mechanism":
                    artifact_data = b'{"pushFrames":1,"postCommitWakes":1,"timerReads":0}\n'
                else:
                    raise AssertionError(f"unhandled fixture artifact: {name}")
                artifacts[name] = self.artifact(artifact_path, artifact_data)
            manifest = {
                "schemaVersion": 1,
                "schema": "ocular-evidence/2",
                "runId": RUN_ID,
                "readinessSha256": sha256(self.readiness_path),
                "case": case_id,
                "surface": surface,
                **self.passing_outcome(),
                "requiredArtifacts": required,
                "artifacts": artifacts,
            }
            if case_id in {"O3", "O4"}:
                manifest["mechanism"] = {
                    "pushFrames": 1,
                    "postCommitWakes": 1,
                    "timerReads": 0,
                }
            manifest_path = self.root / case_directory / "manifest.json"
            self.case_meta[case_id] = manifest_path
            write_json(manifest_path, manifest)

    def _build_results(self) -> None:
        for gate, (relative, artifact_names) in RESULT_SPECS.items():
            if gate == "D2":
                result_directory = Path(relative).parent
                artifacts = {
                    name: self.artifact(
                        result_directory / f"{name}.jsonl",
                        json.dumps({"owner": gate, "artifact": name}).encode("utf-8") + b"\n",
                    )
                    for name in artifact_names
                }
                self.artifact(result_directory / "version.stdout", b"nexus 0.1.5\n")
                evidence_inventory = []
                for absolute in sorted((self.root / result_directory).iterdir()):
                    relative_path = absolute.relative_to(self.root).as_posix()
                    evidence_inventory.append(
                        {
                            "path": relative_path,
                            "sha256": sha256(absolute),
                            "size": absolute.stat().st_size,
                        }
                    )
            else:
                artifacts = self.artifacts(f"results/{gate}", artifact_names)
                evidence_inventory = None
            result = {
                "schemaVersion": 1,
                "runId": RUN_ID,
                "candidateDigest": self.candidate_digest,
                "gate": gate,
                **self.passing_outcome(),
                "requiredArtifacts": list(artifact_names),
                "artifacts": artifacts,
            }
            if evidence_inventory is not None:
                result["evidenceInventory"] = evidence_inventory
            if gate == "DIFF":
                result["unexpectedChanges"] = 0
            elif gate == "REVIEW":
                result["unresolvedBlockers"] = 0
            elif gate == "F3":
                restart_proofs = []
                for index, target in enumerate(("daemon", "daemon", "gateway", "gateway"), 1):
                    before = index * 10
                    restart_proofs.append(
                        {
                            "status": "PASS",
                            "target": target,
                            "transportRecoveryObserved": True,
                            "developer": {
                                "messageId": f"m-restart-{index}",
                                "cursorBefore": before,
                                "cursorAfter": before + 1,
                                "receivedCount": 1,
                            },
                            "agentSessions": {
                                kind: {
                                    "clientMessageId": f"cm-{kind}-{index}",
                                    "cursorBefore": before,
                                    "cursorAfter": before + offset,
                                    "completionCount": 1,
                                }
                                for kind, offset in (("codex", 2), ("claude", 3))
                            },
                        }
                    )
                result.update(
                    {
                        "startedAt": 1_000.0,
                        "endedAt": 2_800.0,
                        "elapsedSeconds": 1_800.0,
                        "failureCounters": {name: 0 for name in SOAK_COUNTERS},
                        "checkpoints": {
                            "developerWebSocket": {
                                "status": "PASS",
                                "reconnects": 4,
                                "lastAcceptedCursor": 14,
                                "topicCursors": {
                                    "sys.message.thread.acceptance": 12,
                                    "sys.dm.codex": 13,
                                    "sys.dm.claude": 14,
                                },
                                "replayCount": 4,
                                "resyncCount": 0,
                            },
                            "agentSessionWebSocket": {
                                "status": "PASS",
                                "reconnects": 4,
                                "lastAcceptedCursor": 31,
                                "agentCursors": {"codex": 31, "claude": 32},
                                "replayCounts": {"codex": 4, "claude": 4},
                                "resyncCounts": {"codex": 0, "claude": 0},
                            },
                            "daemonReconnects": 2,
                            "gatewayReconnects": 2,
                        },
                        "restartProofs": restart_proofs,
                        "bounds": {
                            "memoryBytes": {
                                "start": 100_000_000,
                                "end": 120_000_000,
                                "peak": 150_000_000,
                                "limit": 8589934592,
                            },
                            "diskBytes": {
                                "start": 1_000_000,
                                "end": 1_200_000,
                                "peak": 1_500_000,
                                "limit": 10 * 1024 * 1024 * 1024,
                            },
                        },
                        "resourceHealth": {
                            "status": "PASS",
                            "withinBounds": True,
                            "trendHealthy": True,
                            "sampleCount": 64,
                            "processRssPeak": 220_000_000,
                            "memoryEventDeltas": {"oom": 0, "oom_kill": 0, "max": 0},
                            "pidsMaxDelta": 0,
                        },
                        "topology": {
                            "status": "PASS",
                            "healthy": True,
                            "processes": {
                                "daemon": 101,
                                "gateway": 102,
                                "gatewayProxy": 103,
                                "xvfb": 104,
                                "lens": 105,
                                "lensCdpProxy": 106,
                                "webuiBrowser": 107,
                                "webuiCdpProxy": 108,
                            },
                            "tcpPorts": [4100, 4101, 4200, 9222, 9224],
                            "unixSockets": ["/tmp/nexus.sock", "/tmp/gateway-stream.sock"],
                        },
                        "invariants": {
                            "duration": True,
                            "restartCount": True,
                            "restartStraddle": True,
                            "traffic": True,
                            "sessionCorrelation": True,
                            "delivery": True,
                            "websocketReconnect": True,
                            "resources": True,
                            "topology": True,
                            "diagnostics": True,
                        },
                    }
                )
            path = self.root / relative
            self.result_paths[gate] = path
            write_json(path, result)
            if gate == "D2":
                os.chmod(path, 0o400)
                result_raw = path.read_bytes()
                seal_path = self.root / D2_SEAL_RELATIVE
                write_json(
                    seal_path,
                    {
                        "schemaVersion": 1,
                        "runId": RUN_ID,
                        "candidateDigest": self.candidate_digest,
                        "gate": "D2",
                        "resultPath": D2_RESULT_RELATIVE.as_posix(),
                        "resultSha256": hashlib.sha256(result_raw).hexdigest(),
                        "resultSize": len(result_raw),
                    },
                )
                os.chmod(seal_path, 0o400)

    def _harden_and_seal(self) -> None:
        candidate_directories = {
            Path("candidate"),
            Path("candidate/native"),
            Path("candidate/npm"),
        }
        executable = Path("candidate/native/nexus")
        archives = {
            Path("candidate/npm/nexus.tgz"),
            Path("candidate/npm/nexus-cli.tgz"),
            Path("candidate/npm/nexus-gateway.tgz"),
        }
        for directory, directory_names, filenames in os.walk(self.root, topdown=False):
            base = Path(directory)
            for filename in filenames:
                path = base / filename
                relative = path.relative_to(self.root)
                if relative == executable:
                    mode = 0o555
                elif relative in archives:
                    mode = 0o444
                else:
                    mode = 0o400
                os.chmod(path, mode)
            for name in directory_names:
                path = base / name
                relative = path.relative_to(self.root)
                os.chmod(path, 0o755 if relative in candidate_directories else 0o555)
        os.chmod(self.root, 0o700)

        inventory: list[dict[str, object]] = []
        for directory, directory_names, filenames in os.walk(self.root):
            base = Path(directory)
            for name in sorted(directory_names):
                path = base / name
                info = path.stat(follow_symlinks=False)
                inventory.append(
                    {
                        "path": path.relative_to(self.root).as_posix(),
                        "kind": "directory",
                        "device": info.st_dev,
                        "inode": info.st_ino,
                        "uid": info.st_uid,
                        "gid": info.st_gid,
                        "mode": stat.S_IMODE(info.st_mode),
                        "nlink": info.st_nlink,
                        "mtimeNs": info.st_mtime_ns,
                        "ctimeNs": info.st_ctime_ns,
                    }
                )
            for name in sorted(filenames):
                path = base / name
                info = path.stat(follow_symlinks=False)
                inventory.append(
                    {
                        "path": path.relative_to(self.root).as_posix(),
                        "kind": "file",
                        "device": info.st_dev,
                        "inode": info.st_ino,
                        "uid": info.st_uid,
                        "gid": info.st_gid,
                        "mode": stat.S_IMODE(info.st_mode),
                        "nlink": info.st_nlink,
                        "size": info.st_size,
                        "mtimeNs": info.st_mtime_ns,
                        "ctimeNs": info.st_ctime_ns,
                        "sha256": sha256(path),
                    }
                )
        inventory.sort(key=lambda row: str(row["path"]))
        root_info = self.root.stat()
        write_json(
            self.run_seal_path,
            {
                "schemaVersion": 1,
                "runId": RUN_ID,
                "candidateDigest": self.candidate_digest,
                "containerId": self.container_id,
                "labRoot": str(self.lab_root),
                "runRoot": str(self.root),
                "runDevice": root_info.st_dev,
                "runInode": root_info.st_ino,
                "evidenceUid": root_info.st_uid,
                "evidenceGid": root_info.st_gid,
                "readinessPath": str(self.readiness_path),
                "readinessSha256": sha256(self.readiness_path),
                "inventory": inventory,
            },
        )
        os.chmod(self.run_seal_path, 0o400)

    def _build(self) -> None:
        self.root.mkdir(parents=True)
        self.seal_root.mkdir(mode=0o700)
        os.chmod(self.seal_root, 0o700)
        os.chmod(self.lab_root, 0o700)
        os.chmod(self.root.parent, 0o700)
        os.chmod(self.root, 0o700)
        self.readiness_path.parent.mkdir(mode=0o1777)
        self.readiness_path.write_text(
            "\n".join(
                (
                    "schema=1",
                    f"containerId={self.container_id}",
                    "mode=packed",
                    f"runId={RUN_ID}",
                )
            )
            + "\n",
            encoding="utf-8",
        )
        os.chmod(self.readiness_path.parent, 0o1777)
        os.chmod(self.readiness_path, 0o444)
        self._build_manifest()
        self._build_cases()
        self._build_results()
        self._harden_and_seal()


class EvidenceValidatorTests(unittest.TestCase):
    def setUp(self) -> None:
        self.temp = tempfile.TemporaryDirectory(prefix="nexus-v015-evidence-test-")
        self.addCleanup(self.temp.cleanup)
        self.base = Path(self.temp.name)

    def fixture(self, name: str) -> EvidenceFixture:
        return EvidenceFixture(self.base / name / "lab-root" / "evidence" / RUN_ID)

    def fixture_environment(self, fixture: EvidenceFixture) -> dict[str, str]:
        return {
            "NEXUS_LAB_ROOT": str(fixture.lab_root),
            "NEXUS_V015_RUN_ID": RUN_ID,
            "NEXUS_V015_CONTAINER_ID": fixture.container_id,
            "NEXUS_V015_READINESS_LEDGER_SHA256": sha256(fixture.readiness_path),
            "NEXUS_V015_ALLOW_FIXTURE_HOME": "1",
            "NEXUS_V015_EVIDENCE_AUTHORITY_ROOT": str(fixture.seal_root),
        }

    def run_validator(
        self,
        *arguments: object,
        env_override: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess[str]:
        environment = dict(os.environ)
        paths = [Path(str(argument)) for argument in arguments if not str(argument).startswith("-")]
        if paths:
            run_root = paths[-1]
            if len(run_root.parents) >= 2:
                lab_root = run_root.parents[1]
                readiness = lab_root / "lab/candidate-ready.v1"
                environment.update(
                    {
                        "NEXUS_LAB_ROOT": str(lab_root),
                        "NEXUS_V015_RUN_ID": RUN_ID,
                        "NEXUS_V015_CONTAINER_ID": "a" * 64,
                        "NEXUS_V015_READINESS_LEDGER_SHA256": (
                            sha256(readiness) if readiness.is_file() else "0" * 64
                        ),
                        "NEXUS_V015_ALLOW_FIXTURE_HOME": "1",
                        "NEXUS_V015_EVIDENCE_AUTHORITY_ROOT": str(
                            lab_root.parent / f"{lab_root.name}-evidence-authority"
                        ),
                    }
                )
        if env_override:
            environment.update(env_override)
        return subprocess.run(
            [sys.executable, str(TARGET), *[str(argument) for argument in arguments]],
            cwd=self.base,
            text=True,
            capture_output=True,
            env=environment,
            check=False,
        )

    def assert_invalid(self, fixture: EvidenceFixture, code: str, root: Path | None = None) -> None:
        result = self.run_validator(root or fixture.root)
        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
        self.assertIn(f"EVIDENCE_{code}:", result.stderr)

    def test_help_is_successful_and_side_effect_free(self) -> None:
        before = set(self.base.iterdir())
        result = self.run_validator("--help")
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn("RUN_DIR", result.stdout)
        self.assertEqual(set(self.base.iterdir()), before)

    def test_complete_strict_evidence_ledger_passes(self) -> None:
        fixture = self.fixture("valid")
        result = self.run_validator(fixture.root)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertIn(f"validated {len(EXPECTED_CASES)} cases", result.stdout)
        self.assertIn(f"{len(RESULT_SPECS)} canonical results", result.stdout)
        self.assertIn(fixture.candidate_digest, result.stdout)

    def test_run_root_and_readiness_must_match_the_canonical_lab_authority(self) -> None:
        fixture = self.fixture("canonical-authority")
        wrong_lab = self.base / "wrong-lab"
        result = self.run_validator(
            fixture.root,
            env_override={"NEXUS_LAB_ROOT": str(wrong_lab)},
        )
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn("EVIDENCE_RUN_AUTHORITY:", result.stderr)

        result = self.run_validator(
            fixture.root,
            env_override={"NEXUS_V015_READINESS_LEDGER_SHA256": "f" * 64},
        )
        self.assertEqual(result.returncode, 2, result.stdout + result.stderr)
        self.assertIn("EVIDENCE_READINESS_AUTHORITY:", result.stderr)

    def test_root_owned_run_seal_binds_the_complete_evidence_inventory(self) -> None:
        missing = self.fixture("run-seal-missing")
        missing.run_seal_path.unlink()
        self.assert_invalid(missing, "RUN_SEAL_MISSING")

        coordinated = self.fixture("run-seal-coordinated-rewrite")
        artifact = coordinated.root / "artifacts/results/A1/versionReport.json"
        artifact_data = b'{"coordinated":"rewrite"}\n'
        os.chmod(artifact, 0o600)
        artifact.write_bytes(artifact_data)
        os.chmod(artifact, 0o400)
        result = read_json(coordinated.result_paths["A1"])
        result["artifacts"]["versionReport"]["sha256"] = hashlib.sha256(
            artifact_data
        ).hexdigest()
        rewrite_readonly_json(coordinated.result_paths["A1"], result)
        self.assert_invalid(coordinated, "RUN_SEAL_MISMATCH")

        foreign = self.fixture("run-seal-extra-file")
        extra = foreign.root / "unsealed-extra.txt"
        extra.write_text("not sealed\n", encoding="utf-8")
        os.chmod(extra, 0o400)
        self.assert_invalid(foreign, "INVENTORY_UNDECLARED")

        residue = self.fixture("run-seal-temp-residue")
        stale = residue.seal_root / f".{RUN_ID}{RUN_SEAL_SUFFIX}.tmp-crashed"
        stale.write_text("incomplete\n", encoding="utf-8")
        os.chmod(stale, 0o400)
        self.assert_invalid(residue, "RUN_SEAL_RESIDUE")

    def test_seal_mode_hardens_and_commits_an_unsealed_ledger_once(self) -> None:
        fixture = self.fixture("seal-mode")
        fixture.run_seal_path.unlink()
        artifact = fixture.root / "artifacts/results/A1/versionReport.json"
        artifact_directory = artifact.parent
        os.chmod(artifact, 0o600)
        os.chmod(artifact_directory, 0o700)

        result = self.run_validator("--seal", fixture.root)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        self.assertEqual(artifact.stat().st_mode & 0o777, 0o400)
        self.assertEqual(artifact_directory.stat().st_mode & 0o777, 0o555)
        self.assertEqual(fixture.run_seal_path.stat().st_uid, 0)
        self.assertEqual(fixture.run_seal_path.stat().st_gid, 0)
        self.assertEqual(fixture.run_seal_path.stat().st_mode & 0o777, 0o400)
        self.assertEqual(fixture.run_seal_path.stat().st_nlink, 1)
        for path in (fixture.root, *fixture.root.rglob("*")):
            info = path.stat(follow_symlinks=False)
            self.assertEqual((info.st_uid, info.st_gid), (0, 0), path)
        self.assertEqual(self.run_validator(fixture.root).returncode, 0)

        before = (
            fixture.run_seal_path.read_bytes(),
            fixture.run_seal_path.stat().st_dev,
            fixture.run_seal_path.stat().st_ino,
        )
        repeated = self.run_validator("--seal", fixture.root)
        self.assertEqual(repeated.returncode, 1, repeated.stdout + repeated.stderr)
        self.assertIn("EVIDENCE_RUN_SEAL_EXISTS:", repeated.stderr)
        after = (
            fixture.run_seal_path.read_bytes(),
            fixture.run_seal_path.stat().st_dev,
            fixture.run_seal_path.stat().st_ino,
        )
        self.assertEqual(after, before)

    def test_seal_mode_rejects_residue_and_undeclared_paths(self) -> None:
        residue = self.fixture("seal-mode-temp-residue")
        residue.run_seal_path.unlink()
        stale = residue.seal_root / f".{RUN_ID}{RUN_SEAL_SUFFIX}.tmp-crashed"
        stale.write_text("incomplete\n", encoding="utf-8")
        os.chmod(stale, 0o400)
        result = self.run_validator("--seal", residue.root)
        self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
        self.assertIn("EVIDENCE_RUN_SEAL_RESIDUE:", result.stderr)

        for name, create in (
            (
                "file",
                lambda root: (root / "unreferenced-secret.txt").write_text(
                    "not declared\n", encoding="utf-8"
                ),
            ),
            ("directory", lambda root: (root / "unreferenced-empty").mkdir()),
        ):
            with self.subTest(kind=name):
                fixture = self.fixture(f"seal-mode-undeclared-{name}")
                fixture.run_seal_path.unlink()
                create(fixture.root)
                result = self.run_validator("--seal", fixture.root)
                self.assertEqual(result.returncode, 1, result.stdout + result.stderr)
                self.assertIn("EVIDENCE_INVENTORY_UNDECLARED:", result.stderr)

    def test_validation_rechecks_readiness_and_held_root_ancestry_at_completion(self) -> None:
        module = load_validator_module()

        readiness = self.fixture("readiness-reread")
        with mock.patch.dict(os.environ, self.fixture_environment(readiness), clear=False):
            authority = module.resolve_run_authority(readiness.root)
            validator = module.Validator(readiness.root, authority)
            try:
                os.chmod(readiness.readiness_path, 0o600)
                readiness.readiness_path.write_text(
                    readiness.readiness_path.read_text(encoding="utf-8") + "nonce=changed\n",
                    encoding="utf-8",
                )
                os.chmod(readiness.readiness_path, 0o444)
                with self.assertRaises(module.EvidenceError) as raised:
                    validator.validate()
                self.assertEqual(raised.exception.code, "READINESS_AUTHORITY")
            finally:
                validator.close()

        readiness_ancestry = self.fixture("readiness-ancestry-reread")
        with mock.patch.dict(
            os.environ, self.fixture_environment(readiness_ancestry), clear=False
        ):
            authority = module.resolve_run_authority(readiness_ancestry.root)
            validator = module.Validator(readiness_ancestry.root, authority)
            moved_lab_state = readiness_ancestry.readiness_path.parent.with_name("lab-moved")
            try:
                readiness_ancestry.readiness_path.parent.rename(moved_lab_state)
                readiness_ancestry.readiness_path.parent.symlink_to(
                    moved_lab_state, target_is_directory=True
                )
                with self.assertRaises(module.EvidenceError) as raised:
                    validator.validate()
                self.assertEqual(raised.exception.code, "READINESS_AUTHORITY")
            finally:
                validator.close()

        ancestry = self.fixture("held-root-ancestry")
        with mock.patch.dict(os.environ, self.fixture_environment(ancestry), clear=False):
            authority = module.resolve_run_authority(ancestry.root)
            validator = module.Validator(ancestry.root, authority)
            moved = ancestry.lab_root.with_name(f"{ancestry.lab_root.name}-moved")
            try:
                ancestry.lab_root.rename(moved)
                ancestry.lab_root.symlink_to(moved, target_is_directory=True)
                with self.assertRaises(module.EvidenceError) as raised:
                    validator.validate()
                self.assertEqual(raised.exception.code, "RUN_SEAL_CHANGED")
            finally:
                validator.close()

    def test_seal_chowns_every_entry_and_revalidates_after_publication(self) -> None:
        module = load_validator_module()
        fixture = self.fixture("seal-owner-and-post-publish")
        fixture.run_seal_path.unlink()
        artifact = fixture.root / "artifacts/results/A1/versionReport.json"
        expected_fchowns = 1 + sum(1 for _ in fixture.root.rglob("*"))
        with mock.patch.dict(os.environ, self.fixture_environment(fixture), clear=False):
            authority = module.resolve_run_authority(fixture.root)
            validator = module.Validator(fixture.root, authority)
            original_publish = validator.publish_run_seal

            def publish_then_mutate(document: dict[str, object]) -> None:
                original_publish(document)
                os.chmod(artifact, 0o600)
                artifact.write_bytes(b'{"changed":"after-publish"}\n')
                os.chmod(artifact, 0o400)

            validator.publish_run_seal = publish_then_mutate
            try:
                with mock.patch.object(module.os, "fchown", wraps=os.fchown) as fchown:
                    with self.assertRaises(module.EvidenceError):
                        validator.seal()
                self.assertEqual(
                    fchown.call_count,
                    expected_fchowns,
                    "seal must root-own every evidence entry and the run root",
                )
            finally:
                validator.close()

    def test_manifest_is_one_strict_packed_candidate_ledger(self) -> None:
        mutations = (
            ("source-mode", lambda doc: doc.__setitem__("mode", "source"), "MANIFEST_MODE"),
            ("source-revision", lambda doc: doc["sources"]["nexus"].__setitem__("revision", "nope"), "SOURCE_REVISION"),
            ("package-set", lambda doc: doc["packages"].pop(), "PACKAGE_SET"),
            ("package-version", lambda doc: doc["packages"][0].__setitem__("version", "0.1.4"), "PACKAGE_VERSION"),
            ("image", lambda doc: doc["image"].__setitem__("digest", "latest"), "IMAGE_DIGEST"),
            ("dirty-hash", lambda doc: doc["sources"]["nexus"]["dirtyPaths"][0].__setitem__("sha256", "bad"), "SHA256_FORMAT"),
            ("toolchains", lambda doc: doc["toolchains"].pop("rustc"), "TOOLCHAINS"),
            (
                "nexus-version-suffix",
                lambda doc: doc["toolchains"].__setitem__(
                    "nexus", "nexus 0.1.5 (revision 0123456789abcdef)"
                ),
                "TOOLCHAINS",
            ),
            ("environment", lambda doc: doc["environment"].__setitem__("NPM_TOKEN", "npm_secret"), "ENV_REDACTION"),
            ("limits", lambda doc: doc["container"]["limits"].__setitem__("cpus", 7), "RESOURCE_LIMITS"),
        )
        for name, mutate, code in mutations:
            with self.subTest(name=name):
                fixture = self.fixture(f"manifest-{name}")
                document = read_json(fixture.manifest_path)
                mutate(document)
                write_json(fixture.manifest_path, document)
                self.assert_invalid(fixture, code)

    def test_candidate_commit_seal_is_required_and_binds_the_tree(self) -> None:
        missing = self.fixture("candidate-seal-missing")
        (missing.root / ".candidate-committed").unlink()
        self.assert_invalid(missing, "CANDIDATE_SEAL_MISSING")

        changed = self.fixture("candidate-seal-changed")
        seal_path = changed.root / ".candidate-committed"
        seal = read_json(seal_path)
        seal["treeSha256"] = "0" * 64
        write_json(seal_path, seal)
        self.assert_invalid(changed, "CANDIDATE_SEAL_MISMATCH")

        mutable_mode = self.fixture("candidate-payload-mode")
        os.chmod(mutable_mode.root / "candidate/npm/nexus.tgz", 0o644)
        self.assert_invalid(mutable_mode, "CANDIDATE_SEAL_MODE")

    def test_manifest_tarball_bindings_match_the_exact_candidate_packages(self) -> None:
        for name, key in (
            ("nexus", "NEXUS_V015_NEXUS_TARBALL_SHA256"),
            ("cli", "NEXUS_V015_CLI_TARBALL_SHA256"),
            ("gateway", "NEXUS_V015_GATEWAY_TARBALL_SHA256"),
        ):
            with self.subTest(name=name):
                fixture = self.fixture(f"manifest-tarball-{name}")
                document = read_json(fixture.manifest_path)
                document["environment"][key] = "0" * 64
                write_json(fixture.manifest_path, document)
                self.assert_invalid(fixture, "PACKED_RUNTIME_BINDING")

    def test_manifest_requires_candidate_bound_production_lens_renderer(self) -> None:
        for name, mutate in (
            (
                "missing-mode",
                lambda environment: environment.pop("NEXUS_V015_LENS_RENDERER_MODE"),
            ),
            (
                "development-mode",
                lambda environment: environment.__setitem__(
                    "NEXUS_V015_LENS_RENDERER_MODE", "development"
                ),
            ),
            (
                "source-app",
                lambda environment: environment.__setitem__(
                    "NEXUS_V015_LENS_APP", "/work/egregore-lens"
                ),
            ),
            (
                "wrong-main",
                lambda environment: environment.__setitem__(
                    "NEXUS_V015_LENS_MAIN", "/tmp/other/electron/main.cjs"
                ),
            ),
            (
                "bad-tree-hash",
                lambda environment: environment.__setitem__(
                    "NEXUS_V015_LENS_TREE_SHA256", "not-a-digest"
                ),
            ),
        ):
            with self.subTest(name=name):
                fixture = self.fixture(f"manifest-lens-{name}")
                document = read_json(fixture.manifest_path)
                mutate(document["environment"])
                write_json(fixture.manifest_path, document)
                self.assert_invalid(fixture, "LENS_RENDERER_BINDING")

    def test_manifest_requires_complete_packed_runtime_binding(self) -> None:
        mutations = (
            (
                "missing-readiness",
                lambda env: env.pop("NEXUS_V015_READINESS_LEDGER_SHA256"),
            ),
            (
                "wrong-run",
                lambda env: env.__setitem__("NEXUS_V015_RUN_ID", "another-run"),
            ),
            (
                "source-prefix",
                lambda env: env.__setitem__("NEXUS_V015_PACKED_PREFIX", "/work/egregore-nexus"),
            ),
            (
                "native-mismatch",
                lambda env: env.__setitem__("NEXUS_V015_NATIVE_BIN_SHA256", "0" * 64),
            ),
            (
                "image-mismatch",
                lambda env: env.__setitem__("NEXUS_V015_IMAGE_DIGEST", "sha256:" + "0" * 64),
            ),
            (
                "bad-install-tree",
                lambda env: env.__setitem__("NEXUS_V015_INSTALL_TREE_SHA256", "bad"),
            ),
            (
                "source-ws-acceptance",
                lambda env: env.__setitem__(
                    "NEXUS_V015_WS_ACCEPTANCE",
                    "/work/egregore-nexus/scripts/nexus-v015-ws-acceptance",
                ),
            ),
            (
                "bad-ws-soak-hash",
                lambda env: env.__setitem__("NEXUS_V015_WS_SOAK_SHA256", "bad"),
            ),
            (
                "source-webconsole-acceptance",
                lambda env: env.__setitem__(
                    "NEXUS_V015_WEBCONSOLE_ACCEPTANCE",
                    "/work/egregore-nexus/scripts/nexus-v015-webconsole-acceptance",
                ),
            ),
            (
                "bad-evidence-validator-hash",
                lambda env: env.__setitem__("NEXUS_V015_EVIDENCE_VALIDATOR_SHA256", "bad"),
            ),
            (
                "source-release-assembler",
                lambda env: env.__setitem__(
                    "NEXUS_V015_RELEASE_ASSEMBLER",
                    "/work/egregore-nexus/scripts/nexus-v015-release-assemble",
                ),
            ),
            (
                "bad-release-assembler-hash",
                lambda env: env.__setitem__("NEXUS_V015_RELEASE_ASSEMBLER_SHA256", "bad"),
            ),
            (
                "source-webconsole-evidence-verifier",
                lambda env: env.__setitem__(
                    "NEXUS_V015_WEBCONSOLE_EVIDENCE_VERIFIER",
                    "/work/egregore-nexus/scripts/nexus-v015-webconsole-evidence-verify",
                ),
            ),
        )
        for name, mutate in mutations:
            with self.subTest(name=name):
                fixture = self.fixture(f"manifest-runtime-{name}")
                document = read_json(fixture.manifest_path)
                mutate(document["environment"])
                write_json(fixture.manifest_path, document)
                self.assert_invalid(fixture, "PACKED_RUNTIME_BINDING")

    def test_candidate_identity_is_derived_and_caller_ids_are_forbidden(self) -> None:
