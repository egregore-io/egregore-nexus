    def test_case_artifact_payloads_are_semantic_evidence_not_placeholders(self) -> None:
        mutations = (
            ("preScreenshot", b"not a jpeg\n", "SCREENSHOT_EVIDENCE"),
            ("dom", b"plain text without markup\n", "DOM_EVIDENCE"),
            ("console", b'{"messages":[],"violations":["boom"]}\n', "CONSOLE_EVIDENCE"),
            ("network", b'{"not":"an array"}\n', "NETWORK_EVIDENCE"),
            ("websocket", b'{"not":"an array"}\n', "WEBSOCKET_EVIDENCE"),
            (
                "processLogs",
                b'{"capturedAt":"t","runnerPid":1,"rendererTarget":null,"logs":{"daemon":{"tail":"ok"},"gateway":{"absent":true},"lens":{"tail":"ok"}}}\n',
                "PROCESS_LOG_EVIDENCE",
            ),
            (
                "health",
                b'{"capturedAt":"t","url":"http://127.0.0.1:4100/api/v1/health","status":503,"body":"down"}\n',
                "HEALTH_EVIDENCE",
            ),
        )
        for name, payload, code in mutations:
            with self.subTest(name=name):
                fixture = self.fixture(f"case-payload-{name}")
                document = read_json(fixture.case_meta["O5"])
                record = document["artifacts"][name]
                artifact = fixture.root / record["path"]
                artifact.write_bytes(payload)
                record["sha256"] = sha256(artifact)
                write_json(fixture.case_meta["O5"], document)
                self.assert_invalid(fixture, code)

        mechanism = self.fixture("case-payload-mechanism")
        document = read_json(mechanism.case_meta["O3"])
        record = document["artifacts"]["mechanism"]
        artifact = mechanism.root / record["path"]
        artifact.write_text(
            '{"pushFrames":2,"postCommitWakes":1,"timerReads":0}\n',
            encoding="utf-8",
        )
        record["sha256"] = sha256(artifact)
        write_json(mechanism.case_meta["O3"], document)
        self.assert_invalid(mechanism, "MECHANISM_EVIDENCE")

