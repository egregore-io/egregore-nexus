def load_validator_module():
    name = "nexus_v015_evidence_validate_for_tests"
    existing = sys.modules.get(name)
    if existing is not None:
        return existing
    loader = importlib.machinery.SourceFileLoader(name, str(TARGET))
    spec = importlib.util.spec_from_loader(name, loader)
    if spec is None:
        raise RuntimeError("cannot create validator module spec")
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(64 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def write_json(path: Path, value: object) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    previous_mode: int | None = None
    if path.exists():
        previous_mode = stat.S_IMODE(path.stat().st_mode)
        if previous_mode & 0o200 == 0:
            os.chmod(path, previous_mode | 0o200)
    try:
        path.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    finally:
        if previous_mode is not None:
            os.chmod(path, previous_mode)


def rewrite_readonly_json(path: Path, value: object) -> None:
    mode = stat.S_IMODE(os.lstat(path).st_mode)
    os.chmod(path, mode | stat.S_IWUSR)
    try:
        write_json(path, value)
    finally:
        os.chmod(path, mode)


def read_json(path: Path) -> dict[str, object]:
    return json.loads(path.read_text(encoding="utf-8"))


def candidate_ledger(manifest: dict[str, object]) -> dict[str, object]:
    return {
        "mode": manifest["mode"],
        "sources": manifest["sources"],
        "nativeSha256": manifest["native"]["sha256"],
        "packages": [
            {
                "name": package["name"],
                "version": package["version"],
                "tarballSha256": package["tarball"]["sha256"],
            }
            for package in manifest["packages"]
        ],
        "imageDigest": manifest["image"]["digest"],
        "limits": manifest["container"]["limits"],
        "toolchains": manifest["toolchains"],
        "environment": manifest["environment"],
    }


def candidate_digest(manifest: dict[str, object]) -> str:
    encoded = json.dumps(
        candidate_ledger(manifest),
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


class EvidenceFixture:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.lab_root = self.root.parents[1]
        self.readiness_path = self.lab_root / "lab/candidate-ready.v1"
        self.seal_root = self.lab_root.parent / f"{self.lab_root.name}-evidence-authority"
        self.container_id = "a" * 64
        self.run_seal_path = self.seal_root / f"{RUN_ID}{RUN_SEAL_SUFFIX}"
        self.case_meta: dict[str, Path] = {}
        self.result_paths: dict[str, Path] = {}
        self.manifest_path = self.root / "manifest.json"
        self.manifest: dict[str, object] = {}
        self.candidate_digest = ""
        self._build()

    def artifact(self, relative: Path, content: bytes) -> dict[str, str]:
        absolute = self.root / relative
        absolute.parent.mkdir(parents=True, exist_ok=True)
        absolute.write_bytes(content)
        return {"path": relative.as_posix(), "sha256": sha256(absolute)}

    def artifacts(self, owner: str, names: tuple[str, ...]) -> dict[str, dict[str, str]]:
        return {
            name: self.artifact(
                Path("artifacts") / owner / f"{name}.json",
                json.dumps({"owner": owner, "artifact": name}).encode("utf-8") + b"\n",
            )
            for name in names
        }

    @staticmethod
    def passing_outcome() -> dict[str, object]:
        return {
            "status": "PASS",
            "error": None,
            "partial": False,
            "flaky": False,
            "skipped": False,
            "refused": False,
            "failureCount": 0,
        }

    def _build_manifest(self) -> None:
        native = self.artifact(Path("candidate/native/nexus"), b"native-v0.1.5\n")
        os.chmod(self.root / native["path"], 0o555)
        packages = []
        package_files = ("nexus.tgz", "nexus-cli.tgz", "nexus-gateway.tgz")
        for index, (name, filename) in enumerate(zip(PACKAGE_NAMES, package_files, strict=True)):
            tarball = self.artifact(
                Path("candidate/npm") / filename,
                f"{name}@0.1.5\n".encode("utf-8"),
            )
            os.chmod(self.root / tarball["path"], 0o444)
            packages.append({"name": name, "version": "0.1.5", "tarball": tarball})
        for relative in (Path("candidate"), Path("candidate/native"), Path("candidate/npm")):
            os.chmod(self.root / relative, 0o755)
        sources = {}
        for index, name in enumerate(SOURCE_NAMES, start=1):
            dirty_paths = []
            if name == "nexus":
                dirty_paths = [
                    {
                        "path": "gateway/src/candidate.ts",
                        "state": "present",
                        "sha256": "b" * 64,
                    }
                ]
            sources[name] = {
                "revision": format(index, "x") * 40,
                "dirty": bool(dirty_paths),
                "dirtyPaths": dirty_paths,
            }
        self.manifest = {
            "schemaVersion": 1,
            "runId": RUN_ID,
            "mode": "packed",
            "sources": sources,
            "native": native,
            "packages": packages,
            "image": {"digest": "sha256:" + "c" * 64},
            "container": {"limits": {"cpus": 6, "memoryBytes": 8589934592, "pids": 1024}},
            "toolchains": {
                "nexus": "nexus 0.1.5",
                "node": "v24.18.0",
                "rustc": "rustc 1.90.0",
            },
            "environment": {
                "OCULAR_LAB": "1",
                "NEXUS_HOME": str(self.lab_root / "nexus"),
                "NEXUS_V015_RUN_ID": RUN_ID,
                "NEXUS_V015_CONTAINER_ID": self.container_id,
                "NEXUS_V015_PACKED_PREFIX": "/tmp/nexus-lab-install.fixture",
                "NEXUS_V015_INSTALL_NONCE": "fixture",
                "NEXUS_V015_NEXUS_BIN": "/tmp/nexus-lab-bin/nexus",
                "NEXUS_V015_NEXUS_BIN_RESOLVED": "/tmp/nexus-lab-install.fixture/lib/node_modules/@egregore/nexus/bin/nexus.mjs",
                "NEXUS_V015_NEXUS_BIN_SHA256": "1" * 64,
                "NEXUS_V015_GATEWAY_BIN": "/tmp/nexus-lab-bin/nexus-gateway",
                "NEXUS_V015_GATEWAY_BIN_RESOLVED": "/tmp/nexus-lab-install.fixture/lib/node_modules/@egregore/nexus/bin/nexus-gateway.mjs",
                "NEXUS_V015_GATEWAY_BIN_SHA256": "2" * 64,
                "NEXUS_V015_WEBUI_BIN": "/tmp/nexus-lab-bin/nexus-webui",
                "NEXUS_V015_WEBUI_BIN_RESOLVED": "/tmp/nexus-lab-install.fixture/lib/node_modules/@egregore/nexus/bin/nexus-webui.mjs",
                "NEXUS_V015_WEBUI_BIN_SHA256": "3" * 64,
                "NEXUS_V015_GATEWAY_MODULE": "/tmp/nexus-lab-install.fixture/lib/node_modules/@egregore/nexus/node_modules/@egregore/nexus-gateway/dist-gateway/headless.mjs",
                "NEXUS_V015_GATEWAY_MODULE_SHA256": "4" * 64,
                "NEXUS_V015_LENS_RENDERER_MODE": "production",
                "NEXUS_V015_LENS_APP": "/tmp/nexus-lens-app.fixture",
                "NEXUS_V015_LENS_MAIN": "/tmp/nexus-lens-app.fixture/electron/main.cjs",
                "NEXUS_V015_LENS_TREE_SHA256": "d" * 64,
