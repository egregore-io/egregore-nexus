port_is_open() {
  python3 - "$HOST" "$1" <<'PY'
import socket
import sys
family = socket.AF_INET6 if ":" in sys.argv[1] else socket.AF_INET
with socket.socket(family) as sock:
    if family == socket.AF_INET6:
        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
    sock.settimeout(0.2)
    raise SystemExit(0 if sock.connect_ex((sys.argv[1], int(sys.argv[2]))) == 0 else 1)
PY
}

allocate_closed_port() {
  python3 - "$HOST" <<'PY'
import socket
import sys
family = socket.AF_INET6 if ":" in sys.argv[1] else socket.AF_INET
with socket.socket(family) as sock:
    if family == socket.AF_INET6:
        sock.setsockopt(socket.IPPROTO_IPV6, socket.IPV6_V6ONLY, 1)
    sock.bind((sys.argv[1], 0))
    print(sock.getsockname()[1])
PY
}

http_url() {
  local host=$1 port=$2
  if [[ "$host" == *:* ]]; then
    printf 'http://[%s]:%s' "$host" "$port"
  else
    printf 'http://%s:%s' "$host" "$port"
  fi
}

if [ "$PORT" -eq 0 ]; then
  PORT=$(allocate_closed_port)
fi
port_is_open "$PORT" && die "selected Webconsole port $PORT is not closed before the gate"
WEBCONSOLE_URL=$(http_url "$HOST" "$PORT")

WEBCONSOLE_EXE="${NEXUS_WEBUI_BIN:-}"
if [ -z "$WEBCONSOLE_EXE" ]; then
  WEBCONSOLE_EXE=$(command -v nexus-webui 2>/dev/null || true)
fi
[ -n "$WEBCONSOLE_EXE" ] && [ -f "$WEBCONSOLE_EXE" ] \
  || die "cannot resolve the packed nexus-webui executable"
WEBCONSOLE_EXE=$(readlink -f "$WEBCONSOLE_EXE")
WEBCONSOLE_ENTRYPOINT_SNAPSHOT="$WORK/webconsole-entrypoint.snapshot"
python3 - "$WEBCONSOLE_EXE" >"$WEBCONSOLE_ENTRYPOINT_SNAPSHOT" <<'PY'
import hashlib
import json
import os
import stat
import sys

path = sys.argv[1]
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
descriptor = os.open(path, flags)
try:
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise SystemExit("packed nexus-webui entrypoint is not a single regular file")
    raw = b""
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        raw += chunk
finally:
    os.close(descriptor)
print(json.dumps({
    "device": info.st_dev,
    "inode": info.st_ino,
    "size": info.st_size,
    "sha256": hashlib.sha256(raw).hexdigest(),
}, sort_keys=True))
PY

matching_webconsole_pids() {
  local snapshot="$WORK/matching-webconsole.$$.snapshot"
  capture_validated_cleanup_targets "$snapshot"
  jq -c '[.targets[].pid]' "$snapshot"
  rm -f "$snapshot"
}

capture_candidate_readiness() {
  local path=$1 install_tree_sha
  install_tree_sha=$(packed_install_tree_digest "$PACKED_PREFIX") \
    || die "cannot inventory the packed install dependency closure"
  python3 - \
    "$READINESS_PATH" "$READINESS_CONTAINER_ID" "$RUN_ID" \
    "$READINESS_INSTALL_ROOT" "$READINESS_INSTALL_NONCE" \
    "$PACKED_PREFIX" "$NEXUS_LAUNCHER" "$PACKED_GATEWAY_BIN" "$PACKED_WEBUI_BIN" \
    "$PACKED_NATIVE_BIN" "$PACKED_GATEWAY_MODULE" "$install_tree_sha" \
    "$IMAGE_DIGEST" "$CGROUP_ROOT" \
    >"$path" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

(
    raw_path, container_id, run_id, install_root, install_nonce,
    packed_prefix, nexus_launcher, gateway_launcher, webui_launcher,
    native_binary, gateway_module, install_tree_sha, image_digest, cgroup_root,
) = sys.argv[1:]
path = Path(raw_path)
cursor = Path(path.anchor)
for component in path.parts[1:-1]:
    cursor /= component
    try:
        ancestor = os.lstat(cursor)
    except OSError as error:
        raise SystemExit(f"cannot inspect candidate readiness ancestry: {error}")
    if stat.S_ISLNK(ancestor.st_mode) or not stat.S_ISDIR(ancestor.st_mode):
        raise SystemExit(f"candidate readiness ancestry is unsafe: {cursor}")
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(path, flags)
except OSError as error:
    raise SystemExit(f"candidate readiness ledger is unavailable: {error}")
try:
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise SystemExit("candidate readiness ledger is not a single regular file")
    chunks = []
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        chunks.append(chunk)
    raw = b"".join(chunks)
    text = raw.decode("utf-8")
except (OSError, UnicodeError) as error:
    raise SystemExit(f"cannot read candidate readiness ledger: {error}")
finally:
    os.close(descriptor)
fields = {}
for line_number, line in enumerate(text.splitlines(), 1):
    if not line or "=" not in line:
        raise SystemExit(f"candidate readiness ledger has invalid line {line_number}")
    key, value = line.split("=", 1)
    if not key or not value or key in fields:
        raise SystemExit(f"candidate readiness ledger has invalid field {key!r}")
    fields[key] = value


def read_cgroup_value(name):
    path = Path(cgroup_root) / name
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode):
                raise SystemExit(f"live cgroup authority {name} is not a regular file")
            raw = os.read(descriptor, 4096)
            if os.read(descriptor, 1):
                raise SystemExit(f"live cgroup authority {name} is unexpectedly large")
        finally:
            os.close(descriptor)
    except OSError as error:
        raise SystemExit(f"live cgroup authority {name} is unavailable: {error}") from error
    try:
        return raw.decode("ascii").strip()
    except UnicodeError as error:
        raise SystemExit(f"live cgroup authority {name} is invalid: {error}") from error


resource_authority = {
    "cpuMax": read_cgroup_value("cpu.max"),
    "memoryMax": read_cgroup_value("memory.max"),
    "memorySwapMax": read_cgroup_value("memory.swap.max"),
    "pidsMax": read_cgroup_value("pids.max"),
}
if resource_authority != {
    "cpuMax": "600000 100000",
    "memoryMax": "8589934592",
    "memorySwapMax": "0",
    "pidsMax": "1024",
}:
    raise SystemExit("live cgroup authority does not match the 6 CPU / 8 GiB / 1024 PID contract")

expected = {
    "schema": "1",
    "containerId": container_id,
    "mode": "packed",
    "runId": run_id,
    "installRoot": install_root,
    "installNonce": install_nonce,
    "nativeResolved": native_binary,
    "nativeSha256": hashlib.sha256(Path(native_binary).read_bytes()).hexdigest(),
    "nexusLink": str(Path(packed_prefix) / "bin" / "nexus"),
    "nexusResolved": nexus_launcher,
    "nexusSha256": hashlib.sha256(Path(nexus_launcher).read_bytes()).hexdigest(),
    "gatewayLink": str(Path(packed_prefix) / "bin" / "nexus-gateway"),
    "gatewayResolved": gateway_launcher,
    "gatewaySha256": hashlib.sha256(Path(gateway_launcher).read_bytes()).hexdigest(),
    "webuiLink": str(Path(packed_prefix) / "bin" / "nexus-webui"),
    "webuiResolved": webui_launcher,
    "webuiSha256": hashlib.sha256(Path(webui_launcher).read_bytes()).hexdigest(),
    "installTreeSha256": install_tree_sha,
    "imageDigest": image_digest,
}
missing = sorted(set(expected) - set(fields))
if missing:
    raise SystemExit(f"candidate readiness ledger is missing required D2 fields: {missing}")
changed = sorted(key for key, value in expected.items() if fields.get(key) != value)
if changed:
    raise SystemExit(
        "candidate readiness ledger no longer matches container/run/install bindings: "
        f"{changed}"
    )
print(json.dumps({
    "path": str(path),
    "sha256": hashlib.sha256(raw).hexdigest(),
    "inode": info.st_ino,
    "device": info.st_dev,
    "size": info.st_size,
    "mode": stat.S_IMODE(info.st_mode),
    "containerId": container_id,
    "runId": run_id,
    "installRoot": install_root,
    "installNonce": install_nonce,
    "nativeSha256": hashlib.sha256(Path(native_binary).read_bytes()).hexdigest(),
    "gatewayModuleSha256": hashlib.sha256(Path(gateway_module).read_bytes()).hexdigest(),
    "installTreeSha256": install_tree_sha,
    "extraFields": sorted(set(fields) - set(expected)),
    "resourceAuthority": resource_authority,
}, sort_keys=True))
PY
}

BASELINE_READINESS="$WORK/readiness-baseline.snapshot"
capture_candidate_readiness "$BASELINE_READINESS"
[ "$(jq -er '.nativeSha256' "$BASELINE_READINESS")" = \
  "$(jq -er '.provenance.nativeSha256' "$WORK/packed-topology.snapshot")" ] \
  || die "candidate native binary changed before D2"
[ "$(jq -er '.gatewayModuleSha256' "$BASELINE_READINESS")" = \
  "$(jq -er '.provenance.gatewayModuleSha256' "$WORK/packed-topology.snapshot")" ] \
  || die "candidate Gateway module changed before D2"
[ "$(jq -er '.installTreeSha256' "$BASELINE_READINESS")" = \
  "$(jq -er '.provenance.installTreeSha256' "$WORK/packed-topology.snapshot")" ] \
  || die "packed install dependency closure changed before D2"

assert_candidate_readiness_unchanged() {
  local path=$1 label=$2
  capture_candidate_readiness "$path"
  cmp -s "$BASELINE_READINESS" "$path" \
    || die "candidate readiness identity changed $label"
}

capture_gateway_signature() {
  local path=$1 status_path="$WORK/gateway-status.$$.stdout"
  "$NEXUS_BIN" --json gateway status >"$status_path" 2>"$WORK/gateway-status.$$.stderr" \
    || die "Gateway must be live before and throughout D2"
  jq -e '
    .installed == true and
    .daemonRunning == true and
    .runtime.state == "live" and
    (.runtime.pid | type == "number") and
    (.runtime.url | type == "string")
  ' "$status_path" >/dev/null || die "Gateway status is not healthy"
  local pid discovery sha inode size modified proc_exe cmdline process_provenance module_sha
  pid=$(jq -er '.runtime.pid' "$status_path")
  discovery="$NEXUS_HOME/gateway.json"
  [ -f "$discovery" ] && [ ! -L "$discovery" ] || die "Gateway discovery is missing or unsafe"
  kill -0 "$pid" 2>/dev/null || die "Gateway pid $pid is not alive"
  [ -e "/proc/$pid/exe" ] || die "Gateway process metadata is unavailable for pid $pid"
  sha=$(sha256sum "$discovery" | cut -d' ' -f1)
  inode=$(stat -c %i "$discovery")
  size=$(stat -c %s "$discovery")
  modified=$(stat -c %y "$discovery")
  proc_exe=$(readlink -f "/proc/$pid/exe")
  cmdline=$(tr '\0' ' ' <"/proc/$pid/cmdline")
  process_provenance=$(python3 - \
    "$pid" \
    "$PACKED_GATEWAY_BIN" \
    "$PACKED_GATEWAY_MODULE" \
    "$PACKED_PREFIX" \
    "$(jq -er '.runtime.url' "$status_path")" \
    "${NEXUS_V015_FIXTURE_GATEWAY_HOST_MODE:-explicit}" <<'PY'
import hashlib
import http.client
import ipaddress
import json
import os
import socket
import sys
import time
import urllib.parse
from pathlib import Path

pid = int(sys.argv[1])
expected = os.path.realpath(sys.argv[2])
expected_module = os.path.realpath(sys.argv[3])
expected_install_root = os.path.realpath(sys.argv[4])
gateway_url = sys.argv[5]
host_mode = sys.argv[6]
if host_mode not in {"explicit", "wrong", "missing"}:
    raise SystemExit("invalid Gateway Host fixture mode")
try:
    argv = [
        raw.decode("utf-8", "surrogateescape")
        for raw in (Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0"))
        if raw
    ]
except OSError as error:
    raise SystemExit(f"cannot inspect live Gateway argv: {error}")
if len(argv) < 2 or not os.path.isabs(argv[1]) or os.path.realpath(argv[1]) != expected:
    raise SystemExit(
        "live Gateway process was not launched through the validated packed Gateway entrypoint at argv[1]"
    )

try:
    process_stat_fields = (
        Path(f"/proc/{pid}/stat")
        .read_text(encoding="ascii")
        .rsplit(") ", 1)[1]
        .split()
    )
    process_start_ticks = int(process_stat_fields[19])
    ticks_per_second = int(os.sysconf("SC_CLK_TCK"))
    process_started_boot_ns = process_start_ticks * 1_000_000_000 // ticks_per_second
    module_ctime_ns = Path(expected_module).stat().st_ctime_ns
except (OSError, ValueError, IndexError) as error:
    raise SystemExit(f"cannot bind live Gateway process start to candidate module: {error}")
module_changed_boot_ns = (
    time.clock_gettime_ns(time.CLOCK_BOOTTIME) - (time.time_ns() - module_ctime_ns)
)
if module_changed_boot_ns > process_started_boot_ns + 10_000_000:
    raise SystemExit("candidate Gateway module changed after the live process started")

parsed = urllib.parse.urlsplit(gateway_url)
if parsed.scheme != "http" or parsed.hostname is None or parsed.port is None:
    raise SystemExit("Gateway listener or health endpoint is not owned by the live Gateway process")
try:
    address = ipaddress.ip_address(parsed.hostname)
    family = socket.AF_INET if address.version == 4 else socket.AF_INET6
    expected_addresses = {(family, address)} if address.is_loopback else set()
except ValueError:
    expected_addresses = set()
if not expected_addresses:
    raise SystemExit("Gateway listener or health endpoint is not owned by the live Gateway process")

try:
    socket_inodes = {
        target.removeprefix("socket:[").removesuffix("]")
        for entry in Path(f"/proc/{pid}/fd").iterdir()
        if (target := os.readlink(entry)).startswith("socket:[") and target.endswith("]")
    }
except OSError as error:
    raise SystemExit(
        "Gateway listener or health endpoint is not owned by the live Gateway process"
    ) from error

def decode_proc_address(raw, family):
    try:
        encoded = bytes.fromhex(raw)
    except ValueError as error:
        raise ValueError("invalid proc socket address") from error
    if family == socket.AF_INET:
        if len(encoded) != 4:
            raise ValueError("invalid IPv4 proc socket address")
        encoded = encoded[::-1]
    else:
        if len(encoded) != 16:
            raise ValueError("invalid IPv6 proc socket address")
        encoded = b"".join(encoded[index:index + 4][::-1] for index in range(0, 16, 4))
    return ipaddress.ip_address(encoded)


owned_listeners = set()
for table, family, family_name in (
    (Path("/proc/net/tcp"), socket.AF_INET, "ipv4"),
    (Path("/proc/net/tcp6"), socket.AF_INET6, "ipv6"),
):
    try:
        lines = table.read_text(encoding="ascii").splitlines()[1:]
    except OSError:
        continue
    for line in lines:
        fields = line.split()
        if len(fields) < 10 or fields[3] != "0A":
            continue
        try:
            address_raw, port_raw = fields[1].rsplit(":", 1)
            port = int(port_raw, 16)
            address = decode_proc_address(address_raw, family)
        except (IndexError, ValueError):
            continue
        if (
            port == parsed.port
            and fields[9] in socket_inodes
            and (family, address) in expected_addresses
        ):
            owned_listeners.add((family, address, family_name))
if not owned_listeners:
    raise SystemExit("Gateway listener or health endpoint is not owned by the live Gateway process")

health_path = (parsed.path.rstrip("/") if parsed.path else "") + "/api/v1/health"
health_url = urllib.parse.urlunsplit((parsed.scheme, parsed.netloc, health_path, "", ""))
connection = None
try:
    connection = http.client.HTTPConnection(parsed.hostname, parsed.port, timeout=2)
    connection.connect()
    if connection.sock is None:
        raise OSError("health connection has no selected socket")
    selected_family = connection.sock.family
    selected_address = ipaddress.ip_address(connection.sock.getpeername()[0])
    selected = next(
        (
            (family, address, family_name)
            for family, address, family_name in owned_listeners
            if family == selected_family and address == selected_address
        ),
        None,
    )
    if selected is None:
        raise OSError("health connection selected a listener not owned by the Gateway pid")
    listener_family = selected[2]
    listener_address = str(selected_address)
    connection.putrequest("GET", health_path, skip_host=True)
    if host_mode == "explicit":
        connection.putheader("Host", parsed.netloc)
    elif host_mode == "wrong":
        connection.putheader("Host", "wrong.invalid")
    connection.endheaders()
    response = connection.getresponse()
    health_raw = response.read()
    if response.status != 200:
        raise ValueError(f"unexpected status {response.status}")
    health = json.loads(health_raw)
    if not isinstance(health, dict) or health.get("status") != "ok":
        raise ValueError("health status is not ok")
except (OSError, ValueError, json.JSONDecodeError, http.client.HTTPException) as error:
    raise SystemExit(
        "Gateway listener or health endpoint is not owned by the live Gateway process"
    ) from error
finally:
    if connection is not None:
        connection.close()

runtime = health.get("runtime")
runtime_facets = ("entrypoint", "loadedModule", "installRoot")
runtime_identity_reported = False
if runtime is not None and not isinstance(runtime, dict):
    raise SystemExit("live Gateway health runtime identity is incomplete or malformed")
if isinstance(runtime, dict):
    present_facets = {key for key in runtime_facets if key in runtime}
    if present_facets:
        if present_facets != set(runtime_facets) or any(
            not isinstance(runtime[key], str)
            or not runtime[key]
            or not os.path.isabs(runtime[key])
            for key in runtime_facets
        ):
            raise SystemExit("live Gateway health runtime identity is incomplete or malformed")
        runtime_identity_reported = True
if runtime_identity_reported:
    if (
        os.path.realpath(str(runtime["entrypoint"])) != expected
        or os.path.realpath(str(runtime["loadedModule"])) != expected_module
        or os.path.realpath(str(runtime["installRoot"])) != expected_install_root
    ):
        raise SystemExit("live Gateway health runtime identity is not candidate-bound")

print(json.dumps({
    "argv": argv,
    "candidateLauncher": expected,
    "listenerOwned": True,
    "listenerAddress": listener_address,
    "listenerFamily": listener_family,
    "healthUrl": health_url,
    "healthSha256": hashlib.sha256(health_raw).hexdigest(),
    "runtimeIdentityReported": runtime_identity_reported,
    "runtimeIdentityMatched": True if runtime_identity_reported else None,
    "processStartTicks": process_start_ticks,
    "clockTicksPerSecond": ticks_per_second,
    "gatewayModuleCtimeNs": module_ctime_ns,
}))
PY
  )
  module_sha=$(sha256sum "$PACKED_GATEWAY_MODULE" | cut -d' ' -f1)
  [ "$module_sha" = "$(jq -er '.provenance.gatewayModuleSha256' "$WORK/packed-topology.snapshot")" ] \
    || die "live Gateway candidate module changed during D2"
  jq -n \
    --argjson pid "$pid" \
    --arg url "$(jq -er '.runtime.url' "$status_path")" \
    --arg discoveryPath "$discovery" \
    --arg discoverySha256 "$sha" \
    --argjson discoveryInode "$inode" \
    --argjson discoverySize "$size" \
    --arg discoveryModified "$modified" \
    --arg processExecutable "$proc_exe" \
    --arg processCommand "$cmdline" \
    --argjson processArgv "$(jq -c '.argv' <<<"$process_provenance")" \
    --arg candidateLauncher "$(jq -r '.candidateLauncher' <<<"$process_provenance")" \
    --argjson listenerOwned "$(jq -c '.listenerOwned' <<<"$process_provenance")" \
    --arg listenerAddress "$(jq -r '.listenerAddress' <<<"$process_provenance")" \
    --arg listenerFamily "$(jq -r '.listenerFamily' <<<"$process_provenance")" \
    --arg healthUrl "$(jq -r '.healthUrl' <<<"$process_provenance")" \
    --arg healthSha256 "$(jq -r '.healthSha256' <<<"$process_provenance")" \
    --argjson runtimeIdentityReported "$(jq -c '.runtimeIdentityReported' <<<"$process_provenance")" \
    --argjson runtimeIdentityMatched "$(jq -c '.runtimeIdentityMatched' <<<"$process_provenance")" \
    --argjson processStartTicks "$(jq -c '.processStartTicks' <<<"$process_provenance")" \
    --argjson clockTicksPerSecond "$(jq -c '.clockTicksPerSecond' <<<"$process_provenance")" \
    --argjson gatewayModuleCtimeNs "$(jq -c '.gatewayModuleCtimeNs' <<<"$process_provenance")" \
    --arg gatewayModule "$PACKED_GATEWAY_MODULE" \
    --arg gatewayModuleSha256 "$module_sha" \
    '{
      pid: $pid,
      url: $url,
      discoveryPath: $discoveryPath,
      discoverySha256: $discoverySha256,
      discoveryInode: $discoveryInode,
      discoverySize: $discoverySize,
      discoveryModified: $discoveryModified,
      processExecutable: $processExecutable,
      processCommand: $processCommand,
      processArgv: $processArgv,
      candidateLauncher: $candidateLauncher,
      candidateLauncherMatched: true,
      listenerOwned: $listenerOwned,
      listenerAddress: $listenerAddress,
      listenerFamily: $listenerFamily,
      healthUrl: $healthUrl,
      healthSha256: $healthSha256,
      runtimeIdentityReported: $runtimeIdentityReported,
      runtimeIdentityMatched: $runtimeIdentityMatched,
      gatewayModule: $gatewayModule,
      gatewayModuleSha256: $gatewayModuleSha256,
      gatewayModuleCtimeNs: $gatewayModuleCtimeNs,
      processStartTicks: $processStartTicks,
      clockTicksPerSecond: $clockTicksPerSecond,
      candidateModuleOnDiskMatched: true,
      candidateModulePredatesProcess: true
    }' >"$path"
}

BASELINE_GATEWAY="$WORK/gateway-baseline.snapshot"
capture_gateway_signature "$BASELINE_GATEWAY"
jq -cn --slurpfile gateway "$BASELINE_GATEWAY" --slurpfile readiness "$BASELINE_READINESS" '
  {"label":"gateway-baseline", command:[], exitCode:0, expectedExitCode:0,
   stdout:null, stderr:null, gateway:($gateway[0] + {matchesBaseline:true}),
   candidateReadiness:($readiness[0] + {matchesBaseline:true})}
' >>"$TRANSCRIPT"
jq -cn \
  --slurpfile gateway "$BASELINE_GATEWAY" \
  --slurpfile readiness "$BASELINE_READINESS" \
  --slurpfile topology "$WORK/packed-topology.snapshot" '
  {"label":"packed-topology", command:[], exitCode:0, expectedExitCode:0,
   stdout:null, stderr:null, topology:$topology[0],
   gateway:($gateway[0] + {matchesBaseline:true}),
   candidateReadiness:($readiness[0] + {matchesBaseline:true})}
' >>"$TRANSCRIPT"

refresh_cleanup_owner_snapshot() {
  local label=$1 staged="$WORK/cleanup-owner.$$.tmp" destination="$WORK/cleanup-owner.snapshot"
  capture_validated_cleanup_targets "$staged" \
    || die "could not capture the discovery-selected Webconsole owner after $label"
  jq -e '
    .schemaVersion == 1 and
    .stopAllowed == true and
    (.discovery | type == "object") and
    (.targets | length == 1) and
    .targets[0].pid == .discovery.pid
  ' "$staged" >/dev/null \
    || die "Webconsole cleanup owner is not uniquely discovery-selected after $label"
  mv "$staged" "$destination"
  CLEANUP_TARGET_SNAPSHOT=$destination
}

capture_command() {
  local label=$1 expected=$2
  shift 2
  local stdout="$OUT/$label.stdout" stderr="$OUT/$label.stderr" current="$WORK/gateway-$label.snapshot"
  local gateway_before="$WORK/gateway-$label-before.snapshot"
  local readiness_before="$WORK/readiness-$label-before.snapshot" readiness_after="$WORK/readiness-$label-after.snapshot"
  local status matches stdout_relative stderr_relative stdout_sha stderr_sha stdout_size stderr_size
  assert_candidate_readiness_unchanged "$readiness_before" "before $label"
  capture_gateway_signature "$gateway_before"
  cmp -s "$BASELINE_GATEWAY" "$gateway_before" \
    || die "Gateway identity or discovery changed before $label"
  if "$@" >"$stdout" 2>"$stderr"; then
    status=0
  else
    status=$?
  fi
  if [ "$status" -eq 0 ]; then
    case "$label" in
      start-first|start-second|launch-no-open|start-adopt|restart|start-force)
        # Preserve the discovery-selected owner before later assertions or
        # same-shaped replacement processes can mutate cleanup authority.
        refresh_cleanup_owner_snapshot "$label"
        ;;
    esac
  fi
  assert_candidate_readiness_unchanged "$readiness_after" "after $label"
  capture_gateway_signature "$current"
  if cmp -s "$BASELINE_GATEWAY" "$current"; then matches=true; else matches=false; fi
  stdout_relative="${stdout#"$RUN_ROOT/"}"
  stderr_relative="${stderr#"$RUN_ROOT/"}"
  stdout_sha=$(sha256sum "$stdout" | cut -d' ' -f1)
  stderr_sha=$(sha256sum "$stderr" | cut -d' ' -f1)
  stdout_size=$(stat -c %s "$stdout")
  stderr_size=$(stat -c %s "$stderr")
  jq -cn \
    --arg opLabel "$label" \
    --argjson exitCode "$status" \
    --argjson expectedExitCode "$expected" \
    --arg stdout "$stdout_relative" \
    --arg stderr "$stderr_relative" \
    --arg stdoutSha256 "$stdout_sha" \
    --arg stderrSha256 "$stderr_sha" \
    --argjson stdoutSize "$stdout_size" \
    --argjson stderrSize "$stderr_size" \
    --argjson matchesBaseline "$matches" \
    --slurpfile gateway "$current" \
    --slurpfile readiness "$readiness_after" \
    --args '
      {
        "label": $opLabel,
        command: $ARGS.positional,
        exitCode: $exitCode,
        expectedExitCode: $expectedExitCode,
        stdout: $stdout,
        stderr: $stderr,
        stdoutSha256: $stdoutSha256,
        stdoutSize: $stdoutSize,
        stderrSha256: $stderrSha256,
        stderrSize: $stderrSize,
        gateway: ($gateway[0] + {matchesBaseline:$matchesBaseline}),
        candidateReadiness: ($readiness[0] + {matchesBaseline:true})
      }
    ' -- "$@" >>"$TRANSCRIPT"
  [ "$matches" = true ] || die "Gateway identity or discovery changed after $label"
  if [ "$status" -ne "$expected" ]; then
    detail=$(tr '\n' ' ' <"$stderr")
    [ -n "$detail" ] || detail=$(tr '\n' ' ' <"$stdout")
    die "$label returned $status instead of $expected: $detail"
  fi
}

assert_live_status() {
  local path=$1
  jq -e \
    --arg host "$HOST" \
    --argjson port "$PORT" '
      .installed == true and
      .gatewayHealthy == true and
      .runtime.state == "live" and
      .runtime.host == $host and
      .runtime.port == $port and
      (.runtime.pid | type == "number")
    ' "$path" >/dev/null
}

wait_port_closed() {
  local port=$1 deadline
  deadline=$((SECONDS + 5))
  while port_is_open "$port"; do
    [ "$SECONDS" -lt "$deadline" ] || die "listener on port $port did not close"
    sleep 0.05
  done
}

assert_discovery_converged() {
  local expected_pid=$1 label=$2 health gateway_url
  health="$OUT/discovery-$label.health"
  gateway_url=$(jq -er '.url' "$BASELINE_GATEWAY")
  [ -f "$DISCOVERY" ] || die "$label did not materialize Webconsole discovery"
  curl --noproxy '*' -g -fsS --max-time 2 "$WEBCONSOLE_URL/health" >"$health"
  jq -e \
    --argjson pid "$expected_pid" \
    --arg host "$HOST" \
    --argjson port "$PORT" \
    --arg url "$WEBCONSOLE_URL" \
    --arg gatewayUrl "$gateway_url" \
    --arg executable "$WEBCONSOLE_EXE" '
      .pid == $pid and
      .host == $host and
      .port == $port and
      .url == $url and
      .gatewayUrl == $gatewayUrl and
      .executable == $executable
    ' "$DISCOVERY" >/dev/null || die "$label discovery does not converge with CLI argv"
  jq -e \
    --argjson pid "$expected_pid" \
    --arg host "$HOST" \
    --argjson port "$PORT" \
    --arg url "$WEBCONSOLE_URL" \
    --arg gatewayUrl "$gateway_url" \
    --arg executable "$WEBCONSOLE_EXE" '
      .ok == true and
      .service == "nexus-webui" and
      .pid == $pid and
      .host == $host and
      .port == $port and
      .url == $url and
      .gateway == $gatewayUrl and
      .executable == $executable
    ' "$health" >/dev/null || die "$label health does not converge with CLI argv"
}

capture_command preflight-status 2 "$NEXUS_BIN" --json webconsole status
jq -e '.runtime.state == "down"' "$OUT/preflight-status.stdout" >/dev/null \
  || die "D2 requires a stopped Webconsole at entry"
[ "$(matching_webconsole_pids)" = '[]' ] || die "packed Webconsole is already running in the isolated lab"

capture_command version 0 "$NEXUS_BIN" --version
VERSION_OUTPUT=$(python3 - "$OUT/version.stdout" <<'PY'
import sys
from pathlib import Path

sys.stdout.write(Path(sys.argv[1]).read_text(encoding="utf-8").strip())
PY
)
[ "$VERSION_OUTPUT" = 'nexus 0.1.5' ] \
  || die "packed Nexus CLI version must be exactly nexus 0.1.5"
capture_command help-webconsole 0 "$NEXUS_BIN" webconsole --help
for action in launch start stop restart status logs url; do
  capture_command "help-$action" 0 "$NEXUS_BIN" webconsole "$action" --help
done

LIFECYCLE_TOUCHED=1
capture_command start-first 0 "$NEXUS_BIN" webconsole start --host "$HOST" --port "$PORT"
capture_command status-plain 0 "$NEXUS_BIN" webconsole status
grep -Fq "$WEBCONSOLE_URL" "$OUT/status-plain.stdout" \
  || die "plain Webconsole status omitted the configured URL"
capture_command status-first 0 "$NEXUS_BIN" --json webconsole status
assert_live_status "$OUT/status-first.stdout"
INITIAL_PID=$(jq -r '.runtime.pid' "$OUT/status-first.stdout")
ACTIVE_WEBCONSOLE_PID=$INITIAL_PID
assert_discovery_converged "$INITIAL_PID" start-first

capture_command start-second 0 "$NEXUS_BIN" webconsole start --host "$HOST" --port "$PORT"
capture_command status-second 0 "$NEXUS_BIN" --json webconsole status
assert_live_status "$OUT/status-second.stdout"
[ "$(jq -r '.runtime.pid' "$OUT/status-second.stdout")" = "$INITIAL_PID" ] \
  || die "repeat start replaced the live Webconsole"
assert_discovery_converged "$INITIAL_PID" start-second

capture_command url 0 "$NEXUS_BIN" webconsole url
[ "$(tr -d '\r\n' <"$OUT/url.stdout")" = "$WEBCONSOLE_URL" ] \
  || die "webconsole url did not report the configured endpoint"
NO_OPEN_SENTINEL="$WORK/browser-opener-was-invoked"
NO_OPEN_BIN="$WORK/no-open-bin"
mkdir -p "$NO_OPEN_BIN"
for opener in xdg-open open sensible-browser; do
  cat >"$NO_OPEN_BIN/$opener" <<EOF
#!/bin/sh
touch '$NO_OPEN_SENTINEL'
exit 97
EOF
  chmod +x "$NO_OPEN_BIN/$opener"
done
capture_command launch-no-open 0 \
  env "PATH=$NO_OPEN_BIN:$PATH" "BROWSER=$NO_OPEN_BIN/xdg-open" \
  "$NEXUS_BIN" webconsole launch --no-open --host "$HOST" --port "$PORT"
[ ! -e "$NO_OPEN_SENTINEL" ] \
  || die "webconsole launch --no-open invoked a browser opener"
assert_discovery_converged "$INITIAL_PID" launch-no-open
LOG_PATH=$(jq -er '.logPath' "$OUT/status-first.stdout")
LOG_TAIL_EXPECTED="$WORK/log-tail.expected"
python3 - "$NEXUS_HOME" "$LOG_PATH" "$RUN_ID" "$LOG_TAIL_EXPECTED" <<'PY'
import os
import stat
import sys
from pathlib import Path

home = Path(os.path.abspath(sys.argv[1]))
path = Path(os.path.abspath(sys.argv[2]))
run_id = sys.argv[3]
expected = Path(sys.argv[4])
try:
    path.relative_to(home)
except ValueError as error:
    raise SystemExit("Webconsole log path escapes NEXUS_HOME") from error
cursor = Path(path.anchor)
for component in path.parts[1:-1]:
    cursor /= component
    info = os.lstat(cursor)
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        raise SystemExit(f"Webconsole log ancestry is unsafe: {cursor}")
flags = (
    os.O_WRONLY
    | os.O_APPEND
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0)
)
descriptor = os.open(path, flags)
try:
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
        raise SystemExit("Webconsole log is not a single regular file")
    markers = [f"D2-LOG-{index:02d}:{run_id}" for index in range(1, 9)]
    raw = ("\n".join(markers) + "\n").encode("utf-8")
    view = memoryview(raw)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise OSError("short write while seeding Webconsole log")
        view = view[written:]
    os.fsync(descriptor)
finally:
    os.close(descriptor)
expected.write_text("\n".join(markers[-5:]) + "\n", encoding="utf-8")
PY
capture_command logs-lines 0 "$NEXUS_BIN" webconsole logs --lines 5
cmp -s "$LOG_TAIL_EXPECTED" "$OUT/logs-lines.stdout" \
  || die "webconsole logs --lines did not return the exact final five ordered lines"
FOLLOW_MARKER="D2-FOLLOW:$RUN_ID"
capture_command logs-follow 124 \
  timeout 2s sh -c '
    (sleep 0.25; printf "%s\n" "$3" >>"$1") &
    exec "$2" webconsole logs --follow --lines 1
  ' sh "$LOG_PATH" "$NEXUS_BIN" "$FOLLOW_MARKER"
printf '%s\n%s\n' "D2-LOG-08:$RUN_ID" "$FOLLOW_MARKER" >"$WORK/log-follow.expected"
cmp -s "$WORK/log-follow.expected" "$OUT/logs-follow.stdout" \
  || die "webconsole logs --follow did not stream the unique appended line exactly once"

[ -f "$DISCOVERY" ] || die "Webconsole discovery is missing before adoption test"
cp "$DISCOVERY" "$OUT/discovery-before-adoption.snapshot"
rm "$DISCOVERY"
kill -0 "$INITIAL_PID" 2>/dev/null || die "Webconsole died before discovery recovery"
port_is_open "$PORT" || die "Webconsole listener disappeared before discovery recovery"
capture_command start-adopt 0 "$NEXUS_BIN" webconsole start --host "$HOST" --port "$PORT"
[ -f "$DISCOVERY" ] || die "Webconsole start did not restore missing discovery"
ADOPTED_PID=$(jq -r '.pid' "$DISCOVERY")
[ "$ADOPTED_PID" = "$INITIAL_PID" ] || die "missing-discovery recovery adopted the wrong process"
assert_discovery_converged "$ADOPTED_PID" start-adopt

capture_command restart 0 "$NEXUS_BIN" --json webconsole restart --host "$HOST" --port "$PORT"
assert_live_status "$OUT/restart.stdout"
RESTARTED_PID=$(jq -r '.runtime.pid' "$OUT/restart.stdout")
ACTIVE_WEBCONSOLE_PID=$RESTARTED_PID
[ "$RESTARTED_PID" != "$ADOPTED_PID" ] || die "webconsole restart did not replace the process"
assert_discovery_converged "$RESTARTED_PID" restart
curl --noproxy '*' -g -fsS --max-time 2 \
  "$WEBCONSOLE_URL/health" >"$OUT/health-after-restart.stdout"

capture_command stop-first 0 "$NEXUS_BIN" webconsole stop
ACTIVE_WEBCONSOLE_PID=""
capture_command status-down-normal 2 "$NEXUS_BIN" --json webconsole status
jq -e '.runtime.state == "down"' "$OUT/status-down-normal.stdout" >/dev/null
wait_port_closed "$PORT"
capture_command stop-second 0 "$NEXUS_BIN" webconsole stop

capture_command start-force 0 "$NEXUS_BIN" --json webconsole start --host "$HOST" --port "$PORT"
assert_live_status "$OUT/start-force.stdout"
FORCE_PID=$(jq -r '.runtime.pid' "$OUT/start-force.stdout")
ACTIVE_WEBCONSOLE_PID=$FORCE_PID
assert_discovery_converged "$FORCE_PID" start-force
capture_command stop-force-first 0 "$NEXUS_BIN" webconsole stop --force
ACTIVE_WEBCONSOLE_PID=""
wait_port_closed "$PORT"
capture_command stop-force-second 0 "$NEXUS_BIN" webconsole stop --force

OCCUPIED_PORT=$(allocate_closed_port)
while [ "$OCCUPIED_PORT" = "$PORT" ]; do OCCUPIED_PORT=$(allocate_closed_port); done
OCCUPIED_URL=$(http_url "$HOST" "$OCCUPIED_PORT")
WEBCONSOLE_PIDS_BEFORE=$(matching_webconsole_pids)
[ "$WEBCONSOLE_PIDS_BEFORE" = '[]' ] || die "Webconsole process remained before occupied-port check"
python3 -m http.server "$OCCUPIED_PORT" --bind "$HOST" \
  >"$OUT/foreign-listener.stdout" 2>"$OUT/foreign-listener.stderr" &
FOREIGN_PID=$!
deadline=$((SECONDS + 5))
until curl --noproxy '*' -g -sS --max-time 1 -o /dev/null \
  "$OCCUPIED_URL/health" 2>/dev/null; do
  [ "$SECONDS" -lt "$deadline" ] || die "foreign occupied-port fixture did not become ready"
  sleep 0.05
done
FOREIGN_PID_BEFORE=$FOREIGN_PID
FOREIGN_EXE_BEFORE=$(readlink -f "/proc/$FOREIGN_PID/exe")
OCCUPIED_WEBUI_AUDIT="$WORK/nexus-webui-exec-audit"
OCCUPIED_WEBUI_INVOCATIONS="$WORK/nexus-webui-exec-invocations"
cat >"$OCCUPIED_WEBUI_AUDIT" <<'SH'
#!/bin/sh
printf '%s\n' "$$" >>"$NEXUS_V015_WEBUI_EXEC_AUDIT"
exec "$NEXUS_V015_WEBUI_EXEC_TARGET" "$@"
SH
chmod 0500 "$OCCUPIED_WEBUI_AUDIT"
OCCUPIED_STARTED=$(python3 -c 'import time; print(time.monotonic())')
capture_command occupied-start 1 \
  env \
    "NEXUS_WEBUI_BIN=$OCCUPIED_WEBUI_AUDIT" \
    "NEXUS_V015_WEBUI_EXEC_AUDIT=$OCCUPIED_WEBUI_INVOCATIONS" \
    "NEXUS_V015_WEBUI_EXEC_TARGET=$WEBCONSOLE_EXE" \
  "$NEXUS_BIN" --json webconsole start --host "$HOST" --port "$OCCUPIED_PORT"
OCCUPIED_ENDED=$(python3 -c 'import time; print(time.monotonic())')
OCCUPIED_ELAPSED=$(python3 - "$OCCUPIED_STARTED" "$OCCUPIED_ENDED" <<'PY'
import sys
print(float(sys.argv[2]) - float(sys.argv[1]))
PY
)
OCCUPIED_ERROR_CODE=$(jq -er '.error.code' "$OUT/occupied-start.stdout")
OCCUPIED_MESSAGE=$(jq -er '.error.message' "$OUT/occupied-start.stdout")
OCCUPIED_ERROR_HOST=$(jq -er '.error.data.host' "$OUT/occupied-start.stdout")
OCCUPIED_ERROR_PORT=$(jq -er '.error.data.port' "$OUT/occupied-start.stdout")
[ "$OCCUPIED_ERROR_CODE" = "WEBCONSOLE_PORT_OCCUPIED" ] \
  || die "occupied-port refusal did not use WEBCONSOLE_PORT_OCCUPIED"
[ "$OCCUPIED_ERROR_HOST" = "$HOST" ] && [ "$OCCUPIED_ERROR_PORT" = "$OCCUPIED_PORT" ] \
  || die "occupied-port refusal did not report the rejected endpoint"
grep -Eqi 'occupied' <<<"$OCCUPIED_MESSAGE" || die "occupied-port refusal was not typed as occupied"
[ ! -s "$OCCUPIED_WEBUI_INVOCATIONS" ] \
  || die "occupied-port refusal invoked the packed WebUI executable"
kill -0 "$FOREIGN_PID" 2>/dev/null || die "occupied-port refusal killed the unrelated listener"
FOREIGN_PID_AFTER=$FOREIGN_PID
FOREIGN_EXE_AFTER=$(readlink -f "/proc/$FOREIGN_PID/exe")
[ "$FOREIGN_EXE_AFTER" = "$FOREIGN_EXE_BEFORE" ] \
  || die "occupied-port refusal replaced the unrelated listener"
curl --noproxy '*' -g -sS --max-time 1 -o /dev/null "$OCCUPIED_URL/health" \
  || die "unrelated occupied-port listener stopped responding"
[ ! -e "$DISCOVERY" ] || die "occupied-port refusal created Webconsole discovery"
WEBCONSOLE_PIDS_AFTER=$(matching_webconsole_pids)
[ "$WEBCONSOLE_PIDS_AFTER" = '[]' ] || die "occupied-port refusal spawned a Webconsole child"

jq -n \
  --argjson initialPid "$INITIAL_PID" \
  --argjson adoptedPid "$ADOPTED_PID" \
  --argjson restartedPid "$RESTARTED_PID" \
  --argjson forcePid "$FORCE_PID" \
  --argjson argvDiscoveryConverged true \
  --argjson discoveryRestored true \
  --argjson normalStopClosed true \
  --argjson forcedStopClosed true \
  --argjson finalListenerClosed true \
  '{
    schemaVersion: 1,
    initialPid: $initialPid,
    adoptedPid: $adoptedPid,
    restartedPid: $restartedPid,
    forcePid: $forcePid,
    argvDiscoveryConverged: $argvDiscoveryConverged,
    discoveryRestored: $discoveryRestored,
    normalStopClosed: $normalStopClosed,
    forcedStopClosed: $forcedStopClosed,
    finalListenerClosed: $finalListenerClosed
  }' >"$RECOVERY"

jq -n \
  --argjson port "$OCCUPIED_PORT" \
  --arg errorCode "$OCCUPIED_ERROR_CODE" \
  --arg message "$OCCUPIED_MESSAGE" \
  --arg errorHost "$OCCUPIED_ERROR_HOST" \
  --argjson errorPort "$OCCUPIED_ERROR_PORT" \
  --argjson foreignPidBefore "$FOREIGN_PID_BEFORE" \
  --argjson foreignPidAfter "$FOREIGN_PID_AFTER" \
  --arg foreignExecutableBefore "$FOREIGN_EXE_BEFORE" \
  --arg foreignExecutableAfter "$FOREIGN_EXE_AFTER" \
  --argjson foreignListenerPreserved true \
  --argjson webconsolePidsBefore "$WEBCONSOLE_PIDS_BEFORE" \
  --argjson webconsolePidsAfter "$WEBCONSOLE_PIDS_AFTER" \
  --argjson elapsedSeconds "$OCCUPIED_ELAPSED" \
  '{
    schemaVersion: 1,
    port: $port,
    errorCode: $errorCode,
    message: $message,
    errorData: {host:$errorHost, port:$errorPort},
    foreignPidBefore: $foreignPidBefore,
    foreignPidAfter: $foreignPidAfter,
    foreignExecutableBefore: $foreignExecutableBefore,
    foreignExecutableAfter: $foreignExecutableAfter,
    foreignListenerPreserved: $foreignListenerPreserved,
    webconsolePidsBefore: $webconsolePidsBefore,
    webconsolePidsAfter: $webconsolePidsAfter,
    elapsedSeconds: $elapsedSeconds
  }' >"$OCCUPIED"

kill "$FOREIGN_PID"
wait "$FOREIGN_PID" 2>/dev/null || true
FOREIGN_PID=""
wait_port_closed "$OCCUPIED_PORT"
capture_command status-final 2 "$NEXUS_BIN" --json webconsole status
jq -e '.runtime.state == "down"' "$OUT/status-final.stdout" >/dev/null
wait_port_closed "$PORT"
[ ! -e "$DISCOVERY" ] || die "Webconsole discovery remained after final stop"

relative_artifact() {
  printf '%s' "${1#"$RUN_ROOT/"}"
}
artifact_record() {
  local path=$1
  jq -n \
    --arg path "$(relative_artifact "$path")" \
    --arg sha256 "$(sha256sum "$path" | cut -d' ' -f1)" \
    '{path:$path, sha256:$sha256}'
}

CLI_ARTIFACT=$(artifact_record "$TRANSCRIPT")
RECOVERY_ARTIFACT=$(artifact_record "$RECOVERY")
OCCUPIED_ARTIFACT=$(artifact_record "$OCCUPIED")
EVIDENCE_INVENTORY=$(python3 - "$RUN_ROOT" "$OUT" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
out = Path(sys.argv[2])
records = []
for directory, directory_names, filenames in os.walk(out, followlinks=False):
    current = Path(directory)
    for name in sorted(directory_names):
        path = current / name
        info = os.lstat(path)
        if stat.S_ISLNK(info.st_mode):
            raise SystemExit(f"D2 evidence directory contains a symlink: {path}")
        if not stat.S_ISDIR(info.st_mode):
            raise SystemExit(f"D2 evidence directory contains a non-directory: {path}")
    for name in sorted(filenames):
        path = current / name
        info = os.lstat(path)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            raise SystemExit(f"D2 evidence path is not a single regular file: {path}")
        raw = path.read_bytes()
        records.append({
            "path": path.relative_to(root).as_posix(),
            "sha256": hashlib.sha256(raw).hexdigest(),
            "size": len(raw),
        })
print(json.dumps(sorted(records, key=lambda record: record["path"]), separators=(",", ":")))
PY
)
jq -n \
  --arg runId "$RUN_ID" \
  --arg candidateDigest "$CANDIDATE_DIGEST" \
  --argjson primaryPort "$PORT" \
  --argjson occupiedPort "$OCCUPIED_PORT" \
  --argjson cliTranscript "$CLI_ARTIFACT" \
  --argjson discoveryRecovery "$RECOVERY_ARTIFACT" \
  --argjson occupiedPortArtifact "$OCCUPIED_ARTIFACT" \
  --argjson evidenceInventory "$EVIDENCE_INVENTORY" '
  {
    schemaVersion: 1,
    runId: $runId,
    candidateDigest: $candidateDigest,
    gate: "D2",
    status: "PASS",
    error: null,
    partial: false,
    flaky: false,
    skipped: false,
    refused: false,
    failureCount: 0,
    finalState: "down",
    primaryPort: $primaryPort,
    occupiedPort: $occupiedPort,
    evidenceInventory: $evidenceInventory,
    requiredArtifacts: ["cliTranscript", "discoveryRecovery", "occupiedPort"],
    artifacts: {
      cliTranscript: $cliTranscript,
      discoveryRecovery: $discoveryRecovery,
      occupiedPort: $occupiedPortArtifact
    }
  }
' >"$OUT/result.json.tmp"
mv "$OUT/result.json.tmp" "$OUT/result.json"
find "$OUT" -maxdepth 1 -type f -exec chmod 0400 {} +
"$SCRIPT_DIR/nexus-v015-webconsole-evidence-verify" "$RUN_ROOT" >/dev/null

FINAL_READINESS="$WORK/readiness-final.snapshot"
assert_candidate_readiness_unchanged "$FINAL_READINESS" "at D2 completion"
FINAL_GATEWAY="$WORK/gateway-final.snapshot"
capture_gateway_signature "$FINAL_GATEWAY"
cmp -s "$BASELINE_GATEWAY" "$FINAL_GATEWAY" \
  || die "Gateway identity or discovery changed at D2 completion"

RESULT_SEAL_SNAPSHOT="$WORK/result-seal-owned.snapshot"
RESULT_SEAL_OWNED=1
python3 - \
  "$RUN_ROOT" "$RUN_ID" "$CANDIDATE_DIGEST" "$RESULT_SEAL_SNAPSHOT" \
  "${NEXUS_V015_FIXTURE_FAIL_SELF_VERIFY:-0}" \
  "${NEXUS_V015_FIXTURE_FAIL_SEAL_PARENT_FSYNC:-0}" \
  "${NEXUS_V015_FIXTURE_FAIL_POST_PUBLISH_VERIFY:-0}" \
  "${NEXUS_V015_FIXTURE_SWAP_SEAL_BEFORE_PUBLISH_ROLLBACK:-}" \
  "${NEXUS_V015_FIXTURE_FAIL_SEAL_RESTORE_PARENT_FSYNC:-0}" \
  "${NEXUS_V015_FIXTURE_KILL_AFTER_SEAL_RESTORE_FSYNC:-0}" \
  "${NEXUS_V015_FIXTURE_FAIL_RESULT_FSYNC:-0}" \
  "${NEXUS_V015_FIXTURE_KILL_PARENT_AFTER_SEAL_COMMIT:-0}" \
  "${NEXUS_V015_FIXTURE_FAIL_AFTER_SEAL_PUBLISH:-0}" <<'PY'
import hashlib
import json
import os
import secrets
import signal
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
run_id = sys.argv[2]
candidate_digest = sys.argv[3]
snapshot_path = Path(sys.argv[4])
fail_self_verify = sys.argv[5] == "1"
fail_parent_fsync = sys.argv[6] == "1"
fail_post_publish_verify = sys.argv[7] == "1"
swap_before_publish_rollback = sys.argv[8]
fail_restore_parent_fsync = sys.argv[9] == "1"
kill_after_restore_fsync = sys.argv[10] == "1"
fail_result_fsync = sys.argv[11] == "1"
kill_parent_after_seal_commit = sys.argv[12] == "1"
fail_after_seal_publish = sys.argv[13] == "1"
result_relative = Path("results/D2-webconsole-cli/result.json")
seal_relative = Path("results/D2-webconsole-cli.result.sha256")
result_path = root / result_relative
seal_path = root / seal_relative
temporary = seal_path.with_name(f".{seal_path.name}.tmp-{os.getpid()}")
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
descriptor = os.open(result_path, flags)
try:
    info = os.fstat(descriptor)
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o400
        or info.st_nlink != 1
    ):
        raise SystemExit("D2 result is not a single 0400 regular file")
    chunks = []
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        chunks.append(chunk)
    result_raw = b"".join(chunks)
    if fail_result_fsync:
        raise OSError("fixture forced D2 result fsync failure")
    os.fsync(descriptor)
    visible = os.stat(result_path, follow_symlinks=False)
    if (
        visible.st_dev != info.st_dev
        or visible.st_ino != info.st_ino
        or visible.st_size != info.st_size
        or stat.S_IMODE(visible.st_mode) != 0o400
        or visible.st_nlink != 1
    ):
        raise SystemExit("D2 result changed while establishing durability")
finally:
    os.close(descriptor)
directory_flags = (
    os.O_RDONLY
    | getattr(os, "O_DIRECTORY", 0)
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0)
)
result_directory = os.open(result_path.parent, directory_flags)
try:
    os.fsync(result_directory)
finally:
    os.close(result_directory)
document = {
    "schemaVersion": 1,
    "runId": run_id,
    "candidateDigest": candidate_digest,
    "gate": "D2",
    "resultPath": result_relative.as_posix(),
    "resultSha256": hashlib.sha256(result_raw).hexdigest(),
    "resultSize": len(result_raw),
}
raw = (json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n").encode()
create_flags = (
    os.O_WRONLY
    | os.O_CREAT
    | os.O_EXCL
    | getattr(os, "O_CLOEXEC", 0)
    | getattr(os, "O_NOFOLLOW", 0)
)
descriptor = os.open(temporary, create_flags, 0o400)
try:
    os.fchmod(descriptor, 0o400)
    view = memoryview(raw)
    while view:
        written = os.write(descriptor, view)
        if written <= 0:
            raise OSError("short write while publishing D2 result seal")
        view = view[written:]
    os.fsync(descriptor)
finally:
    os.close(descriptor)

read_flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
staged_descriptor = os.open(temporary, read_flags)
committed = False
try:
    staged_info = os.fstat(staged_descriptor)
    staged_raw = b""
    while True:
        chunk = os.read(staged_descriptor, 1024 * 1024)
        if not chunk:
            break
        staged_raw += chunk
    if (
        not stat.S_ISREG(staged_info.st_mode)
        or stat.S_IMODE(staged_info.st_mode) != 0o400
        or staged_info.st_nlink != 1
        or staged_raw != raw
    ):
        raise SystemExit("staged D2 result seal failed self-verification")

    staged_record = {
        "device": staged_info.st_dev,
        "inode": staged_info.st_ino,
        "size": staged_info.st_size,
        "sha256": hashlib.sha256(staged_raw).hexdigest(),
    }
    snapshot_path.write_text(json.dumps(staged_record, sort_keys=True), encoding="utf-8")
    if fail_self_verify:
        os.unlink(temporary)
        raise SystemExit("fixture forced D2 result self-verification failure")
    if fail_post_publish_verify:
        os.unlink(temporary)
        raise SystemExit("fixture forced D2 post-publication verification failure")
    if fail_after_seal_publish:
        os.unlink(temporary)
        raise SystemExit("fixture forced failure after D2 result seal publication")

    linked = False
    directory = os.open(
        seal_path.parent,
        directory_flags | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        try:
            os.link(
                temporary.name,
                seal_path.name,
                src_dir_fd=directory,
                dst_dir_fd=directory,
                follow_symlinks=False,
            )
            linked = True
            os.unlink(temporary.name, dir_fd=directory)
            if fail_parent_fsync:
                raise OSError("fixture forced D2 result seal parent fsync failure")
            os.fsync(directory)
            committed = True
            if kill_parent_after_seal_commit:
                os.kill(os.getppid(), signal.SIGKILL)
        except BaseException:
            if linked:
                if swap_before_publish_rollback:
                    os.replace(swap_before_publish_rollback, seal_path)
                quarantine_name = (
                    f".{seal_path.name}.rollback-{os.getpid()}-{secrets.token_hex(6)}"
                )
                try:
                    os.replace(
                        seal_path.name,
                        quarantine_name,
                        src_dir_fd=directory,
                        dst_dir_fd=directory,
                    )
                except FileNotFoundError:
                    quarantine_name = ""
                if quarantine_name:
                    quarantine = os.open(quarantine_name, read_flags, dir_fd=directory)
                    try:
                        quarantine_info = os.fstat(quarantine)
                        quarantine_raw = b""
                        while True:
                            chunk = os.read(quarantine, 1024 * 1024)
                            if not chunk:
                                break
                            quarantine_raw += chunk
                        quarantine_record = {
                            "device": quarantine_info.st_dev,
                            "inode": quarantine_info.st_ino,
                            "size": quarantine_info.st_size,
                            "sha256": hashlib.sha256(quarantine_raw).hexdigest(),
                        }
                        if quarantine_record != staged_record:
                            replacement_record = quarantine_record
                            # Make the quarantined replacement a durable
                            # recovery point before restoring its canonical
                            # name. A crash cannot make it disappear together
                            # with the invocation-owned seal.
                            os.fsync(directory)
                            try:
                                os.stat(
                                    seal_path.name,
                                    dir_fd=directory,
                                    follow_symlinks=False,
                                )
                            except FileNotFoundError:
                                os.rename(
                                    quarantine_name,
                                    seal_path.name,
                                    src_dir_fd=directory,
                                    dst_dir_fd=directory,
                                )
                            try:
                                if fail_restore_parent_fsync:
                                    raise OSError(
                                        "fixture forced D2 replacement restore parent fsync failure"
                                    )
                                os.fsync(directory)
                            except OSError:
                                # A one-shot fsync error is recoverable only if
                                # the visible canonical name still identifies
                                # the exact replacement. Revalidate it, then
                                # establish the durable restore boundary.
                                restored = os.open(
                                    seal_path.name,
                                    read_flags,
                                    dir_fd=directory,
                                )
                                try:
                                    restored_info = os.fstat(restored)
                                    restored_raw = b""
                                    while True:
                                        chunk = os.read(restored, 1024 * 1024)
                                        if not chunk:
                                            break
                                        restored_raw += chunk
                                    restored_record = {
                                        "device": restored_info.st_dev,
                                        "inode": restored_info.st_ino,
                                        "size": restored_info.st_size,
                                        "sha256": hashlib.sha256(restored_raw).hexdigest(),
                                    }
                                finally:
                                    os.close(restored)
                                if restored_record != replacement_record:
                                    raise SystemExit(
                                        "replacement D2 result seal changed during rollback restore"
                                    )
                                os.fsync(directory)
                            if kill_after_restore_fsync:
                                os.kill(os.getpid(), signal.SIGKILL)
                            raise SystemExit(
                                "refusing to roll back a replacement D2 result seal"
                            )
                        # If rollback itself cannot be made durable, any surviving
                        # owned inode must still be verifier-invalid.
                        os.fchmod(staged_descriptor, 0)
                        os.fsync(staged_descriptor)
                    finally:
                        os.close(quarantine)
            try:
                os.unlink(temporary.name, dir_fd=directory)
            except FileNotFoundError:
                pass
            try:
                os.fsync(directory)
            except OSError:
                pass
            raise
    finally:
        try:
            os.close(directory)
        except OSError:
            if not committed:
                raise
finally:
    try:
        os.close(staged_descriptor)
    except OSError:
        if not committed:
            raise
PY
SUCCESS=1
printf 'v0.1.5 Webconsole acceptance passed: %s\n' "$OUT"
