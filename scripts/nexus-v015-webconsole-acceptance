readiness = {}
for line_number, line in enumerate(readiness_text.splitlines(), 1):
    if not line or "=" not in line:
        fail(f"candidate readiness ledger has invalid line {line_number}")
    key, value = line.split("=", 1)
    if not key or not value or key in readiness:
        fail(f"candidate readiness ledger has invalid field {key!r}")
    readiness[key] = value
expected_readiness = {
    "schema": "1",
    "containerId": container_id,
    "mode": "packed",
    "runId": str(manifest.get("runId", "")),
    "installRoot": str(prefix),
    "installNonce": install_nonce,
    "nativeResolved": str(native_path),
    "nativeSha256": installed_hashes["native"],
    "nexusLink": str(prefix / "bin" / "nexus"),
    "nexusResolved": resolved["nexus"],
    "nexusSha256": installed_hashes["nexus"],
    "gatewayLink": str(prefix / "bin" / "nexus-gateway"),
    "gatewayResolved": resolved["nexusGateway"],
    "gatewaySha256": installed_hashes["nexusGateway"],
    "webuiLink": str(prefix / "bin" / "nexus-webui"),
    "webuiResolved": resolved["nexusWebui"],
    "webuiSha256": installed_hashes["nexusWebui"],
    "installTreeSha256": observed_install_tree_sha256,
    "imageDigest": str(manifest.get("image", {}).get("digest", "")),
}
missing_readiness = sorted(set(expected_readiness) - set(readiness))
if missing_readiness:
    fail(f"candidate readiness ledger is missing required D2 fields: {missing_readiness}")
if readiness["installTreeSha256"] != observed_install_tree_sha256:
    fail("packed install dependency closure differs from the candidate readiness ledger")
changed_readiness = sorted(
    key for key, expected in expected_readiness.items()
    if readiness.get(key) != expected
)
if changed_readiness:
    fail(
        "candidate readiness ledger does not match container/run/install bindings: "
        f"{changed_readiness}"
    )

print(json.dumps({
    "schemaVersion": 1,
    "prefix": str(prefix),
    "topLevelPackages": ["@egregore/nexus"],
    "umbrellaVersion": package["version"],
    "dependencies": dependencies,
    "resolvedLaunchers": resolved,
    "resolvedNative": str(native_path),
    "gatewayModule": str(gateway_module),
    "packageInventories": package_inventories,
    "candidateReadiness": {
        "path": str(readiness_path),
        "sha256": readiness_sha,
        "containerId": readiness["containerId"],
        "runId": readiness["runId"],
        "installRoot": readiness["installRoot"],
        "installNonce": readiness["installNonce"],
        "installTreeSha256": readiness["installTreeSha256"],
        "extraFields": sorted(set(readiness) - set(expected_readiness)),
    },
    "provenance": {
        "tarballBound": True,
        "manifestBindingsBound": True,
        "completePackageInventory": True,
        "readinessBound": True,
        "fullDependencyClosure": True,
        "installTreeSha256": observed_install_tree_sha256,
        "nativeSha256": installed_hashes["native"],
        "gatewayModuleSha256": installed_hashes["gatewayModule"],
    },
}, sort_keys=True))
PY

