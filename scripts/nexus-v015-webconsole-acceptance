#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
NEXUS_BIN="${NEXUS_V015_NEXUS_BIN:-nexus}"
HOST=127.0.0.1
PORT=0
RUN_ID="${NEXUS_V015_RUN_ID:-}"
AMBIENT_RUN_ID="${NEXUS_V015_RUN_ID:-}"
EVIDENCE_DIR="${NEXUS_V015_EVIDENCE_DIR:-/tmp/nexus-lens-home/evidence}"
EVIDENCE_ROOT="${NEXUS_V015_EVIDENCE_ROOT:-}"
PACKED_PREFIX="${NEXUS_V015_PACKED_PREFIX:-}"
VERIFY_RESULT_SEAL_ROOT=""
FOREIGN_PID=""
ACTIVE_WEBCONSOLE_PID=""
RESULT_SEAL=""
RESULT_SEAL_OWNED=0
RESULT_SEAL_SNAPSHOT=""
SUCCESS=0
PACKED_CLI_VALIDATED=0
LIFECYCLE_TOUCHED=0
WEBCONSOLE_ENTRYPOINT_SNAPSHOT=""
CLEANUP_TARGET_SNAPSHOT=""

usage() {
  cat <<'USAGE'
Usage: scripts/nexus-v015-webconsole-acceptance [options]

Exercise the complete packed `nexus webconsole` lifecycle inside the isolated
v0.1.5 validator. The gate finishes with Webconsole stopped and its selected
ephemeral ports closed; it never stops or replaces the validator Gateway.

Options:
  --nexus-bin PATH       Packed Nexus CLI under test.
  --host HOST            Webconsole bind host (default: 127.0.0.1).
  --port PORT            Webconsole port; 0 selects a fresh closed port (default: 0).
  --run-id ID            Candidate run identifier (must match manifest.json).
  --evidence-dir PATH    Evidence parent used with --run-id.
  --evidence-root PATH   Run root containing the packed manifest.json.
  --packed-prefix PATH   Clean global prefix containing only @egregore/nexus.
  --verify-result-seal PATH
                         Verify a completed D2 result against its detached seal.
  -h, --help             Show this help without side effects.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --nexus-bin)
      [ "$#" -ge 2 ] || die "--nexus-bin requires a value"
      NEXUS_BIN=$2
      shift 2
      ;;
    --host)
      [ "$#" -ge 2 ] || die "--host requires a value"
      HOST=$2
      shift 2
      ;;
    --port)
      [ "$#" -ge 2 ] || die "--port requires a value"
      PORT=$2
      shift 2
      ;;
    --run-id)
      [ "$#" -ge 2 ] || die "--run-id requires a value"
      RUN_ID=$2
      shift 2
      ;;
    --evidence-dir)
      [ "$#" -ge 2 ] || die "--evidence-dir requires a value"
      EVIDENCE_DIR=$2
      shift 2
      ;;
    --evidence-root)
      [ "$#" -ge 2 ] || die "--evidence-root requires a value"
      EVIDENCE_ROOT=$2
      shift 2
      ;;
    --packed-prefix)
      [ "$#" -ge 2 ] || die "--packed-prefix requires a value"
      PACKED_PREFIX=$2
      shift 2
      ;;
    --verify-result-seal)
      [ "$#" -ge 2 ] || die "--verify-result-seal requires a value"
      VERIFY_RESULT_SEAL_ROOT=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *) die "unknown argument: $1" ;;
  esac
done

for fixture_hook in \
  NEXUS_V015_FIXTURE_FAIL_SELF_VERIFY \
  NEXUS_V015_FIXTURE_FAIL_RESULT_FSYNC \
  NEXUS_V015_FIXTURE_FAIL_POST_PUBLISH_VERIFY \
  NEXUS_V015_FIXTURE_FAIL_SEAL_PARENT_FSYNC \
  NEXUS_V015_FIXTURE_KILL_PARENT_AFTER_SEAL_COMMIT \
  NEXUS_V015_FIXTURE_FAIL_AFTER_SEAL_PUBLISH \
  NEXUS_V015_FIXTURE_FAIL_SEAL_UNLINK \
  NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_RENAME \
  NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_OPEN \
  NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_CHMOD \
  NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_FSYNC \
  NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_PARENT_FSYNC \
  NEXUS_V015_FIXTURE_KILL_AFTER_SEAL_QUARANTINE_RENAME \
  NEXUS_V015_FIXTURE_KILL_AFTER_SEAL_QUARANTINE_CHMOD \
  NEXUS_V015_FIXTURE_FAIL_SEAL_RESTORE_PARENT_FSYNC \
  NEXUS_V015_FIXTURE_KILL_AFTER_SEAL_RESTORE_FSYNC \
  NEXUS_V015_FIXTURE_SWAP_SEAL_BEFORE_PUBLISH_ROLLBACK \
  NEXUS_V015_FIXTURE_SWAP_SEAL_BEFORE_INVALIDATE \
  NEXUS_V015_FIXTURE_GATEWAY_HOST_MODE; do
  hook_value=${!fixture_hook-}
  if [ -n "$hook_value" ] && [ "${NEXUS_V015_ALLOW_FIXTURE_HOME:-}" != 1 ]; then
    die "$fixture_hook is forbidden outside the isolated fixture"
  fi
done

if [ -n "$VERIFY_RESULT_SEAL_ROOT" ]; then
  command -v python3 >/dev/null 2>&1 || die "required command is unavailable: python3"
  python3 - "$VERIFY_RESULT_SEAL_ROOT" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path


def fail(message):
    raise SystemExit(f"D2 result seal verification failed: {message}")


def no_duplicates(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            fail(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def read_json(raw, label):
    try:
        return json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=no_duplicates,
            parse_constant=lambda value: fail(f"non-finite JSON in {label}: {value}"),
        )
    except (UnicodeError, json.JSONDecodeError) as error:
        fail(f"invalid {label}: {error}")


def reject_symlink_ancestry(path):
    absolute = Path(os.path.abspath(os.fspath(path)))
    cursor = Path(absolute.anchor)
    for component in absolute.parts[1:-1]:
        cursor /= component
        try:
            info = os.lstat(cursor)
        except OSError as error:
            fail(f"cannot inspect path ancestry {cursor}: {error}")
        if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
            fail(f"unsafe path ancestry: {cursor}")


def read_single_regular(path, label, expected_mode=None):
    reject_symlink_ancestry(path)
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(f"cannot open {label}: {error}")
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            fail(f"{label} is not a single regular file")
        if expected_mode is not None and stat.S_IMODE(info.st_mode) != expected_mode:
            fail(f"{label} mode is not {expected_mode:o}")
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        return b"".join(chunks)
    finally:
        os.close(descriptor)


root = Path(os.path.abspath(sys.argv[1]))
manifest_raw = read_single_regular(root / "manifest.json", "candidate manifest")
result_relative = Path("results/D2-webconsole-cli/result.json")
seal_relative = Path("results/D2-webconsole-cli.result.sha256")
result_raw = read_single_regular(root / result_relative, "D2 result", 0o400)
seal_raw = read_single_regular(root / seal_relative, "D2 result seal", 0o400)
manifest = read_json(manifest_raw, "candidate manifest")
result = read_json(result_raw, "D2 result")
seal = read_json(seal_raw, "D2 result seal")
packages = manifest.get("packages")
if not isinstance(packages, list):
    fail("candidate manifest package ledger is invalid")
ledger = {
    "mode": manifest.get("mode"),
    "sources": manifest.get("sources"),
    "nativeSha256": (manifest.get("native") or {}).get("sha256"),
    "packages": [{
        "name": row.get("name"),
        "version": row.get("version"),
        "tarballSha256": (row.get("tarball") or {}).get("sha256"),
    } for row in packages if isinstance(row, dict)],
    "imageDigest": (manifest.get("image") or {}).get("digest"),
    "limits": (manifest.get("container") or {}).get("limits"),
    "toolchains": manifest.get("toolchains"),
    "environment": manifest.get("environment"),
}
candidate_raw = json.dumps(
    ledger,
    sort_keys=True,
    separators=(",", ":"),
    ensure_ascii=False,
    allow_nan=False,
).encode("utf-8")
candidate_digest = "sha256:" + hashlib.sha256(candidate_raw).hexdigest()
expected_seal = {
    "schemaVersion": 1,
    "runId": manifest.get("runId"),
    "candidateDigest": candidate_digest,
    "gate": "D2",
    "resultPath": result_relative.as_posix(),
    "resultSha256": hashlib.sha256(result_raw).hexdigest(),
    "resultSize": len(result_raw),
}
if seal != expected_seal:
    if isinstance(seal, dict) and seal.get("resultSha256") != expected_seal["resultSha256"]:
        fail("result hash mismatch")
    fail("result seal does not match the current candidate and D2 result")
if (
    not isinstance(result, dict)
    or result.get("runId") != manifest.get("runId")
    or result.get("candidateDigest") != candidate_digest
    or result.get("gate") != "D2"
    or result.get("status") != "PASS"
):
    fail("D2 result identity does not match the sealed candidate")
print(f"D2 result seal verified: {root / seal_relative}")
PY
  exit 0
fi

[ "${OCULAR_LAB:-}" = 1 ] || die "refusing to run outside the isolated ocular lab"
[ -n "${NEXUS_HOME:-}" ] || die "NEXUS_HOME is required"
[ -n "${NEXUS_LAB_ROOT:-}" ] || die "NEXUS_LAB_ROOT is required"
LAB_ROOT=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$NEXUS_LAB_ROOT")
[ "$LAB_ROOT" = "$NEXUS_LAB_ROOT" ] || die "NEXUS_LAB_ROOT must be an absolute normalized path"
CURRENT_READINESS_PATH="$LAB_ROOT/lab/candidate-ready.v1"
if [ "${NEXUS_V015_ALLOW_FIXTURE_HOME:-}" = 1 ]; then
  CGROUP_ROOT="${NEXUS_V015_FIXTURE_CGROUP_ROOT:-/sys/fs/cgroup}"
  CGROUP_ROOT=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$CGROUP_ROOT")
  case "$CGROUP_ROOT" in
    "$LAB_ROOT"/*|/sys/fs/cgroup) ;;
    *) die "fixture cgroup root must stay inside NEXUS_LAB_ROOT" ;;
  esac
  CURRENT_CONTAINER_ID="${NEXUS_V015_CURRENT_CONTAINER_ID:-}"
  [[ "$CURRENT_CONTAINER_ID" =~ ^[0-9a-f]{64}$ ]] \
    || die "fixture current container identity must be a 64-character hexadecimal id"
  CURRENT_CONTAINER_MATCH=exact
else
  [ -z "${NEXUS_V015_FIXTURE_CGROUP_ROOT:-}" ] \
    || die "fixture cgroup override is forbidden in release mode"
  CGROUP_ROOT=/sys/fs/cgroup
  [ -f /etc/hostname ] && [ ! -L /etc/hostname ] \
    || die "current container identity is unavailable"
  CURRENT_CONTAINER_ID=$(tr -d '\r\n' </etc/hostname)
  [[ "$CURRENT_CONTAINER_ID" =~ ^[0-9a-f]{12,64}$ ]] \
    || die "current container identity is invalid: $CURRENT_CONTAINER_ID"
  CURRENT_CONTAINER_MATCH=prefix
fi
if [ "${NEXUS_V015_ALLOW_FIXTURE_HOME:-}" != 1 ]; then
  case "$NEXUS_HOME" in
    /tmp/nexus-lens-home/*) ;;
    *) die "refusing non-lab NEXUS_HOME: $NEXUS_HOME" ;;
  esac
fi

case "$PORT" in
  ''|*[!0-9]*) die "--port must be an integer" ;;
esac
[ "$PORT" -ge 0 ] && [ "$PORT" -le 65535 ] || die "--port must be 0 or a TCP port"

for command in curl jq timeout python3 sha256sum stat readlink; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done
if [[ "$NEXUS_BIN" == */* ]]; then
  [ -x "$NEXUS_BIN" ] || die "Nexus CLI is not executable: $NEXUS_BIN"
  NEXUS_LAUNCHER=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$NEXUS_BIN")
else
  NEXUS_LAUNCHER=$(command -v "$NEXUS_BIN" 2>/dev/null || true)
  [ -n "$NEXUS_LAUNCHER" ] || die "Nexus CLI is unavailable: $NEXUS_BIN"
fi

if [ -n "$EVIDENCE_ROOT" ]; then
  RUN_ROOT=$EVIDENCE_ROOT
else
  [ -n "$RUN_ID" ] || die "--run-id or NEXUS_V015_RUN_ID is required without --evidence-root"
  RUN_ROOT="$EVIDENCE_DIR/$RUN_ID"
fi
MANIFEST="$RUN_ROOT/manifest.json"
[ -f "$MANIFEST" ] && [ ! -L "$MANIFEST" ] \
  || die "packed candidate manifest is missing or unsafe: $MANIFEST"

WORK=$(mktemp -d)
capture_validated_cleanup_targets() {
  local destination=$1
  python3 - \
    "${WEBCONSOLE_EXE:-}" "${WEBCONSOLE_ENTRYPOINT_SNAPSHOT:-}" \
    "${DISCOVERY:-}" "${NEXUS_V015_ALLOW_FIXTURE_HOME:-0}" \
    >"$destination" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

executable_raw, entrypoint_snapshot_raw, discovery_raw, fixture_raw = sys.argv[1:]
empty = {"schemaVersion": 1, "targets": [], "stopAllowed": False, "discovery": None}
if not executable_raw or not entrypoint_snapshot_raw or not discovery_raw:
    print(json.dumps(empty, sort_keys=True))
    raise SystemExit(0)
executable = os.path.realpath(executable_raw)
discovery = os.path.abspath(discovery_raw)
fixture = fixture_raw == "1"
try:
    expected_entrypoint = json.loads(
        Path(entrypoint_snapshot_raw).read_text(encoding="utf-8")
    )
except (OSError, UnicodeError, json.JSONDecodeError):
    print(json.dumps(empty, sort_keys=True))
    raise SystemExit(0)


def file_record(path):
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            return None, b""
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        raw = b"".join(chunks)
        return (
            {
                "device": info.st_dev,
                "inode": info.st_ino,
                "size": info.st_size,
                "sha256": hashlib.sha256(raw).hexdigest(),
            },
            raw,
        )
    finally:
        os.close(descriptor)


try:
    if file_record(executable)[0] != expected_entrypoint:
        print(json.dumps(empty, sort_keys=True))
        raise SystemExit(0)
except OSError:
    print(json.dumps(empty, sort_keys=True))
    raise SystemExit(0)


def process_matches(pid):
    try:
        argv = [
            raw.decode("utf-8", "surrogateescape")
            for raw in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            if raw
        ]
        process_executable = os.path.basename(os.path.realpath(f"/proc/{pid}/exe"))
        fields = (
            Path(f"/proc/{pid}/stat")
            .read_text(encoding="ascii")
            .rsplit(") ", 1)[1]
            .split()
        )
        start_ticks = int(fields[19])
    except (OSError, ValueError, IndexError):
        return None
    interpreter_allowed = process_executable in {"node", "nodejs"} or (
        fixture and (process_executable == "python" or process_executable.startswith("python3"))
    )
    if (
        len(argv) < 2
        or not interpreter_allowed
        or not os.path.isabs(argv[1])
        or os.path.realpath(argv[1]) != executable
    ):
        return None
    discovery_indexes = [
        index for index, value in enumerate(argv) if value == "--discovery"
    ]
    if len(discovery_indexes) != 1:
        return None
    index = discovery_indexes[0]
    if index + 1 >= len(argv) or os.path.abspath(argv[index + 1]) != discovery:
        return None
    return {
        "pid": pid,
        "startTicks": start_ticks,
        "argv": argv,
        "processExecutable": os.path.realpath(f"/proc/{pid}/exe"),
    }


targets = []
for entry in Path("/proc").iterdir():
    if not entry.name.isdigit() or int(entry.name) == os.getpid():
        continue
    matched = process_matches(int(entry.name))
    if matched is not None:
        targets.append(matched)
targets.sort(key=lambda row: row["pid"])
target_by_pid = {row["pid"]: row for row in targets}

discovery_record = None
stop_allowed = False
try:
    discovery_identity, raw = file_record(discovery)
    if discovery_identity is not None:
        value = json.loads(raw)
        pid = value.get("pid") if isinstance(value, dict) else None
        recorded = value.get("executable") if isinstance(value, dict) else None
        if (
            isinstance(pid, int)
            and pid in target_by_pid
            and isinstance(recorded, str)
            and os.path.realpath(recorded) == executable
        ):
            discovery_record = {
                **discovery_identity,
                "pid": pid,
                "executable": recorded,
            }
            stop_allowed = True
except (OSError, UnicodeError, json.JSONDecodeError):
    pass

# Cleanup authority is the one process selected by the pre-mutation discovery
# record. Other same-shaped candidate processes are never cleanup targets.
if stop_allowed and discovery_record is not None:
    targets = [target_by_pid[discovery_record["pid"]]]
else:
    targets = []

print(json.dumps({
    "schemaVersion": 1,
    "targets": targets,
    "stopAllowed": stop_allowed,
    "discovery": discovery_record,
}, sort_keys=True))
PY
}

cleanup_snapshot_stop_is_allowed() {
  local snapshot=$1
  python3 - \
    "$snapshot" "${WEBCONSOLE_ENTRYPOINT_SNAPSHOT:-}" \
    "${WEBCONSOLE_EXE:-}" "${DISCOVERY:-}" \
    "${NEXUS_V015_ALLOW_FIXTURE_HOME:-0}" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

snapshot_path, entrypoint_path, executable_raw, discovery, fixture_raw = sys.argv[1:]
fixture = fixture_raw == "1"
try:
    snapshot = json.loads(Path(snapshot_path).read_text(encoding="utf-8"))
    expected_entrypoint = json.loads(Path(entrypoint_path).read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError):
    raise SystemExit(1)
if not snapshot.get("stopAllowed") or not isinstance(snapshot.get("discovery"), dict):
    raise SystemExit(1)


def read_record(path):
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            return None, b""
        raw = b""
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            raw += chunk
        return (
            {
                "device": info.st_dev,
                "inode": info.st_ino,
                "size": info.st_size,
                "sha256": hashlib.sha256(raw).hexdigest(),
            },
            raw,
        )
    finally:
        os.close(descriptor)


try:
    if read_record(os.path.realpath(executable_raw))[0] != expected_entrypoint:
        raise SystemExit(1)
    current_discovery, discovery_raw = read_record(discovery)
except OSError:
    raise SystemExit(1)
expected_discovery = {
    key: snapshot["discovery"][key]
    for key in ("device", "inode", "size", "sha256")
}
if current_discovery != expected_discovery:
    raise SystemExit(1)
try:
    discovery_value = json.loads(discovery_raw)
except (UnicodeError, json.JSONDecodeError):
    raise SystemExit(1)
if (
    not isinstance(discovery_value, dict)
    or discovery_value.get("pid") != snapshot["discovery"]["pid"]
    or not isinstance(discovery_value.get("executable"), str)
    or os.path.realpath(discovery_value["executable"]) != os.path.realpath(executable_raw)
):
    raise SystemExit(1)
target = next(
    (row for row in snapshot.get("targets", []) if row.get("pid") == snapshot["discovery"]["pid"]),
    None,
)
if target is None:
    raise SystemExit(1)
try:
    pid = target["pid"]
    argv = [
        raw.decode("utf-8", "surrogateescape")
        for raw in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        if raw
    ]
    process_executable = os.path.realpath(f"/proc/{pid}/exe")
    fields = (
        Path(f"/proc/{pid}/stat")
        .read_text(encoding="ascii")
        .rsplit(") ", 1)[1]
        .split()
    )
    start_ticks = int(fields[19])
except (OSError, ValueError, IndexError):
    raise SystemExit(1)
indexes = [index for index, value in enumerate(argv) if value == "--discovery"]
if not (
    start_ticks == target["startTicks"]
    and process_executable == target["processExecutable"]
    and argv == target["argv"]
    and len(indexes) == 1
    and indexes[0] + 1 < len(argv)
    and os.path.abspath(argv[indexes[0] + 1]) == os.path.abspath(discovery)
):
    raise SystemExit(1)
raise SystemExit(0)
PY
}

cleanup_validated_snapshot() {
  local snapshot=$1
  python3 - \
    "$snapshot" "${WEBCONSOLE_ENTRYPOINT_SNAPSHOT:-}" \
    "${WEBCONSOLE_EXE:-}" "${DISCOVERY:-}" \
    "${NEXUS_V015_ALLOW_FIXTURE_HOME:-0}" <<'PY'
import hashlib
import json
import os
import signal
import stat
import sys
import time
from pathlib import Path

snapshot_path, entrypoint_path, executable_raw, discovery, fixture_raw = sys.argv[1:]
fixture = fixture_raw == "1"
try:
    snapshot = json.loads(Path(snapshot_path).read_text(encoding="utf-8"))
    expected_entrypoint = json.loads(Path(entrypoint_path).read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError):
    raise SystemExit(0)
executable = os.path.realpath(executable_raw)


def read_record(path):
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            return None, b""
        raw = b""
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            raw += chunk
        return (
            {
                "device": info.st_dev,
                "inode": info.st_ino,
                "size": info.st_size,
                "sha256": hashlib.sha256(raw).hexdigest(),
            },
            raw,
        )
    finally:
        os.close(descriptor)


record = snapshot.get("discovery")


def entrypoint_is_same():
    try:
        return read_record(executable)[0] == expected_entrypoint
    except OSError:
        return False


def process_is_same(target):
    pid = target["pid"]
    try:
        if not entrypoint_is_same():
            return False
        argv = [
            raw.decode("utf-8", "surrogateescape")
            for raw in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
            if raw
        ]
        process_executable = os.path.realpath(f"/proc/{pid}/exe")
        fields = (
            Path(f"/proc/{pid}/stat")
            .read_text(encoding="ascii")
            .rsplit(") ", 1)[1]
            .split()
        )
        start_ticks = int(fields[19])
    except (OSError, ValueError, IndexError):
        return False
    return (
        start_ticks == target["startTicks"]
        and process_executable == target["processExecutable"]
        and argv == target["argv"]
    )


for target in snapshot.get("targets", []):
    if not process_is_same(target):
        continue
    try:
        os.kill(target["pid"], signal.SIGTERM)
    except ProcessLookupError:
        continue
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline and process_is_same(target):
        time.sleep(0.05)
    if process_is_same(target):
        try:
            os.kill(target["pid"], signal.SIGKILL)
        except ProcessLookupError:
            pass

if isinstance(record, dict):
    try:
        current, current_raw = read_record(discovery)
        entrypoint_current = read_record(executable)[0]
    except OSError:
        current = None
        entrypoint_current = None
    expected = {key: record[key] for key in ("device", "inode", "size", "sha256")}
    if current == expected and entrypoint_current == expected_entrypoint:
        try:
            value = json.loads(current_raw)
        except (OSError, UnicodeError, json.JSONDecodeError):
            value = None
        pid = value.get("pid") if isinstance(value, dict) else None
        recorded = value.get("executable") if isinstance(value, dict) else None
        if (
            pid == record["pid"]
            and isinstance(recorded, str)
            and os.path.realpath(recorded) == executable
            and not any(process_is_same(target) for target in snapshot.get("targets", []))
        ):
            os.unlink(discovery)
PY
}

invalidate_owned_result_seal() {
  [ "$RESULT_SEAL_OWNED" -eq 1 ] || return 0
  [ -n "$RESULT_SEAL" ] && [ -n "$RESULT_SEAL_SNAPSHOT" ] || return 1
  python3 - \
    "$RESULT_SEAL" "$RESULT_SEAL_SNAPSHOT" \
    "${NEXUS_V015_FIXTURE_FAIL_SEAL_UNLINK:-0}" \
    "${NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_RENAME:-0}" \
    "${NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_OPEN:-0}" \
    "${NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_CHMOD:-0}" \
    "${NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_FSYNC:-0}" \
    "${NEXUS_V015_FIXTURE_FAIL_SEAL_QUARANTINE_PARENT_FSYNC:-0}" \
    "${NEXUS_V015_FIXTURE_KILL_AFTER_SEAL_QUARANTINE_RENAME:-0}" \
    "${NEXUS_V015_FIXTURE_KILL_AFTER_SEAL_QUARANTINE_CHMOD:-0}" \
    "${NEXUS_V015_FIXTURE_SWAP_SEAL_BEFORE_INVALIDATE:-}" <<'PY'
import hashlib
import json
import os
import secrets
import signal
import stat
import sys
from pathlib import Path

path = Path(sys.argv[1])
snapshot = json.loads(Path(sys.argv[2]).read_text(encoding="utf-8"))
fail_unlink = sys.argv[3] == "1"
fail_quarantine_rename = sys.argv[4] == "1"
fail_quarantine_open = sys.argv[5] == "1"
fail_quarantine_chmod = sys.argv[6] == "1"
fail_quarantine_fsync = sys.argv[7] == "1"
fail_quarantine_parent_fsync = sys.argv[8] == "1"
kill_after_quarantine_rename = sys.argv[9] == "1"
kill_after_quarantine_chmod = sys.argv[10] == "1"
swap_before_invalidate = sys.argv[11]
flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
try:
    descriptor = os.open(path, flags)
except FileNotFoundError:
    raise SystemExit(0)
try:
    info = os.fstat(descriptor)
    chunks = []
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        chunks.append(chunk)
    raw = b"".join(chunks)
    observed = {
        "device": info.st_dev,
        "inode": info.st_ino,
        "size": info.st_size,
        "sha256": hashlib.sha256(raw).hexdigest(),
    }
    expected = {key: snapshot[key] for key in observed}
    if (
        observed != expected
        or not stat.S_ISREG(info.st_mode)
        or info.st_nlink != 1
    ):
        raise SystemExit("refusing to invalidate a replacement D2 result seal")

    directory_flags = (
        os.O_RDONLY
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    directory = os.open(path.parent, directory_flags)
    try:
        if swap_before_invalidate:
            os.replace(swap_before_invalidate, path)

        quarantine_name = f".{path.name}.invalid-{os.getpid()}-{secrets.token_hex(6)}"
        try:
            if fail_quarantine_rename:
                raise OSError("fixture forced D2 seal quarantine rename failure")
            os.replace(
                path.name,
                quarantine_name,
                src_dir_fd=directory,
                dst_dir_fd=directory,
            )
        except OSError:
            # The exact owned descriptor remains authoritative if the atomic
            # rename cannot remove its canonical name. Invalidate that inode
            # through the retained descriptor before propagating the failure.
            try:
                visible = os.stat(path.name, dir_fd=directory, follow_symlinks=False)
            except FileNotFoundError:
                visible = None
            if (
                visible is not None
                and visible.st_dev == expected["device"]
                and visible.st_ino == expected["inode"]
            ):
                os.fchmod(descriptor, 0)
                os.fsync(descriptor)
                os.fsync(directory)
            raise

        # Canonical-name removal is the first durable invalidation boundary.
        # Every later injected failure (including SIGKILL) therefore leaves the
        # standalone verifier unable to observe a valid canonical seal.
        os.fsync(directory)
        if kill_after_quarantine_rename:
            os.kill(os.getpid(), signal.SIGKILL)
        if fail_unlink:
            raise OSError("fixture forced owned seal unlink failure")
        if fail_quarantine_open:
            raise OSError("fixture forced D2 seal quarantine open failure")
        quarantine = os.open(quarantine_name, flags, dir_fd=directory)
        try:
            current = os.fstat(quarantine)
            current_raw = b""
            while True:
                chunk = os.read(quarantine, 1024 * 1024)
                if not chunk:
                    break
                current_raw += chunk
            current_record = {
                "device": current.st_dev,
                "inode": current.st_ino,
                "size": current.st_size,
                "sha256": hashlib.sha256(current_raw).hexdigest(),
            }
            if current_record != expected or not stat.S_ISREG(current.st_mode):
                # The canonical pathname was replaced after the owned descriptor
                # was captured. Restore that replacement to its canonical name;
                # never mutate or unlink it as though it were ours.
                try:
                    os.stat(path.name, dir_fd=directory, follow_symlinks=False)
                except FileNotFoundError:
                    os.rename(
                        quarantine_name,
                        path.name,
                        src_dir_fd=directory,
                        dst_dir_fd=directory,
                    )
                    os.fsync(directory)
                raise SystemExit("refusing to invalidate a replacement D2 result seal")
            if fail_quarantine_chmod:
                raise OSError("fixture forced D2 seal quarantine chmod failure")
            os.fchmod(quarantine, 0)
            if kill_after_quarantine_chmod:
                os.kill(os.getpid(), signal.SIGKILL)
            if fail_quarantine_fsync:
                raise OSError("fixture forced D2 seal quarantine fsync failure")
            os.fsync(quarantine)
        finally:
            os.close(quarantine)
        if fail_quarantine_parent_fsync:
            raise OSError("fixture forced D2 seal quarantine parent fsync failure")
        os.fsync(directory)
    finally:
        os.close(directory)
finally:
    os.close(descriptor)
PY
}

cleanup() {
  if [ -n "$FOREIGN_PID" ]; then
    kill "$FOREIGN_PID" 2>/dev/null || true
    wait "$FOREIGN_PID" 2>/dev/null || true
  fi
  if [ "$SUCCESS" -ne 1 ] \
    && [ "$PACKED_CLI_VALIDATED" -eq 1 ] \
    && [ "$LIFECYCLE_TOUCHED" -eq 1 ]; then
    if [ -z "$CLEANUP_TARGET_SNAPSHOT" ] || [ ! -s "$CLEANUP_TARGET_SNAPSHOT" ]; then
      CLEANUP_TARGET_SNAPSHOT="$WORK/cleanup-targets.snapshot"
      capture_validated_cleanup_targets "$CLEANUP_TARGET_SNAPSHOT" 2>/dev/null || true
    fi
    if [ -s "$CLEANUP_TARGET_SNAPSHOT" ] \
      && cleanup_snapshot_stop_is_allowed "$CLEANUP_TARGET_SNAPSHOT" 2>/dev/null; then
      "$NEXUS_BIN" webconsole stop --force >/dev/null 2>&1 || true
    fi
    if [ -s "$CLEANUP_TARGET_SNAPSHOT" ]; then
      cleanup_validated_snapshot "$CLEANUP_TARGET_SNAPSHOT" 2>/dev/null || true
    fi
  fi
  if [ "$SUCCESS" -ne 1 ] && [ "$RESULT_SEAL_OWNED" -eq 1 ]; then
    invalidate_owned_result_seal || {
      echo "error: could not durably invalidate the owned D2 result seal" >&2
    }
  fi
  rm -rf "$WORK"
}
trap cleanup EXIT

python3 - "$MANIFEST" "$RUN_ROOT" >"$WORK/candidate.snapshot" <<'PY'
import hashlib
import json
import os
import re
import sys
from pathlib import Path

manifest_path = Path(sys.argv[1])
root = Path(sys.argv[2]).resolve()
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    raise SystemExit(f"invalid packed candidate manifest: {error}")

required = {
    "schemaVersion", "runId", "mode", "sources", "native", "packages",
    "image", "container", "toolchains", "environment",
}
if set(manifest) != required or manifest.get("schemaVersion") != 1:
    raise SystemExit("packed candidate manifest does not use the v0.1.5 schema")
if not isinstance(manifest.get("runId"), str) or not manifest["runId"].strip():
    raise SystemExit("packed candidate manifest runId is invalid")
if manifest.get("mode") != "packed":
    raise SystemExit("Webconsole acceptance requires a packed candidate manifest")
if set(manifest.get("sources", {})) != {"nexus"}:
    raise SystemExit("packed candidate source ledger must contain only Nexus")
if manifest.get("container", {}).get("limits") != {
    "cpus": 6, "memoryBytes": 8589934592, "pids": 1024,
}:
    raise SystemExit("packed candidate does not use the 6 CPU / 8 GiB / 1024 PID lab contract")
if not re.fullmatch(r"sha256:[0-9a-f]{64}", str(manifest.get("image", {}).get("digest", ""))):
    raise SystemExit("packed candidate image digest is invalid")


def checked_artifact(record, label):
    if not isinstance(record, dict) or set(record) != {"path", "sha256"}:
        raise SystemExit(f"{label} artifact record is invalid")
    relative = Path(str(record["path"]))
    if relative.is_absolute() or ".." in relative.parts:
        raise SystemExit(f"{label} artifact escapes the run root")
    path = root / relative
    if path.is_symlink() or not path.is_file():
        raise SystemExit(f"{label} artifact is missing or unsafe")
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != record["sha256"]:
        raise SystemExit(f"{label} artifact hash mismatch")


checked_artifact(manifest.get("native"), "native")
names = ("@egregore/nexus", "@egregore/nexus-cli", "@egregore/nexus-gateway")
packages = manifest.get("packages")
if not isinstance(packages, list) or tuple(
    row.get("name") if isinstance(row, dict) else None for row in packages
) != names:
    raise SystemExit("packed candidate package ledger is invalid")
for row in packages:
    if row.get("version") != "0.1.5":
        raise SystemExit(f"packed candidate package {row.get('name')} is not 0.1.5")
    checked_artifact(row.get("tarball"), f"package {row['name']}")
toolchains = manifest.get("toolchains")
if not isinstance(toolchains, dict) or "0.1.5" not in str(toolchains.get("nexus", "")):
    raise SystemExit("packed candidate toolchain does not identify Nexus 0.1.5")
if not isinstance(manifest.get("environment"), dict):
    raise SystemExit("packed candidate environment ledger is invalid")

ledger = {
    "mode": manifest["mode"],
    "sources": manifest["sources"],
    "nativeSha256": manifest["native"]["sha256"],
    "packages": [{
        "name": row["name"],
        "version": row["version"],
        "tarballSha256": row["tarball"]["sha256"],
    } for row in packages],
    "imageDigest": manifest["image"]["digest"],
    "limits": manifest["container"]["limits"],
    "toolchains": toolchains,
    "environment": manifest["environment"],
}
body = json.dumps(
    ledger,
    sort_keys=True,
    separators=(",", ":"),
    ensure_ascii=False,
    allow_nan=False,
).encode("utf-8")
print(json.dumps({
    "runId": manifest["runId"],
    "candidateDigest": "sha256:" + hashlib.sha256(body).hexdigest(),
    "imageDigest": manifest["image"]["digest"],
}))
PY

MANIFEST_RUN_ID=$(jq -er '.runId' "$WORK/candidate.snapshot")
CANDIDATE_DIGEST=$(jq -er '.candidateDigest' "$WORK/candidate.snapshot")
IMAGE_DIGEST=$(jq -er '.imageDigest' "$WORK/candidate.snapshot")
[ -n "$AMBIENT_RUN_ID" ] || die "current lab run id is unavailable"
[ "$AMBIENT_RUN_ID" = "$MANIFEST_RUN_ID" ] \
  || die "current lab run id $AMBIENT_RUN_ID does not match packed manifest run id $MANIFEST_RUN_ID"
if [ -n "$RUN_ID" ] && [ "$RUN_ID" != "$MANIFEST_RUN_ID" ]; then
  die "run id $RUN_ID does not match packed manifest run id $MANIFEST_RUN_ID"
fi
RUN_ID=$MANIFEST_RUN_ID

if [ -z "$PACKED_PREFIX" ]; then
  candidate=$NEXUS_LAUNCHER
  for _ in 1 2 3 4; do
    if [ "$(basename "$candidate")" = nexus ] \
      && [ "$(basename "$(dirname "$candidate")")" = bin ] \
      && [ -f "$(dirname "$(dirname "$candidate")")/lib/node_modules/@egregore/nexus/package.json" ]; then
      PACKED_PREFIX=$(dirname "$(dirname "$candidate")")
      break
    fi
    [ -L "$candidate" ] || break
    target=$(readlink "$candidate")
    case "$target" in
      /*) candidate=$target ;;
      *) candidate=$(python3 -c 'import os,sys; print(os.path.abspath(os.path.join(os.path.dirname(sys.argv[1]), sys.argv[2])))' "$candidate" "$target") ;;
    esac
  done
fi
[ -n "$PACKED_PREFIX" ] || die "cannot derive the umbrella-only packed prefix from $NEXUS_LAUNCHER"
PACKED_PREFIX=$(python3 -c 'import os,sys; print(os.path.abspath(sys.argv[1]))' "$PACKED_PREFIX")

packed_install_tree_digest() {
  python3 - "$1" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path, PurePosixPath

root = Path(os.path.abspath(sys.argv[1]))
try:
    root_info = os.lstat(root)
except OSError as error:
    raise SystemExit(f"packed install root is unavailable: {error}")
if not stat.S_ISDIR(root_info.st_mode) or stat.S_ISLNK(root_info.st_mode):
    raise SystemExit("packed install root is not a real directory")

inventory = {}


def inside(path, parent):
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def read_regular(path, expected, label):
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = -1
    try:
        descriptor = os.open(path, flags)
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
            raise SystemExit(f"packed install entry is not a single regular file: {label}")
        if (before.st_dev, before.st_ino) != (expected.st_dev, expected.st_ino):
            raise SystemExit(f"packed install entry changed before read: {label}")
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(descriptor)
    except OSError as error:
        raise SystemExit(f"cannot read packed install entry {label}: {error}") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
    if (
        before.st_dev,
        before.st_ino,
        before.st_size,
        before.st_mtime_ns,
        before.st_ctime_ns,
    ) != (
        after.st_dev,
        after.st_ino,
        after.st_size,
        after.st_mtime_ns,
        after.st_ctime_ns,
    ):
        raise SystemExit(f"packed install entry changed while read: {label}")
    return b"".join(chunks)


def visit(directory, relative):
    try:
        entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
    except OSError as error:
        raise SystemExit(f"cannot inspect packed install closure: {error}") from error
    for entry in entries:
        child_relative = relative / entry.name
        key = child_relative.as_posix()
        try:
            info = entry.stat(follow_symlinks=False)
        except OSError as error:
            raise SystemExit(f"cannot inspect packed install entry {key}: {error}") from error
        if stat.S_ISLNK(info.st_mode):
            try:
                target = os.readlink(entry.path)
                resolved = Path(os.path.realpath(Path(entry.path).parent / target))
            except OSError as error:
                raise SystemExit(f"cannot read packed install symlink {key}: {error}") from error
            if not inside(resolved, root):
                raise SystemExit(f"packed install symlink escapes prefix: {key}")
            inventory[key] = {
                "kind": "symlink",
                "target": target,
                "mode": stat.S_IMODE(info.st_mode),
            }
        elif stat.S_ISDIR(info.st_mode):
            inventory[key] = {"kind": "directory", "mode": stat.S_IMODE(info.st_mode)}
            visit(Path(entry.path), child_relative)
        elif stat.S_ISREG(info.st_mode):
            raw = read_regular(entry.path, info, key)
            inventory[key] = {
                "kind": "file",
                "sha256": hashlib.sha256(raw).hexdigest(),
                "size": len(raw),
                "mode": stat.S_IMODE(info.st_mode),
            }
        else:
            raise SystemExit(f"packed install has unsupported entry: {key}")


visit(root, PurePosixPath())
if not inventory:
    raise SystemExit("packed install inventory is empty")
body = json.dumps(
    inventory,
    sort_keys=True,
    separators=(",", ":"),
    ensure_ascii=False,
    allow_nan=False,
).encode("utf-8")
print(hashlib.sha256(body).hexdigest())
PY
}

OBSERVED_INSTALL_TREE_SHA256=$(packed_install_tree_digest "$PACKED_PREFIX") \
  || die "cannot inventory the packed install dependency closure"

PACKED_GATEWAY_BIN="${NEXUS_GATEWAY_BIN:-$PACKED_PREFIX/bin/nexus-gateway}"
PACKED_WEBUI_BIN="${NEXUS_WEBUI_BIN:-$PACKED_PREFIX/bin/nexus-webui}"
python3 - \
  "$PACKED_PREFIX" "$NEXUS_LAUNCHER" "$PACKED_GATEWAY_BIN" "$PACKED_WEBUI_BIN" \
  "$MANIFEST" "$RUN_ROOT" "$CURRENT_READINESS_PATH" \
  "$CURRENT_CONTAINER_ID" "$CURRENT_CONTAINER_MATCH" "$OBSERVED_INSTALL_TREE_SHA256" \
  >"$WORK/packed-topology.snapshot" <<'PY'
import hashlib
import json
import os
import stat
import sys
import tarfile
from pathlib import Path, PurePosixPath


def fail(message):
    raise SystemExit(f"umbrella-only packed prefix: {message}")


prefix = Path(sys.argv[1])
nexus_launcher = Path(sys.argv[2])
gateway_launcher = Path(sys.argv[3])
webui_launcher = Path(sys.argv[4])
manifest_path = Path(sys.argv[5])
run_root = Path(sys.argv[6]).resolve()
current_readiness_path = Path(os.path.abspath(sys.argv[7]))
current_container_id = sys.argv[8]
current_container_match = sys.argv[9]
observed_install_tree_sha256 = sys.argv[10]
modules = prefix / "lib" / "node_modules"
scope = modules / "@egregore"
umbrella = scope / "nexus"
if not prefix.is_dir() or not umbrella.is_dir():
    fail("@egregore/nexus is missing")
top_level = sorted(path.name for path in modules.iterdir() if path.is_dir())
scope_level = sorted(path.name for path in scope.iterdir() if path.is_dir())
if top_level != ["@egregore"] or scope_level != ["nexus"]:
    fail(f"expected only @egregore/nexus at top level, got {top_level}/{scope_level}")

try:
    package = json.loads((umbrella / "package.json").read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    fail(f"invalid umbrella package metadata: {error}")
expected_bin = {
    "nexus": "bin/nexus.mjs",
    "nexus-gateway": "bin/nexus-gateway.mjs",
    "nexus-webui": "bin/nexus-webui.mjs",
}
expected_dependencies = {
    "@egregore/nexus-cli": "0.1.5",
    "@egregore/nexus-gateway": "0.1.5",
}
if package.get("name") != "@egregore/nexus" or package.get("version") != "0.1.5":
    fail("umbrella package identity/version is wrong")
if package.get("bin") != expected_bin or package.get("dependencies") != expected_dependencies:
    fail("umbrella bin or dependency contract is wrong")

dependencies = {}
for name in ("nexus-cli", "nexus-gateway"):
    path = umbrella / "node_modules" / "@egregore" / name / "package.json"
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        fail(f"invalid nested dependency {name}: {error}")
    expected_name = f"@egregore/{name}"
    if value.get("name") != expected_name or value.get("version") != "0.1.5":
        fail(f"nested dependency {name} does not match candidate version")
    dependencies[expected_name] = value["version"]

nested_cli = umbrella / "node_modules" / "@egregore" / "nexus-cli"
nested_gateway = umbrella / "node_modules" / "@egregore" / "nexus-gateway"

expected_launchers = {
    "nexus": umbrella / "bin" / "nexus.mjs",
    "nexusGateway": umbrella / "bin" / "nexus-gateway.mjs",
    "nexusWebui": umbrella / "bin" / "nexus-webui.mjs",
}
provided = {
    "nexus": nexus_launcher,
    "nexusGateway": gateway_launcher,
    "nexusWebui": webui_launcher,
}
resolved = {}
for name, expected in expected_launchers.items():
    prefix_link = prefix / "bin" / ({
        "nexus": "nexus",
        "nexusGateway": "nexus-gateway",
        "nexusWebui": "nexus-webui",
    }[name])
    try:
        expected_resolved = expected.resolve(strict=True)
        prefix_resolved = prefix_link.resolve(strict=True)
        provided_resolved = provided[name].resolve(strict=True)
    except OSError as error:
        fail(f"{name} launcher is missing: {error}")
    if prefix_resolved != expected_resolved or provided_resolved != expected_resolved:
        fail(f"{name} launcher does not resolve through @egregore/nexus")
    resolved[name] = str(expected_resolved)


def sha256_file(path, label):
    try:
        if path.is_symlink() or not path.is_file():
            fail(f"{label} is missing or unsafe")
        return hashlib.sha256(path.read_bytes()).hexdigest()
    except OSError as error:
        fail(f"cannot read {label}: {error}")


def manifest_artifact(record, label):
    if not isinstance(record, dict) or set(record) != {"path", "sha256"}:
        fail(f"{label} manifest artifact is invalid")
    relative = Path(str(record["path"]))
    if relative.is_absolute() or ".." in relative.parts:
        fail(f"{label} manifest artifact escapes the evidence root")
    path = run_root / relative
    actual = sha256_file(path, label)
    if actual != record["sha256"]:
        fail(f"{label} manifest artifact changed")
    return path


def safe_link_target(relative, target, label):
    target_path = PurePosixPath(target)
    if target_path.is_absolute():
        fail(f"{label} symlink target is absolute")
    parts = list(relative.parent.parts)
    for component in target_path.parts:
        if component in {"", "."}:
            continue
        if component == "..":
            if not parts:
                fail(f"{label} symlink target escapes its package")
            parts.pop()
        else:
            parts.append(component)


def tar_package_inventory(tarball, label):
    inventory = {}
    try:
        with tarfile.open(tarball, "r:gz") as archive:
            for member in archive.getmembers():
                path = PurePosixPath(member.name)
                if path.is_absolute() or ".." in path.parts or not path.parts:
                    fail(f"{label} tarball contains an unsafe path")
                if path.parts[0] != "package":
                    fail(f"{label} tarball contains a file outside package/")
                relative = PurePosixPath(*path.parts[1:])
                if not relative.parts or member.isdir():
                    continue
                key = relative.as_posix()
                if key in inventory:
                    fail(f"{label} tarball contains duplicate runtime entry: {key}")
                if member.isfile():
                    stream = archive.extractfile(member)
                    if stream is None:
                        fail(f"{label} tarball entry cannot be read: {key}")
                    inventory[key] = {
                        "kind": "file",
                        "sha256": hashlib.sha256(stream.read()).hexdigest(),
                        "executable": bool(member.mode & 0o111),
                    }
                elif member.issym():
                    safe_link_target(relative, member.linkname, f"{label}:{key}")
                    inventory[key] = {"kind": "symlink", "target": member.linkname}
                else:
                    fail(f"{label} tarball contains unsupported runtime entry: {key}")
    except (OSError, tarfile.TarError) as error:
        fail(f"cannot inspect {label} tarball: {error}")
    return inventory


def installed_package_inventory(root, label):
    inventory = {}

    def visit(directory, relative):
        try:
            entries = sorted(os.scandir(directory), key=lambda entry: entry.name)
        except OSError as error:
            fail(f"cannot inspect installed {label}: {error}")
        for entry in entries:
            child_relative = relative / entry.name
            if not relative.parts and entry.name == "node_modules":
                if entry.is_symlink():
                    fail(f"installed {label} node_modules is a symlink")
                continue
            key = child_relative.as_posix()
            try:
                info = entry.stat(follow_symlinks=False)
            except OSError as error:
                fail(f"cannot stat installed {label}:{key}: {error}")
            if stat.S_ISLNK(info.st_mode):
                try:
                    target = os.readlink(entry.path)
                except OSError as error:
                    fail(f"cannot read installed {label}:{key} symlink: {error}")
                safe_link_target(child_relative, target, f"installed {label}:{key}")
                inventory[key] = {"kind": "symlink", "target": target}
            elif stat.S_ISREG(info.st_mode):
                try:
                    raw = Path(entry.path).read_bytes()
                except OSError as error:
                    fail(f"cannot read installed {label}:{key}: {error}")
                inventory[key] = {
                    "kind": "file",
                    "sha256": hashlib.sha256(raw).hexdigest(),
                    "executable": bool(info.st_mode & 0o111),
                }
            elif stat.S_ISDIR(info.st_mode):
                visit(Path(entry.path), child_relative)
            else:
                fail(f"installed {label} has unsupported runtime entry: {key}")

    if root.is_symlink() or not root.is_dir():
        fail(f"installed {label} root is missing or unsafe")
    visit(root, PurePosixPath())
    return inventory


try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except (OSError, UnicodeError, json.JSONDecodeError) as error:
    fail(f"cannot read candidate manifest bindings: {error}")
environment = manifest.get("environment")
if not isinstance(environment, dict):
    fail("candidate manifest environment is invalid")
container_id = str(environment.get("NEXUS_V015_CONTAINER_ID", ""))
if len(container_id) != 64 or any(character not in "0123456789abcdef" for character in container_id):
    fail("candidate manifest container identity is invalid")
if (
    (current_container_match == "exact" and container_id != current_container_id)
    or (current_container_match == "prefix" and not container_id.startswith(current_container_id))
):
    fail("candidate manifest does not match the current container identity")
if environment.get("NEXUS_V015_RUN_ID") != manifest.get("runId"):
    fail("candidate manifest run binding is invalid")

gateway_module = nested_gateway / "dist-gateway" / "headless.mjs"
nested_webui = nested_gateway / "webconsole" / "bin" / "nexus-webui.mjs"
native_path = Path(str(environment.get("NEXUS_V015_NATIVE_BIN", "")))
try:
    native_relative = native_path.resolve(strict=True).relative_to(nested_cli.resolve(strict=True))
except (OSError, ValueError) as error:
    fail(f"candidate native binary is not inside the installed CLI package: {error}")

installed_hashes = {
    "nexus": sha256_file(expected_launchers["nexus"], "installed umbrella Nexus launcher"),
    "nexusGateway": sha256_file(expected_launchers["nexusGateway"], "installed umbrella Gateway launcher"),
    "nexusWebui": sha256_file(expected_launchers["nexusWebui"], "installed umbrella WebUI launcher"),
    "cliLauncher": sha256_file(nested_cli / "bin" / "nexus.mjs", "installed CLI launcher"),
    "gatewayModule": sha256_file(gateway_module, "installed Gateway module"),
    "gatewayWebui": sha256_file(nested_webui, "installed Gateway WebUI launcher"),
    "native": sha256_file(native_path, "installed native Nexus binary"),
}

install_nonce = prefix.name.removeprefix("nexus-lab-install.")
if (
    install_nonce == prefix.name
    or not install_nonce
    or not install_nonce.isalnum()
):
    fail("packed prefix does not contain a valid install nonce")

binding_contract = {
    "NEXUS_V015_PACKED_PREFIX": str(prefix),
    "NEXUS_V015_NEXUS_BIN_RESOLVED": resolved["nexus"],
    "NEXUS_V015_NEXUS_BIN_SHA256": installed_hashes["nexus"],
    "NEXUS_V015_GATEWAY_BIN_RESOLVED": resolved["nexusGateway"],
    "NEXUS_V015_GATEWAY_BIN_SHA256": installed_hashes["nexusGateway"],
    "NEXUS_V015_WEBUI_BIN_RESOLVED": resolved["nexusWebui"],
    "NEXUS_V015_WEBUI_BIN_SHA256": installed_hashes["nexusWebui"],
    "NEXUS_V015_GATEWAY_MODULE": str(gateway_module),
    "NEXUS_V015_GATEWAY_MODULE_SHA256": installed_hashes["gatewayModule"],
    "NEXUS_V015_NATIVE_BIN": str(native_path),
    "NEXUS_V015_NATIVE_BIN_SHA256": installed_hashes["native"],
    "NEXUS_V015_CONTAINER_ID": container_id,
    "NEXUS_V015_INSTALL_NONCE": install_nonce,
}
for key, expected in binding_contract.items():
    if environment.get(key) != expected:
        fail(f"candidate manifest binding {key} does not match the installed prefix")
for key, expected_path in {
    "NEXUS_V015_NEXUS_BIN": expected_launchers["nexus"],
    "NEXUS_V015_GATEWAY_BIN": expected_launchers["nexusGateway"],
    "NEXUS_V015_WEBUI_BIN": expected_launchers["nexusWebui"],
}.items():
    raw = Path(str(environment.get(key, "")))
    try:
        if raw.resolve(strict=True) != expected_path.resolve(strict=True):
            fail(f"candidate manifest binding {key} resolves outside the installed umbrella")
    except OSError as error:
        fail(f"candidate manifest binding {key} is unavailable: {error}")

packages = {
    row.get("name"): row
    for row in manifest.get("packages", [])
    if isinstance(row, dict)
}
if set(packages) != {"@egregore/nexus", "@egregore/nexus-cli", "@egregore/nexus-gateway"}:
    fail("candidate package artifacts are incomplete")
tarballs = {
    name: manifest_artifact(row.get("tarball"), f"{name} tarball")
    for name, row in packages.items()
}
installed_package_roots = {
    "@egregore/nexus": umbrella,
    "@egregore/nexus-cli": nested_cli,
    "@egregore/nexus-gateway": nested_gateway,
}
package_inventories = {}
for package_name, installed_root in installed_package_roots.items():
    packed_inventory = tar_package_inventory(tarballs[package_name], package_name)
    installed_inventory = installed_package_inventory(installed_root, package_name)
    if installed_inventory != packed_inventory:
        missing = sorted(set(packed_inventory) - set(installed_inventory))
        extra = sorted(set(installed_inventory) - set(packed_inventory))
        changed = sorted(
            key for key in set(installed_inventory) & set(packed_inventory)
            if installed_inventory[key] != packed_inventory[key]
        )
        fail(
            "installed package inventory differs from candidate tarball: "
            f"{package_name}; missing={missing}; extra={extra}; changed={changed}"
        )
    encoded = json.dumps(
        packed_inventory,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode("utf-8")
    package_inventories[package_name] = {
        "entryCount": len(packed_inventory),
        "sha256": hashlib.sha256(encoded).hexdigest(),
    }

native_artifact = manifest_artifact(manifest.get("native"), "native binary")
if sha256_file(native_artifact, "native candidate artifact") != installed_hashes["native"]:
    fail("installed native binary differs from the candidate artifact")

readiness_path = Path(os.path.abspath(str(environment.get("NEXUS_V015_READINESS_LEDGER", ""))))
if readiness_path != current_readiness_path:
    fail("candidate manifest does not name the current lab readiness ledger")


def read_single_regular(path, label):
    cursor = Path(path.anchor)
    for component in path.parts[1:-1]:
        cursor /= component
        try:
            ancestor = os.lstat(cursor)
        except OSError as error:
            fail(f"cannot inspect {label} ancestry: {error}")
        if stat.S_ISLNK(ancestor.st_mode) or not stat.S_ISDIR(ancestor.st_mode):
            fail(f"{label} ancestry is unsafe: {cursor}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(f"cannot open {label}: {error}")
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
            fail(f"{label} must be a single regular file")
        chunks = []
        while True:
            chunk = os.read(descriptor, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        return info, b"".join(chunks)
    finally:
        os.close(descriptor)


try:
    readiness_info, readiness_raw = read_single_regular(
        readiness_path,
        "candidate readiness ledger",
    )
except OSError as error:
    fail(f"cannot read candidate readiness ledger: {error}")
readiness_sha = hashlib.sha256(readiness_raw).hexdigest()
