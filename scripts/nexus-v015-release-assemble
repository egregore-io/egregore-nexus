#!/usr/bin/env python3
"""Assemble cross-producer v0.1.5 release evidence without inventing PASS data."""

from __future__ import annotations

import argparse
import ctypes
import errno
import hashlib
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


VERSION = "0.1.5"
SHA256 = re.compile(r"[0-9a-f]{64}")
SAFE_RUN_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}")
HOST_FILES = (
    "daemon.pid",
    "daemon-ipc-endpoint.json",
    "gateway.json",
    "webconsole.json",
    "nexus.db",
    "nexus.db-wal",
    "nexus.db-shm",
    "gateway.db",
    "gateway.db-wal",
    "gateway.db-shm",
)
LIVE_PLUGIN_SURFACES = (
    ("LP1", "health-auth"),
    ("LP2", "hydration"),
    ("LP3", "thread-create"),
    ("LP4", "thread-post"),
    ("LP5", "thread-reply"),
    ("LP6", "thread-agent-reply"),
    ("LP7", "dm-two-way"),
    ("LP8", "session-prompt-stream"),
    ("LP9", "queued-send"),
    ("LP10", "steer"),
    ("LP11", "interrupt-cancel"),
    ("LP12", "compact"),
    ("LP13", "reload-hydration"),
    ("LP14", "gateway-reconnect"),
    ("LP15", "daemon-reconnect"),
    ("LP16", "typed-failures"),
)
HUMAN_PLUGIN_MUTATIONS = {
    "thread-create",
    "thread-post",
    "thread-reply",
    "dm-two-way",
    "session-prompt-stream",
    "queued-send",
    "steer",
    "interrupt-cancel",
    "compact",
}
COMMAND_RECEIPT_SURFACES = {
    "session-prompt-stream",
    "queued-send",
    "steer",
    "interrupt-cancel",
    "compact",
}
MESSAGE_HISTORY_SURFACES = {"thread-post", "thread-reply", "dm-two-way"}


class AssemblyError(RuntimeError):
    """Cross-producer evidence is absent, stale, or contradictory."""


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ValueError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def reject_nonfinite(value: str) -> None:
    raise ValueError(f"non-finite JSON constant: {value}")


def canonical(value: object) -> bytes:
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        allow_nan=False,
    ).encode("utf-8")


def pretty(value: object) -> bytes:
    return (
        json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False, allow_nan=False) + "\n"
    ).encode("utf-8")


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def read_regular(path: Path, label: str) -> bytes:
    try:
        before_visible = path.lstat()
    except OSError as error:
        raise AssemblyError(f"cannot inspect {label} {path}: {error}") from error
    if stat.S_ISLNK(before_visible.st_mode) or not stat.S_ISREG(before_visible.st_mode):
        raise AssemblyError(f"{label} must be a regular non-symlink file: {path}")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise AssemblyError(f"cannot open {label} {path}: {error}") from error
    try:
        opened = os.fstat(descriptor)
        identity = lambda row: (
            row.st_dev,
            row.st_ino,
            row.st_mode,
            row.st_uid,
            row.st_gid,
            row.st_nlink,
            row.st_size,
            row.st_mtime_ns,
            row.st_ctime_ns,
        )
        if identity(opened) != identity(before_visible) or opened.st_nlink != 1:
            raise AssemblyError(f"{label} changed before it was opened: {path}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(descriptor, 64 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        after = os.fstat(descriptor)
        after_visible = path.lstat()
        if identity(opened) != identity(after) or identity(after) != identity(after_visible):
            raise AssemblyError(f"{label} changed while it was read: {path}")
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def read_json(path: Path, label: str) -> dict[str, Any]:
    raw = read_regular(path, label)
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_nonfinite,
        )
    except (UnicodeError, ValueError, json.JSONDecodeError) as error:
        raise AssemblyError(f"invalid {label} {path}: {error}") from error
    if not isinstance(value, dict):
        raise AssemblyError(f"{label} must be a JSON object: {path}")
    return value


def parse_json_bytes(raw: bytes, label: str) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_nonfinite,
        )
    except (UnicodeError, ValueError, json.JSONDecodeError) as error:
        raise AssemblyError(f"invalid {label}: {error}") from error
    if not isinstance(value, dict):
        raise AssemblyError(f"{label} must be a JSON object")
    return value


def candidate_digest(manifest: dict[str, Any]) -> str:
    try:
        ledger = {
            "mode": manifest["mode"],
            "sources": manifest["sources"],
            "nativeSha256": manifest["native"]["sha256"],
            "packages": [
                {
                    "name": row["name"],
                    "version": row["version"],
                    "tarballSha256": row["tarball"]["sha256"],
                }
                for row in manifest["packages"]
            ],
            "imageDigest": manifest["image"]["digest"],
            "limits": manifest["container"]["limits"],
            "toolchains": manifest["toolchains"],
            "environment": manifest["environment"],
        }
    except (KeyError, TypeError) as error:
        raise AssemblyError(f"manifest cannot derive candidate identity: {error}") from error
    return "sha256:" + sha256(canonical(ledger))


def require_pass(document: dict[str, Any], label: str, run_id: str, digest: str) -> None:
    expected = {
        "runId": run_id,
        "candidateDigest": digest,
        "status": "PASS",
        "error": None,
        "partial": False,
        "flaky": False,
        "skipped": False,
        "refused": False,
        "failureCount": 0,
    }
    if any(document.get(key) != value for key, value in expected.items()):
        raise AssemblyError(f"{label} is not an exact candidate-bound PASS")


def artifact_bytes(
    run_root: Path,
    result: dict[str, Any],
    name: str,
    label: str,
) -> bytes:
    record = result.get("artifacts", {}).get(name)
    if not isinstance(record, dict):
        raise AssemblyError(f"{label} is missing artifact {name}")
    raw_path = record.get("path")
    expected_sha = record.get("sha256")
    if (
        not isinstance(raw_path, str)
        or not raw_path
        or raw_path.startswith("/")
        or ".." in Path(raw_path).parts
        or SHA256.fullmatch(str(expected_sha)) is None
    ):
        raise AssemblyError(f"{label} artifact {name} has an invalid binding")
    data = read_regular(run_root / raw_path, f"{label}:{name}")
    if not data or sha256(data) != expected_sha:
        raise AssemblyError(f"{label} artifact {name} does not match its digest")
    return data


def load_result(
    run_root: Path,
    gate: str,
    leaf: str,
    names: tuple[str, ...],
    run_id: str,
    digest: str,
) -> tuple[dict[str, Any], dict[str, bytes]]:
    path = run_root / "results" / leaf / "result.json"
    document = read_json(path, f"{gate} result")
    if document.get("gate") != gate:
        raise AssemblyError(f"{gate} result carries the wrong gate id")
    require_pass(document, f"{gate} result", run_id, digest)
    if document.get("requiredArtifacts") != list(names) or set(document.get("artifacts", {})) != set(names):
        raise AssemblyError(f"{gate} result artifacts do not match the canonical contract")
    return document, {
        name: artifact_bytes(run_root, document, name, f"{gate} result") for name in names
    }


def load_case(run_root: Path, case_id: str, run_id: str, readiness: str) -> dict[str, Any]:
    matches: list[tuple[Path, dict[str, Any]]] = []
    for path in run_root.rglob("manifest.json"):
        if path == run_root / "manifest.json":
            continue
        document = read_json(path, "ocular case manifest")
        if document.get("case") == case_id:
            matches.append((path, document))
    if len(matches) != 1:
        raise AssemblyError(f"expected one canonical {case_id} case manifest, found {len(matches)}")
    _, document = matches[0]
    expected = {
        "schema": "ocular-evidence/2",
        "case": case_id,
        "runId": run_id,
        "readinessSha256": readiness,
        "status": "PASS",
        "error": None,
        "partial": False,
        "flaky": False,
        "skipped": False,
        "refused": False,
        "failureCount": 0,
    }
    if any(document.get(key) != value for key, value in expected.items()):
        raise AssemblyError(f"{case_id} is not an exact run/readiness-bound PASS case")
    names = document.get("requiredArtifacts")
    if not isinstance(names, list) or not names or set(document.get("artifacts", {})) != set(names):
        raise AssemblyError(f"{case_id} case artifact declaration is incomplete")
    for name in names:
        artifact_bytes(run_root, document, str(name), f"{case_id} case")
    return document


def artifact_refs(document: dict[str, Any]) -> dict[str, Any]:
    return {
        name: {"path": row["path"], "sha256": row["sha256"]}
        for name, row in document["artifacts"].items()
    }


def require_nonempty_string(value: Any, label: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise AssemblyError(f"E2 live-plugin canonical evidence lacks {label}")
    return value


def validate_attribution_evidence(
    row: dict[str, Any],
    surface: str,
    origin: str,
    human_id: str,
    agent_id: str,
) -> None:
    evidence = row.get("evidence")
    if not isinstance(evidence, dict):
        raise AssemblyError(
            f"E2 live-plugin {surface} attribution lacks canonical evidence"
        )
    kind = evidence.get("kind")
    if origin == "agent":
        if (
            kind != "message.history"
            or evidence.get("authorId") != agent_id
        ):
            raise AssemblyError(
                f"E2 live-plugin {surface} agent attribution lacks canonical message evidence"
            )
        require_nonempty_string(evidence.get("messageId"), "messageId")
        return

    if evidence.get("callerId") != human_id or evidence.get("callerKind") != "human":
        raise AssemblyError(
            f"E2 live-plugin {surface} canonical evidence does not bind the human caller"
        )
    if surface == "thread-create":
        topic = require_nonempty_string(evidence.get("topic"), "developer topic")
        seq = evidence.get("seq")
        if (
            kind != "developer.action"
            or evidence.get("action") != "thread.create"
            or not topic.startswith("sys.thread.")
            or isinstance(seq, bool)
            or not isinstance(seq, int)
            or seq <= 0
        ):
            raise AssemblyError(
                "E2 live-plugin thread-create lacks its canonical developer action"
            )
        return
    if surface in MESSAGE_HISTORY_SURFACES:
        if kind != "message.history":
            raise AssemblyError(
                f"E2 live-plugin {surface} lacks canonical message history evidence"
            )
        require_nonempty_string(evidence.get("messageId"), "messageId")
        return
    if surface in COMMAND_RECEIPT_SURFACES:
        revision = evidence.get("revision")
        seq = evidence.get("seq")
        if (
            kind != "command.receipt"
            or evidence.get("state") != "completed"
            or isinstance(revision, bool)
            or not isinstance(revision, int)
            or revision <= 0
            or isinstance(seq, bool)
            or not isinstance(seq, int)
            or seq < 0
        ):
            raise AssemblyError(
                f"E2 live-plugin {surface} lacks a terminal canonical command receipt"
            )
        require_nonempty_string(evidence.get("commandId"), "commandId")
        require_nonempty_string(evidence.get("clientId"), "clientId")
        require_nonempty_string(evidence.get("sessionId"), "sessionId")
        return
    raise AssemblyError(
        f"E2 live-plugin {surface} has no canonical attribution evidence contract"
    )


def validate_live_plugin(
    coverage_raw: bytes,
    run_id: str,
    readiness: str,
    digest: str,
) -> dict[str, Any]:
    coverage = parse_json_bytes(coverage_raw, "E2 affordance coverage")
    live = coverage.get("livePlugin")
    if not isinstance(live, dict):
        raise AssemblyError("E2 affordance coverage is missing the live-plugin result")
    expected = {
        "schemaVersion": 1,
        "runId": run_id,
        "readinessSha256": readiness,
        "candidateDigest": digest,
        "candidateBound": True,
        "hostStateRefused": True,
        "manualGatewayConfigured": True,
    }
    if any(live.get(name) != value for name, value in expected.items()):
        raise AssemblyError("E2 live-plugin result is not bound to this candidate and isolated lab")
    command = live.get("command")
    if (
        not isinstance(command, str)
        or "tests/ocular/live-plugin.mjs" not in command
        or "--release" not in command
    ):
        raise AssemblyError("E2 live-plugin result lacks its documented release command")
    human_id = live.get("humanId")
    agent_id = live.get("agentId")
    if (
        not isinstance(human_id, str)
        or not human_id
        or not isinstance(agent_id, str)
        or not agent_id
        or human_id == agent_id
    ):
        raise AssemblyError("E2 live-plugin result lacks distinct human and target-agent identities")

    surfaces = live.get("surfaces")
    if not isinstance(surfaces, list) or len(surfaces) != len(LIVE_PLUGIN_SURFACES):
        raise AssemblyError("E2 live-plugin surface matrix is incomplete")
    observed: list[tuple[str, str]] = []
    for row in surfaces:
        if not isinstance(row, dict) or row.get("status") != "PASS":
            raise AssemblyError("E2 live-plugin surface matrix contains a non-PASS row")
        observed.append((str(row.get("id")), str(row.get("surface"))))
    if tuple(observed) != LIVE_PLUGIN_SURFACES:
        raise AssemblyError("E2 live-plugin surface matrix does not match LP1-LP16")

    attribution = live.get("attributionRows")
    if not isinstance(attribution, list) or not attribution:
        raise AssemblyError("E2 live-plugin result contains no durable attribution rows")
    human_surfaces: set[str] = set()
    agent_surfaces: set[str] = set()
    for row in attribution:
        if not isinstance(row, dict):
            raise AssemblyError("E2 live-plugin attribution row is not an object")
        surface = row.get("surface")
        origin = row.get("origin")
        if origin == "human":
            if row.get("callerId") != human_id or row.get("targetAgentId") != agent_id:
                raise AssemblyError(
                    "E2 live-plugin human mutation does not preserve caller/target identity"
                )
            validate_attribution_evidence(
                row, str(surface), "human", human_id, agent_id
            )
            human_surfaces.add(str(surface))
        elif origin == "agent":
            if row.get("authorId") != agent_id or row.get("targetHumanId") != human_id:
                raise AssemblyError(
                    "E2 live-plugin agent reply does not preserve author/target identity"
                )
            validate_attribution_evidence(
                row, str(surface), "agent", human_id, agent_id
            )
            agent_surfaces.add(str(surface))
        else:
            raise AssemblyError("E2 live-plugin attribution row has an unknown origin")
    if not HUMAN_PLUGIN_MUTATIONS.issubset(human_surfaces):
        raise AssemblyError("E2 live-plugin attribution omits a human mutation surface")
    if not {"thread-agent-reply", "dm-two-way"}.issubset(agent_surfaces):
        raise AssemblyError("E2 live-plugin attribution omits an agent reply surface")
    return live


def result_document(
    gate: str,
    run_id: str,
    digest: str,
    directory: str,
    payloads: dict[str, bytes],
) -> tuple[dict[str, Any], dict[str, bytes]]:
    artifacts: dict[str, dict[str, str]] = {}
    files: dict[str, bytes] = {}
    for name, data in payloads.items():
        if not data:
            raise AssemblyError(f"{gate} artifact {name} is empty")
        filename = f"{name}.jsonl"
        relative = (Path("results") / directory / filename).as_posix()
        artifacts[name] = {"path": relative, "sha256": sha256(data)}
        files[filename] = data
    document = {
        "schemaVersion": 1,
        "gate": gate,
        "runId": run_id,
        "candidateDigest": digest,
        "status": "PASS",
        "error": None,
        "partial": False,
        "flaky": False,
        "skipped": False,
        "refused": False,
        "failureCount": 0,
        "requiredArtifacts": list(payloads),
        "artifacts": artifacts,
    }
    files["result.json"] = pretty(document)
    return document, files


def release_document(
    gate: str,
    run_id: str,
    digest: str,
    fields: dict[str, Any],
    names: tuple[str, ...],
) -> tuple[dict[str, Any], dict[str, bytes]]:
    payloads = {name: pretty(fields[name]) for name in names}
    artifacts = {
        name: {"path": f"release/{name}.jsonl", "sha256": sha256(data)}
        for name, data in payloads.items()
    }
    document = {
        "schemaVersion": 1,
        "gate": gate,
        "runId": run_id,
        "candidateDigest": digest,
        "status": "PASS",
        "error": None,
        "partial": False,
        "flaky": False,
        "skipped": False,
        "refused": False,
        "failureCount": 0,
        "requiredArtifacts": list(names),
        "artifacts": artifacts,
    }
    if gate == "DIFF":
        document["unexpectedChanges"] = fields["unexpectedChanges"]
    else:
        document["unresolvedBlockers"] = fields["unresolvedBlockers"]
    return document, {f"{name}.jsonl": data for name, data in payloads.items()}


def write_all(descriptor: int, data: bytes) -> None:
    remaining = memoryview(data)
    while remaining:
        written = os.write(descriptor, remaining)
        if written <= 0:
            raise AssemblyError("short evidence write")
        remaining = remaining[written:]


def rename_noreplace(source: Path, destination: Path) -> None:
    parent_fd = os.open(
        source.parent,
        os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | getattr(os, "O_NOFOLLOW", 0),
    )
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        renameat2 = getattr(libc, "renameat2", None)
        if renameat2 is None:
            raise AssemblyError("renameat2(RENAME_NOREPLACE) is unavailable")
        result = renameat2(
            parent_fd,
            os.fsencode(source.name),
            parent_fd,
            os.fsencode(destination.name),
            1,
        )
        if result == 0:
            return
        code = ctypes.get_errno()
        if code == errno.EEXIST:
            raise AssemblyError(f"refusing to replace existing evidence: {destination}")
        raise AssemblyError(
            f"atomic evidence publication failed for {destination}: {os.strerror(code)}"
        )
    finally:
        os.close(parent_fd)


def publish_directory(parent: Path, final_name: str, files: dict[str, bytes]) -> Path:
    parent.mkdir(parents=True, exist_ok=True)
    final = parent / final_name
    if os.path.lexists(final):
        raise AssemblyError(f"refusing to replace existing evidence: {final}")
    stage = parent / f".{final_name}.tmp-{os.getpid()}-{time.time_ns()}"
    stage.mkdir(mode=0o700)
    try:
        for name, data in files.items():
            descriptor = os.open(
                stage / name,
                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC,
                0o600,
            )
            try:
                write_all(descriptor, data)
                os.fchmod(descriptor, 0o400)
                os.fsync(descriptor)
            finally:
                os.close(descriptor)
        os.chmod(stage, 0o555)
        stage_fd = os.open(stage, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(stage_fd)
        finally:
            os.close(stage_fd)
        rename_noreplace(stage, final)
        parent_fd = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
        return final
    except BaseException:
        if stage.exists():
            try:
                os.chmod(stage, 0o700)
            except OSError:
                pass
        shutil.rmtree(stage, ignore_errors=True)
        raise


def parse_snapshot(path: Path, label: str) -> dict[str, Any]:
    value = read_json(path, label)
    fields = {
        "daemon": {"pid": int, "bootId": str, "executable": str, "sha256": str},
        "gateway": {"pid": int, "listener": str, "executable": str, "sha256": str},
        "webconsole": {"pid": int, "listener": str, "executable": str, "sha256": str},
        "ipc": {"path": str, "inode": int},
    }
    if set(value) != {*fields, "files", "capturedAt"}:
        raise AssemblyError(f"{label} does not match the canonical host snapshot schema")
    captured_at = value.get("capturedAt")
    if isinstance(captured_at, bool) or not isinstance(captured_at, int):
        raise AssemblyError(f"{label} capturedAt has the wrong type")
    for section, expected in fields.items():
        row = value.get(section)
        if not isinstance(row, dict) or set(row) != set(expected):
            raise AssemblyError(f"{label} {section} does not match the canonical schema")
        for name, expected_type in expected.items():
            actual = row[name]
            if isinstance(actual, bool) or not isinstance(actual, expected_type):
                raise AssemblyError(f"{label} {section}.{name} has the wrong type")
    file_fields = {
        "kind": str,
        "device": int,
        "inode": int,
        "mode": int,
        "uid": int,
        "gid": int,
        "nlink": int,
        "size": int,
        "mtimeNs": int,
        "ctimeNs": int,
    }
    files = value.get("files")
    if not isinstance(files, dict) or set(files) != set(HOST_FILES):
        raise AssemblyError(f"{label} tracked file inventory does not match the contract")
    for filename, row in files.items():
        if not isinstance(row, dict) or set(row) != set(file_fields):
            raise AssemblyError(f"{label} files.{filename} does not match the contract")
        if row.get("kind") not in {
            "missing",
            "regular",
            "fifo",
            "symlink",
            "socket",
            "directory",
            "other",
        }:
            raise AssemblyError(f"{label} files.{filename}.kind is invalid")
        for name, expected_type in file_fields.items():
            actual = row[name]
            if isinstance(actual, bool) or not isinstance(actual, expected_type):
                raise AssemblyError(f"{label} files.{filename}.{name} has the wrong type")
    return value


def assemble(args: argparse.Namespace) -> None:
    run_root = Path(args.run_root).absolute()
    manifest = read_json(run_root / "manifest.json", "candidate manifest")
    run_id = manifest.get("runId")
    if SAFE_RUN_ID.fullmatch(str(run_id)) is None or manifest.get("mode") != "packed":
        raise AssemblyError("candidate manifest is not a safe packed run")
    readiness = args.readiness_sha256
    if SHA256.fullmatch(readiness) is None:
        raise AssemblyError("--readiness-sha256 must be 64 lowercase hex characters")
    manifest_readiness = manifest.get("environment", {}).get(
        "NEXUS_V015_READINESS_LEDGER_SHA256"
    )
    if manifest_readiness is not None and manifest_readiness != readiness:
        raise AssemblyError("candidate manifest readiness binding does not match this run")
    digest = candidate_digest(manifest)

    version = subprocess.run(
        [args.nexus_bin, "--version"],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
        timeout=30,
    )
    if version.returncode != 0 or version.stdout.strip() != f"nexus {VERSION}" or version.stderr:
        raise AssemblyError("packed Nexus version output is not exactly 'nexus 0.1.5'")
    metadata = read_json(Path(args.cargo_metadata), "Cargo metadata")
    packages = metadata.get("packages")
    if (
        not isinstance(packages, list)
        or not packages
        or any(
            not isinstance(row, dict)
            or not isinstance(row.get("name"), str)
            or row.get("version") != VERSION
            for row in packages
        )
    ):
        raise AssemblyError("every Cargo metadata package must report version 0.1.5")
    npm = manifest.get("packages")
    if (
        not isinstance(npm, list)
        or [(row.get("name"), row.get("version")) for row in npm]
        != [
            ("@egregore/nexus", VERSION),
            ("@egregore/nexus-cli", VERSION),
            ("@egregore/nexus-gateway", VERSION),
        ]
    ):
        raise AssemblyError("manifest does not contain the exact three v0.1.5 npm packages")

    _, d1 = load_result(
        run_root,
        "D1",
        "D1-clean-packed-install",
        ("packedInventory", "installLog", "foreignCwd", "shutdown"),
        str(run_id),
        digest,
    )
    _, b1 = load_result(
        run_root,
        "B1",
        "B1-stable-identity",
        ("identityMatrix", "renameRegression", "agentIdResolution"),
        str(run_id),
        digest,
    )
    _, b2 = load_result(
        run_root,
        "B2",
        "B2-restart-reconciliation",
        ("restartTimeline", "rosterComparison", "humanRebind"),
        str(run_id),
        digest,
    )
    _, e2 = load_result(
        run_root,
        "E2",
        "E2-lens-ocular",
        ("ocularSummary", "affordanceCoverage", "artifactsIndex"),
        str(run_id),
        digest,
    )
    live_plugin = validate_live_plugin(
        e2["affordanceCoverage"],
        str(run_id),
        readiness,
        digest,
    )
    cases = {
        case_id: load_case(run_root, case_id, str(run_id), readiness)
        for case_id in ("W2", "W3", "W6", "W7", "W8")
    }

    before = parse_snapshot(Path(args.host_before), "host-before snapshot")
    after = parse_snapshot(Path(args.host_after), "host-after snapshot")
    comparable_before = {key: value for key, value in before.items() if key != "capturedAt"}
    comparable_after = {key: value for key, value in after.items() if key != "capturedAt"}
    if comparable_before != comparable_after or after["capturedAt"] < before["capturedAt"]:
        raise AssemblyError("host runtime identity changed during the candidate run")

    disposition = read_json(Path(args.diff_review), "diff/review disposition")
    if (
        disposition.get("schemaVersion") != 1
        or disposition.get("runId") != run_id
        or disposition.get("candidateDigest") != digest
        or not isinstance(disposition.get("diff"), dict)
        or not isinstance(disposition.get("review"), dict)
        or disposition["diff"].get("unexpectedChanges") != 0
        or disposition["review"].get("unresolvedBlockers") != 0
    ):
        raise AssemblyError("diff/review disposition is not an explicit zero-blocker candidate record")
    diff_fields = disposition["diff"]
    review_fields = disposition["review"]
    for name in ("trackedDiff", "untrackedInventory", "intendedChanges"):
        if name not in diff_fields or diff_fields[name] in (None, [], {}, ""):
            raise AssemblyError(f"diff disposition is missing {name}")
    for name in ("reviewReport", "blockerDisposition"):
        if name not in review_fields or review_fields[name] in (None, [], {}, ""):
            raise AssemblyError(f"review disposition is missing {name}")

    a1_doc, a1_files = result_document(
        "A1",
        str(run_id),
        digest,
        "A1-candidate-identity",
        {
            "versionReport": pretty(
                {
                    "nexus": version.stdout.strip(),
                    "cargoPackages": [
                        {"name": row["name"], "version": row["version"]} for row in packages
                    ],
                    "npmPackages": [
                        {"name": row["name"], "version": row["version"]} for row in npm
                    ],
                }
            ),
            "cargoVersions": pretty(metadata),
            "packedInventory": d1["packedInventory"],
        },
    )
    a2_doc, a2_files = result_document(
        "A2",
        str(run_id),
        digest,
        "A2-host-isolation",
        {
            "beforeSnapshot": pretty(before),
            "afterSnapshot": pretty(after),
            "comparison": pretty(
                {
                    "status": "PASS",
                    "unchanged": True,
                    "beforeSha256": sha256(pretty(before)),
                    "afterSha256": sha256(pretty(after)),
                }
            ),
        },
    )
    b3_doc, b3_files = result_document(
        "B3",
        str(run_id),
        digest,
        "B3-human-webconsole-attribution",
        {
            "attributionRows": pretty(
                {
                    "restartRebind": json.loads(b2["humanRebind"]),
                    "lensLivePlugin": live_plugin["attributionRows"],
                }
            ),
            "renderedAttribution": pretty(
                {
                    "thread": {"case": "W2", "artifacts": artifact_refs(cases["W2"])},
                    "dm": {"case": "W3", "artifacts": artifact_refs(cases["W3"])},
                    "lensLivePlugin": live_plugin,
                }
            ),
            "principalTransitions": pretty(
                {
                    "rename": json.loads(b1["renameRegression"]),
                    "rebind": json.loads(b2["humanRebind"]),
                    "reload": {"case": "W6", "artifacts": artifact_refs(cases["W6"])},
                    "gatewayReconnect": {"case": "W7", "artifacts": artifact_refs(cases["W7"])},
                    "daemonRestart": {"case": "W8", "artifacts": artifact_refs(cases["W8"])},
                    "lensReload": next(
                        row for row in live_plugin["surfaces"] if row["surface"] == "reload-hydration"
                    ),
                    "lensGatewayReconnect": next(
                        row for row in live_plugin["surfaces"] if row["surface"] == "gateway-reconnect"
                    ),
                    "lensDaemonReconnect": next(
                        row for row in live_plugin["surfaces"] if row["surface"] == "daemon-reconnect"
                    ),
                }
            ),
        },
    )
    diff_doc, diff_payloads = release_document(
        "DIFF",
        str(run_id),
        digest,
        diff_fields,
        ("trackedDiff", "untrackedInventory", "intendedChanges"),
    )
    review_doc, review_payloads = release_document(
        "REVIEW",
        str(run_id),
        digest,
        review_fields,
        ("reviewReport", "blockerDisposition"),
    )

    targets = [
        run_root / "results/A1-candidate-identity",
        run_root / "results/A2-host-isolation",
        run_root / "results/B3-human-webconsole-attribution",
        run_root / "release",
    ]
    if any(os.path.lexists(path) for path in targets):
        raise AssemblyError("one or more cross-producer evidence targets already exist")
    created: list[Path] = []
    try:
        for leaf, files in (
            ("A1-candidate-identity", a1_files),
            ("A2-host-isolation", a2_files),
            ("B3-human-webconsole-attribution", b3_files),
        ):
            created.append(publish_directory(run_root / "results", leaf, files))
        release_files = {
            **diff_payloads,
            **review_payloads,
            "diff-disposition.json": pretty(diff_doc),
            "review-disposition.json": pretty(review_doc),
        }
        created.append(publish_directory(run_root, "release", release_files))
    except BaseException:
        for path in reversed(created):
            shutil.rmtree(path, ignore_errors=True)
        raise

    print(
        f"v0.1.5 cross-producer evidence assembled: run={run_id} candidate={digest} "
        f"gates={a1_doc['gate']},{a2_doc['gate']},{b3_doc['gate']},DIFF,REVIEW"
    )


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Assemble candidate identity, host isolation, human attribution, and "
            "explicit diff/review dispositions from already-published run evidence."
        )
    )
    parser.add_argument("--run-root", required=True, type=Path)
    parser.add_argument(
        "--print-candidate-digest",
        action="store_true",
        help=(
            "read manifest.json and print its derived candidate digest without "
            "publishing evidence"
        ),
    )
    parser.add_argument("--host-before", type=Path)
    parser.add_argument("--host-after", type=Path)
    parser.add_argument("--diff-review", type=Path)
    parser.add_argument("--cargo-metadata", type=Path)
    parser.add_argument("--nexus-bin", type=Path)
    parser.add_argument("--readiness-sha256")
    args = parser.parse_args()
    if not args.print_candidate_digest:
        missing = [
            option
            for option, value in (
                ("--host-before", args.host_before),
                ("--host-after", args.host_after),
                ("--diff-review", args.diff_review),
                ("--cargo-metadata", args.cargo_metadata),
                ("--nexus-bin", args.nexus_bin),
                ("--readiness-sha256", args.readiness_sha256),
            )
            if value is None
        ]
        if missing:
            parser.error("full assembly requires " + ", ".join(missing))
    return args


def main() -> int:
    try:
        args = parse_args()
        if args.print_candidate_digest:
            manifest = read_json(args.run_root / "manifest.json", "manifest")
            print(candidate_digest(manifest))
            return 0
        assemble(args)
        return 0
    except (AssemblyError, OSError, subprocess.SubprocessError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
