#!/usr/bin/env python3
"""Unit tests for the pure helpers in scripts/nexus-load-gate (no docker needed)."""

from __future__ import annotations

import importlib.machinery
import importlib.util
import inspect
import ast
import asyncio
import json
import sqlite3
import sys
import threading
import unittest
from pathlib import Path
from types import SimpleNamespace
from unittest import mock

_PATH = Path(__file__).resolve().parent / "nexus-load-gate"
_loader = importlib.machinery.SourceFileLoader("nexus_load_gate", str(_PATH))
_spec = importlib.util.spec_from_loader("nexus_load_gate", _loader)
lg = importlib.util.module_from_spec(_spec)
sys.modules["nexus_load_gate"] = lg  # dataclasses resolve annotations via sys.modules
_loader.exec_module(lg)


class LedgerTests(unittest.TestCase):
    def test_exactly_once_is_clean(self):
        led = lg.Ledger()
        led.record_send("m1", "a1", "post", {"a2", "a3"}, t=0.0)
        led.record_receipt("m1", "a2", "row1", t=0.1)
        led.record_receipt("m1", "a3", "row1", t=0.2)
        self.assertEqual(led.missing(), [])
        self.assertEqual(led.duplicates(), [])

    def test_missing_recipient_reported(self):
        led = lg.Ledger()
        led.record_send("m1", "a1", "post", {"a2", "a3"}, t=0.0)
        led.record_receipt("m1", "a2", "row1", t=0.1)
        self.assertEqual(led.missing(), [("m1", "a3")])

    def test_duplicate_receipt_reported(self):
        led = lg.Ledger()
        led.record_send("m1", "a1", "dm", {"a2"}, t=0.0)
        led.record_receipt("m1", "a2", "row1", t=0.1)
        led.record_receipt("m1", "a2", "row1", t=0.2)
        dupes = led.duplicates()
        self.assertEqual(len(dupes), 1)
        self.assertIn("received 2x", dupes[0])

    def test_two_durable_rows_for_one_send_reported(self):
        led = lg.Ledger()
        led.record_send("m1", "a1", "post", {"a2", "a3"}, t=0.0)
        led.record_receipt("m1", "a2", "rowA", t=0.1)
        led.record_receipt("m1", "a3", "rowB", t=0.2)
        dupes = led.duplicates()
        self.assertEqual(len(dupes), 1)
        self.assertIn("2 distinct durable rows", dupes[0])

    def test_allowed_restart_dupes_are_exempt(self):
        led = lg.Ledger()
        led.record_send("m1", "a1", "dm", {"a2"}, t=0.0)
        led.record_receipt("m1", "a2", "row1", t=0.1)
        led.record_receipt("m1", "a2", "row1", t=0.2)
        self.assertEqual(led.duplicates(allowed={"m1"}), [])
        self.assertEqual(len(led.duplicates(allowed=set())), 1)


class SendPumpProgressTests(unittest.IsolatedAsyncioTestCase):
    async def assert_pump_progress_during_send(self, target_kind):
        # Exercise actual run_phases and Consumer._pump without Docker or a daemon.
        # Only the pump can release the held synchronous CLI call. Its finite wait is
        # a deadlock watchdog, not the success oracle: success requires a real receipt
        # while the send is still held, on the event-loop thread.
        class StopPhase(BaseException):
            pass

        loop = asyncio.get_running_loop()
        loop_thread = threading.get_ident()
        released = threading.Event()
        held = threading.Event()
        watchdog_used = []
        receipt_threads = []
        send_threads = []
        consumers = []
        calls = []
        target_completed = False
        real_sleep = asyncio.sleep

        class TrackingLedger(lg.Ledger):
            def record_receipt(self, *args, **kwargs):
                super().record_receipt(*args, **kwargs)
                receipt_threads.append(threading.get_ident())
                if held.is_set():
                    released.set()

            def record_send(self, *args, **kwargs):
                send_threads.append(threading.get_ident())
                super().record_send(*args, **kwargs)

        async def start_consumer(consumer):
            consumer.proc = SimpleNamespace(
                stdout=asyncio.StreamReader(), stderr=asyncio.StreamReader(), returncode=None
            )
            consumer.task = asyncio.create_task(consumer._pump())
            consumer.stderr_task = asyncio.create_task(consumer._pump_stderr())
            consumers.append(consumer)

        def nexus(actor, *args, **kwargs):
            nonlocal target_completed
            if target_completed:
                raise StopPhase()
            calls.append((args, kwargs))
            is_ghost = args[:2] == ("dm", "lgghost")
            if is_ghost != (target_kind == "ghost"):
                return ""
            held.set()
            batch = {"dms": [{"id": "row-proof", "body": "LG:abcdef: pump proof"}], "threads": []}
            loop.call_soon_threadsafe(
                consumers[0].proc.stdout.feed_data, json.dumps(batch).encode() + b"\n"
            )
            watchdog_used.append(not released.wait(1.0))
            held.clear()
            target_completed = True
            return ""

        async def yield_only(_delay):
            await real_sleep(0)

        actors = [lg.Actor("lg01", "key1"), lg.Actor("lg02", "key2")]
        fleet = lg.Fleet(actors, lg.Actor("lgghost", "ghost"), {"load-a": [a.name for a in actors]})
        env = SimpleNamespace(host_port="unused", nexus=nexus)
        args = SimpleNamespace(seed=7, messages=10)
        rng = lg.random.Random(7)
        roll = {"ghost": 0.0, "post": 0.0, "dm": 0.8, "publish": 0.95}[target_kind]
        lane = SimpleNamespace(start=mock.AsyncMock())
        try:
            with mock.patch.object(lg, "Ledger", TrackingLedger), \
                 mock.patch.object(lg.Consumer, "start", start_consumer), \
                 mock.patch.object(lg, "EventsLane", return_value=lane), \
                 mock.patch.object(lg.asyncio, "sleep", yield_only), \
                 mock.patch.object(lg.random, "Random", return_value=rng), \
                 mock.patch.object(rng, "random", side_effect=[0.9, roll, 0.9, roll]):
                with self.assertRaises(StopPhase):
                    await lg.run_phases(env, fleet, lg.Summary(), args)
        finally:
            released.set()
            # A RED run can leave feed_data queued behind the blocked send.
            await real_sleep(0)
            for consumer in consumers:
                consumer.proc.stdout.feed_eof()
                consumer.proc.stderr.feed_eof()
            await asyncio.gather(*(task for c in consumers for task in (c.task, c.stderr_task)))

        self.assertEqual(watchdog_used, [False], "listener pump could not progress while CLI send was held")
        self.assertEqual(receipt_threads, [loop_thread])
        self.assertTrue(all(kwargs == {"timeout": 35} for _, kwargs in calls))
        self.assertEqual(len(calls), 1 if target_kind == "ghost" else 4)
        if target_kind != "ghost":
            self.assertEqual(calls[-1][0][0], target_kind)
            self.assertEqual(send_threads, [loop_thread], "ledger must remain event-loop owned")

    async def test_ghost_send_keeps_listener_pump_running(self):
        await self.assert_pump_progress_during_send("ghost")

    async def test_live_post_keeps_listener_pump_running(self):
        await self.assert_pump_progress_during_send("post")

    async def test_live_dm_keeps_listener_pump_running(self):
        await self.assert_pump_progress_during_send("dm")

    async def test_live_publish_keeps_listener_pump_running(self):
        await self.assert_pump_progress_during_send("publish")

    def test_all_cli_send_phases_await_the_send(self):
        tree = ast.parse(inspect.getsource(lg.run_phases))
        calls = [node for node in ast.walk(tree) if isinstance(node, ast.Call)
                 and isinstance(node.func, ast.Name) and node.func.id == "cli_send"]
        awaited = [node.value for node in ast.walk(tree) if isinstance(node, ast.Await)]
        self.assertEqual(len(calls), 4, "cover burst, idle, restart, and rename sends")
        self.assertTrue(all(call in awaited for call in calls))


class CompletionTimeoutAuditTests(unittest.TestCase):
    def test_actual_phase6_query_detects_structured_timeouts_independent_of_reason(self):
        # Execute the actual audit query, not a second test-only implementation.
        tree = ast.parse(inspect.getsource(lg.run_phase6_audits))
        queries = [
            node.args[0].value
            for node in ast.walk(tree)
            if isinstance(node, ast.Call)
            and isinstance(node.func, ast.Attribute)
            and node.func.attr == "db_query"
            and node.args
            and isinstance(node.args[0], ast.Constant)
            and isinstance(node.args[0].value, str)
            and "turn completion timeout" in node.args[0].value
        ]
        self.assertEqual(len(queries), 1)
        with sqlite3.connect(":memory:") as db:
            db.execute("CREATE TABLE in_flight(state TEXT, error_code TEXT, error_reason TEXT)")
            rows = [
                ("error", "completion_timeout", "harness completion await timed out"),
                ("error", "completion_timeout", "harness accepted the prompt but model completion was not observed"),
                ("error", None, "turn completion timeout"),
                ("error", "contract_error", "different failure"),
                ("delivered", "completion_timeout", "turn completion timeout"),
                ("notified", None, None),
            ]
            for index, row in enumerate(rows):
                db.execute("INSERT INTO in_flight VALUES (?, ?, ?)", row)
                self.assertEqual(db.execute(queries[0]).fetchone()[0], min(index + 1, 3))


class ScanLogsTests(unittest.TestCase):
    def test_instant_fail_signatures(self):
        for sig in lg.INSTANT_FAIL_SIGNATURES:
            findings = lg.scan_logs(f"junk\nERROR blah {sig} blah\n", budgets={})
            self.assertEqual(len(findings), 1, sig)
            self.assertTrue(findings[0].over_budget, sig)
            self.assertEqual(findings[0].count, 1)

    def test_clean_log_is_clean(self):
        self.assertEqual(lg.scan_logs("all good\nnothing to see\n"), [])

    def test_budgeted_signature_within_budget(self):
        text = "x unsupported statement y\n" * 3
        findings = lg.scan_logs(text, budgets={"unsupported statement": 5})
        self.assertEqual(len(findings), 1)
        self.assertFalse(findings[0].over_budget)
        self.assertEqual(findings[0].count, 3)

    def test_budgeted_signature_over_budget(self):
        text = "x unsupported statement y\n" * 6
        findings = lg.scan_logs(text, budgets={"unsupported statement": 5})
        self.assertTrue(findings[0].over_budget)


class SummaryTests(unittest.TestCase):
    def test_fail_wins_and_json_shape(self):
        s = lg.Summary(profile={"agents": 2})
        s.check("a", True)
        s.check("b", False, evidence="boom")
        self.assertFalse(s.ok)
        d = s.to_dict()
        self.assertEqual(d["status"], "fail")
        self.assertEqual(d["failures"], ["b"])
        self.assertEqual(d["checks"][1]["evidence"], "boom")

    def test_empty_summary_is_not_a_pass(self):
        self.assertFalse(lg.Summary().ok)

    def test_all_pass(self):
        s = lg.Summary()
        s.check("a", True)
        self.assertTrue(s.ok)
        self.assertEqual(s.to_dict()["status"], "pass")


class BodyCodecTests(unittest.TestCase):
    def test_roundtrip(self):
        body = lg.body_for("abc123")
        self.assertEqual(lg.msg_id_from_body(body), "abc123")

    def test_non_gate_traffic_is_none(self):
        self.assertIsNone(lg.msg_id_from_body("hello world"))
        self.assertIsNone(lg.msg_id_from_body("LG:noterminator"))


class CpuParseTests(unittest.TestCase):
    def test_mm_ss(self):
        self.assertEqual(lg.parse_ps_cpu_seconds("02:30"), 150)

    def test_hh_mm_ss(self):
        self.assertEqual(lg.parse_ps_cpu_seconds("01:02:03"), 3723)

    def test_days(self):
        self.assertEqual(lg.parse_ps_cpu_seconds("1-00:00:10"), 86410)

    def test_malformed(self):
        self.assertIsNone(lg.parse_ps_cpu_seconds("junk"))


class CensusTests(unittest.TestCase):
    HEADER = "    PID ARGS\n"

    def test_stack_processes_pass(self):
        out = lg.census_violettions(
            self.HEADER
            + "  1 /tmp/nexus-target/debug/nexus daemon\n"
            + "  3 socat TCP-LISTEN:4500\n"
            + "  4 node scripts/gateway-serve.mjs\n"
            + "  5 sleep infinity\n"
        )
        self.assertEqual(out, [])

    def test_harness_process_fails(self):
        out = lg.census_violettions(self.HEADER + "  9 claude --resume abc\n")
        self.assertEqual(len(out), 1)
        self.assertIn("forbidden", out[0])

    def test_unknown_process_fails(self):
        out = lg.census_violettions(self.HEADER + "  9 minerd --threads 8\n")
        self.assertEqual(len(out), 1)
        self.assertIn("unexpected", out[0])


class ProvisioningTests(unittest.TestCase):
    def test_endurance_default_stops_after_watchdog_without_resurrection(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        watchdog_wait = source.index('wait "$WATCHDOG_PID"')
        restart_guard = source.index('if [ "$RUN_RESURRECTION" != 1 ]; then')
        resurrection = source.index("nexus-v010-resurrection-gate")

        self.assertIn(
            "RUN_RESURRECTION=${NEXUS_ENDURANCE_RUN_RESURRECTION:-0}", source
        )
        self.assertLess(watchdog_wait, restart_guard)
        self.assertLess(restart_guard, resurrection)
        self.assertIn("exit 0", source[restart_guard:resurrection])
        self.assertNotIn("--filter label=egregore-nexus-test=true", source)

    def test_resurrection_runner_selects_an_isolated_fixture(self):
        source = (_PATH.parent / "nexus-v010-resurrection-run").read_text(
            encoding="utf-8"
        )

        self.assertIn("NEXUS_ENDURANCE_RUN_RESURRECTION=1", source)
        self.assertIn("nexus-v010-resurrection", source)
        self.assertIn("4561", source)
        self.assertIn("4562", source)
        self.assertIn("resurrection-v010-final", source)
        self.assertIn("v010-resurrection-candidate", source)
        self.assertIn("NEXUS_ENDURANCE_EXPECT_CPUS=2000000000", source)
        self.assertIn("NEXUS_ENDURANCE_EXPECT_MEMORY_BYTES=8589934592", source)
        self.assertIn(
            "NEXUS_ENDURANCE_REQUIRE_HOST_CAPACITY=${NEXUS_RESURRECTION_REQUIRE_HOST_CAPACITY:-0}",
            source,
        )
        self.assertIn('exec "$ROOT/scripts/nexus-v010-endurance-gate"', source)

    def test_concurrent_fixture_has_a_fail_closed_host_capacity_gate(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("NEXUS_ENDURANCE_REQUIRE_HOST_CAPACITY", source)
        self.assertIn("MemAvailable", source)
        self.assertIn("/proc/pressure/memory", source)
        self.assertIn("1099511627776", source)
        self.assertIn("host-capacity.json", source)

    def test_docker_image_leaves_isolated_home_writable_for_host_uid(self):
        dockerfile = (
            _PATH.parent.parent / "tools" / "docker" / "nexus-test.Dockerfile"
        ).read_text(encoding="utf-8")

        self.assertIn('install -d -m 0777 "$HOME"', dockerfile)

    def test_claude_fixture_preserves_oauth_but_removes_host_api_overrides(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        self.assertIn("ANTHROPIC_BASE_URL", docker_env)
        self.assertIn("ANTHROPIC_API_KEY", docker_env)
        self.assertIn("ANTHROPIC_AUTH_TOKEN", docker_env)
        self.assertIn("del(.env.ANTHROPIC_BASE_URL", docker_env)

    def test_claude_fixture_pins_exact_sonnet_five_model(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        self.assertIn('CLAUDE_MODEL="${NEXUS_DOCKER_TEST_CLAUDE_MODEL:-claude-sonnet-5}"', docker_env)
        self.assertIn('-e "ANTHROPIC_MODEL=$CLAUDE_MODEL"', docker_env)

    def test_real_harness_path_includes_the_mounted_bun_opencode_binary(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        self.assertIn('path_env="$path_env:$HOME/.bun/bin"', docker_env)

    def test_docker_environment_hands_in_tree_gateway_to_daemon(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        self.assertIn(
            '-e "NEXUS_GATEWAY_BIN=/work/egregore-nexus/gateway/scripts/nexus-gateway.mjs"',
            docker_env,
        )
        self.assertIn("container_uses_in_tree_gateway()", docker_env)
        self.assertIn("$NEXUS_BIN gateway restart", docker_env)
        self.assertIn("start_gateway", docker_env)

    def test_docker_environment_clamps_compile_and_gate_resources(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        self.assertIn("--init", docker_env)
        self.assertIn('--user "$HOST_UID:$HOST_GID"', docker_env)
        self.assertIn('--cpus "$CPUS"', docker_env)
        self.assertIn('--memory "$MEMORY"', docker_env)
        self.assertIn('--memory-swap "$MEMORY"', docker_env)
        self.assertIn('--pids-limit "$PIDS_LIMIT"', docker_env)

    def test_reused_container_repairs_harness_home_for_host_uid(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        self.assertIn(
            'docker exec --user 0:0 "${ACTIVE_CONTAINER_ID:-$NAME}" install -d -o "$HOST_UID" -g "$HOST_GID" -m 0700 /tmp/harness-home',
            " ".join(docker_env.replace("\\\n", " ").split()),
        )
        self.assertLess(
            docker_env.index("ensure_harness_home_owned"),
            docker_env.index("prepare_host_harnesses"),
        )

    def test_docker_environment_reuses_the_only_container_without_an_image_probe(self):
        docker_env = (_PATH.parent / "nexus-docker-test-env").read_text(encoding="utf-8")

        up = docker_env.split("cmd_up() {", 1)[1].split("\n}", 1)[0]
        self.assertIn("if container_exists; then", up)
        self.assertIn("normal) ACTIVE_CONTAINER_ID=$CONTAINER_ID ;;", up)
        self.assertIn("else\n    ensure_image\n  fi", up)
        self.assertEqual(up.count("ensure_image"), 1)
        self.assertLess(up.index("if container_exists; then"), up.index("ensure_image"))

    def test_store_reset_reaps_the_container_and_removes_only_embedded_database(self):
        source = inspect.getsource(lg.Env.reset_state)

        self.assertIn('["docker", "restart", self.container]', source)
        self.assertIn("/tmp/nexus-home/nexus.db", source)
        self.assertIn("socat TCP-LISTEN:4100", source)
        self.assertNotIn("sqld", source)
        self.assertLess(source.index('"restart"'), source.index("rm -rf"))

    def test_daemon_restart_bounces_gateway_and_waits_for_daemon_read_view(self):
        restart = inspect.getsource(lg.Env.restart_daemon)
        readiness = inspect.getsource(lg.Env.wait_healthy)

        self.assertIn("gateway stop", restart)
        self.assertIn("gateway start", restart)
        self.assertLess(restart.index("gateway stop"), restart.index("gateway start"))
        self.assertIn("members", readiness)
        self.assertIn("--include-offline", readiness)

    def test_restart_re_adoption_excludes_the_dead_target_control(self):
        live = [lg.Actor(name="lg01", client_key="ck_lg01")]
        ghost = lg.Actor(name="lgghost", client_key="ck_lgghost")
        self.assertEqual(
            [actor.name for actor in lg.registration_actors(live, ghost, include_ghost=False)],
            ["lg01"],
        )
        self.assertEqual(
            [actor.name for actor in lg.registration_actors(live, ghost, include_ghost=True)],
            ["lg01", "lgghost"],
        )


class EnduranceFixtureTests(unittest.TestCase):
    def test_controller_is_explicitly_human_and_never_enters_harness_revival(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("-e NEXUS_KIND=human", source)
        self.assertIn(
            'controller register --name "$CONTROLLER" --agent other --kind human',
            source,
        )

    def test_shared_thread_fixture_names_expose_harness_and_variant(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn(
            "printf '%s-%s-%s-%s\\n' \"$proper_name\" \"$harness\" \"$variant\" \"$CANDIDATE\"",
            source,
        )

    def test_shared_thread_fixture_builds_the_candidate_cli_before_launch(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        build = source.index("cargo build -p egregore-nexus --bin nexus")
        launch = source.index("nexus gateway start --json")
        self.assertLess(build, launch)

    def test_candidate_binary_reports_the_canonical_release_version(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn('FULL_CANDIDATE=$(git -C "$ROOT" rev-parse', source)
        self.assertIn('"$NEXUS_BIN" --version', source)
        self.assertIn('VERSION=$(tr -d', source)
        self.assertIn('test "$(cat "$OUT/runtime/nexus-version.txt")" = "nexus $VERSION"', source)
        self.assertIn('sha256sum "$NEXUS_BIN" > "$OUT/runtime/nexus-binary.sha256"', source)
        self.assertNotIn('NEXUS_BUILD_REVISION', source)
        self.assertNotIn('revision $FULL_CANDIDATE', source)

    def test_shared_thread_fixture_starts_and_sustains_a_bounded_debate(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("The hostile 4chan-style forum is open", source)
        self.assertIn("reply once to each new operator post", source)
        self.assertIn("reply only when you are directly named or challenged", source)
        self.assertIn("challenge exactly one named peer", source)
        self.assertNotIn("post exactly once when that message explicitly asks", source)
        self.assertNotIn("Do not answer peer posts until", source)

    def test_resurrection_controls_outrank_debate_traffic(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn(
            "resurrection proof control message takes absolute priority",
            source,
        )

    def test_shared_thread_fixture_assigns_balanced_randomized_thinkers(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("thinker-assignments.json", source)
        self.assertIn("Nietzsche", source)
        self.assertIn("Freud", source)
        self.assertIn("Jung", source)
        self.assertIn("Piaget", source)
        self.assertIn("random.Random(seed).shuffle(thinkers)", source)
        self.assertIn("--thinker-assignment", source)

    def test_shared_thread_fixture_keys_watchdog_participants_by_stable_agent_id(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn(
            "agent_id=$(jq -er '.runtimes[] | select(.active == true) | .agentId'",
            source,
        )
        self.assertIn(
            'watchdog_args+=(--participant-agent-id "$name=$agent_id")',
            source,
        )

    def test_shared_thread_fixture_is_profane_and_enables_adaptive_operator_pressure(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("4chan-style forum", source)
        self.assertIn("fuck", source)
        self.assertIn("shit", source)
        self.assertIn("brainlet", source)
        self.assertIn("--operator-min-seconds", source)
        self.assertIn("--operator-max-seconds", source)
        self.assertIn("--operator-seed", source)

    def test_endurance_fixture_defaults_to_the_two_cpu_eight_gib_budget(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn(
            "EXPECTED_CPUS=${NEXUS_ENDURANCE_EXPECT_CPUS:-2000000000}", source
        )
        self.assertIn(
            "EXPECTED_MEMORY_BYTES=${NEXUS_ENDURANCE_EXPECT_MEMORY_BYTES:-8589934592}",
            source,
        )
        self.assertIn('[ "$cpus" = "$EXPECTED_CPUS" ]', source)
        self.assertIn('[ "$memory" = "$EXPECTED_MEMORY_BYTES" ]', source)

    def test_endurance_fixture_records_exact_harness_versions(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("harness-versions.txt", source)
        for harness in ("claude", "codex", "opencode", "hermes"):
            self.assertIn(f'capture_harness_version "{harness}"', source)

    def test_endurance_fixture_preserves_container_path_when_capturing_harness_versions(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )
        capture = source.split("capture_harness_version() {", 1)[1].split("\n}\n", 1)[0]

        self.assertIn('bash -c', capture)
        self.assertNotIn('bash -lc', capture)

    def test_endurance_fixture_preflights_hermes_acp_dependencies(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn('hermes acp --check', source)
        self.assertLess(source.index('hermes acp --check'), source.index('launch_one()'))

    def test_endurance_fixture_preserves_container_path_for_hermes_preflight(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn(
            'docker exec "$CONTAINER" bash -c \'hermes acp --check\'', source
        )
        self.assertNotIn(
            'docker exec "$CONTAINER" bash -lc \'hermes acp --check\'', source
        )

    def test_endurance_fixture_requires_logged_in_claude_oauth_before_launch(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("claude-auth-status.json", source)
        self.assertIn(".loggedIn == true", source)
        self.assertLess(source.index("claude-auth-status.json"), source.index("launch_one()"))

    def test_endurance_fixture_requires_a_model_completed_readiness_dm(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        self.assertIn("ENDURANCE_READY_", source)
        self.assertIn("Use the Nexus bus exactly once to DM", source)
        self.assertIn('controller history --with "$name" --limit 20 --json', source)
        self.assertIn('.from == $name and .body == $marker', source)
        self.assertIn('[ "$ready_count" -eq 12 ]', source)

    def test_endurance_fixture_waits_for_all_model_turns_before_thread_traffic(self):
        source = (_PATH.parent / "nexus-v010-endurance-gate").read_text(
            encoding="utf-8"
        )

        launches_complete = source.index('done\n\nlog "Waiting for all 12 real harness variants')
        readiness = source.index("Waiting for all 12 model-completion readiness DMs")
        thread_create = source.index('log "Creating shared thread $THREAD"')
        opening = source.index('controller post "$THREAD" -m "$opening"')

        self.assertLess(launches_complete, readiness)
        self.assertLess(readiness, thread_create)
        self.assertLess(thread_create, opening)
        self.assertIn("readiness.tsv", source)


if __name__ == "__main__":
    unittest.main(verbosity=1)
