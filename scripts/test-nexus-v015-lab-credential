    def test_well_shaped_foreign_storage_temporary_is_never_consumed(self) -> None:
        document = dict(self.original_document)
        document["humanCookie"] = "v015-unknown-" + "a" * 40
        payload = json.dumps(document, ensure_ascii=False, indent=1).encode()
        temporary = self.plugin_dir / ".credential.storage.tmp-foreign-run-deadbeef"
        temporary.write_bytes(payload)
        temporary.chmod(0o640)
