    def test_sigkill_at_each_precommit_wedge_boundary_is_recoverable(self) -> None:
        for point in (
            "before-storage-backup-link",
            "storage-backup-linked-unflushed",
            "storage-backup-linked",
            "receipt-temp-fsynced-prepared",
            "receipt-replaced-prepared",
            "storage-replaced-wedged",
            "storage-fsynced-wedged",
            "receipt-temp-fsynced-wedged",
            "before-receipt-anchor-link-wedged",
            "receipt-anchor-linked-wedged",
        ):
            with self.subTest(point=point):
                barrier = self.crash_at("wedge", point)
                recovered = self.command("restore") if self.receipt.exists() else self.command("wedge")
                self.assertEqual(recovered.returncode, 0, recovered.stderr)
                if not self.receipt.exists() or self.receipt_document()["state"] != "restored":
                    restored = self.command("restore")
                    self.assertEqual(restored.returncode, 0, restored.stderr)
                self.assert_original_storage(inode=self.original_stat.st_ino)
                self.assertEqual(self.transaction_residue(), [])
                barrier.unlink(missing_ok=True)

    def test_sigkill_at_each_restore_boundary_is_recoverable(self) -> None:
        for point in (
            "storage-replaced-restored",
            "storage-fsynced-restored",
            "receipt-temp-fsynced-restored",
            "receipt-anchor-linked-restored",
            "receipt-anchor-fsynced-restored",
            "receipt-replaced-restored",
        ):
            with self.subTest(point=point):
                wedged = self.command("wedge")
                self.assertEqual(wedged.returncode, 0, wedged.stderr)
                barrier = self.crash_at("restore", point)
                restored = self.command("restore")
                self.assertEqual(restored.returncode, 0, restored.stderr)
                self.assert_original_storage(inode=self.original_stat.st_ino)
                self.assertEqual(self.transaction_residue(), [])
                barrier.unlink(missing_ok=True)

    def test_sigkill_with_anchor_and_restore_link_pair_completes_rollback(self) -> None:
