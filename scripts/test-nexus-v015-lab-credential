#!/usr/bin/env python3
"""External contract tests for the isolated v0.1.5 Lens credential hook."""

from __future__ import annotations

import hashlib
import importlib.machinery
import importlib.util
import json
import os
import signal
import stat
import subprocess
import sys
import tempfile
import time
import unittest
from pathlib import Path
from unittest import mock


ROOT = Path(__file__).resolve().parent.parent
TARGET = ROOT / "scripts/nexus-v015-lab-credential"


def sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


class LabCredentialContractTest(unittest.TestCase):
    def setUp(self) -> None:
        self.temporary = tempfile.TemporaryDirectory(prefix="nexus-v015-lab-credential-")
        self.temp = Path(self.temporary.name)
        self.lab_root = self.temp / "nexus-lens-home"
        self.lens_root = self.lab_root / "lens-data"
        self.plugin_dir = self.lens_root / "plugins" / "lens.nexus"
        self.metadata_lab_dir = self.lab_root / "lab"
        self.lab_dir = self.temp / "credential-authority"
        self.plugin_dir.mkdir(parents=True)
        self.metadata_lab_dir.mkdir(parents=True)
        self.lab_dir.mkdir(parents=True)
        self.metadata_lab_dir.chmod(0o700)
        self.lens_root.chmod(0o750)
        (self.lens_root / "plugins").chmod(0o750)
        self.plugin_dir.chmod(0o750)
        self.lab_dir.chmod(0o700)
        self.run_id = "credential-run"
        self.container_id = "0123456789abcdef" * 4
        self.readiness_bytes = (
            "schema=1\n"
            f"containerId={self.container_id}\n"
            "mode=packed\n"
            f"runId={self.run_id}\n"
            f"nexusSha256={'1' * 64}\n"
            f"gatewaySha256={'2' * 64}\n"
            f"webuiSha256={'3' * 64}\n"
        ).encode()
        # One candidate authority only: the hook reads the same root-owned
        # readiness ledger consumed by the rest of the lab.  The private state
        # root contains only the lock/journal/receipt recovery authority.
        self.readiness = self.metadata_lab_dir / "candidate-ready.v1"
        self.readiness.write_bytes(self.readiness_bytes)
        self.readiness.chmod(0o444)
        self.storage = self.plugin_dir / "storage.json"
        self.original_document = {
            "humanCookie": "human-cookie-original",
            "csrfToken": "csrf-token-original",
            "other": {"keep": True, "count": 7},
        }
        self.original_bytes = json.dumps(
            self.original_document, ensure_ascii=False, indent=1
        ).encode()
        self.storage.write_bytes(self.original_bytes)
        self.storage.chmod(0o640)
        self.env = {
            **os.environ,
            "HOME": str(self.temp / "unused-home"),
            "OCULAR_LAB": "1",
            "NEXUS_V015_ALLOW_FIXTURE_HOME": "1",
            "NEXUS_LAB_ROOT": str(self.lab_root),
            "LENS_DATA_HOME": str(self.lens_root),
            "NEXUS_V015_CREDENTIAL_STATE_ROOT": str(self.lab_dir),
            "NEXUS_V015_LAB_UID": str(os.geteuid()),
            "NEXUS_V015_LAB_GID": str(os.getegid()),
            "NEXUS_LAB_MODE": "packed",
            "NEXUS_V015_RUN_ID": self.run_id,
            "NEXUS_V015_CONTAINER_ID": self.container_id,
            "NEXUS_V015_READINESS_LEDGER_SHA256": sha256(self.readiness_bytes),
        }
        self.receipt = self.lab_dir / "credential.v1.json"
        self.plan = self.lab_dir / "credential.plan.v1.json"
        self.original_stat = self.storage.lstat()

    def tearDown(self) -> None:
        self.temporary.cleanup()

    def command(
        self, action: str, *, env: dict[str, str] | None = None
    ) -> subprocess.CompletedProcess[str]:
        if not TARGET.is_file():
            return subprocess.CompletedProcess(
                [str(TARGET), action],
                127,
                "",
                f"implementation script is missing: {TARGET}\n",
            )
        return subprocess.run(
            [str(TARGET), action],
            cwd=ROOT,
            env=env or self.env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
        )

    def load_target_module(self):
        name = f"nexus_v015_lab_credential_{id(self)}_{len(sys.modules)}"
        loader = importlib.machinery.SourceFileLoader(name, str(TARGET))
        spec = importlib.util.spec_from_loader(name, loader)
        if spec is None:
            self.fail(f"cannot load credential hook: {TARGET}")
        module = importlib.util.module_from_spec(spec)
        sys.modules[name] = module
        loader.exec_module(module)
        self.addCleanup(sys.modules.pop, name, None)
        return module

    def receipt_document(self) -> dict[str, object]:
        return json.loads(self.receipt.read_text(encoding="utf-8"))

    def transaction_residue(self) -> list[Path]:
        residues = [
                *self.lab_dir.glob(".credential.storage.backup-*"),
                *self.lab_dir.glob(".credential.v1.json.tmp-*"),
                *self.lab_dir.glob(".credential.v1.json.backup-*"),
                *self.lab_dir.glob(".credential.v1.json.restore-*"),
                *self.lab_dir.glob(".credential.plan.v1.json.tmp-*"),
                *self.plugin_dir.glob(".credential.storage.tmp-*"),
        ]
        if self.plan.exists() or self.plan.is_symlink():
            residues.append(self.plan)
        return sorted(residues, key=str)

    def assert_original_storage(self, *, inode: int) -> None:
        current = self.storage.lstat()
        self.assertEqual(self.storage.read_bytes(), self.original_bytes)
        self.assertEqual(stat.S_IMODE(current.st_mode), 0o640)
        self.assertEqual(current.st_ino, inode)
        self.assertEqual(current.st_uid, self.original_stat.st_uid)
        self.assertEqual(current.st_gid, self.original_stat.st_gid)
        self.assertEqual(current.st_mtime_ns, self.original_stat.st_mtime_ns)
        self.assertEqual(current.st_nlink, self.original_stat.st_nlink)

    def wait_for_barrier(self, barrier: Path, process: subprocess.Popen[str]) -> None:
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            if barrier.exists():
                return
            if process.poll() is not None:
                stdout, stderr = process.communicate()
                self.fail(
                    f"credential hook exited before barrier: {process.returncode}\n"
                    f"stdout={stdout}\nstderr={stderr}"
                )
            time.sleep(0.02)
        process.kill()
        stdout, stderr = process.communicate()
        self.fail(f"credential hook never reached barrier\nstdout={stdout}\nstderr={stderr}")

    def crash_at(
        self,
        action: str,
        point: str,
        *,
        fault: str | None = None,
        env: dict[str, str] | None = None,
    ) -> Path:
        barrier = self.lab_dir / f"{point}.barrier"
        crash_env = {
            **(env or self.env),
            "NEXUS_V015_TEST_BARRIER": point,
            "NEXUS_V015_TEST_BARRIER_PATH": str(barrier),
        }
        if fault is not None:
            crash_env["NEXUS_V015_TEST_FAULT"] = fault
        process = subprocess.Popen(
            [str(TARGET), action],
            cwd=ROOT,
            env=crash_env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        self.wait_for_barrier(barrier, process)
        os.kill(process.pid, signal.SIGKILL)
        process.communicate(timeout=10)
        self.assertEqual(process.returncode, -signal.SIGKILL)
        return barrier

    def rotate_run(self, run_id: str) -> dict[str, str]:
        changed = self.readiness_bytes.replace(
            f"runId={self.run_id}".encode(), f"runId={run_id}".encode()
        )
        self.readiness.chmod(0o600)
        self.readiness.write_bytes(changed)
        self.readiness.chmod(0o444)
        return {
            **self.env,
            "NEXUS_V015_RUN_ID": run_id,
            "NEXUS_V015_READINESS_LEDGER_SHA256": sha256(changed),
        }

    def test_help_is_side_effect_free_before_lab_guard(self) -> None:
        env = {**os.environ, "HOME": str(self.temp / "unused-home")}
        before = sorted(str(path.relative_to(self.temp)) for path in self.temp.rglob("*"))

        result = subprocess.run(
            [str(TARGET), "--help"],
            cwd=ROOT,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=10,
        ) if TARGET.is_file() else self.command("--help", env=env)

        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("lab-credential wedge|restore", result.stdout)
        after = sorted(str(path.relative_to(self.temp)) for path in self.temp.rglob("*"))
        self.assertEqual(after, before)

    def test_refuses_host_execution_and_unsafe_lab_paths(self) -> None:
        no_lab = {**self.env}
        no_lab.pop("OCULAR_LAB")
        outside_lens = self.temp / "outside-lens"
        outside_lens.mkdir()
        wrong_lens = {**self.env, "LENS_DATA_HOME": str(outside_lens)}

        outside = self.command("wedge", env=no_lab)
        escaped = self.command("wedge", env=wrong_lens)

        self.assertEqual(outside.returncode, 3)
        self.assertIn("error[LAB_CREDENTIAL_LAB_ONLY]", outside.stderr)
        self.assertEqual(escaped.returncode, 4)
        self.assertIn("error[LAB_CREDENTIAL_PATH_UNSAFE]", escaped.stderr)
        self.assertEqual(self.storage.read_bytes(), self.original_bytes)
        self.assertFalse(self.receipt.exists())

    def test_refuses_symlink_ancestry_without_touching_target(self) -> None:
        plugins = self.lens_root / "plugins"
        real_plugins = self.lens_root / "plugins-real"
        plugins.rename(real_plugins)
        plugins.symlink_to(real_plugins, target_is_directory=True)
        redirected = real_plugins / "lens.nexus" / "storage.json"
        before = redirected.read_bytes()

        result = self.command("wedge")

        self.assertEqual(result.returncode, 4)
        self.assertIn("error[LAB_CREDENTIAL_PATH_UNSAFE]", result.stderr)
        self.assertEqual(redirected.read_bytes(), before)
        self.assertFalse(self.receipt.exists())

    def test_credential_authority_is_separate_strict_and_not_lens_owned(self) -> None:
        inside = self.lab_root / "credential-authority"
        inside.mkdir(mode=0o700)
        inside_env = {
            **self.env,
            "NEXUS_V015_CREDENTIAL_STATE_ROOT": str(inside),
        }
        permissive = {**self.env}
        self.lab_dir.chmod(0o750)

        inside_result = self.command("wedge", env=inside_env)
        permissive_result = self.command("wedge", env=permissive)

        self.assertEqual(inside_result.returncode, 4, inside_result.stderr)
        self.assertEqual(permissive_result.returncode, 4, permissive_result.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertFalse(self.receipt.exists())

    def test_credential_authority_inode_replacement_before_lock_fails_closed(self) -> None:
        module = self.load_target_module()
        paths = module.resolve_lab_paths(dict(self.env))
        self.addCleanup(module.close_lab_paths, paths)
        original_authority = self.temp / "credential-authority-original"
        self.lab_dir.rename(original_authority)
        self.lab_dir.mkdir(mode=0o700)

        with self.assertRaises(module.CredentialError) as caught:
            with module.acquire_lock(
                paths, owner=os.geteuid(), group=os.getegid()
            ):
                self.fail("replaced authority unexpectedly acquired the lock")

        self.assertEqual(caught.exception.kind, "LAB_CREDENTIAL_PATH_UNSAFE")
        self.assert_original_storage(inode=self.original_stat.st_ino)

    def test_single_readiness_authority_is_metadata_ledger_not_private_copy(self) -> None:
        module = self.load_target_module()
        paths = module.resolve_lab_paths(dict(self.env))
        self.addCleanup(module.close_lab_paths, paths)

        self.assertEqual(paths.readiness, self.readiness)
        self.assertEqual(paths.readiness.parent, self.metadata_lab_dir)
        self.assertFalse((self.lab_dir / "candidate-ready.v1").exists())

        shadow = self.lab_dir / "candidate-ready.v1"
        shadow.write_bytes(self.readiness_bytes.replace(b"credential-run", b"shadow-run"))
        shadow.chmod(0o444)
        result = self.command("wedge")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(json.loads(result.stdout)["runId"], self.run_id)

    def test_metadata_and_plugin_directory_anchors_fail_when_replaced(self) -> None:
        module = self.load_target_module()
        for label in ("metadata", "plugin"):
            with self.subTest(label=label):
                paths = module.resolve_lab_paths(dict(self.env))
                self.addCleanup(module.close_lab_paths, paths)
                target = self.metadata_lab_dir if label == "metadata" else self.plugin_dir
                moved = target.with_name(target.name + "-anchored")
                target.rename(moved)
                target.mkdir(mode=0o700 if label == "metadata" else 0o750)
                try:
                    with self.assertRaises(module.CredentialError) as caught:
                        module.validate_anchored_directories(paths)
                    self.assertEqual(caught.exception.kind, "LAB_CREDENTIAL_PATH_UNSAFE")
                finally:
                    target.rmdir()
                    moved.rename(target)

    def test_unreadable_or_wrong_mode_authority_is_rejected_without_secret_output(self) -> None:
        self.lab_dir.chmod(0)
        try:
            result = self.command("wedge")
        finally:
            self.lab_dir.chmod(0o700)

        self.assertEqual(result.returncode, 4, result.stderr)
        combined = result.stdout + result.stderr
        self.assertNotIn(self.original_document["humanCookie"], combined)
        self.assertNotIn(self.original_document["csrfToken"], combined)
        self.assert_original_storage(inode=self.original_stat.st_ino)

    def test_hardlink_allocator_retries_eexist_without_empty_reservation(self) -> None:
        module = self.load_target_module()
        occupied = self.lab_dir / ".probe-deadbeef"
        occupied.write_bytes(b"foreign")
        occupied.chmod(0o600)
        tokens = iter(["deadbeef", "feedface"])

        with mock.patch.object(module.secrets, "token_hex", side_effect=lambda _n: next(tokens)):
            linked, linked_data = module.hardlink_at_absent_name(
                self.storage,
                self.lab_dir,
                ".probe-",
                label="probe link",
                error_kind="LAB_CREDENTIAL_IO",
                limit=module.MAX_STORAGE_BYTES,
            )

        self.assertEqual(occupied.read_bytes(), b"foreign")
        self.assertEqual(linked.path.name, ".probe-feedface")
        self.assertEqual(linked_data, self.original_bytes)
        self.assertEqual(linked.inode, self.original_stat.st_ino)
        self.assertEqual(linked.nlink, 2)
        linked.path.unlink()

    def test_requires_exact_run_and_readiness_binding(self) -> None:
        wrong_run = {**self.env, "NEXUS_V015_RUN_ID": "other-run"}
        wrong_digest = {
            **self.env,
            "NEXUS_V015_READINESS_LEDGER_SHA256": "f" * 64,
        }

        run_result = self.command("wedge", env=wrong_run)
        digest_result = self.command("wedge", env=wrong_digest)

        self.assertEqual(run_result.returncode, 5)
        self.assertIn("error[LAB_CREDENTIAL_CANDIDATE_INVALID]", run_result.stderr)
        self.assertEqual(digest_result.returncode, 5)
        self.assertIn("error[LAB_CREDENTIAL_CANDIDATE_INVALID]", digest_result.stderr)
        self.assertEqual(self.storage.read_bytes(), self.original_bytes)
        self.assertFalse(self.receipt.exists())

    def test_requires_mode_and_current_full_container_binding(self) -> None:
        missing_mode = {**self.env}
        missing_mode.pop("NEXUS_LAB_MODE")
        missing_container = {**self.env}
        missing_container.pop("NEXUS_V015_CONTAINER_ID")
        wrong_container = {
            **self.env,
            "NEXUS_V015_CONTAINER_ID": "f" * 64,
        }

        results = [
            self.command("wedge", env=missing_mode),
            self.command("wedge", env=missing_container),
            self.command("wedge", env=wrong_container),
        ]

        for result in results:
            self.assertEqual(result.returncode, 5, result.stderr)
            self.assertIn("error[LAB_CREDENTIAL_CANDIDATE_INVALID]", result.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertFalse(self.receipt.exists())

    def test_rejects_noncanonical_container_id_in_readiness(self) -> None:
        invalid = self.readiness_bytes.replace(
            self.container_id.encode(), b"0123456789abcdef"
        )
        self.readiness.chmod(0o600)
        self.readiness.write_bytes(invalid)
        self.readiness.chmod(0o444)
        env = {
            **self.env,
            "NEXUS_V015_CONTAINER_ID": "0123456789abcdef",
            "NEXUS_V015_READINESS_LEDGER_SHA256": sha256(invalid),
        }

        result = self.command("wedge", env=env)

        self.assertEqual(result.returncode, 5, result.stderr)
        self.assertIn("error[LAB_CREDENTIAL_CANDIDATE_INVALID]", result.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)

    def test_rejects_malformed_storage_and_missing_credential_twin(self) -> None:
        malformed_cases = (
            b"{not-json",
            b"[]",
            b'{"humanCookie":"only-cookie"}',
            b'{"csrfToken":"only-csrf"}',
            b'{"humanCookie":"","csrfToken":"csrf"}',
            b'{"humanCookie":"cookie","csrfToken":""}',
            b'{"humanCookie":"a","humanCookie":"b","csrfToken":"c"}',
        )
        for index, payload in enumerate(malformed_cases):
            with self.subTest(index=index):
                self.storage.write_bytes(payload)
                result = self.command("wedge")
                self.assertEqual(result.returncode, 6, result.stderr)
                self.assertIn("error[LAB_CREDENTIAL_STORAGE_INVALID]", result.stderr)
                self.assertEqual(self.storage.read_bytes(), payload)
                self.assertFalse(self.receipt.exists())

    def test_storage_authority_requires_configured_owner_safe_modes_and_one_link(self) -> None:
        hardlink = self.temp / "storage-hardlink"
        cases = (
            ("writable-lens", lambda: self.lens_root.chmod(0o770), self.env),
            ("writable-plugin", lambda: self.plugin_dir.chmod(0o772), self.env),
            ("writable-storage", lambda: self.storage.chmod(0o660), self.env),
            ("linked-storage", lambda: os.link(self.storage, hardlink), self.env),
            (
                "wrong-configured-owner",
                lambda: None,
                {**self.env, "NEXUS_V015_LAB_UID": str(os.geteuid() + 1)},
            ),
        )
        for name, mutate, env in cases:
            with self.subTest(name=name):
                mutate()
                result = self.command("wedge", env=env)
                self.assertEqual(result.returncode, 4, result.stderr)
                self.assertIn("error[LAB_CREDENTIAL_PATH_UNSAFE]", result.stderr)
                self.assertEqual(self.storage.read_bytes(), self.original_bytes)
                self.assertFalse(self.receipt.exists())
                if hardlink.exists():
                    hardlink.unlink()
                self.lens_root.chmod(0o750)
                self.plugin_dir.chmod(0o750)
                self.storage.chmod(0o640)

    def test_fd_backed_read_detects_post_open_replacement_and_symlink(self) -> None:
        for replacement_kind in ("file", "symlink"):
            with self.subTest(replacement=replacement_kind):
                module = self.load_target_module()
                original_path = self.storage
                moved = self.plugin_dir / f"storage-{replacement_kind}-opened"
                real_read = module._read_fd
                swapped = False

                def swap_after_open(descriptor, size):
                    nonlocal swapped
                    data = real_read(descriptor, size)
                    if not swapped:
                        swapped = True
                        original_path.rename(moved)
                        if replacement_kind == "file":
                            original_path.write_bytes(self.original_bytes)
                            original_path.chmod(0o640)
                        else:
                            original_path.symlink_to(moved)
                    return data

                with mock.patch.object(module, "_read_fd", side_effect=swap_after_open):
                    with self.assertRaises(module.CredentialError):
                        module.read_owned_file(
                            original_path,
                            "storage",
                            "LAB_CREDENTIAL_STORAGE_INVALID",
                        )
                if original_path.is_symlink() or original_path.exists():
                    original_path.unlink()
                moved.rename(original_path)

    def test_wedge_and_restore_are_exact_and_idempotent(self) -> None:
        original = self.storage.lstat()
        original_sha = sha256(self.original_bytes)

        first = self.command("wedge")
        wedged_stat = self.storage.lstat()
        wedged_bytes = self.storage.read_bytes()
        second = self.command("wedge")

        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertEqual(json.loads(first.stdout)["status"], "wedged")
        self.assertEqual(json.loads(second.stdout)["status"], "unchanged")
        self.assertEqual(self.storage.lstat().st_ino, wedged_stat.st_ino)
        self.assertEqual(self.storage.read_bytes(), wedged_bytes)
        wedged = json.loads(wedged_bytes)
        self.assertNotEqual(wedged["humanCookie"], self.original_document["humanCookie"])
        self.assertTrue(wedged["humanCookie"].startswith("v015-unknown-"))
        self.assertEqual(wedged["csrfToken"], self.original_document["csrfToken"])
        self.assertEqual(wedged["other"], self.original_document["other"])
        self.assertNotEqual(wedged_stat.st_ino, original.st_ino)
        self.assertEqual(stat.S_IMODE(wedged_stat.st_mode), 0o640)

        receipt_stat = self.receipt.lstat()
        receipt = self.receipt_document()
        self.assertEqual(stat.S_IMODE(receipt_stat.st_mode), 0o600)
        self.assertEqual(receipt_stat.st_uid, os.geteuid())
        self.assertEqual(receipt["schemaVersion"], 1)
        self.assertEqual(receipt["state"], "wedged")
        self.assertEqual(receipt["runId"], self.run_id)
        self.assertEqual(receipt["readinessSha256"], sha256(self.readiness_bytes))
        self.assertEqual(receipt["original"]["sha256"], original_sha)
        backup = Path(receipt["backup"]["path"])
        self.assertTrue(backup.is_file())
        self.assertEqual(backup.read_bytes(), self.original_bytes)
        self.assertEqual(backup.lstat().st_ino, original.st_ino)

        restored = self.command("restore")
        restored_receipt_inode = self.receipt.lstat().st_ino
        restored_again = self.command("restore")

        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assertEqual(restored_again.returncode, 0, restored_again.stderr)
        self.assertEqual(json.loads(restored.stdout)["status"], "restored")
        self.assertEqual(json.loads(restored_again.stdout)["status"], "unchanged")
        self.assert_original_storage(inode=original.st_ino)
        self.assertFalse(backup.exists())
        self.assertEqual(self.receipt_document()["state"], "restored")
        self.assertEqual(self.receipt.lstat().st_ino, restored_receipt_inode)
        self.assertEqual(self.transaction_residue(), [])

    def test_absent_receipt_valid_orphan_backup_is_reconciled_before_wedge(self) -> None:
        module = self.load_target_module()
        paths = module.resolve_lab_paths(dict(self.env))
        self.addCleanup(module.close_lab_paths, paths)
        binding = module.load_candidate(paths, dict(self.env), os.geteuid())
        original, _ = module.read_owned_file(
            self.storage,
            "storage",
            "LAB_CREDENTIAL_STORAGE_INVALID",
            limit=module.MAX_STORAGE_BYTES,
        )
        orphan = self.lab_dir / (
            module.storage_backup_prefix(paths, binding, original) + "orphan"
        )
        os.link(self.storage, orphan)
        self.assertEqual(self.storage.lstat().st_nlink, 2)

        wedged = self.command("wedge")
        restored = self.command("restore")

        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

    def test_absent_receipt_adversarial_orphan_fails_closed(self) -> None:
        orphan = self.lab_dir / ".credential.storage.backup-attacker"
        orphan.write_bytes(b"attacker")
        before = orphan.lstat()

        result = self.command("wedge")

        self.assertNotEqual(result.returncode, 0, result.stdout)
        self.assertIn("error[LAB_CREDENTIAL_REPLACED]", result.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
