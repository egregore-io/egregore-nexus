                barrier.unlink(missing_ok=True)

    def test_temporary_fsync_failure_leaves_original_and_no_transaction_residue(self) -> None:
        module = self.load_target_module()
        original_inode = self.storage.lstat().st_ino
        real_fsync = module.os.fsync
        failed = False

        def fail_first_regular_file(descriptor):
            nonlocal failed
            metadata = module.os.fstat(descriptor)
            if stat.S_ISREG(metadata.st_mode) and not failed:
                failed = True
                raise OSError("injected temporary-file fsync failure")
            return real_fsync(descriptor)

        with mock.patch.object(module.os, "fsync", side_effect=fail_first_regular_file):
            with self.assertRaises(OSError):
                module.wedge(dict(self.env))

        self.assertTrue(failed)
        self.assert_original_storage(inode=original_inode)
        self.assertFalse(self.receipt.exists())
        self.assertEqual(
            list(self.plugin_dir.glob(".credential.storage.tmp-*")), []
        )
        self.assertEqual(
            list(self.lab_dir.glob(".credential.storage.backup-*")), []
        )

    def test_existing_lock_with_unsafe_mode_fails_closed(self) -> None:
        lock = self.lab_dir / "credential.lock"
        lock.write_text("foreign", encoding="utf-8")
        lock.chmod(0o644)

        result = self.command("wedge")

        self.assertEqual(result.returncode, 4)
        self.assertIn("error[LAB_CREDENTIAL_PATH_UNSAFE]", result.stderr)
        self.assertEqual(stat.S_IMODE(lock.lstat().st_mode), 0o644)
        self.assertEqual(self.storage.read_bytes(), self.original_bytes)
        self.assertFalse(self.receipt.exists())

    def test_unknown_token_is_deterministic_and_run_bound_without_leaking_original(self) -> None:
        first = self.command("wedge")
        first_cookie = json.loads(self.storage.read_text())["humanCookie"]
        receipt_text = self.receipt.read_text(encoding="utf-8")
        restore = self.command("restore")
        second = self.command("wedge")
        second_cookie = json.loads(self.storage.read_text())["humanCookie"]

        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertEqual(restore.returncode, 0, restore.stderr)
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertEqual(first_cookie, second_cookie)
        self.assertNotIn(self.original_document["humanCookie"], receipt_text)
        self.assertNotIn(self.original_document["csrfToken"], receipt_text)

    def test_restore_refuses_storage_or_backup_replacement_and_retains_recovery(self) -> None:
        original = self.storage.lstat()
        wedged = self.command("wedge")
        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        receipt = self.receipt_document()
        backup = Path(receipt["backup"]["path"])
        backup_bytes = backup.read_bytes()
        replacement = b'{"humanCookie":"replacement","csrfToken":"replacement-csrf"}'
        replacement_temp = self.plugin_dir / "replacement.json"
        replacement_temp.write_bytes(replacement)
        os.replace(replacement_temp, self.storage)

        refused = self.command("restore")

        self.assertEqual(refused.returncode, 8)
        self.assertIn("error[LAB_CREDENTIAL_REPLACED]", refused.stderr)
        self.assertEqual(self.storage.read_bytes(), replacement)
        self.assertEqual(backup.read_bytes(), backup_bytes)
        self.assertEqual(backup.lstat().st_ino, original.st_ino)
        self.assertEqual(self.receipt_document()["state"], "wedged")

    def test_restore_refuses_replaced_backup_without_touching_wedged_storage(self) -> None:
        wedged = self.command("wedge")
        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        receipt = self.receipt_document()
        backup = Path(receipt["backup"]["path"])
        original_wedge = self.storage.read_bytes()
        backup.unlink()
        backup.write_bytes(b"attacker")

        refused = self.command("restore")

        self.assertEqual(refused.returncode, 8)
        self.assertIn("error[LAB_CREDENTIAL_REPLACED]", refused.stderr)
        self.assertEqual(self.storage.read_bytes(), original_wedge)
        self.assertEqual(backup.read_bytes(), b"attacker")

    def test_receipt_is_fail_closed_for_symlink_hardlink_mode_and_binding_changes(self) -> None:
        wedged = self.command("wedge")
        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        wedged_bytes = self.storage.read_bytes()

        receipt_real = self.lab_dir / "receipt-real.json"
        self.receipt.rename(receipt_real)
        self.receipt.symlink_to(receipt_real)
        symlink = self.command("restore")
        self.receipt.unlink()
        receipt_real.rename(self.receipt)
        self.receipt.chmod(0o644)
        bad_mode = self.command("restore")
        self.receipt.chmod(0o600)
        hardlink = self.lab_dir / "receipt-hardlink.json"
        os.link(self.receipt, hardlink)
        bad_links = self.command("restore")

        self.assertEqual(symlink.returncode, 4)
        self.assertEqual(bad_mode.returncode, 7)
        self.assertEqual(bad_links.returncode, 7)
        self.assertEqual(self.storage.read_bytes(), wedged_bytes)
        self.assertTrue(hardlink.exists())

    def test_run_rotation_recovers_stale_receipt_before_new_wedge(self) -> None:
        wedged = self.command("wedge")
        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        first_cookie = json.loads(self.storage.read_text())["humanCookie"]
        self.readiness.chmod(0o600)
        next_run = "credential-run-next"
        changed = self.readiness_bytes.replace(
            f"runId={self.run_id}".encode(), f"runId={next_run}".encode()
        )
        self.readiness.write_bytes(changed)
        self.readiness.chmod(0o444)
        env = {
            **self.env,
            "NEXUS_V015_RUN_ID": next_run,
            "NEXUS_V015_READINESS_LEDGER_SHA256": sha256(changed),
        }

        result = self.command("wedge", env=env)
        second_cookie = json.loads(self.storage.read_text())["humanCookie"]
        restored = self.command("restore", env=env)

        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(json.loads(result.stdout)["status"], "wedged")
        self.assertNotEqual(second_cookie, first_cookie)
        self.assertEqual(self.receipt_document()["runId"], next_run)
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

    def test_cross_run_restore_tombstone_survives_kill_before_response(self) -> None:
        wedged = self.command("wedge")
        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        next_env = self.rotate_run("credential-run-b")

        barrier = self.crash_at(
            "restore", "stale-receipt-restored", env=next_env
        )
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertTrue(self.receipt.exists())
        self.assertEqual(self.receipt_document()["state"], "restored")

        retried = self.command("restore", env=next_env)

        self.assertEqual(retried.returncode, 0, retried.stderr)
        self.assertIn(json.loads(retried.stdout)["status"], {"restored", "unchanged"})
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.receipt_document()["state"], "restored")
        barrier.unlink(missing_ok=True)

    def test_public_artifacts_and_process_streams_never_leak_credential_twins(self) -> None:
        outputs: list[str] = []
        wedged = self.command("wedge")
        outputs.extend((wedged.stdout, wedged.stderr))
        self.assertEqual(wedged.returncode, 0, wedged.stderr)

        # The root-only hard-link rollback anchor necessarily contains the
        # original bytes.  Everything public/readable by the Lens UID and every
        # hook stream must remain redacted.
        for root in (self.lab_root, self.lab_dir):
            for artifact in root.rglob("*"):
                if not artifact.is_file():
                    continue
                if artifact == self.storage or artifact.name.startswith(
                    ".credential.storage.backup-"
                ):
                    # The live Lens storage and its private exact-inode rollback
                    # anchor necessarily contain the twin; neither is evidence
                    # or a hook output artifact.
                    continue
                outputs.append(artifact.read_text(encoding="utf-8", errors="replace"))

        restored = self.command("restore")
        outputs.extend((restored.stdout, restored.stderr))
        self.assertEqual(restored.returncode, 0, restored.stderr)

        exposed = "\n".join(outputs)
        self.assertNotIn(self.original_document["humanCookie"], exposed)
        self.assertNotIn(self.original_document["csrfToken"], exposed)

    def test_production_contract_keeps_root_authority_distinct_from_lens_uid(self) -> None:
        module = self.load_target_module()
        lens_uid, lens_gid = module.configured_lab_identity(
            {"NEXUS_V015_LAB_UID": "4242", "NEXUS_V015_LAB_GID": "4343"}
        )
        owner, group, mode = module.expected_metadata_authority(
            module.CANONICAL_ROOT, {}
        )

        self.assertEqual((owner, group, mode), (0, 0, 0o1777))
        self.assertEqual((lens_uid, lens_gid), (4242, 4343))
        self.assertNotEqual(owner, lens_uid)
        self.assertEqual(module.expected_receipt_owner(module.CANONICAL_ROOT, {}), 0)
        with self.assertRaises(module.CredentialError) as same_owner:
            module.require_distinct_lens_authority(
                module.CANONICAL_ROOT,
                lab_uid=0,
                receipt_owner=0,
            )
        self.assertEqual(same_owner.exception.kind, "LAB_CREDENTIAL_LAB_ONLY")
        with (
            mock.patch.object(module, "CANONICAL_ROOT", self.lab_root),
            mock.patch.object(module, "CANONICAL_STATE_ROOT", self.lab_dir),
            mock.patch.object(
                module, "expected_receipt_owner", return_value=os.geteuid()
            ),
            mock.patch.object(
                module, "expected_receipt_group", return_value=os.getegid()
            ),
        ):
            with self.assertRaises(module.CredentialError) as before_mutation:
                module.resolve_lab_paths(dict(self.env))
        self.assertEqual(before_mutation.exception.kind, "LAB_CREDENTIAL_LAB_ONLY")
        self.assertIn("must be distinct", str(before_mutation.exception))
        self.assertFalse((self.lab_dir / "credential.lock").exists())
        with mock.patch.object(module.os, "geteuid", return_value=lens_uid):
            with self.assertRaises(module.CredentialError) as caught:
                module.require_invoker_for_receipt(module.CANONICAL_ROOT, {})
        self.assertEqual(caught.exception.kind, "LAB_CREDENTIAL_LAB_ONLY")

    def test_same_uid_race_claim_is_explicitly_outside_the_lock_contract(self) -> None:
        source = TARGET.read_text(encoding="utf-8")

        self.assertIn("All participating\nwriters MUST serialize on this hook's lock", source)
        self.assertIn("uncooperative\nsame-UID/root process racing pathnames is explicitly outside this contract", source)

    def test_ambiguous_wedge_replace_is_classified_and_remains_restorable(self) -> None:
        module = self.load_target_module()
        original_inode = self.storage.lstat().st_ino
        real_replace = module.os.replace
        raised = False

        def replace_then_raise(source, destination):
            nonlocal raised
            real_replace(source, destination)
            if Path(destination) == self.storage and not raised:
                raised = True
                raise OSError("injected post-wedge replace error")

        with mock.patch.object(module.os, "replace", side_effect=replace_then_raise):
            result = module.wedge(dict(self.env))

        self.assertEqual(result["status"], "wedged")
        self.assertNotEqual(self.storage.lstat().st_ino, original_inode)
        self.assertEqual(self.receipt_document()["state"], "wedged")
        restored = self.command("restore")
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=original_inode)

    def test_ambiguous_restore_replace_is_classified_as_restored(self) -> None:
        module = self.load_target_module()
        original_inode = self.storage.lstat().st_ino
        wedged = module.wedge(dict(self.env))
        self.assertEqual(wedged["status"], "wedged")
        real_replace = module.os.replace
        raised = False

        def replace_then_raise(source, destination):
            nonlocal raised
            real_replace(source, destination)
            if Path(destination) == self.storage and not raised:
                raised = True
                raise OSError("injected post-restore replace error")

        with mock.patch.object(module.os, "replace", side_effect=replace_then_raise):
            result = module.restore(dict(self.env))

        self.assertEqual(result["status"], "restored")
        self.assert_original_storage(inode=original_inode)
        self.assertEqual(self.receipt_document()["state"], "restored")

    def test_prepared_receipt_recovers_after_post_replace_receipt_failure(self) -> None:
        module = self.load_target_module()
        original_inode = self.storage.lstat().st_ino
        real_publish = module.publish_receipt
        calls = 0

        def fail_second_publish(*args, **kwargs):
            nonlocal calls
            calls += 1
            if calls == 2:
                raise OSError("injected final receipt failure")
            return real_publish(*args, **kwargs)

        with mock.patch.object(module, "publish_receipt", side_effect=fail_second_publish):
            with self.assertRaises(OSError):
                module.wedge(dict(self.env))

        self.assertEqual(self.receipt_document()["state"], "prepared")
        self.assertNotEqual(self.storage.lstat().st_ino, original_inode)
        restored = self.command("restore")
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=original_inode)

    def test_receipt_transition_post_replace_error_keeps_exact_prior_recovery(self) -> None:
        module = self.load_target_module()
        real_replace = module.os.replace
        injected = False

        def replace_wedged_receipt_then_raise(source, destination):
            nonlocal injected
            source_path = Path(source)
            destination_path = Path(destination)
            state = None
            if destination_path == self.receipt and source_path.exists():
                try:
                    state = json.loads(source_path.read_text(encoding="utf-8")).get("state")
                except (OSError, json.JSONDecodeError):
                    pass
            real_replace(source, destination)
            if destination_path == self.receipt and state == "wedged" and not injected:
                injected = True
                raise OSError("injected post-transition replace error")

        with mock.patch.object(
            module.os, "replace", side_effect=replace_wedged_receipt_then_raise
        ):
            with self.assertRaises(OSError):
                module.wedge(dict(self.env))

        self.assertTrue(injected)
        # Whichever receipt state is visible must retain a complete exact
        # recovery chain. A retry may normalize it, but never lose authority.
        self.assertTrue(self.receipt.exists())
        restored = self.command("restore")
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

    def test_receipt_transition_directory_fsync_failure_is_recoverable(self) -> None:
        module = self.load_target_module()
        real_fsync_directory = module.fsync_directory
        failed = False

        def fail_after_wedged_receipt(path):
            nonlocal failed
            if Path(path) == self.lab_dir and self.receipt.exists() and not failed:
                try:
                    state = self.receipt_document().get("state")
                except (OSError, json.JSONDecodeError):
                    state = None
                if state == "wedged":
                    failed = True
                    raise OSError("injected wedged-receipt directory fsync failure")
            return real_fsync_directory(path)

        with mock.patch.object(
            module, "fsync_directory", side_effect=fail_after_wedged_receipt
        ):
            with self.assertRaises(OSError):
                module.wedge(dict(self.env))

        self.assertTrue(failed)
        restored = self.command("restore")
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

    def test_receipt_transition_indeterminate_rollback_retains_recovery(self) -> None:
        module = self.load_target_module()
        real_fsync_directory = module.fsync_directory
        real_replace = module.os.replace
        commit_failed = False

        def fail_commit_fsync(path):
            nonlocal commit_failed
            if Path(path) == self.lab_dir and self.receipt.exists() and not commit_failed:
                try:
                    state = self.receipt_document().get("state")
                except (OSError, json.JSONDecodeError):
                    state = None
                if state == "wedged":
                    commit_failed = True
                    raise OSError("injected receipt commit fsync failure")
            return real_fsync_directory(path)

        def fail_restore_replace(source, destination):
            if (
                commit_failed
                and Path(destination) == self.receipt
                and Path(source).name.startswith(".credential.v1.json.restore-")
            ):
                raise OSError("injected receipt rollback replace failure")
            return real_replace(source, destination)

        with mock.patch.object(
            module, "fsync_directory", side_effect=fail_commit_fsync
        ), mock.patch.object(module.os, "replace", side_effect=fail_restore_replace):
            with self.assertRaises(module.ReceiptPublishError) as caught:
                module.wedge(dict(self.env))

        self.assertEqual(caught.exception.state, "indeterminate")
        self.assertTrue(list(self.lab_dir.glob(".credential.v1.json.backup-*")))
        self.assertTrue(list(self.lab_dir.glob(".credential.storage.backup-*")))

        restored = self.command("restore")

        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

    def test_first_receipt_post_commit_probe_failure_retains_recovery(self) -> None:
        module = self.load_target_module()
        real_read_owned = module.read_owned_file
        receipt_reads = 0

        def fail_final_receipt_probe(path, *args, **kwargs):
            nonlocal receipt_reads
            if Path(path) == self.receipt and self.receipt.exists():
                receipt_reads += 1
                if receipt_reads == 2:
                    raise OSError("injected final committed-receipt probe failure")
            return real_read_owned(path, *args, **kwargs)

        with mock.patch.object(
            module, "read_owned_file", side_effect=fail_final_receipt_probe
        ):
            with self.assertRaises(module.ReceiptPublishError) as caught:
                module.wedge(dict(self.env))

        self.assertEqual(caught.exception.state, "indeterminate")
        self.assertTrue(self.receipt.exists())
        self.assertTrue(list(self.lab_dir.glob(".credential.storage.backup-*")))

        restored = self.command("restore")

        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

    def test_production_owner_contract_requires_root_but_fixture_seam_uses_invoker(self) -> None:
        module = self.load_target_module()
        canonical = Path("/tmp/nexus-lens-home")

        self.assertEqual(module.expected_receipt_owner(canonical, {}), 0)
        self.assertEqual(
            module.expected_receipt_owner(
                canonical, {"NEXUS_V015_ALLOW_FIXTURE_HOME": "1"}
            ),
            0,
        )
        self.assertEqual(
            module.expected_receipt_owner(
                self.lab_root, {"NEXUS_V015_ALLOW_FIXTURE_HOME": "1"}
            ),
            os.geteuid(),
        )
        if os.geteuid() != 0:
            with self.assertRaises(module.CredentialError) as caught:
                module.require_invoker_for_receipt(canonical, {})
            self.assertEqual(caught.exception.kind, "LAB_CREDENTIAL_LAB_ONLY")


