        self.assertEqual(orphan.lstat().st_ino, before.st_ino)

    def test_exact_hardlink_with_foreign_backup_name_is_never_consumed(self) -> None:
        orphan = self.lab_dir / ".credential.storage.backup-foreign-run"
        os.link(self.storage, orphan)
        storage_before = self.storage.lstat()
        orphan_before = orphan.lstat()

        result = self.command("wedge")

        self.assertEqual(result.returncode, 8, result.stderr)
        self.assertEqual(self.storage.read_bytes(), self.original_bytes)
        self.assertEqual(self.storage.lstat().st_ino, storage_before.st_ino)
        self.assertEqual(orphan.lstat().st_ino, orphan_before.st_ino)
        self.assertEqual(orphan.lstat().st_nlink, 2)

    def test_each_malformed_managed_residue_is_rejected_without_mutation(self) -> None:
        cases = (
            (self.lab_dir, ".credential.storage.backup-empty", 0o600),
            (self.lab_dir, ".credential.v1.json.tmp-empty", 0o600),
            (self.lab_dir, ".credential.v1.json.backup-empty", 0o600),
            (self.lab_dir, ".credential.v1.json.restore-empty", 0o600),
            (self.plugin_dir, ".credential.storage.tmp-empty", 0o640),
        )
        for parent, name, mode in cases:
            with self.subTest(name=name):
                residue = parent / name
                residue.write_bytes(b"")
                residue.chmod(mode)
                before = residue.lstat()

                result = self.command("wedge")

                self.assertNotEqual(result.returncode, 0, result.stdout)
                self.assertEqual(residue.lstat().st_ino, before.st_ino)
                self.assertEqual(residue.read_bytes(), b"")
                self.assert_original_storage(inode=self.original_stat.st_ino)
                residue.unlink()

    def test_sigkill_after_backup_is_reconciled_on_retry(self) -> None:
        barrier = self.lab_dir / "after-backup.barrier"
        env = {
            **self.env,
            "NEXUS_V015_TEST_BARRIER": "after-backup-fsync",
            "NEXUS_V015_TEST_BARRIER_PATH": str(barrier),
        }
        process = subprocess.Popen(
            [str(TARGET), "wedge"],
            cwd=ROOT,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        self.wait_for_barrier(barrier, process)
        os.kill(process.pid, signal.SIGKILL)
        process.communicate(timeout=10)
        self.assertEqual(process.returncode, -signal.SIGKILL)
        self.assertFalse(self.receipt.exists())
        self.assertTrue(self.plan.exists())
        self.assertTrue(list(self.lab_dir.glob(".credential.storage.backup-*")))

        wedged = self.command("wedge")
        restored = self.command("restore")

        self.assertEqual(wedged.returncode, 0, wedged.stderr)
        self.assertEqual(restored.returncode, 0, restored.stderr)
        self.assert_original_storage(inode=self.original_stat.st_ino)
        self.assertEqual(self.transaction_residue(), [])

