#!/usr/bin/env python3
from __future__ import annotations

import importlib.machinery
import importlib.util
import inspect
import json
import os
import random
import subprocess
import sys
import tempfile
import time
import unittest
import urllib.error
from pathlib import Path
from types import SimpleNamespace
from unittest import mock


PATH = Path(__file__).resolve().parent / "nexus-endurance-watchdog"
ENDURANCE_GATE_PATH = Path(__file__).resolve().parent / "nexus-v010-endurance-gate"
LOADER = importlib.machinery.SourceFileLoader("nexus_endurance_watchdog", str(PATH))
SPEC = importlib.util.spec_from_loader("nexus_endurance_watchdog", LOADER)
watchdog = importlib.util.module_from_spec(SPEC)
sys.modules["nexus_endurance_watchdog"] = watchdog
LOADER.exec_module(watchdog)


class WatchStateTests(unittest.TestCase):
    def test_docker_client_runs_as_configured_container_user(self) -> None:
        client = watchdog.DockerNexus(
            container="gate",
            binary="/opt/nexus",
            name="controller",
            client_key="ck_controller",
            project="endurance",
            nexus_home="/tmp/endurance-home",
            docker_user="1000:1000",
        )

        self.assertEqual(
            client.docker_exec_prefix(),
            ["docker", "exec", "--user", "1000:1000"],
        )

    def test_docker_client_propagates_only_daemon_ipc_discovery(self) -> None:
        client = watchdog.DockerNexus(
            container="gate",
            binary="/opt/nexus",
            name="controller",
            client_key="ck_controller",
            project="endurance",
            nexus_home="/tmp/endurance-home",
        )

        joined = " ".join(client.identity_env)
        self.assertIn("NEXUS_HOME=/tmp/endurance-home", joined)
        self.assertIn("NEXUS_KIND=human", joined)
        self.assertIn("TOKIO_WORKER_THREADS=2", joined)
        self.assertNotIn("NEXUS_DB_URL", joined)
        self.assertNotIn("NEXUS_STREAM_DB_PATH", joined)
        operator = " ".join(client.operator_env)
        self.assertIn("NEXUS_PROJECT=endurance", operator)
        self.assertIn("TOKIO_WORKER_THREADS=2", operator)
        self.assertNotIn("NEXUS_NAME", operator)
        self.assertNotIn("NEXUS_CLIENT_KEY", operator)

    def test_only_target_thread_messages_count_as_activity(self) -> None:
        state = watchdog.WatchState(thread="endurance", started_at=10.0)
        batch = {
            "dms": [{"id": "m_dm", "body": "not thread activity"}],
            "threads": [
                {"id": "m_other", "thread": "other", "body": "ignore"},
                {
                    "id": "m_target",
                    "from": "endurance-agent",
                    "thread": "endurance",
                    "body": "count",
                },
            ],
        }

        observed = state.observe(batch, now=25.0)

        self.assertEqual([row["id"] for row in observed], ["m_target"])
        self.assertEqual(state.last_activity_at, 25.0)
        self.assertEqual(state.message_count, 1)
        self.assertEqual(state.authors, {"endurance-agent"})
        self.assertEqual(state.participant_message_count({"endurance-agent"}), 1)
        self.assertEqual(state.participant_message_count({"controller"}), 0)

    def test_silence_and_snapshot_deadlines_are_independent(self) -> None:
        state = watchdog.WatchState(thread="endurance", started_at=100.0)
        self.assertFalse(state.quiet_due(now=219.9, silence_seconds=120.0))
        self.assertTrue(state.quiet_due(now=220.0, silence_seconds=120.0))
        self.assertFalse(state.snapshot_due(now=699.9, snapshot_seconds=600.0))
        self.assertTrue(state.snapshot_due(now=700.0, snapshot_seconds=600.0))

        state.mark_snapshot(now=700.0)
        self.assertFalse(state.snapshot_due(now=1299.9, snapshot_seconds=600.0))
        self.assertTrue(state.snapshot_due(now=1300.0, snapshot_seconds=600.0))

    def test_operator_posts_do_not_mask_participant_silence(self) -> None:
        state = watchdog.WatchState(thread="endurance", started_at=100.0)
        state.observe(
            {
                "threads": [
                    {"thread": "endurance", "from": "Ada-74", "body": "first"}
                ]
            },
            now=200.0,
        )
        state.observe(
            {
                "threads": [
                    {"thread": "endurance", "from": "controller", "body": "heat"}
                ]
            },
            now=500.0,
        )

        self.assertEqual(state.last_activity_at, 500.0)
        self.assertEqual(state.participant_last_activity_at({"Ada-74"}), 200.0)

    def test_operator_deadline_enforces_minimum_after_previous_injection(self) -> None:
        self.assertEqual(
            watchdog.next_operator_deadline(
                scheduled_at=900.0,
                participant_last_activity_at=100.0,
                last_operator_at=350.0,
                minimum=240,
            ),
            590.0,
        )
        self.assertEqual(
            watchdog.next_operator_deadline(
                scheduled_at=900.0,
                participant_last_activity_at=100.0,
                last_operator_at=None,
                minimum=240,
            ),
            340.0,
        )

    def test_operator_intervention_is_deterministic_profane_and_assignment_aware(self) -> None:
        assignments = {
            "Ada-73": "Nietzsche",
            "Marcus-73": "Freud",
            "Maya-73": "Jung",
            "Hypatia-73": "Piaget",
        }

        first = watchdog.operator_intervention(random.Random("candidate-73"), 4, assignments)
        second = watchdog.operator_intervention(random.Random("candidate-73"), 4, assignments)

        self.assertEqual(first, second)
        self.assertEqual(len(first["targets"]), 2)
        self.assertTrue(set(first["targets"]).issubset(assignments))
        for target in first["targets"]:
            self.assertIn(target, first["body"])
            self.assertIn(assignments[target], first["body"])
        self.assertRegex(first["body"], r"fuck|shit|brainlet|clanker|fraud")
        self.assertIn("one terse rebuttal", first["body"])

    def test_operator_delay_accelerates_when_traffic_declines(self) -> None:
        calm = watchdog.adaptive_operator_delay(
            random.Random(3),
            minimum=240,
            maximum=600,
            messages_since_last=30,
            previous_messages=24,
            participant_count=12,
        )
        declining = watchdog.adaptive_operator_delay(
            random.Random(3),
            minimum=240,
            maximum=600,
            messages_since_last=8,
            previous_messages=30,
            participant_count=12,
        )

        self.assertGreaterEqual(calm[0], 240)
        self.assertLessEqual(calm[0], 600)
        self.assertEqual(calm[1], "scheduled")
        self.assertEqual(declining, (240, "traffic_decline"))

    def test_thinker_assignments_require_one_assignment_per_participant(self) -> None:
        self.assertEqual(
            watchdog.parse_thinker_assignments(
                ["Ada-73=Nietzsche", "Marcus-73=Freud"]
            ),
            {"Ada-73": "Nietzsche", "Marcus-73": "Freud"},
        )
        with self.assertRaisesRegex(ValueError, "invalid thinker assignment"):
            watchdog.parse_thinker_assignments(["broken"])

    def test_participant_agent_ids_parse_explicit_stable_identity_map(self) -> None:
        self.assertEqual(
            watchdog.parse_participant_agent_ids(
                ["Noor-opencode-tmux-110=a_noor", "Ada-claude-headless-110=a_ada"]
            ),
            {
                "Noor-opencode-tmux-110": "a_noor",
                "Ada-claude-headless-110": "a_ada",
            },
        )

    def test_participant_agent_ids_must_exactly_match_participants(self) -> None:
        with self.assertRaisesRegex(
            ValueError,
            r"participant agent IDs must exactly match participants; missing=\['Noor'\], unknown=\['Other'\]",
        ):
            watchdog.validate_participant_agent_ids(
                {"Ada", "Noor"},
                {"Ada": "a_ada", "Other": "a_other"},
            )

    def test_participant_agent_ids_must_be_unique(self) -> None:
        with self.assertRaisesRegex(ValueError, "participant agent IDs must be unique"):
            watchdog.validate_participant_agent_ids(
                {"Ada", "Noor"},
                {"Ada": "a_shared", "Noor": "a_shared"},
            )

    def test_cli_accepts_repeatable_participant_agent_ids(self) -> None:
        argv = [
            "nexus-endurance-watchdog",
            "--container",
            "gate",
            "--thread",
            "endurance",
            "--controller",
            "controller",
            "--client-key",
            "ck_controller",
            "--nexus-home",
            "/tmp/nexus-home",
            "--participant-agent-id",
            "Noor=a_noor",
            "--participant-agent-id",
            "Ada=a_ada",
        ]

        with mock.patch.object(sys, "argv", argv):
            args = watchdog.parse_args()

        self.assertEqual(args.participant_agent_id, ["Noor=a_noor", "Ada=a_ada"])

    def test_operator_post_is_recorded_as_jsonl_evidence(self) -> None:
        nexus = mock.Mock(spec=watchdog.DockerNexus)
        nexus.run.return_value = SimpleNamespace(
            stdout='{"messageId":"m_operator"}\n'
        )
        intervention = {
            "sequence": 1,
            "targets": ["Ada-73", "Marcus-73"],
            "body": "Ada-73 and Marcus-73: fight.",
        }

        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "operator-interventions.jsonl"
            record = watchdog.post_operator_intervention(
                nexus,
                "endurance",
                intervention,
                path,
                reason="traffic_decline",
                messages_since_last=4,
                next_delay_seconds=240,
            )
            persisted = json.loads(path.read_text(encoding="utf-8"))

        self.assertEqual(record, persisted)
        self.assertEqual(record["messageId"], "m_operator")
        self.assertEqual(record["reason"], "traffic_decline")
        nexus.run.assert_called_once_with(
            "post",
            "endurance",
            "-m",
            intervention["body"],
            "--json",
            timeout=30,
        )

    def test_lifecycle_notifications_cover_start_intervention_and_completion(self) -> None:
        self.assertEqual(
            watchdog.lifecycle_notification("started", "endurance"),
            "ENDURANCE_STARTED: monitoring thread endurance",
        )
        self.assertEqual(
            watchdog.lifecycle_notification("quiet", "endurance", "marker-1"),
            "ENDURANCE_QUIET_REVIEW_REQUIRED: thread endurance is silent at marker-1; inspect delivery, runtime, and harness evidence before any continuation",
        )
        self.assertEqual(
            watchdog.lifecycle_notification("checkpoint", "endurance", "5/15 at 50m"),
            "ENDURANCE_CHECKPOINT: thread endurance 5/15 at 50m",
        )
        self.assertEqual(
            watchdog.lifecycle_notification("passed", "endurance"),
            "ENDURANCE_PASSED: thread endurance completed its timed gate",
        )

    def test_watchdog_notification_uses_explicit_target_without_source_registration(self) -> None:
        nexus = mock.Mock(spec=watchdog.DockerNexus)

        watchdog.notify(nexus, "endurance-controller", "CHECKPOINT_READY")

        args = nexus.run.call_args.args
        self.assertEqual(args[:6], (
            "notify",
            "--target",
            "endurance-controller",
            "--source",
            "nexus-endurance-watchdog",
            "--idempotency-key",
        ))
        self.assertTrue(args[6].startswith("watchdog:"))
        self.assertEqual(args[7], "CHECKPOINT_READY")
        self.assertNotIn("source", args[:1])
        self.assertEqual(nexus.run.call_args.kwargs, {"timeout": 30})

    def test_lifecycle_notification_is_mirrored_once(self) -> None:
        nexus = mock.Mock(spec=watchdog.DockerNexus)
        mirror = Path("/tmp/nexus-notify-mirror")

        with mock.patch.object(watchdog, "notify") as canonical, mock.patch.object(
            watchdog, "mirror_notification"
        ) as external:
            watchdog.emit_notification(nexus, "controller", "CHECKPOINT", mirror)

        canonical.assert_called_once_with(nexus, "controller", "CHECKPOINT")
        external.assert_called_once_with(mirror, "CHECKPOINT")

