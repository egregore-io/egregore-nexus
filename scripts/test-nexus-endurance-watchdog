            5.0,
        )

    def test_quiet_diagnostics_fail_on_offline_participant(self) -> None:
        failure = watchdog.classify_quiet_diagnostics(
            {"rows": [], "total": 0},
            {
                "members": [
                    {"name": "claude", "presence": "online"},
                    {"name": "hermes", "presence": "offline"},
                ]
            },
            ["claude", "hermes"],
        )

        self.assertEqual(failure, "runtime failure: offline participant(s): hermes")

    def test_quiet_diagnostics_accept_live_participants_without_dlq(self) -> None:
        failure = watchdog.classify_quiet_diagnostics(
            {"rows": [], "total": 0},
            {
                "members": [
                    {"name": "claude", "presence": "online"},
                    {"name": "hermes", "presence": "active"},
                ]
            },
            ["claude", "hermes"],
        )

        self.assertIsNone(failure)

    def test_quiet_diagnostics_follow_stable_agent_id_across_rename(self) -> None:
        failure = watchdog.classify_quiet_diagnostics(
            {"rows": [], "total": 0},
            {
                "members": [
                    {
                        "name": "Noor-opencode-tmux-110-CLOSED",
                        "agentId": "a_noor",
                        "presence": "online",
                    }
                ]
            },
            ["Noor-opencode-tmux-110"],
            participant_agent_ids={"Noor-opencode-tmux-110": "a_noor"},
        )

        self.assertIsNone(failure)

    def test_diagnose_quiet_reads_both_dlq_and_member_state(self) -> None:
        class FakeNexus:
            def run_operator(self, *args: str, **kwargs: object) -> SimpleNamespace:
                return SimpleNamespace(stdout=json.dumps({"rows": [], "total": 0}))

            def run(self, *args: str, **kwargs: object) -> SimpleNamespace:
                return SimpleNamespace(
                    stdout=json.dumps(
                        {"members": [{"name": "claude", "presence": "offline"}]}
                    )
                )

        self.assertEqual(
            watchdog.diagnose_quiet(FakeNexus(), ["claude"]),
            "runtime failure: offline participant(s): claude",
        )

    def test_diagnose_quiet_passes_stable_agent_identity_map(self) -> None:
        class FakeNexus:
            def run_operator(self, *args: str, **kwargs: object) -> SimpleNamespace:
                return SimpleNamespace(stdout=json.dumps({"rows": [], "total": 0}))

            def run(self, *args: str, **kwargs: object) -> SimpleNamespace:
                return SimpleNamespace(
                    stdout=json.dumps(
                        {
                            "members": [
                                {
                                    "name": "Noor-CLOSED",
                                    "agentId": "a_noor",
                                    "presence": "online",
                                }
                            ]
                        }
                    )
                )

        self.assertIsNone(
            watchdog.diagnose_quiet(
                FakeNexus(), ["Noor"], {"Noor": "a_noor"}
            )
        )

    def test_main_threads_stable_identity_map_through_runtime_checks_and_screenshots(self) -> None:
        source = inspect.getsource(watchdog.main)

        self.assertIn(
            "participant_agent_ids = parse_participant_agent_ids(args.participant_agent_id)",
            source,
        )
        self.assertIn(
            "validate_participant_agent_ids(participant_names, participant_agent_ids)",
            source,
        )
        self.assertGreaterEqual(
            source.count("failure = diagnose_quiet("),
            5,
        )
        self.assertGreaterEqual(source.count("provider_retries,"), 3)
        self.assertGreaterEqual(
            source.count("participant_agent_ids=participant_agent_ids"),
            3,
        )

    def test_diagnose_delivery_reads_dlq_without_requiring_members(self) -> None:
        class FakeNexus:
            def run_operator(self, *args: str, **kwargs: object) -> SimpleNamespace:
                return SimpleNamespace(
                    stdout=json.dumps({"rows": [{"inFlightId": "if_1"}], "total": 1})
                )

        self.assertEqual(
            watchdog.diagnose_delivery(FakeNexus()),
            "delivery failure: 1 dead-lettered row(s)",
        )

    def test_snapshot_records_slow_diagnostic_without_aborting_gate(self) -> None:
        class FakeNexus:
            container = "gate"

            def run(self, *args: str, **kwargs: object) -> SimpleNamespace:
                if args[:2] == ("daemon", "status"):
                    raise subprocess.TimeoutExpired(["nexus", "daemon", "status"], 10)
                return SimpleNamespace(returncode=0, stdout='{"members": []}', stderr="")

            def run_operator(self, *args: str, **kwargs: object) -> SimpleNamespace:
                return SimpleNamespace(
                    returncode=0,
                    stdout='{"rows": [], "total": 0}',
                    stderr="",
                )

        stats = SimpleNamespace(returncode=0, stdout="stats", stderr="")
        with tempfile.TemporaryDirectory() as directory, mock.patch.object(
            watchdog.subprocess, "run", return_value=stats
        ):
            path = watchdog.snapshot(
                output=Path(directory),
                sequence=0,
                state=watchdog.WatchState(thread="endurance", started_at=1.0),
                nexus=FakeNexus(),
                status="running",
            )

            diagnostics = json.loads(path.read_text())["diagnostics"]

        self.assertTrue(diagnostics["daemon_status"]["timedOut"])
        self.assertIsNone(diagnostics["daemon_status"]["returncode"])
        self.assertEqual(diagnostics["members"]["returncode"], 0)
        self.assertIn("process_memory", diagnostics)


if __name__ == "__main__":
    unittest.main(verbosity=1)
