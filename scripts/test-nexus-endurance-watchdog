    def test_continuation_is_one_bounded_current_request(self) -> None:
        message = watchdog.continuation_request("marker-1", "endurance")

        self.assertIn("marker-1", message)
        self.assertIn("For this current turn only", message)
        self.assertIn("exactly one", message)
        self.assertIn("confirm the m_ receipt", message)
        self.assertIn("then stop", message)
        self.assertIn("endurance", message)
        self.assertNotIn("future", message.lower())
        self.assertNotIn("automatic", message.lower())

    def test_silence_checkpoint_requires_manual_continuation(self) -> None:
        source = inspect.getsource(watchdog.main)

        self.assertNotIn("continuation_request(", source)
        self.assertIn("manual_review_required", source)

    def test_quiet_diagnostics_fail_on_dead_letters(self) -> None:
        failure = watchdog.classify_quiet_diagnostics(
            {"rows": [{"inFlightId": "if_1"}], "total": 1},
            {"members": []},
            [],
        )

        self.assertEqual(failure, "delivery failure: 1 dead-lettered row(s)")

    def test_retryable_provider_error_is_explicitly_requeued_after_backoff(self) -> None:
        class FakeNexus:
            def __init__(self) -> None:
                self.calls: list[tuple[tuple[str, ...], dict[str, object]]] = []

            def run_operator(self, *args: str, **kwargs: object) -> SimpleNamespace:
                self.calls.append((args, kwargs))
                return SimpleNamespace(
                    stdout=json.dumps(
                        {"count": 1, "inFlightIds": ["if_provider_1"]}
                    )
                )

        dlq = {
            "rows": [
                {
                    "inFlightId": "if_provider_1",
                    "attemptCount": 1,
                    "errorCode": "provider_error",
                    "errorDetails": {
                        "retryable": True,
                        "source": "claude.acp.prompt_error",
                    },
                }
            ],
            "total": 1,
        }
        nexus = FakeNexus()
        with tempfile.TemporaryDirectory() as directory:
            evidence = Path(directory) / "provider-requeues.jsonl"
            retries = watchdog.ProviderRetryController(evidence)

            self.assertIsNone(retries.review(dlq, nexus, now=100.0))
            self.assertEqual(retries.next_deadline(999.0), 105.0)
            self.assertEqual(nexus.calls, [])

            self.assertIsNone(retries.review(dlq, nexus, now=105.0))
            self.assertEqual(
                nexus.calls[0][0],
                ("admin", "dlq", "requeue", "if_provider_1", "--json"),
            )
            self.assertEqual(nexus.calls[0][1], {"timeout": 10})
            record = json.loads(evidence.read_text().strip())
            self.assertEqual(record["inFlightId"], "if_provider_1")
            self.assertEqual(record["completedAttempt"], 1)
            self.assertEqual(record["nextAttempt"], 2)
            self.assertEqual(record["source"], "claude.acp.prompt_error")

    def test_retryable_provider_error_is_terminal_after_third_attempt(self) -> None:
        retries = watchdog.ProviderRetryController(Path("/tmp/not-written.jsonl"))
        failure = retries.review(
            {
                "rows": [
                    {
                        "inFlightId": "if_provider_3",
                        "attemptCount": 3,
                        "errorCode": "provider_error",
                        "errorDetails": {"retryable": True},
                    }
                ],
                "total": 1,
            },
            mock.Mock(),
            now=100.0,
        )

        self.assertEqual(
            failure,
            "delivery failure: 1 dead-lettered row(s); explicit provider retry exhausted at attempt 3",
        )

    def test_nonretryable_provider_error_remains_terminal(self) -> None:
        retries = watchdog.ProviderRetryController(Path("/tmp/not-written.jsonl"))
        failure = retries.review(
            {
                "rows": [
                    {
                        "inFlightId": "if_provider_auth",
                        "attemptCount": 1,
                        "errorCode": "provider_error",
                        "errorDetails": {"retryable": False},
                    }
                ],
                "total": 1,
            },
            mock.Mock(),
            now=100.0,
        )

        self.assertEqual(failure, "delivery failure: 1 dead-lettered row(s)")

    def test_next_watch_wait_wakes_for_provider_retry_deadline(self) -> None:
        self.assertEqual(
            watchdog.bounded_wait_seconds(
                now=100.0,
                deadlines=[160.0, 105.0, 300.0],
