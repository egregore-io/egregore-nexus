    def test_participant_sessions_follow_stable_agent_id_across_rename(self) -> None:
        self.assertEqual(
            watchdog.participant_sessions(
                {
                    "members": [
                        {
                            "name": "Noor-opencode-tmux-110-CLOSED",
                            "agentId": "a_noor",
                            "sessionId": "s_noor",
                        }
                    ]
                },
                ["Noor-opencode-tmux-110"],
                {"Noor-opencode-tmux-110": "a_noor"},
            ),
            {"Noor-opencode-tmux-110": "s_noor"},
        )

    def test_raw_pty_capture_detaches_without_forwarding_eof(self) -> None:
        command = watchdog.raw_pty_capture_shell("/opt/nexus", "s_123", 3)

        self.assertIn("sleep 3", command)
        self.assertIn("printf '\\035'", command)
        self.assertIn("pty-attach s_123", command)
        self.assertNotIn("/dev/null <", command)

    def test_webui_capture_does_not_wait_for_virtual_time_idle(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            browser = root / "browser"
            arguments = root / "arguments.txt"
            browser.write_text(
                "#!/usr/bin/env bash\n"
                "set -euo pipefail\n"
                f"printf '%s\\n' \"$@\" > {arguments}\n"
                "for argument in \"$@\"; do\n"
                "  case \"$argument\" in\n"
                "    --screenshot=*) touch \"${argument#--screenshot=}\" ;;\n"
                "  esac\n"
                "done\n",
                encoding="utf-8",
            )
            browser.chmod(0o755)
            png = root / "webui.png"
            log = root / "webui.log"

            watchdog.capture_webui_screen(
                webui_url="http://127.0.0.1:4552/c/endurance",
                webui_png=png,
                webui_log=log,
                profile=root / "profile",
                browser=browser,
                timeout=2,
            )

            command = arguments.read_text(encoding="utf-8")
            self.assertNotIn("--virtual-time-budget", command)
            self.assertTrue(png.exists())
            self.assertIn("returncode=0", log.read_text(encoding="utf-8"))

    def test_gateway_health_check_rejects_a_missing_backend(self) -> None:
        failure = urllib.error.URLError("connection refused")
        with mock.patch.object(watchdog.urllib.request, "urlopen", side_effect=failure):
            with self.assertRaisesRegex(RuntimeError, "Gateway health check failed"):
                watchdog.require_gateway_health("http://127.0.0.1:4551/api/v1/health")

    def test_watchdog_checks_gateway_health_while_listening(self) -> None:
        source = inspect.getsource(watchdog.main)

        self.assertGreaterEqual(source.count("require_gateway_health(args.gateway_health_url)"), 2)

    def test_webui_capture_timeout_reaps_the_browser_process_group(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            browser = root / "browser"
            child_pid_path = root / "child.pid"
            browser.write_text(
                "#!/usr/bin/env bash\n"
                "set -euo pipefail\n"
                "sleep 60 &\n"
                f"printf '%s' \"$!\" > {child_pid_path}\n"
                "wait\n",
                encoding="utf-8",
            )
            browser.chmod(0o755)

            with self.assertRaises(subprocess.TimeoutExpired):
                watchdog.capture_webui_screen(
                    webui_url="http://127.0.0.1:4552/c/endurance",
                    webui_png=root / "webui.png",
                    webui_log=root / "webui.log",
                    profile=root / "profile",
                    browser=browser,
                    timeout=0.2,
                )

            child_pid = int(child_pid_path.read_text(encoding="utf-8"))
            for _ in range(50):
                try:
                    os.kill(child_pid, 0)
                except ProcessLookupError:
                    break
                time.sleep(0.01)
            else:
                self.fail(f"timed-out browser child {child_pid} was not reaped")

    def test_optional_webui_capture_records_observer_failure_without_failing_gate(self) -> None:
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            browser = root / "browser"
            browser.write_text("#!/usr/bin/env bash\nexit 17\n", encoding="utf-8")
            browser.chmod(0o755)
            png = root / "webui.png"
            log = root / "webui.log"

            captured = watchdog.capture_optional_webui_screen(
                webui_url="http://127.0.0.1:4552/c/endurance",
                webui_png=png,
                webui_log=log,
                profile=root / "profile",
                browser=browser,
                timeout=2,
            )

            self.assertEqual(captured, [str(log)])
            evidence = log.read_text(encoding="utf-8")
            self.assertIn("returncode=17", evidence)
            self.assertIn("observerCaptureError=WebUI screenshot exited rc=17", evidence)
            self.assertFalse(png.exists())

    def test_failure_snapshot_does_not_repeat_failed_webui_capture(self) -> None:
        source = inspect.getsource(watchdog.main)
        failure_handler = source.split(
            "except (OSError, ValueError, RuntimeError, subprocess.SubprocessError)",
            maxsplit=1,
        )[1]

        self.assertIn("webui_url=None", failure_handler)

    def test_final_pass_rechecks_runtime_liveness(self) -> None:
        source = inspect.getsource(watchdog.main)

        self.assertGreaterEqual(
            source.count(
                "failure = diagnose_quiet(nexus, args.participant, participant_agent_ids)"
            ),
            2,
            "checkpoint validation must run again immediately before passed",
        )

    def test_hermes_state_path_uses_runtime_identity_not_name_shape(self) -> None:
        self.assertEqual(
            watchdog.hermes_state_db_path("s_123", "Albert candidate/1"),
            "/tmp/nexus-hermes-gateway-s_123-Albert_candidate_1/home/state.db",
