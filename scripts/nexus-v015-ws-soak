#!/usr/bin/env python3
"""Produce the v0.1.5 dual-WebSocket restart-soak evidence gate.

This runner is intentionally container-only and candidate-bound. It reads the
canonical packed manifest, derives the candidate digest itself, exercises both
authenticated WebSocket lanes against live Codex and Claude sessions, and
publishes F3 evidence only after the whole gate has finished.
"""

from __future__ import annotations

