#!/usr/bin/env python3
"""Evidence-first public v0.1 release validation for an isolated Nexus container.

This runner deliberately keeps the test ledger separate from the release verdict. Every public
CLI facet must have a behavior result, including bounded interactive and platform-limited facets.
Bus and WebSocket probes use the same ledger but are classified as next-cutoff exploration.
"""

from __future__ import annotations

import argparse
import dataclasses
import datetime as dt
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Iterable


