#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
REPO=$(cd "$SCRIPT_DIR/.." && pwd)
CONTAINER="${NEXUS_DOCKER_TEST_NAME:-nexus-v010-load51}"
MODE="${NEXUS_V015_LAB_MODE:-packed}"
RUN_ID="${NEXUS_V015_RUN_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
OUTPUT=""
COPY_TO_CONTAINER=1
LAB_ROOT="${NEXUS_V015_LAB_ROOT:-/tmp/nexus-lens-home}"
VERSION=0.1.5

usage() {
  cat <<'USAGE'
Usage: scripts/nexus-v015-lab-manifest [options]

Capture a redacted, reproducible manifest for the isolated v0.1.5 validator.

Options:
  --container NAME  Validator container name.
  --mode MODE       Candidate mode; v0.1.5 release manifests require packed.
  --output PATH     Host output path for manifest.json.
  --run-id ID       Evidence run identifier.
  --no-copy         Do not copy the manifest into the validator evidence tree.
  -h, --help        Show this help.

The command reads Docker metadata and source checkouts only. It never reads the
host Nexus home, databases, discovery files, or runtime sockets.
USAGE
}

die() {
  echo "error: $*" >&2
  exit 1
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --container)
      [ "$#" -ge 2 ] || die "--container requires a value"
      CONTAINER=$2
      shift 2
      ;;
    --mode)
      [ "$#" -ge 2 ] || die "--mode requires a value"
      MODE=$2
      shift 2
      ;;
    --output)
      [ "$#" -ge 2 ] || die "--output requires a value"
      OUTPUT=$2
      shift 2
      ;;
    --run-id)
      [ "$#" -ge 2 ] || die "--run-id requires a value"
      RUN_ID=$2
      shift 2
      ;;
    --no-copy)
      COPY_TO_CONTAINER=0
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

case "$MODE" in
  packed) ;;
  *) die "the v0.1.5 release manifest requires --mode packed" ;;
esac
[[ "$RUN_ID" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$ ]] \
  || die "run ID must match [A-Za-z0-9][A-Za-z0-9_-]{0,127}"
[ "$LAB_ROOT" = /tmp/nexus-lens-home ] \
  || die "candidate manifests require NEXUS_V015_LAB_ROOT=/tmp/nexus-lens-home"

for command in base64 docker git jq sha256sum tar; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done

if [ -z "$OUTPUT" ]; then
  OUTPUT="$REPO/output/v0.1.5/evidence/$RUN_ID/manifest.json"
fi

TMP=$(mktemp -d)
CONTAINER_COPY_STAGE=""
CONTAINER_COPY_FINAL=""
HOST_STAGE=""

cleanup() {
  local status=$?
  trap - EXIT
  if [ "$status" -ne 0 ] && [ -n "$CONTAINER_COPY_STAGE" ]; then
    echo "error: incomplete container manifest stage retained for diagnosis: $CONTAINER_COPY_STAGE" >&2
  fi
  if [ "$status" -ne 0 ] && [ -n "$HOST_STAGE" ]; then
    echo "error: incomplete host manifest stage retained for diagnosis: $HOST_STAGE" >&2
  fi
  rm -rf "$TMP"
  exit "$status"
}
trap cleanup EXIT

source_ledger_program() {
  command cat <<'PY'
from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import time

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


def fail(message: str) -> "NoReturn":
    raise SystemExit(message)


def git(repo: Path, *arguments: str) -> bytes:
    result = subprocess.run(
        ["git", "-C", os.fspath(repo), *arguments],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        detail = result.stderr.decode("utf-8", "replace").strip()
        fail(f"source Git query failed for {repo}: {detail}")
    return result.stdout


def revision(repo: Path) -> str:
    value = git(repo, "rev-parse", "HEAD").decode("ascii", "strict").strip()
    if len(value) not in (40, 64) or any(character not in "0123456789abcdef" for character in value):
        fail(f"source revision is invalid: {repo}")
    return value


def dirty_names(repo: Path) -> tuple[bytes, ...]:
    payload = (
        git(repo, "diff", "--name-only", "-z", "HEAD")
        + git(repo, "ls-files", "--others", "--exclude-standard", "-z")
    )
    names = tuple(sorted(set(part for part in payload.split(b"\0") if part)))
    for name in names:
        if name.startswith(b"/") or any(part in (b"", b".", b"..") for part in name.split(b"/")):
            fail(f"source dirty path is unsafe: {name!r}")
    return names


def open_directory(path: Path) -> int:
    absolute = Path(os.path.abspath(os.fspath(path)))
    fd = os.open("/", os.O_RDONLY | O_DIRECTORY)
    try:
        for component in absolute.parts[1:]:
            child = os.open(
                component,
                os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW,
                dir_fd=fd,
            )
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def parent_for(root_fd: int, components: list[str]) -> tuple[int, str]:
    fd = os.dup(root_fd)
    try:
        for component in components[:-1]:
            child = os.open(
                component,
                os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW,
                dir_fd=fd,
            )
            os.close(fd)
            fd = child
        return fd, components[-1]
    except BaseException:
        os.close(fd)
        raise


def inspect_path(root_fd: int, raw_name: bytes) -> dict[str, object]:
    text = os.fsdecode(raw_name)
    components = [os.fsdecode(part) for part in raw_name.split(b"/")]
    parent_fd, leaf = parent_for(root_fd, components)
    try:
        try:
            before = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            return {"path": text, "state": "deleted", "sha256": None}
        if stat.S_ISLNK(before.st_mode):
            target = os.readlink(leaf, dir_fd=parent_fd)
            after = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
            if identity(before) != identity(after):
                fail(f"source symlink changed while captured: {text}")
            digest = hashlib.sha256(os.fsencode(target)).hexdigest()
        elif stat.S_ISREG(before.st_mode):
            fd = os.open(leaf, os.O_RDONLY | O_NOFOLLOW, dir_fd=parent_fd)
            try:
                opened = os.fstat(fd)
                if identity(opened) != identity(before):
                    fail(f"source file changed before open: {text}")
                digest_object = hashlib.sha256()
                while True:
                    block = os.read(fd, 1024 * 1024)
                    if not block:
                        break
                    digest_object.update(block)
                after = os.fstat(fd)
            finally:
                os.close(fd)
            visible = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
            if identity(before) != identity(after) or identity(after) != identity(visible):
                fail(f"source file changed while captured: {text}")
            digest = digest_object.hexdigest()
        else:
            fail(f"source dirty path is not a file/symlink: {text}")
        return {"path": text, "state": "present", "sha256": digest}
    finally:
        os.close(parent_fd)


def snapshot(repo: Path) -> dict[str, object]:
    head = revision(repo)
    names = dirty_names(repo)
    root_fd = open_directory(repo)
    try:
        dirty = [inspect_path(root_fd, name) for name in names]
    finally:
        os.close(root_fd)
    return {
        "revision": head,
        "dirty": bool(dirty),
        "dirtyPaths": dirty,
    }


def maybe_pause(repo: Path) -> None:
    expected = os.environ.get("NEXUS_V015_SOURCE_CAPTURE_PAUSE_REPO")
    ready = os.environ.get("NEXUS_V015_SOURCE_CAPTURE_PAUSE_READY")
    proceed = os.environ.get("NEXUS_V015_SOURCE_CAPTURE_PAUSE_CONTINUE")
    if expected != os.fspath(repo) or not ready or not proceed:
        return
    Path(ready).touch(exist_ok=False)
    deadline = time.monotonic() + 10
    while not Path(proceed).exists():
        if time.monotonic() >= deadline:
            fail("source capture test pause timed out")
        time.sleep(0.01)


def capture(arguments: argparse.Namespace) -> None:
    repo = Path(arguments.repo)
    first = snapshot(repo)
    maybe_pause(repo)
    second = snapshot(repo)
    if first != second:
        fail(f"source changed while manifest snapshot was captured: {repo}")
    token = Path(arguments.token)
    token.write_text(json.dumps(first, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
    print(json.dumps(first, sort_keys=True, separators=(",", ":")))


def verify(arguments: argparse.Namespace) -> None:
    repo = Path(arguments.repo)
    expected = json.loads(Path(arguments.token).read_text(encoding="utf-8"))
    observed = snapshot(repo)
    if observed != expected:
        fail(f"source changed after manifest snapshot was captured: {repo}")


parser = argparse.ArgumentParser()
sub = parser.add_subparsers(required=True)
capture_parser = sub.add_parser("capture")
capture_parser.add_argument("--repo", required=True)
capture_parser.add_argument("--token", required=True)
capture_parser.set_defaults(handler=capture)
verify_parser = sub.add_parser("verify")
verify_parser.add_argument("--repo", required=True)
verify_parser.add_argument("--token", required=True)
verify_parser.set_defaults(handler=verify)
args = parser.parse_args()
args.handler(args)
PY
}

source_record() {
  local path=$1 token=$2
  source_ledger_program | python3 - capture --repo "$path" --token "$token"
}

verify_source_record() {
  local path=$1 token=$2
  source_ledger_program | python3 - verify --repo "$path" --token "$token"
}

readiness_snapshot_program() {
  command cat <<'PY'
from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import stat

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)


def fail(message: str) -> "NoReturn":
    raise SystemExit(message)


def identity(info: os.stat_result) -> tuple[int, ...]:
    return (
        info.st_dev,
        info.st_ino,
        info.st_mode,
        info.st_uid,
        info.st_gid,
        info.st_nlink,
        info.st_size,
        info.st_mtime_ns,
        info.st_ctime_ns,
    )


def open_parent(path: Path) -> tuple[int, str]:
    if not path.is_absolute():
        fail("candidate readiness path must be absolute")
    fd = os.open("/", os.O_RDONLY | O_DIRECTORY)
    try:
        for component in path.parts[1:-1]:
            child = os.open(
                component,
                os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW,
                dir_fd=fd,
            )
            os.close(fd)
            fd = child
        return fd, path.name
    except BaseException:
        os.close(fd)
        raise


def main(path: Path, expected_uid: int, expected_gid: int) -> None:
    parent_fd, leaf = open_parent(path)
    try:
        parent = os.fstat(parent_fd)
        if (
            (parent.st_uid, parent.st_gid) != (expected_uid, expected_gid)
            or stat.S_IMODE(parent.st_mode) != 0o1777
        ):
            fail("candidate readiness parent must be root-owned mode 1777")
        visible_before = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        descriptor = os.open(leaf, os.O_RDONLY | O_NOFOLLOW, dir_fd=parent_fd)
        try:
            before = os.fstat(descriptor)
            if identity(before) != identity(visible_before):
                fail("candidate readiness changed before open")
            if (
                not stat.S_ISREG(before.st_mode)
                or (before.st_uid, before.st_gid) != (expected_uid, expected_gid)
                or stat.S_IMODE(before.st_mode) != 0o444
                or before.st_nlink != 1
            ):
                fail("candidate readiness must be a root-owned single-link 0444 file")
            chunks: list[bytes] = []
            while True:
                block = os.read(descriptor, 64 * 1024)
                if not block:
                    break
                chunks.append(block)
            after = os.fstat(descriptor)
        finally:
            os.close(descriptor)
        visible_after = os.stat(leaf, dir_fd=parent_fd, follow_symlinks=False)
        if identity(before) != identity(after) or identity(after) != identity(visible_after):
            fail("candidate readiness changed while read")
    finally:
        os.close(parent_fd)

    raw = b"".join(chunks)
    try:
        text = raw.decode("utf-8")
    except UnicodeError as error:
        fail(f"candidate readiness is not UTF-8: {error}")
    rows: dict[str, str] = {}
    for line in text.splitlines():
        key, separator, value = line.partition("=")
        if (
            not separator
            or not re.fullmatch(r"[A-Za-z][A-Za-z0-9]*", key)
            or not value
            or key in rows
        ):
            fail("candidate readiness has an invalid or duplicate key")
        rows[key] = value
    if not rows or not raw.endswith(b"\n"):
        fail("candidate readiness is empty or lacks a final newline")
    print(json.dumps({
        "schemaVersion": 1,
        "device": before.st_dev,
        "inode": before.st_ino,
        "uid": before.st_uid,
        "gid": before.st_gid,
        "mode": stat.S_IMODE(before.st_mode),
        "nlink": before.st_nlink,
        "sha256": hashlib.sha256(raw).hexdigest(),
        "bytesBase64": base64.b64encode(raw).decode("ascii"),
        "rows": rows,
    }, sort_keys=True, separators=(",", ":")))


parser = argparse.ArgumentParser()
parser.add_argument("path")
parser.add_argument("--expected-uid", type=int, required=True)
parser.add_argument("--expected-gid", type=int, required=True)
arguments = parser.parse_args()
main(Path(arguments.path), arguments.expected_uid, arguments.expected_gid)
PY
}

# This exact program is used on both sides of docker cp.  It opens every
# ancestry component and tree entry with O_NOFOLLOW, validates and hashes the
# same fstat-backed inode it reads, fsyncs bottom-up, and publishes a directory
# with Linux renameat2(RENAME_NOREPLACE).  A tree is candidate evidence only
# after the final 0400 commit seal is durable.
secure_tree_program() {
  command cat <<'PY'
from __future__ import annotations

import argparse
import ctypes
import errno
import hashlib
import json
import os
import re
import stat
import sys

O_DIRECTORY = getattr(os, "O_DIRECTORY", 0)
O_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
RENAME_NOREPLACE = 1
SEAL = ".candidate-committed"


def fail(message: str) -> "NoReturn":
    raise SystemExit(message)


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def strict_json(data: bytes) -> object:
    def pairs(rows: list[tuple[str, object]]) -> dict[str, object]:
        result: dict[str, object] = {}
        for key, value in rows:
            if key in result:
                fail(f"duplicate JSON key: {key}")
            result[key] = value
        return result

    return json.loads(data.decode("utf-8"), object_pairs_hook=pairs, parse_constant=lambda v: fail(f"non-finite JSON: {v}"))


def open_dir_no_follow(path: str) -> int:
    if not os.path.isabs(path):
        fail(f"path must be absolute: {path}")
    fd = os.open("/", os.O_RDONLY | O_DIRECTORY)
    try:
        for component in [part for part in path.split("/") if part]:
            child = os.open(component, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        return fd
    except BaseException:
        os.close(fd)
        raise


def read_regular(parent_fd: int, name: str, expected_uid: int, expected_gid: int) -> tuple[bytes, os.stat_result]:
    before = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if not stat.S_ISREG(before.st_mode) or before.st_nlink != 1:
        fail(f"unsafe evidence file: {name}")
    fd = os.open(name, os.O_RDONLY | O_NOFOLLOW, dir_fd=parent_fd)
    try:
        opened = os.fstat(fd)
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            fail(f"evidence file changed before open: {name}")
        if (opened.st_uid, opened.st_gid) != (expected_uid, expected_gid):
            fail(f"evidence file owner mismatch: {name}")
        if stat.S_IMODE(opened.st_mode) & 0o022:
            fail(f"evidence file is group/other writable: {name}")
        chunks: list[bytes] = []
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            chunks.append(chunk)
        os.fsync(fd)
        after = os.fstat(fd)
        identity = lambda row: (row.st_dev, row.st_ino, row.st_size, row.st_mode, row.st_uid, row.st_gid, row.st_nlink, row.st_mtime_ns)
        if identity(opened) != identity(after):
            fail(f"evidence file changed while read: {name}")
        return b"".join(chunks), after
    finally:
        os.close(fd)


def inspect_tree(root: str, run_id: str, uid: int, gid: int, expected_dev: int, expected_ino: int, require_seal: bool) -> dict[str, object]:
    root_fd = open_dir_no_follow(root)
    try:
        root_stat = os.fstat(root_fd)
        if (root_stat.st_dev, root_stat.st_ino) != (expected_dev, expected_ino):
            fail("evidence stage identity changed")
        if (root_stat.st_uid, root_stat.st_gid) != (uid, gid):
            fail("evidence stage owner mismatch")
        if stat.S_IMODE(root_stat.st_mode) != 0o700:
            fail("evidence stage mode must be 0700")

        files: dict[str, tuple[bytes, os.stat_result]] = {}
        directories: set[str] = set()

        def walk(directory_fd: int, prefix: str) -> None:
            for name in sorted(os.listdir(directory_fd)):
                if "/" in name or name in {".", ".."}:
                    fail("unsafe evidence entry name")
                relative = f"{prefix}/{name}" if prefix else name
                entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
                if stat.S_ISDIR(entry.st_mode):
                    if (entry.st_uid, entry.st_gid) != (uid, gid) or stat.S_IMODE(entry.st_mode) & 0o022:
                        fail(f"unsafe evidence directory: {relative}")
                    child = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=directory_fd)
                    try:
                        opened = os.fstat(child)
                        if (opened.st_dev, opened.st_ino) != (entry.st_dev, entry.st_ino):
                            fail(f"evidence directory changed before open: {relative}")
                        directories.add(relative)
                        walk(child, relative)
                        os.fsync(child)
                    finally:
                        os.close(child)
                elif stat.S_ISREG(entry.st_mode):
                    files[relative] = read_regular(directory_fd, name, uid, gid)
                else:
                    fail(f"non-regular evidence entry: {relative}")

        walk(root_fd, "")
        os.fsync(root_fd)

        expected_dirs = {"candidate", "candidate/native", "candidate/npm"}
        if directories != expected_dirs:
            fail(f"unexpected evidence directories: {sorted(directories ^ expected_dirs)}")
        for path in expected_dirs:
            # Every payload directory is created by this producer and has one
            # canonical immutable-candidate mode.  Merely being non-writable
            # is insufficient evidence of the intended topology.
            current_fd = root_fd
            opened_fds: list[int] = []
            try:
                for component in path.split("/"):
                    current_fd = os.open(
                        component,
                        os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW,
                        dir_fd=current_fd,
                    )
                    opened_fds.append(current_fd)
                if stat.S_IMODE(os.fstat(current_fd).st_mode) != 0o755:
                    fail(f"candidate payload directory mode must be 0755: {path}")
            finally:
                for opened_fd in reversed(opened_fds):
                    os.close(opened_fd)
        payload_paths = {
            "manifest.json",
            "candidate/native/nexus",
            "candidate/npm/nexus.tgz",
            "candidate/npm/nexus-cli.tgz",
            "candidate/npm/nexus-gateway.tgz",
        }
        expected_files = payload_paths | ({SEAL} if require_seal else set())
        if set(files) != expected_files:
            fail(f"unexpected evidence files: {sorted(set(files) ^ expected_files)}")
        if stat.S_IMODE(files["manifest.json"][1].st_mode) != 0o400:
            fail("manifest mode must be 0400")
        expected_payload_modes = {
            "candidate/native/nexus": 0o555,
            "candidate/npm/nexus.tgz": 0o444,
            "candidate/npm/nexus-cli.tgz": 0o444,
            "candidate/npm/nexus-gateway.tgz": 0o444,
        }
        for path, expected_mode in expected_payload_modes.items():
            if stat.S_IMODE(files[path][1].st_mode) != expected_mode:
                fail(f"candidate payload mode mismatch: {path}")

        manifest_bytes = files["manifest.json"][0]
        manifest = strict_json(manifest_bytes)
        if not isinstance(manifest, dict) or manifest.get("schemaVersion") != 1 or manifest.get("runId") != run_id or manifest.get("mode") != "packed":
            fail("manifest identity mismatch")
        native = manifest.get("native")
        packages = manifest.get("packages")
        if not isinstance(native, dict) or native.get("path") != "candidate/native/nexus":
            fail("manifest native path is invalid")
        if not isinstance(packages, list) or len(packages) != 3:
            fail("manifest package inventory is invalid")
        expected_packages = (
            ("@egregore/nexus", "candidate/npm/nexus.tgz"),
            ("@egregore/nexus-cli", "candidate/npm/nexus-cli.tgz"),
            ("@egregore/nexus-gateway", "candidate/npm/nexus-gateway.tgz"),
        )
        bindings = [(native.get("path"), native.get("sha256"))]
        for row, (name, path) in zip(packages, expected_packages, strict=True):
            if not isinstance(row, dict) or row.get("name") != name or row.get("version") != "0.1.5":
                fail("manifest package identity mismatch")
            tarball = row.get("tarball")
            if not isinstance(tarball, dict) or tarball.get("path") != path:
                fail("manifest package path mismatch")
            bindings.append((tarball.get("path"), tarball.get("sha256")))
        for path, digest in bindings:
            if path not in payload_paths or not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
                fail("manifest artifact binding is invalid")
            actual = hashlib.sha256(files[path][0]).hexdigest()
            if actual != digest:
                fail(f"manifest artifact hash mismatch: {path}")

        tree = hashlib.sha256()
        for path in sorted(payload_paths):
            mode = stat.S_IMODE(files[path][1].st_mode)
            tree.update(path.encode() + b"\0" + str(mode).encode() + b"\0" + hashlib.sha256(files[path][0]).hexdigest().encode() + b"\0")
        result: dict[str, object] = {
            "runId": run_id,
            "device": root_stat.st_dev,
            "inode": root_stat.st_ino,
            "manifestSha256": hashlib.sha256(manifest_bytes).hexdigest(),
            "treeSha256": tree.hexdigest(),
        }
        if require_seal:
            seal_bytes, seal_stat = files[SEAL]
            if stat.S_IMODE(seal_stat.st_mode) != 0o400:
                fail("candidate commit seal mode must be 0400")
            seal = strict_json(seal_bytes)
            expected_seal = {"schemaVersion": 1, **result}
            if seal != expected_seal:
                fail("candidate commit seal binding mismatch")
        return result
    finally:
        os.close(root_fd)


def fault(name: str) -> None:
    if os.environ.get("NEXUS_V015_EVIDENCE_TREE_TESTING") == "1" and os.environ.get("NEXUS_V015_EVIDENCE_TREE_FAULT") == name:
        raise OSError(errno.EIO, f"injected {name} fault")


def ensure_parent(args: argparse.Namespace) -> None:
    if not os.path.isabs(args.path):
        fail("evidence parent path must be absolute")
    fd = os.open("/", os.O_RDONLY | O_DIRECTORY)
    try:
        for component in [part for part in args.path.split("/") if part]:
            try:
                child = os.open(component, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=fd)
            except FileNotFoundError:
                os.mkdir(component, 0o700, dir_fd=fd)
                os.fsync(fd)
                child = os.open(component, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = child
        row = os.fstat(fd)
        if (row.st_uid, row.st_gid) != (args.uid, args.gid) or stat.S_IMODE(row.st_mode) & 0o022:
            fail("evidence destination parent ownership or mode is unsafe")
        print(canonical({"path": args.path, "device": row.st_dev, "inode": row.st_ino}).decode(), end="")
    finally:
        os.close(fd)


def create_stage(args: argparse.Namespace) -> None:
    parent_fd = open_dir_no_follow(args.parent)
    try:
        parent = os.fstat(parent_fd)
        if (parent.st_uid, parent.st_gid) != (args.uid, args.gid) or stat.S_IMODE(parent.st_mode) & 0o022:
            fail("evidence parent ownership or mode is unsafe")
        name = f".{args.run_id}.{args.kind}-{args.nonce}"
        if not re.fullmatch(r"\.[A-Za-z0-9][A-Za-z0-9_-]{0,127}\.(?:host|copy)-[0-9a-f]{16}", name):
            fail("evidence staging name is invalid")
        for entry in os.listdir(parent_fd):
            if entry.startswith(f".{args.run_id}.{args.kind}-"):
                fail(f"stale evidence staging root exists: {entry}")
        os.mkdir(name, 0o700, dir_fd=parent_fd)
        os.fsync(parent_fd)
        stage_fd = os.open(name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=parent_fd)
        try:
            row = os.fstat(stage_fd)
            if (row.st_uid, row.st_gid) != (args.uid, args.gid) or stat.S_IMODE(row.st_mode) != 0o700:
                fail("created evidence stage identity is invalid")
            print(canonical({"path": os.path.join(args.parent, name), "device": row.st_dev, "inode": row.st_ino}).decode(), end="")
        finally:
            os.close(stage_fd)
    finally:
        os.close(parent_fd)


def rename_noreplace(parent_fd: int, source: str, destination: str) -> None:
    libc = ctypes.CDLL(None, use_errno=True)
    renameat2 = getattr(libc, "renameat2", None)
    if renameat2 is None:
        fail("renameat2(RENAME_NOREPLACE) is unavailable")
    result = renameat2(parent_fd, os.fsencode(source), parent_fd, os.fsencode(destination), RENAME_NOREPLACE)
    if result != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code), destination)


def publish(args: argparse.Namespace) -> None:
    stage_parent, stage_name = os.path.split(args.stage)
    final_parent, final_name = os.path.split(args.final)
    if stage_parent != final_parent or final_name != args.run_id:
        fail("evidence publication paths are not one run-bound parent")
    evidence = inspect_tree(args.stage, args.run_id, args.uid, args.gid, args.dev, args.ino, False)
    parent_fd = open_dir_no_follow(stage_parent)
    try:
        current = os.stat(stage_name, dir_fd=parent_fd, follow_symlinks=False)
        if not stat.S_ISDIR(current.st_mode) or (current.st_dev, current.st_ino) != (args.dev, args.ino):
            fail("evidence stage changed before publication")
        try:
            os.stat(final_name, dir_fd=parent_fd, follow_symlinks=False)
        except FileNotFoundError:
            pass
        else:
            fail("refusing to replace existing evidence run root")
        fault("before-rename")
        rename_noreplace(parent_fd, stage_name, final_name)
        os.fsync(parent_fd)
        fault("after-rename-parent-fsync")
        final_fd = os.open(final_name, os.O_RDONLY | O_DIRECTORY | O_NOFOLLOW, dir_fd=parent_fd)
        try:
            visible = os.fstat(final_fd)
            if (visible.st_dev, visible.st_ino) != (args.dev, args.ino):
                fail("published evidence identity mismatch")
            seal_payload = canonical({"schemaVersion": 1, **evidence})
            temporary = f"{SEAL}.tmp-{os.getpid()}"
            seal_fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | O_NOFOLLOW, 0o200, dir_fd=final_fd)
            try:
                offset = 0
                while offset < len(seal_payload):
                    offset += os.write(seal_fd, seal_payload[offset:])
                os.fsync(seal_fd)
            finally:
                os.close(seal_fd)
            os.rename(temporary, SEAL, src_dir_fd=final_fd, dst_dir_fd=final_fd)
            os.fsync(final_fd)
            fault("after-seal-publish")
            seal_fd = os.open(SEAL, os.O_WRONLY | O_NOFOLLOW, dir_fd=final_fd)
            try:
                os.fchmod(seal_fd, 0o400)
                os.fsync(seal_fd)
                fault("after-seal-mode")
            except BaseException:
                try:
                    os.fchmod(seal_fd, 0)
                    os.fsync(seal_fd)
                    os.fsync(final_fd)
                finally:
                    os.close(seal_fd)
                raise
            else:
                os.close(seal_fd)
            os.fsync(final_fd)
            os.fsync(parent_fd)
        finally:
            os.close(final_fd)
    finally:
        os.close(parent_fd)
    verified = inspect_tree(args.final, args.run_id, args.uid, args.gid, args.dev, args.ino, True)
    print(canonical(verified).decode(), end="")


def verify(args: argparse.Namespace) -> None:
    result = inspect_tree(args.root, args.run_id, args.uid, args.gid, args.dev, args.ino, True)
    print(canonical(result).decode(), end="")


def inspect(args: argparse.Namespace) -> None:
    result = inspect_tree(args.root, args.run_id, args.uid, args.gid, args.dev, args.ino, False)
    print(canonical(result).decode(), end="")


parser = argparse.ArgumentParser()
sub = parser.add_subparsers(dest="command", required=True)
ensure = sub.add_parser("ensure-parent")
ensure.add_argument("--path", required=True)
ensure.add_argument("--uid", type=int, required=True)
ensure.add_argument("--gid", type=int, required=True)
ensure.set_defaults(handler=ensure_parent)
create = sub.add_parser("create-stage")
create.add_argument("--parent", required=True)
create.add_argument("--run-id", required=True)
create.add_argument("--kind", choices=("host", "copy"), required=True)
create.add_argument("--nonce", required=True)
create.add_argument("--uid", type=int, required=True)
create.add_argument("--gid", type=int, required=True)
create.set_defaults(handler=create_stage)
for name in ("publish",):
    command = sub.add_parser(name)
    command.add_argument("--stage", required=True)
    command.add_argument("--final", required=True)
    command.add_argument("--run-id", required=True)
    command.add_argument("--uid", type=int, required=True)
    command.add_argument("--gid", type=int, required=True)
    command.add_argument("--dev", type=int, required=True)
    command.add_argument("--ino", type=int, required=True)
    command.set_defaults(handler=publish)
inspect_command = sub.add_parser("inspect")
inspect_command.add_argument("--root", required=True)
inspect_command.add_argument("--run-id", required=True)
inspect_command.add_argument("--uid", type=int, required=True)
inspect_command.add_argument("--gid", type=int, required=True)
inspect_command.add_argument("--dev", type=int, required=True)
inspect_command.add_argument("--ino", type=int, required=True)
inspect_command.set_defaults(handler=inspect)
check = sub.add_parser("verify")
check.add_argument("--root", required=True)
check.add_argument("--run-id", required=True)
check.add_argument("--uid", type=int, required=True)
check.add_argument("--gid", type=int, required=True)
check.add_argument("--dev", type=int, required=True)
check.add_argument("--ino", type=int, required=True)
check.set_defaults(handler=verify)
arguments = parser.parse_args()
arguments.handler(arguments)
PY
}

NEXUS_REPO="${NEXUS_V015_NEXUS_REPO:-$REPO}"

source_record "$NEXUS_REPO" "$TMP/nexus.source" >"$TMP/nexus.json"

IMAGE_ID=$(docker container inspect -f '{{.Image}}' "$CONTAINER")
CONTAINER_ID=$(docker container inspect -f '{{.Id}}' "$CONTAINER")
CONTAINER_USER=$(docker container inspect -f '{{.Config.User}}' "$CONTAINER")
[[ "$IMAGE_ID" =~ ^sha256:[0-9a-f]{64}$ ]] \
  || die "Docker image ID is not an immutable sha256 digest"
[[ "$CONTAINER_ID" =~ ^[0-9a-f]{64}$ ]] \
  || die "Docker container ID is not immutable"
[[ "$CONTAINER_USER" =~ ^[0-9]+:[0-9]+$ ]] \
  || die "validator Config.User must be an explicit numeric UID:GID"
[ "$CONTAINER_USER" = "$(id -u):$(id -g)" ] \
  || die "validator Config.User does not match the manifest producer UID:GID"
MANIFEST_UID=${CONTAINER_USER%%:*}
MANIFEST_GID=${CONTAINER_USER#*:}
HOST_CONFIG=$(docker container inspect -f '{{json .HostConfig}}' "$CONTAINER")
ENVIRONMENT=$(docker container inspect -f '{{json .Config.Env}}' "$CONTAINER")
for json_value in HOST_CONFIG ENVIRONMENT; do
  jq -e . >/dev/null <<<"${!json_value}" \
    || die "Docker returned invalid JSON for $json_value"
done
jq -e '
  .NanoCpus == 6000000000 and
  .Memory == 8589934592 and
  .MemorySwap == 8589934592 and
  .PidsLimit == 1024
' >/dev/null <<<"$HOST_CONFIG" \
  || die "container does not match the exact 6 CPU / 8 GiB / 1024 PID packed contract"

READINESS_PATH="$LAB_ROOT/lab/candidate-ready.v1"
READINESS_SNAPSHOT=$(readiness_snapshot_program | docker exec -i \
  -e "NEXUS_EXPECTED_RUN_ID=$RUN_ID" "$CONTAINER" \
  python3 - "$READINESS_PATH" --expected-uid 0 --expected-gid 0) \
  || die "candidate readiness snapshot failed"
jq -e '
  .schemaVersion == 1 and .uid == 0 and .gid == 0 and
  .mode == 292 and .nlink == 1 and
  (.device | type == "number") and (.inode | type == "number") and
  (.sha256 | strings | test("^[0-9a-f]{64}$")) and
  (.bytesBase64 | strings | length > 0) and (.rows | type == "object")
' >/dev/null <<<"$READINESS_SNAPSHOT" \
  || die "candidate readiness snapshot contract failed"
READINESS_ROWS_BASE64=$(jq -c '.rows' <<<"$READINESS_SNAPSHOT" | base64 | tr -d '\n')
READINESS_SHA256=$(jq -er '.sha256' <<<"$READINESS_SNAPSHOT")

BINDINGS=$(docker exec \
  -e "NEXUS_EXPECTED_CONTAINER_ID=$CONTAINER_ID" \
  -e "NEXUS_EXPECTED_IMAGE_DIGEST=$IMAGE_ID" \
  -e "NEXUS_EXPECTED_RUN_ID=$RUN_ID" \
  -e "NEXUS_EXPECTED_LAB_ROOT=$LAB_ROOT" \
  -e "NEXUS_EXPECTED_READINESS_ROWS_BASE64=$READINESS_ROWS_BASE64" \
  -e "NEXUS_EXPECTED_READINESS_SHA256=$READINESS_SHA256" \
  "$CONTAINER" bash -lc 'set -euo pipefail
  launcher=/tmp/nexus-lab-bin/nexus
  gateway=/tmp/nexus-lab-bin/nexus-gateway
  webui=/tmp/nexus-lab-bin/nexus-webui
  lab_process=/tmp/nexus-lab-bin/lab-process
  lab_agent=/tmp/nexus-lab-bin/lab-agent
  lab_fixture=/tmp/nexus-lab-bin/lab-fixture
  ws_acceptance=/tmp/nexus-lab-bin/nexus-v015-ws-acceptance
  ws_soak=/tmp/nexus-lab-bin/nexus-v015-ws-soak
  webconsole_acceptance=/tmp/nexus-lab-bin/nexus-v015-webconsole-acceptance
  webconsole_evidence_verifier=/tmp/nexus-lab-bin/nexus-v015-webconsole-evidence-verify
