  case "$lens_app" in /tmp/nexus-lens-app.*) ;; *) exit 42 ;; esac
  [ "$(readlink /tmp/nexus-lab-bin/lens-app)" = "$lens_app" ]
  [ "$(readlink -f /tmp/nexus-lab-bin/lens-app)" = "$lens_app" ]
  [ "$lens_main" = "$lens_app/electron/main.cjs" ]
  [ -f "$lens_main" ] && [ ! -L "$lens_main" ]
  recomputed_lens_tree_sha=$(cd "$lens_app" &&
    find . -type f -printf "%P\0" | LC_ALL=C sort -z |
    while IFS= read -r -d "" relative; do
      printf "%s\0%s\0" "$relative" "$(stat -c %a "$relative")"
      sha256sum "$relative" | awk "{print \$1}"
    done | sha256sum | awk "{print \$1}")
  [ "$lens_tree_sha" = "$recomputed_lens_tree_sha" ]
  gateway_module="$prefix/lib/node_modules/@egregore/nexus/node_modules/@egregore/nexus-gateway/dist-gateway/headless.mjs"
  [ -f "$gateway_module" ] && [ ! -L "$gateway_module" ]
  gateway_module_sha=$(sha256sum "$gateway_module" | cut -d" " -f1)
  native_root="$prefix/lib/node_modules/@egregore/nexus/node_modules/@egregore/nexus-cli/native"
  mapfile -t native_candidates < <(find "$native_root" -type f -name nexus -perm -u+x -print)
  [ "${#native_candidates[@]}" -eq 1 ]
  native=$(readlink -f "${native_candidates[0]}")
  native_sha=$(sha256sum "$native" | cut -d" " -f1)
  [ "$(ledger_value nativeResolved)" = "$native" ]
  [ "$(ledger_value nativeSha256)" = "$native_sha" ]
  install_tree_sha=$(python3 -c "import runpy,sys; from pathlib import Path; ns=runpy.run_path(sys.argv[2]); print(ns.get(\"install_tree_digest\")(Path(sys.argv[1])))" \
    "$prefix" "$ws_acceptance")
  [ "$(ledger_value installTreeSha256)" = "$install_tree_sha" ]
  jq -n \
    --arg containerId "$NEXUS_EXPECTED_CONTAINER_ID" \
    --arg prefix "$prefix" \
    --arg installNonce "$install_nonce" \
    --arg launcher "$launcher" \
    --arg launcherResolved "$launcher_resolved" \
    --arg launcherSha256 "$launcher_sha" \
    --arg gateway "$gateway" \
    --arg gatewayResolved "$gateway_resolved" \
    --arg gatewaySha256 "$gateway_sha" \
    --arg webui "$webui" \
    --arg webuiResolved "$webui_resolved" \
    --arg webuiSha256 "$webui_sha" \
    --arg gatewayModule "$gateway_module" \
    --arg gatewayModuleSha256 "$gateway_module_sha" \
    --arg lensRendererMode "$lens_renderer_mode" \
    --arg lensApp "$lens_app" \
    --arg lensMain "$lens_main" \
    --arg lensTreeSha256 "$lens_tree_sha" \
    --arg native "$native" \
    --arg nativeSha256 "$native_sha" \
    --arg imageDigest "$NEXUS_EXPECTED_IMAGE_DIGEST" \
    --arg installTreeSha256 "$install_tree_sha" \
    --arg wsAcceptance "$ws_acceptance" \
    --arg wsAcceptanceSha256 "$(sha256sum "$ws_acceptance" | cut -d" " -f1)" \
    --arg wsSoak "$ws_soak" \
    --arg wsSoakSha256 "$(sha256sum "$ws_soak" | cut -d" " -f1)" \
    --arg webconsoleAcceptance "$webconsole_acceptance" \
    --arg webconsoleAcceptanceSha256 "$(sha256sum "$webconsole_acceptance" | cut -d" " -f1)" \
    --arg webconsoleEvidenceVerifier "$webconsole_evidence_verifier" \
    --arg webconsoleEvidenceVerifierSha256 "$(sha256sum "$webconsole_evidence_verifier" | cut -d" " -f1)" \
    --arg evidenceValidator "$evidence_validator" \
    --arg evidenceValidatorSha256 "$(sha256sum "$evidence_validator" | cut -d" " -f1)" \
    --arg releaseAssembler "$release_assembler" \
    --arg releaseAssemblerSha256 "$(sha256sum "$release_assembler" | cut -d" " -f1)" \
    --arg labProcess "$lab_process" \
    --arg labProcessSha256 "$(sha256sum "$lab_process" | cut -d" " -f1)" \
    --arg labAgent "$lab_agent" \
    --arg labAgentSha256 "$(sha256sum "$lab_agent" | cut -d" " -f1)" \
    --arg labFixture "$lab_fixture" \
    --arg labFixtureSha256 "$(sha256sum "$lab_fixture" | cut -d" " -f1)" \
    --arg nexusTarball "$nexus_tarball" \
    --arg nexusTarballSha256 "$(ledger_value nexusTarballSha256)" \
    --arg cliTarball "$cli_tarball" \
    --arg cliTarballSha256 "$(ledger_value cliTarballSha256)" \
    --arg gatewayTarball "$gateway_tarball" \
    --arg gatewayTarballSha256 "$(ledger_value gatewayTarballSha256)" \
    --arg readiness "$readiness" \
    --arg readinessSha256 "$NEXUS_EXPECTED_READINESS_SHA256" \
    --arg gatewayUrl http://127.0.0.1:4100 \
    "{containerId:\$containerId,prefix:\$prefix,installNonce:\$installNonce,launcher:\$launcher,
      launcherResolved:\$launcherResolved,launcherSha256:\$launcherSha256,
      gateway:\$gateway,gatewayResolved:\$gatewayResolved,gatewaySha256:\$gatewaySha256,
      webui:\$webui,webuiResolved:\$webuiResolved,webuiSha256:\$webuiSha256,
      gatewayModule:\$gatewayModule,gatewayModuleSha256:\$gatewayModuleSha256,
      lensRendererMode:\$lensRendererMode,lensApp:\$lensApp,
      lensMain:\$lensMain,lensTreeSha256:\$lensTreeSha256,
      native:\$native,nativeSha256:\$nativeSha256,
      imageDigest:\$imageDigest,installTreeSha256:\$installTreeSha256,
      wsAcceptance:\$wsAcceptance,wsAcceptanceSha256:\$wsAcceptanceSha256,
      wsSoak:\$wsSoak,wsSoakSha256:\$wsSoakSha256,
      webconsoleAcceptance:\$webconsoleAcceptance,
      webconsoleAcceptanceSha256:\$webconsoleAcceptanceSha256,
      webconsoleEvidenceVerifier:\$webconsoleEvidenceVerifier,
      webconsoleEvidenceVerifierSha256:\$webconsoleEvidenceVerifierSha256,
      evidenceValidator:\$evidenceValidator,evidenceValidatorSha256:\$evidenceValidatorSha256,
      releaseAssembler:\$releaseAssembler,releaseAssemblerSha256:\$releaseAssemblerSha256,
      labProcess:\$labProcess,labProcessSha256:\$labProcessSha256,
      labAgent:\$labAgent,labAgentSha256:\$labAgentSha256,
      labFixture:\$labFixture,labFixtureSha256:\$labFixtureSha256,
      nexusTarball:\$nexusTarball,nexusTarballSha256:\$nexusTarballSha256,
      cliTarball:\$cliTarball,cliTarballSha256:\$cliTarballSha256,
      gatewayTarball:\$gatewayTarball,gatewayTarballSha256:\$gatewayTarballSha256,
      readiness:\$readiness,readinessSha256:\$readinessSha256,gatewayUrl:\$gatewayUrl}"')
jq -e . >/dev/null <<<"$BINDINGS" || die "packed runtime binding capture failed"

NEXUS_VERSION=$(docker exec "$CONTAINER" bash -lc '/tmp/nexus-lab-bin/nexus --version')
NODE_VERSION=$(docker exec "$CONTAINER" bash -lc 'node --version')
RUST_VERSION=$(docker exec "$CONTAINER" bash -lc 'rustc --version')
[ "$NEXUS_VERSION" = "nexus $VERSION" ] \
  || die "packed Nexus launcher does not report nexus $VERSION exactly"

RUN_ROOT=$(dirname "$OUTPUT")
[ "$(basename "$OUTPUT")" = manifest.json ] \
  || die "--output must name manifest.json"
[ "$(basename "$RUN_ROOT")" = "$RUN_ID" ] \
  || die "--output run directory must equal the run ID"
[ ! -e "$RUN_ROOT" ] || die "refusing to replace existing run root: $RUN_ROOT"
RUN_PARENT=$(dirname "$RUN_ROOT")
secure_tree_program | python3 - ensure-parent \
  --path "$RUN_PARENT" --uid "$MANIFEST_UID" --gid "$MANIFEST_GID" >/dev/null
HOST_NONCE=$(printf '%s:%s:%s:host' "$RUN_ID" "$$" "$(date +%s%N)" \
  | sha256sum | cut -c1-16)
HOST_STAGE_ROW=$(secure_tree_program | python3 - create-stage \
  --parent "$RUN_PARENT" --run-id "$RUN_ID" --kind host --nonce "$HOST_NONCE" \
  --uid "$MANIFEST_UID" --gid "$MANIFEST_GID")
STAGE=$(jq -er '.path' <<<"$HOST_STAGE_ROW")
HOST_STAGE=$STAGE
HOST_STAGE_DEV=$(jq -er '.device' <<<"$HOST_STAGE_ROW")
HOST_STAGE_INO=$(jq -er '.inode' <<<"$HOST_STAGE_ROW")
mkdir -m 0755 "$STAGE/candidate" "$STAGE/candidate/native" "$STAGE/candidate/npm"

NATIVE_PATH=$(jq -er '.native' <<<"$BINDINGS")
docker cp "$CONTAINER:$NATIVE_PATH" "$STAGE/candidate/native/nexus"
chmod 0555 "$STAGE/candidate/native/nexus"
[ "$(sha256sum "$STAGE/candidate/native/nexus" | cut -d' ' -f1)" = \
  "$(jq -er '.nativeSha256' <<<"$BINDINGS")" ] \
  || die "installed native binary changed while capturing the candidate"

PACKAGE_ROWS='[]'
for binding in \
  "@egregore/nexus:nexusTarball:nexusTarballSha256:nexus.tgz" \
  "@egregore/nexus-cli:cliTarball:cliTarballSha256:nexus-cli.tgz" \
  "@egregore/nexus-gateway:gatewayTarball:gatewayTarballSha256:nexus-gateway.tgz"; do
  IFS=: read -r package path_key hash_key leaf <<<"$binding"
  source_path=$(jq -er --arg key "$path_key" '.[$key]' <<<"$BINDINGS")
  expected_digest=$(jq -er --arg key "$hash_key" '.[$key]' <<<"$BINDINGS")
  match="$STAGE/candidate/npm/$leaf"
  docker cp "$CONTAINER:$source_path" "$match"
  chmod 0444 "$match"
  [ "$(sha256sum "$match" | cut -d' ' -f1)" = "$expected_digest" ] \
    || die "candidate tarball changed while capturing $package"
  identity=$(tar -xOf "$match" package/package.json 2>/dev/null | jq -er '.name + "@" + .version') \
    || die "cannot inspect packed tarball: $source_path"
  [ "$identity" = "$package@$VERSION" ] \
    || die "candidate tarball identity mismatch: $identity"
  leaf=$(printf '%s' "$package" | sed 's#@egregore/##').tgz
  digest=$(sha256sum "$match" | cut -d' ' -f1)
  PACKAGE_ROWS=$(jq \
    --arg name "$package" \
    --arg version "$VERSION" \
    --arg path "candidate/npm/$leaf" \
    --arg sha256 "$digest" \
    '. + [{name:$name,version:$version,tarball:{path:$path,sha256:$sha256}}]' \
    <<<"$PACKAGE_ROWS")
done

jq -n \
  --arg runId "$RUN_ID" \
  --arg nexusVersion "$NEXUS_VERSION" \
  --arg nodeVersion "$NODE_VERSION" \
  --arg rustVersion "$RUST_VERSION" \
  --arg imageDigest "$IMAGE_ID" \
  --arg nativeSha256 "$(sha256sum "$STAGE/candidate/native/nexus" | cut -d' ' -f1)" \
  --argjson rawEnvironment "$ENVIRONMENT" \
  --argjson bindings "$BINDINGS" \
  --argjson packages "$PACKAGE_ROWS" \
  --slurpfile nexus "$TMP/nexus.json" '
    def redacted_environment:
      $rawEnvironment
      | map(capture("^(?<key>[^=]+)=(?<value>.*)$"))
      | map({
          key: .key,
          value: (if (.key | test("TOKEN|KEY|SECRET|PASSWORD|COOKIE|AUTH"; "i"))
                  then "<redacted>" else .value end)
        })
      | from_entries;
    (redacted_environment + {
      NEXUS_V015_RUN_ID: $runId,
      NEXUS_V015_CONTAINER_ID: $bindings.containerId,
      NEXUS_V015_PACKED_PREFIX: $bindings.prefix,
      NEXUS_V015_INSTALL_NONCE: $bindings.installNonce,
      NEXUS_V015_NEXUS_BIN: $bindings.launcher,
      NEXUS_V015_NEXUS_BIN_RESOLVED: $bindings.launcherResolved,
      NEXUS_V015_NEXUS_BIN_SHA256: $bindings.launcherSha256,
      NEXUS_V015_GATEWAY_BIN: $bindings.gateway,
      NEXUS_V015_GATEWAY_BIN_RESOLVED: $bindings.gatewayResolved,
      NEXUS_V015_GATEWAY_BIN_SHA256: $bindings.gatewaySha256,
      NEXUS_V015_WEBUI_BIN: $bindings.webui,
      NEXUS_V015_WEBUI_BIN_RESOLVED: $bindings.webuiResolved,
      NEXUS_V015_WEBUI_BIN_SHA256: $bindings.webuiSha256,
      NEXUS_V015_GATEWAY_MODULE: $bindings.gatewayModule,
      NEXUS_V015_GATEWAY_MODULE_SHA256: $bindings.gatewayModuleSha256,
      NEXUS_V015_LENS_RENDERER_MODE: $bindings.lensRendererMode,
      NEXUS_V015_LENS_APP: $bindings.lensApp,
      NEXUS_V015_LENS_MAIN: $bindings.lensMain,
      NEXUS_V015_LENS_TREE_SHA256: $bindings.lensTreeSha256,
      NEXUS_V015_IMAGE_DIGEST: $bindings.imageDigest,
      NEXUS_V015_INSTALL_TREE_SHA256: $bindings.installTreeSha256,
      NEXUS_V015_NATIVE_BIN: $bindings.native,
      NEXUS_V015_NATIVE_BIN_SHA256: $bindings.nativeSha256,
      NEXUS_V015_LAB_PROCESS: $bindings.labProcess,
      NEXUS_V015_LAB_PROCESS_SHA256: $bindings.labProcessSha256,
      NEXUS_V015_LAB_AGENT: $bindings.labAgent,
      NEXUS_V015_LAB_AGENT_SHA256: $bindings.labAgentSha256,
      NEXUS_V015_LAB_FIXTURE: $bindings.labFixture,
      NEXUS_V015_LAB_FIXTURE_SHA256: $bindings.labFixtureSha256,
      NEXUS_V015_NEXUS_TARBALL: $bindings.nexusTarball,
      NEXUS_V015_NEXUS_TARBALL_SHA256: $bindings.nexusTarballSha256,
      NEXUS_V015_CLI_TARBALL: $bindings.cliTarball,
      NEXUS_V015_CLI_TARBALL_SHA256: $bindings.cliTarballSha256,
      NEXUS_V015_GATEWAY_TARBALL: $bindings.gatewayTarball,
      NEXUS_V015_GATEWAY_TARBALL_SHA256: $bindings.gatewayTarballSha256,
      NEXUS_V015_WS_ACCEPTANCE: $bindings.wsAcceptance,
      NEXUS_V015_WS_ACCEPTANCE_SHA256: $bindings.wsAcceptanceSha256,
      NEXUS_V015_WS_SOAK: $bindings.wsSoak,
      NEXUS_V015_WS_SOAK_SHA256: $bindings.wsSoakSha256,
      NEXUS_V015_WEBCONSOLE_ACCEPTANCE: $bindings.webconsoleAcceptance,
      NEXUS_V015_WEBCONSOLE_ACCEPTANCE_SHA256: $bindings.webconsoleAcceptanceSha256,
      NEXUS_V015_WEBCONSOLE_EVIDENCE_VERIFIER: $bindings.webconsoleEvidenceVerifier,
      NEXUS_V015_WEBCONSOLE_EVIDENCE_VERIFIER_SHA256: $bindings.webconsoleEvidenceVerifierSha256,
      NEXUS_V015_EVIDENCE_VALIDATOR: $bindings.evidenceValidator,
      NEXUS_V015_EVIDENCE_VALIDATOR_SHA256: $bindings.evidenceValidatorSha256,
      NEXUS_V015_RELEASE_ASSEMBLER: $bindings.releaseAssembler,
      NEXUS_V015_RELEASE_ASSEMBLER_SHA256: $bindings.releaseAssemblerSha256,
      NEXUS_V015_READINESS_LEDGER: $bindings.readiness,
      NEXUS_V015_READINESS_LEDGER_SHA256: $bindings.readinessSha256,
      NEXUS_V015_GATEWAY_URL: $bindings.gatewayUrl
    }) as $environment |
    {
      schemaVersion: 1,
      runId: $runId,
      mode: "packed",
      sources: {nexus: $nexus[0]},
      native: {path:"candidate/native/nexus",sha256:$nativeSha256},
      packages: $packages,
      image: {digest:$imageDigest},
      container: {limits:{cpus:6,memoryBytes:8589934592,pids:1024}},
      toolchains: {nexus:$nexusVersion,node:$nodeVersion,rustc:$rustVersion},
      environment: $environment
    }
  ' >"$STAGE/manifest.json"

# The Nexus repository must still be the exact fd-backed snapshot encoded in
# the manifest. This closes the otherwise mixed-time window created by the
# Docker/package capture work between the first read and publication.
if [ -n "${NEXUS_V015_SOURCE_FINAL_PAUSE_READY:-}" ] \
    && [ -n "${NEXUS_V015_SOURCE_FINAL_PAUSE_CONTINUE:-}" ]; then
  : >"$NEXUS_V015_SOURCE_FINAL_PAUSE_READY"
  for _ in $(seq 1 1000); do
    [ -e "$NEXUS_V015_SOURCE_FINAL_PAUSE_CONTINUE" ] && break
    sleep 0.01
  done
  [ -e "$NEXUS_V015_SOURCE_FINAL_PAUSE_CONTINUE" ] \
    || die "source final-verification test pause timed out"
fi
READINESS_FINAL_SNAPSHOT=$(readiness_snapshot_program | docker exec -i \
  -e "NEXUS_EXPECTED_RUN_ID=$RUN_ID" "$CONTAINER" \
  python3 - "$READINESS_PATH" --expected-uid 0 --expected-gid 0) \
  || die "final candidate readiness snapshot failed"
[ "$READINESS_FINAL_SNAPSHOT" = "$READINESS_SNAPSHOT" ] \
  || die "candidate readiness changed during manifest capture"
verify_source_record "$NEXUS_REPO" "$TMP/nexus.source"

chmod 0400 "$STAGE/manifest.json"
secure_tree_program | python3 - inspect \
  --root "$STAGE" --run-id "$RUN_ID" --uid "$MANIFEST_UID" --gid "$MANIFEST_GID" \
  --dev "$HOST_STAGE_DEV" --ino "$HOST_STAGE_INO" >/dev/null

if [ "$COPY_TO_CONTAINER" -eq 1 ]; then
  CONTAINER_DIR="$LAB_ROOT/evidence/$RUN_ID"
  COPY_NONCE=$(printf '%s:%s:%s' "$RUN_ID" "$$" "$(date +%s%N)" \
    | sha256sum | cut -c1-16)
  CONTAINER_STAGE="$LAB_ROOT/evidence/.${RUN_ID}.copy-${COPY_NONCE}"
  CONTAINER_COPY_STAGE=$CONTAINER_STAGE
  CONTAINER_COPY_FINAL=$CONTAINER_DIR
  [ "$(stat -c %u:%g "$STAGE/manifest.json")" = "$CONTAINER_USER" ] \
    || die "sealed manifest ownership does not match validator Config.User"
  CONTAINER_STAGE_ROW=$(secure_tree_program | docker exec -i "$CONTAINER" python3 - create-stage \
    --parent "$LAB_ROOT/evidence" --run-id "$RUN_ID" --kind copy --nonce "$COPY_NONCE" \
    --uid "$MANIFEST_UID" --gid "$MANIFEST_GID")
  [ "$(jq -er '.path' <<<"$CONTAINER_STAGE_ROW")" = "$CONTAINER_STAGE" ] \
    || die "container manifest stage path mismatch"
  CONTAINER_STAGE_DEV=$(jq -er '.device' <<<"$CONTAINER_STAGE_ROW")
  CONTAINER_STAGE_INO=$(jq -er '.inode' <<<"$CONTAINER_STAGE_ROW")
  docker cp -a "$STAGE/." "$CONTAINER:$CONTAINER_STAGE"
  secure_tree_program | docker exec -i \
    -e "NEXUS_V015_EVIDENCE_TREE_TESTING=${NEXUS_V015_EVIDENCE_TREE_TESTING:-0}" \
    -e "NEXUS_V015_EVIDENCE_TREE_FAULT=${NEXUS_V015_EVIDENCE_TREE_FAULT:-}" \
    "$CONTAINER" python3 - publish \
      --stage "$CONTAINER_STAGE" --final "$CONTAINER_DIR" --run-id "$RUN_ID" \
      --uid "$MANIFEST_UID" --gid "$MANIFEST_GID" \
      --dev "$CONTAINER_STAGE_DEV" --ino "$CONTAINER_STAGE_INO" >/dev/null
  CONTAINER_COPY_STAGE=""
  CONTAINER_COPY_FINAL=""
fi

secure_tree_program | python3 - publish \
  --stage "$STAGE" --final "$RUN_ROOT" --run-id "$RUN_ID" \
  --uid "$MANIFEST_UID" --gid "$MANIFEST_GID" \
  --dev "$HOST_STAGE_DEV" --ino "$HOST_STAGE_INO" >/dev/null
HOST_STAGE=""
OUTPUT="$RUN_ROOT/manifest.json"

printf '%s\n' "$OUTPUT"
