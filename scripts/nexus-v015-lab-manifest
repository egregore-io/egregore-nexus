    tarball=${binding%%:*}
    expected_sha=${binding#*:}
    case "$tarball" in /tmp/nexus-lab-packs/*.tgz) ;; *) exit 42 ;; esac
    [ -f "$tarball" ] && [ ! -L "$tarball" ] \
      && [ "$(stat -c "%u:%g:%a:%h" "$tarball")" = "0:0:444:1" ]
    [ "$(sha256sum "$tarball" | cut -d" " -f1)" = "$expected_sha" ]
  done
  mapfile -t actual_tarballs < <(find /tmp/nexus-lab-packs -mindepth 1 -maxdepth 1 -type f -name "*.tgz" -printf "%p\n" | LC_ALL=C sort)
  mapfile -t expected_tarballs < <(printf "%s\n" "$nexus_tarball" "$cli_tarball" "$gateway_tarball" | LC_ALL=C sort)
  [ "${actual_tarballs[*]}" = "${expected_tarballs[*]}" ]
  lens_renderer_mode=$(ledger_value lensRendererMode)
  lens_app=$(ledger_value lensApp)
  lens_main=$(ledger_value lensMain)
  lens_tree_sha=$(ledger_value lensTreeSha256)
