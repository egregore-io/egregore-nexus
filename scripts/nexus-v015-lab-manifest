    "$webconsole_evidence_verifier" "$evidence_validator" "$release_assembler"; do
    [ -f "$hook" ] && [ ! -L "$hook" ] && [ -x "$hook" ]
  done
  ledger_value() {
    local key=$1
    jq -er --arg key "$key" ".[\$key] | select(type == \"string\" and length > 0)" \
      <<<"$readiness_json" || {
        echo "candidate readiness ledger has invalid ${key}" >&2
        exit 43
      }
  }
  [ "$(ledger_value schema)" = 1 ]
  [ "$(ledger_value containerId)" = "$NEXUS_EXPECTED_CONTAINER_ID" ]
  [ "$(ledger_value mode)" = packed ]
  [ "$(ledger_value runId)" = "$NEXUS_EXPECTED_RUN_ID" ]
  [ "$(ledger_value imageDigest)" = "$NEXUS_EXPECTED_IMAGE_DIGEST" ]
  [ "$(ledger_value installRoot)" = "$prefix" ]
  [ "$(ledger_value installNonce)" = "$install_nonce" ]
  [ "$(ledger_value nexusLink)" = "$prefix/bin/nexus" ]
  [ "$(ledger_value gatewayLink)" = "$prefix/bin/nexus-gateway" ]
  [ "$(ledger_value webuiLink)" = "$prefix/bin/nexus-webui" ]
  launcher_resolved=$(readlink -f "$launcher")
  gateway_resolved=$(readlink -f "$gateway")
  webui_resolved=$(readlink -f "$webui")
