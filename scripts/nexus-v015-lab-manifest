  launcher_sha=$(sha256sum "$launcher_resolved" | cut -d" " -f1)
  gateway_sha=$(sha256sum "$gateway_resolved" | cut -d" " -f1)
  webui_sha=$(sha256sum "$webui_resolved" | cut -d" " -f1)
  [ "$(ledger_value nexusSha256)" = "$launcher_sha" ]
  [ "$(ledger_value gatewaySha256)" = "$gateway_sha" ]
