  [ "$(ledger_value labProcessSha256)" = "$(sha256sum "$lab_process" | cut -d" " -f1)" ]
  [ "$(ledger_value labAgent)" = "$lab_agent" ]
  [ "$(ledger_value labAgentSha256)" = "$(sha256sum "$lab_agent" | cut -d" " -f1)" ]
  [ "$(ledger_value labFixture)" = "$lab_fixture" ]
  [ "$(ledger_value labFixtureSha256)" = "$(sha256sum "$lab_fixture" | cut -d" " -f1)" ]
  [ "$(ledger_value wsAcceptance)" = "$ws_acceptance" ]
  [ "$(ledger_value wsAcceptanceSha256)" = "$(sha256sum "$ws_acceptance" | cut -d" " -f1)" ]
  [ "$(ledger_value wsSoak)" = "$ws_soak" ]
  [ "$(ledger_value wsSoakSha256)" = "$(sha256sum "$ws_soak" | cut -d" " -f1)" ]
  [ "$(ledger_value webconsoleAcceptance)" = "$webconsole_acceptance" ]
  [ "$(ledger_value webconsoleAcceptanceSha256)" = "$(sha256sum "$webconsole_acceptance" | cut -d" " -f1)" ]
  [ "$(ledger_value webconsoleEvidenceVerifier)" = "$webconsole_evidence_verifier" ]
  [ "$(ledger_value webconsoleEvidenceVerifierSha256)" = "$(sha256sum "$webconsole_evidence_verifier" | cut -d" " -f1)" ]
  [ "$(ledger_value evidenceValidator)" = "$evidence_validator" ]
  [ "$(ledger_value evidenceValidatorSha256)" = "$(sha256sum "$evidence_validator" | cut -d" " -f1)" ]
  [ "$(ledger_value releaseAssembler)" = "$release_assembler" ]
  [ "$(ledger_value releaseAssemblerSha256)" = "$(sha256sum "$release_assembler" | cut -d" " -f1)" ]
  nexus_tarball=$(ledger_value nexusTarball)
  cli_tarball=$(ledger_value cliTarball)
  gateway_tarball=$(ledger_value gatewayTarball)
  for binding in \
    "$nexus_tarball:$(ledger_value nexusTarballSha256)" \
    "$cli_tarball:$(ledger_value cliTarballSha256)" \
