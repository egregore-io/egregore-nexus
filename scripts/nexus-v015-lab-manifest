  launcher_link=$(readlink "$launcher")
  case "$launcher_link" in
    /tmp/nexus-lab-install.*/bin/nexus) ;;
    *) echo "packed Nexus launcher does not identify a nonce-scoped install" >&2; exit 42 ;;
  esac
  prefix=${launcher_link%/bin/nexus}
  install_nonce=${prefix#/tmp/nexus-lab-install.}
  [ -n "$install_nonce" ] && [[ "$install_nonce" =~ ^[A-Za-z0-9]+$ ]] \
    || { echo "packed Nexus install nonce is invalid" >&2; exit 42; }
  [ -d "$prefix" ] && [ ! -L "$prefix" ]
  [ "$launcher_link" = "$prefix/bin/nexus" ]
  [ "$(readlink "$gateway")" = "$prefix/bin/nexus-gateway" ]
  [ "$(readlink "$webui")" = "$prefix/bin/nexus-webui" ]
  readiness_json=$(printf "%s" "$NEXUS_EXPECTED_READINESS_ROWS_BASE64" | base64 -d)
  jq -e "type == \"object\"" >/dev/null <<<"$readiness_json"
  for hook in \
    "$lab_process" "$lab_agent" "$lab_fixture" \
