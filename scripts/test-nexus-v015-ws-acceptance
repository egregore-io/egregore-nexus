    def test_live_harnesses_launch_through_the_candidate_bound_hook(self) -> None:
        module = runpy.run_path(str(TARGET))
        calls: list[tuple[list[str], dict[str, str]]] = []

        def fake_run(
            argv: list[str],
            *,
            text: bool,
            capture_output: bool,
            timeout: int,
            check: bool,
            env: dict[str, str],
        ) -> subprocess.CompletedProcess[str]:
            self.assertTrue(text)
            self.assertTrue(capture_output)
            self.assertEqual(timeout, 240)
            self.assertFalse(check)
            calls.append((argv, env))
            return subprocess.CompletedProcess(argv, 0, stdout='{"agentId":"a_live"}\n', stderr="")

        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            hook = root / "lab-agent"
            hook.write_text("#!/bin/sh\n", encoding="utf-8")
            hook.chmod(0o755)
            hook_sha256 = digest(hook.read_bytes())
            module["launch_live_agents"].__globals__["LAB_AGENT"] = hook
            candidate = module["Candidate"](
                "contract-run",
                "sha256:" + "d" * 64,
                {
                    "environment": {
                        "NEXUS_V015_LAB_AGENT": str(hook),
                        "NEXUS_V015_LAB_AGENT_SHA256": hook_sha256,
                        "NEXUS_V015_NEXUS_BIN": "/tmp/nexus-lab-bin/nexus",
                        "NEXUS_V015_READINESS_LEDGER_SHA256": "a" * 64,
                    }
                },
                root / "evidence" / "contract-run",
                root,
                root / "install",
            )
            module["launch_live_agents"](candidate, runner=fake_run)

        self.assertEqual(
            [argv for argv, _env in calls],
            [[str(hook), "launch", "codex"], [str(hook), "launch", "claude"]],
        )
        for _argv, env in calls:
            self.assertEqual(env["OCULAR_LAB"], "1")
            self.assertEqual(env["NEXUS_V015_RUN_ID"], "contract-run")
            self.assertEqual(env["NEXUS_V015_NEXUS_BIN"], "/tmp/nexus-lab-bin/nexus")
            self.assertEqual(env["NEXUS_V015_READINESS_LEDGER_SHA256"], "a" * 64)

