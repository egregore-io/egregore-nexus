            "seq": 7,
            "revision": 3,
            "turnActive": True,
            "commands": [{"commandId": "cmd_1", "state": "queued"}],
        }
        websocket = {"t": "queue.snapshot", **rest}
        module["require_queue_agreement"](rest, websocket, "s_codex")
        with self.assertRaisesRegex(module["AcceptanceFailure"], "queue snapshot"):
            module["require_queue_agreement"](
                rest,
                {**websocket, "seq": 8},
                "s_codex",
            )

