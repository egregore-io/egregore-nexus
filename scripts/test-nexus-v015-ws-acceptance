    def test_lens_tree_digest_matches_the_shell_ledger_global_sort(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            app = Path(raw) / "app"
            nested = app / "a"
            nested.mkdir(parents=True)
            rows = {
                "a/file.txt": b"nested\n",
                "a.txt": b"sibling\n",
            }
            for relative, payload in rows.items():
                path = app / relative
                path.write_bytes(payload)
                path.chmod(0o444)
            nested.chmod(0o555)
            app.chmod(0o555)
            expected = hashlib.sha256()
            for relative in sorted(rows):
                expected.update(relative.encode("utf-8"))
                expected.update(b"\0" + b"444" + b"\0")
                expected.update(digest(rows[relative]).encode("ascii") + b"\n")
            try:
                first = module["lens_tree_digest"](
                    app, expected_uid=os.geteuid()
                )
                self.assertEqual(first, expected.hexdigest())
                wrong_uid = 1 if os.geteuid() == 0 else 0
                with self.assertRaisesRegex(module["AcceptanceFailure"], "ownership"):
                    module["lens_tree_digest"](app, expected_uid=wrong_uid)
                changed = app / "a.txt"
                changed.chmod(0o644)
                changed.write_bytes(b"mutated\n")
                changed.chmod(0o444)
                self.assertNotEqual(
                    module["lens_tree_digest"](
                        app, expected_uid=os.geteuid()
                    ),
                    first,
                )
            finally:
                app.chmod(0o755)
                nested.chmod(0o755)

    def test_lens_tree_rejects_any_symlink(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            app = Path(raw) / "app"
            app.mkdir()
            target = app / "target.txt"
            target.write_text("target\n", encoding="utf-8")
            target.chmod(0o444)
            (app / "alias.txt").symlink_to(target.name)
            app.chmod(0o555)
            try:
                with self.assertRaisesRegex(module["AcceptanceFailure"], "symlink"):
                    module["lens_tree_digest"](
                        app, expected_uid=os.geteuid()
                    )
            finally:
                app.chmod(0o755)

    def test_support_scripts_are_readiness_and_manifest_bound_before_loading(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            runner = root / "nexus-v015-ws-acceptance"
            soak = root / "nexus-v015-ws-soak"
            runner.write_text("#!/usr/bin/env python3\n", encoding="utf-8")
            soak.write_text("#!/usr/bin/env python3\n", encoding="utf-8")
            runner.chmod(0o555)
            soak.chmod(0o555)
            readiness = {
                "wsAcceptance": str(runner),
                "wsAcceptanceSha256": digest(runner.read_bytes()),
                "wsSoak": str(soak),
                "wsSoakSha256": digest(soak.read_bytes()),
            }
            environment = {
                "NEXUS_V015_WS_ACCEPTANCE": str(runner),
                "NEXUS_V015_WS_ACCEPTANCE_SHA256": readiness["wsAcceptanceSha256"],
                "NEXUS_V015_WS_SOAK": str(soak),
                "NEXUS_V015_WS_SOAK_SHA256": readiness["wsSoakSha256"],
            }
            real_fstat = os.fstat

            def root_owned_fstat(fd: int) -> os.stat_result:
                values = list(real_fstat(fd))
                values[4] = 0
                return os.stat_result(values)

            if os.geteuid() != 0:
                with self.assertRaisesRegex(module["AcceptanceFailure"], "owner"):
                    module["validate_support_script_bindings"](
                        runner,
                        soak,
                        readiness,
                        environment,
                        root,
                    )
            with mock.patch.object(
                module["os"], "fstat", side_effect=root_owned_fstat
            ):
                module["validate_support_script_bindings"](
                    runner,
                    soak,
                    readiness,
                    environment,
                    root,
                )
            environment["NEXUS_V015_WS_SOAK_SHA256"] = "0" * 64
            with mock.patch.object(
                module["os"], "fstat", side_effect=root_owned_fstat
            ):
                with self.assertRaisesRegex(module["AcceptanceFailure"], "soak"):
                    module["validate_support_script_bindings"](
                        runner,
                        soak,
                        readiness,
                        environment,
                        root,
                    )

    def test_final_release_tools_are_root_owned_immutable_and_manifest_bound(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            webconsole = root / "nexus-v015-webconsole-acceptance"
            webconsole_evidence = root / "nexus-v015-webconsole-evidence-verify"
            validator = root / "nexus-v015-evidence-validate"
            assembler = root / "nexus-v015-release-assemble"
            webconsole.write_text("#!/usr/bin/env bash\nexit 0\n", encoding="utf-8")
            webconsole_evidence.write_text(
                "#!/usr/bin/env python3\n", encoding="utf-8"
            )
            validator.write_text("#!/usr/bin/env python3\n", encoding="utf-8")
            assembler.write_text("#!/usr/bin/env python3\n", encoding="utf-8")
            webconsole.chmod(0o555)
            webconsole_evidence.chmod(0o555)
            validator.chmod(0o555)
            assembler.chmod(0o555)
            function_globals = module["validate_final_support_script_bindings"].__globals__
            function_globals["WEBCONSOLE_ACCEPTANCE_BIN"] = webconsole
            function_globals["WEBCONSOLE_EVIDENCE_VERIFIER_BIN"] = webconsole_evidence
            function_globals["EVIDENCE_VALIDATOR_BIN"] = validator
            function_globals["RELEASE_ASSEMBLER_BIN"] = assembler
            readiness = {
                "webconsoleAcceptance": str(webconsole),
                "webconsoleAcceptanceSha256": digest(webconsole.read_bytes()),
                "webconsoleEvidenceVerifier": str(webconsole_evidence),
                "webconsoleEvidenceVerifierSha256": digest(
                    webconsole_evidence.read_bytes()
                ),
                "evidenceValidator": str(validator),
                "evidenceValidatorSha256": digest(validator.read_bytes()),
                "releaseAssembler": str(assembler),
                "releaseAssemblerSha256": digest(assembler.read_bytes()),
            }
            environment = {
                "NEXUS_V015_WEBCONSOLE_ACCEPTANCE": str(webconsole),
                "NEXUS_V015_WEBCONSOLE_ACCEPTANCE_SHA256": readiness[
                    "webconsoleAcceptanceSha256"
                ],
                "NEXUS_V015_WEBCONSOLE_EVIDENCE_VERIFIER": str(
                    webconsole_evidence
                ),
                "NEXUS_V015_WEBCONSOLE_EVIDENCE_VERIFIER_SHA256": readiness[
                    "webconsoleEvidenceVerifierSha256"
                ],
                "NEXUS_V015_EVIDENCE_VALIDATOR": str(validator),
                "NEXUS_V015_EVIDENCE_VALIDATOR_SHA256": readiness[
                    "evidenceValidatorSha256"
                ],
                "NEXUS_V015_RELEASE_ASSEMBLER": str(assembler),
                "NEXUS_V015_RELEASE_ASSEMBLER_SHA256": readiness[
                    "releaseAssemblerSha256"
                ],
            }
            real_fstat = os.fstat

            def root_owned_fstat(fd: int) -> os.stat_result:
                values = list(real_fstat(fd))
                values[4] = 0
                return os.stat_result(values)

            with mock.patch.object(
                module["os"], "fstat", side_effect=root_owned_fstat
            ):
                module["validate_final_support_script_bindings"](
                    readiness, environment
                )
                for missing_key in tuple(readiness):
                    with self.subTest(missing_readiness=missing_key):
                        with self.assertRaisesRegex(
                            module["AcceptanceFailure"], "release tool"
                        ):
                            module["validate_final_support_script_bindings"](
                                {
                                    key: value
                                    for key, value in readiness.items()
                                    if key != missing_key
                                },
                                environment,
                            )
                for missing_key in tuple(environment):
                    with self.subTest(missing_environment=missing_key):
                        with self.assertRaisesRegex(
                            module["AcceptanceFailure"], "release tool"
                        ):
                            module["validate_final_support_script_bindings"](
                                readiness,
                                {
                                    key: value
                                    for key, value in environment.items()
                                    if key != missing_key
                                },
                            )
                with self.assertRaisesRegex(
                    module["AcceptanceFailure"], "release tool"
                ):
                    module["validate_final_support_script_bindings"](
                        {
                            **readiness,
                            "evidenceValidator": (
                                "/work/egregore-nexus/scripts/nexus-v015-evidence-validate"
                            ),
                        },
                        environment,
                    )
                with self.assertRaisesRegex(
                    module["AcceptanceFailure"], "release tool"
                ):
                    module["validate_final_support_script_bindings"](
                        {
                            **readiness,
                            "webconsoleEvidenceVerifier": (
                                "/work/egregore-nexus/scripts/"
                                "nexus-v015-webconsole-evidence-verify"
                            ),
                        },
                        environment,
                    )

            webconsole_evidence.chmod(0o755)
            webconsole_evidence.write_text(
                "#!/usr/bin/env python3\n# mutated\n", encoding="utf-8"
            )
            webconsole_evidence.chmod(0o555)
            with mock.patch.object(
                module["os"], "fstat", side_effect=root_owned_fstat
            ):
                with self.assertRaisesRegex(module["AcceptanceFailure"], "hash"):
                    module["validate_final_support_script_bindings"](
                        readiness, environment
                    )
            webconsole_evidence.chmod(0o755)
            webconsole_evidence.write_text(
                "#!/usr/bin/env python3\n", encoding="utf-8"
            )
            webconsole_evidence.chmod(0o555)
            validator.chmod(0o755)
            validator.write_text("#!/usr/bin/env python3\n# mutated\n", encoding="utf-8")
            validator.chmod(0o555)
            with mock.patch.object(
                module["os"], "fstat", side_effect=root_owned_fstat
            ):
                with self.assertRaisesRegex(module["AcceptanceFailure"], "hash"):
                    module["validate_final_support_script_bindings"](
                        readiness, environment
                    )
            validator.chmod(0o755)
            validator.write_text("#!/usr/bin/env python3\n", encoding="utf-8")
            validator.chmod(0o555)
            if os.geteuid() != 0:
                with self.assertRaisesRegex(module["AcceptanceFailure"], "owner"):
                    module["validate_final_support_script_bindings"](
                        readiness, environment
                    )
            validator.chmod(0o755)
            with mock.patch.object(
                module["os"], "fstat", side_effect=root_owned_fstat
            ):
                with self.assertRaisesRegex(module["AcceptanceFailure"], "mode"):
                    module["validate_final_support_script_bindings"](
                        readiness, environment
                    )

    def test_native_readiness_rejects_missing_mutated_and_decoy_binaries(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            install = Path(raw) / "install"
            cli = install / "lib" / "node_modules" / "@egregore" / "nexus-cli"
            native = cli / "native" / "linux-x64" / "nexus"
            native.parent.mkdir(parents=True)
            native.write_bytes(b"candidate-native\n")
            native.chmod(0o555)
            native_hash = digest(native.read_bytes())
            readiness = {
                "nativeResolved": str(native),
                "nativeSha256": native_hash,
            }
            environment = {
                "NEXUS_V015_NATIVE_BIN": str(native),
                "NEXUS_V015_NATIVE_BIN_SHA256": native_hash,
            }
            manifest_native = {"path": "candidate/native/nexus", "sha256": native_hash}
            module["validate_native_binding"](
                install, cli, readiness, environment, manifest_native
            )
            for missing_key in ("nativeResolved", "nativeSha256"):
                with self.subTest(missing_readiness=missing_key):
                    with self.assertRaisesRegex(module["AcceptanceFailure"], "native"):
                        module["validate_native_binding"](
                            install,
                            cli,
                            {
                                key: value
                                for key, value in readiness.items()
                                if key != missing_key
                            },
                            environment,
                            manifest_native,
                        )
            for missing_key in (
                "NEXUS_V015_NATIVE_BIN",
                "NEXUS_V015_NATIVE_BIN_SHA256",
            ):
                with self.subTest(missing_environment=missing_key):
                    with self.assertRaisesRegex(module["AcceptanceFailure"], "native"):
                        module["validate_native_binding"](
                            install,
                            cli,
                            readiness,
                            {
                                key: value
                                for key, value in environment.items()
                                if key != missing_key
                            },
                            manifest_native,
                        )
            native.chmod(0o755)
            native.write_bytes(b"mutated-native\n")
            native.chmod(0o555)
            with self.assertRaisesRegex(module["AcceptanceFailure"], "native"):
                module["validate_native_binding"](
                    install, cli, readiness, environment, manifest_native
                )
            native.chmod(0o755)
            native.write_bytes(b"candidate-native\n")
            native.chmod(0o555)
            decoy = cli / "native" / "other" / "nexus"
            decoy.parent.mkdir()
            decoy.write_bytes(b"decoy\n")
            decoy.chmod(0o555)
            with self.assertRaisesRegex(module["AcceptanceFailure"], "single"):
                module["validate_native_binding"](
                    install, cli, readiness, environment, manifest_native
                )

