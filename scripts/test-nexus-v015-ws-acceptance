    def test_marker_row_must_be_attributed_and_exactly_once(self) -> None:
        module = runpy.run_path(str(TARGET))
        row = module["exact_marker_row"](
            [
                {"messageId": "m_other", "from": "codex", "body": "other"},
                {"messageId": "m_marker", "from": "codex", "body": "V015_MARKER"},
            ],
            "codex",
            "V015_MARKER",
        )
        self.assertEqual(row["messageId"], "m_marker")
        with self.assertRaisesRegex(module["AcceptanceFailure"], "exactly once"):
            module["exact_marker_row"](
                [
                    {"messageId": "m_1", "from": "codex", "body": "V015_MARKER"},
                    {"messageId": "m_2", "from": "codex", "body": "V015_MARKER"},
                ],
                "codex",
                "V015_MARKER",
            )

