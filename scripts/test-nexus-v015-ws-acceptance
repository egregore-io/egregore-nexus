            {
                "cookie": "nexus_human=human-cookie; nexus_csrf=csrf-issued",
                "csrf": "csrf-issued",
            },
        )()
        backend.human_name = "human-operator"
        backend.unknown_cookie = {"status": 403, "acceptedRows": 0}
        backend.soak = type("Soak", (), {"thread": "security-thread", "sessions": {}})()
        backend.live_agents = (object(), object())
        backend.history = lambda _path: []
        backend._http_mutation_attempt = lambda *_args: {
            "status": 201,
            "bodySha256": "d" * 64,
            "messageId": "m-should-not-exist",
