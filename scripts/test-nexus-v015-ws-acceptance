#!/usr/bin/env python3
"""External contracts for the v0.1.5 real-network WebSocket gate."""

from __future__ import annotations

import asyncio
import dataclasses
import hashlib
import io
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import tarfile
import tempfile
import unittest
from unittest import mock


SCRIPT_DIR = Path(__file__).resolve().parent
TARGET = SCRIPT_DIR / "nexus-v015-ws-acceptance"


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


class WsAcceptanceContracts(unittest.TestCase):
    def run_target(
        self,
        *args: str,
        env: dict[str, str] | None = None,
    ) -> subprocess.CompletedProcess[str]:
        return subprocess.run(
            [str(TARGET), *args],
            text=True,
            capture_output=True,
            env=env,
            timeout=10,
            check=False,
        )

    def manifest_fixture(self, root: Path) -> dict[str, object]:
        sources = {}
        for name in ("nexus",):
            sources[name] = {
                "revision": "a" * 40,
                "dirty": False,
                "dirtyPaths": [],
            }
        return {
            "schemaVersion": 1,
            "runId": "contract-run",
            "mode": "packed",
            "sources": sources,
            "native": {"path": "candidate/native/nexus", "sha256": "b" * 64},
            "packages": [
                {
                    "name": name,
                    "version": "0.1.5",
                    "tarball": {
                        "path": f"candidate/npm/{filename}",
                        "sha256": str(index) * 64,
                    },
                }
                for index, (name, filename) in enumerate(
                    zip(
                        ("@egregore/nexus", "@egregore/nexus-cli", "@egregore/nexus-gateway"),
                        ("nexus.tgz", "nexus-cli.tgz", "nexus-gateway.tgz"),
                        strict=True,
                    ),
                    start=1,
                )
            ],
            "image": {"digest": "sha256:" + "c" * 64},
            "container": {
                "limits": {"cpus": 6, "memoryBytes": 8589934592, "pids": 1024},
            },
            "toolchains": {
                "nexus": "nexus 0.1.5",
                "node": "v24.1.0",
                "rustc": "rustc 1.90.0",
            },
            "environment": {
                "HOME": str(root),
                "NEXUS_HOME": str(root / "nexus"),
                "API_TOKEN": "<redacted>",
            },
        }

    def test_help_is_side_effect_free(self) -> None:
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            before = sorted(path.relative_to(root) for path in root.rglob("*"))
            result = self.run_target(
                "--help",
                env={
                    **os.environ,
                    "OCULAR_LAB": "1",
                    "NEXUS_LAB_ROOT": str(root),
                    "NEXUS_V015_RUN_ID": "help-must-not-write",
                },
            )
            after = sorted(path.relative_to(root) for path in root.rglob("*"))
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertIn("--mode packed", result.stdout)
        self.assertEqual(before, after)

    def test_execution_refuses_outside_the_ocular_lab(self) -> None:
        with tempfile.TemporaryDirectory() as raw:
            result = self.run_target(
                "--mode",
                "packed",
                "--evidence-dir",
                raw,
                env={
                    key: value
                    for key, value in os.environ.items()
                    if key not in {"OCULAR_LAB", "NEXUS_LAB_ROOT", "NEXUS_V015_RUN_ID"}
                },
            )
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("OCULAR_LAB", result.stderr)

    def test_source_mode_cannot_publish_release_evidence(self) -> None:
        with tempfile.TemporaryDirectory() as raw:
            result = self.run_target(
                "--mode",
                "source",
                "--evidence-dir",
                str(Path(raw) / "evidence"),
                env={
                    **os.environ,
                    "OCULAR_LAB": "1",
                    "NEXUS_LAB_ROOT": raw,
                    "NEXUS_V015_RUN_ID": "source-refused",
                },
            )
        self.assertNotEqual(result.returncode, 0)
        self.assertIn("packed", result.stderr)

    def test_module_contracts_are_candidate_bound_and_fail_closed(self) -> None:
        module = runpy.run_path(str(TARGET))
        expected_gates = {
            "B1": ("identityMatrix", "renameRegression", "agentIdResolution"),
            "B2": ("restartTimeline", "rosterComparison", "humanRebind"),
            "C1": ("csrfMatrix", "packedHttp", "packedWebsocket"),
            "C2": ("upgrades", "frames", "cursorCheckpoints", "backpressure", "noPolling"),
            "C3": ("sessionFrames", "correlation", "reconnect", "backpressure", "laneIsolation"),
            "C4": ("restSnapshot", "websocketDeltas", "recovery"),
            "D1": ("packedInventory", "installLog", "foreignCwd", "shutdown"),
            "F1": ("codex", "claude", "deliveryMatrix"),
        }
        self.assertEqual(module["RESULT_SPECS"], expected_gates)
        self.assertEqual(
            module["RESULT_DIRECTORIES"]["D1"],
            "D1-clean-packed-install",
        )
        manifest = {
            "mode": "packed",
            "sources": {"nexus": {"revision": "a" * 40}},
            "native": {"sha256": "b" * 64},
            "packages": [
                {"name": "@egregore/nexus", "version": "0.1.5", "tarball": {"sha256": "1" * 64}},
                {"name": "@egregore/nexus-cli", "version": "0.1.5", "tarball": {"sha256": "2" * 64}},
                {"name": "@egregore/nexus-gateway", "version": "0.1.5", "tarball": {"sha256": "3" * 64}},
            ],
            "image": {"digest": "sha256:" + "c" * 64},
            "container": {"limits": {"cpus": 6, "memoryBytes": 8589934592, "pids": 1024}},
            "toolchains": {"nexus": "0.1.5", "node": "v24", "rustc": "rustc 1.90"},
            "environment": {"OCULAR_LAB": "1"},
        }
        canonical = {
            "mode": manifest["mode"],
            "sources": manifest["sources"],
            "nativeSha256": manifest["native"]["sha256"],
            "packages": [
                {
                    "name": row["name"],
                    "version": row["version"],
                    "tarballSha256": row["tarball"]["sha256"],
                }
                for row in manifest["packages"]
            ],
            "imageDigest": manifest["image"]["digest"],
            "limits": manifest["container"]["limits"],
            "toolchains": manifest["toolchains"],
            "environment": manifest["environment"],
        }
        expected = "sha256:" + digest(
            json.dumps(
                canonical,
                sort_keys=True,
                separators=(",", ":"),
                ensure_ascii=False,
                allow_nan=False,
            ).encode("utf-8")
        )
        self.assertEqual(module["candidate_digest"](manifest), expected)

    def test_foreign_cwd_launcher_contract_removes_source_fallbacks(self) -> None:
        module = runpy.run_path(str(TARGET))
        calls: list[tuple[list[str], Path, dict[str, str]]] = []

        def run(command: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
            cwd = Path(str(kwargs["cwd"]))
            environment = dict(kwargs["env"])
            self.assertEqual(list(cwd.iterdir()), [])
            for key in (
                "NODE_PATH",
                "TSX_TSCONFIG_PATH",
                "NEXUS_NATIVE_BIN",
                "NEXUS_GATEWAY_SOURCE_ROOT",
                "NEXUS_GATEWAY_BIN",
                "NEXUS_WEBUI_BIN",
            ):
                self.assertNotIn(key, environment)
            calls.append((command, cwd, environment))
            stdout = "nexus 0.1.5\n" if command[-1] == "--version" else "help\n"
            return subprocess.CompletedProcess(command, 0, stdout, "")

        globals_ = module["validate_foreign_cwd_launchers"].__globals__
        with tempfile.TemporaryDirectory() as raw, mock.patch.dict(
            globals_, {"subprocess": mock.Mock(run=run)}
        ):
            evidence = module["validate_foreign_cwd_launchers"](Path(raw))

        self.assertEqual(len(calls), 3)
        self.assertEqual(evidence["cwd"], "fresh-empty-mktemp")
        self.assertTrue(evidence["cwdStayedEmpty"])
        self.assertEqual(
            set(evidence["commands"]),
            {"nexus", "gateway", "webui"},
        )
        with self.assertRaisesRegex(module["AcceptanceFailure"], "cursor"):
            module["parse_developer_backpressure"](1013, "developer.backpressure:not-a-number")
        self.assertEqual(module["parse_developer_backpressure"](1013, "developer.backpressure:41"), 41)
        self.assertEqual(module["parse_session_backpressure"](1013, "session.bp:opaque-40"), "opaque-40")
        with self.assertRaisesRegex(module["AcceptanceFailure"], "1013"):
            module["parse_session_backpressure"](1011, "session.bp:opaque-40")

    def test_candidate_only_verification_reports_the_bound_readiness_digest(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            readiness = root / "lab" / "candidate-ready.v1"
            readiness.parent.mkdir()
            readiness.write_text("schema=1\nrunId=contract-run\n", encoding="utf-8")
            readiness.chmod(0o644)
            candidate = module["Candidate"](
                "contract-run",
                "sha256:" + "d" * 64,
                {
                    "image": {"digest": "sha256:" + "e" * 64},
                    "container": {
                        "limits": {
                            "cpus": 6,
                            "memoryBytes": 8589934592,
                            "pids": 1024,
                        }
                    },
                    "environment": {
                        "NEXUS_V015_READINESS_LEDGER": str(readiness),
                    },
                },
                root / "evidence" / "contract-run",
                root,
                root / "install",
            )
            readiness_bytes = readiness.read_bytes()
            checker = mock.Mock(return_value=readiness_bytes)
            globals_ = module["candidate_verification_document"].__globals__
            with mock.patch.dict(globals_, {"checked_file": checker}):
                document = module["candidate_verification_document"](candidate)

        checker.assert_called_once_with(
            readiness,
            root,
            "candidate readiness ledger",
            expected_uid=0,
            expected_mode=0o444,
        )

        self.assertEqual(document["status"], "PASS")
        self.assertEqual(document["runId"], "contract-run")
        self.assertEqual(document["candidateDigest"], "sha256:" + "d" * 64)
        self.assertEqual(document["readinessSha256"], digest(b"schema=1\nrunId=contract-run\n"))
        self.assertEqual(document["imageDigest"], "sha256:" + "e" * 64)
        self.assertEqual(document["limits"]["cpus"], 6)
        parsed = module["parse_args"]([
            "--mode", "packed",
            "--evidence-dir", "/tmp/evidence",
            "--verify-candidate-only",
        ])
        self.assertTrue(parsed.verify_candidate_only)

    def test_readiness_reads_require_root_owned_immutable_authority(self) -> None:
        module = runpy.run_path(str(TARGET))
        root = Path("/tmp/nexus-lens-home")
        readiness = root / "lab" / "candidate-ready.v1"
        raw = b"schema=1\nrunId=contract-run\n"

        parse_checker = mock.Mock(return_value=raw)
        parse_globals = module["parse_readiness"].__globals__
        with mock.patch.dict(parse_globals, {"checked_file": parse_checker}):
            self.assertEqual(
                module["parse_readiness"](readiness, root),
                {"schema": "1", "runId": "contract-run"},
            )
        parse_checker.assert_called_once_with(
            readiness,
            root,
            "candidate readiness ledger",
            expected_uid=0,
            expected_mode=0o444,
        )

        bound_checker = mock.Mock(return_value=raw)
        bound_globals = module["require_bound_file"].__globals__
        with mock.patch.dict(bound_globals, {"checked_file": bound_checker}):
            module["require_bound_file"](
                readiness,
                digest(raw),
                "candidate readiness ledger",
                root,
                expected_uid=0,
                expected_mode=0o444,
            )
        bound_checker.assert_called_once_with(
            readiness,
            root,
            "candidate readiness ledger",
            expected_uid=0,
            expected_mode=0o444,
        )

    def test_post_acceptance_revalidates_candidate_and_runtime_before_publish(self) -> None:
        module = runpy.run_path(str(TARGET))
        candidate = module["Candidate"](
            "contract-run",
            "sha256:" + "d" * 64,
            {"environment": {"NEXUS_V015_READINESS_LEDGER": "/lab/ready"}},
            Path("/lab/evidence/contract-run"),
            Path("/lab"),
            Path("/install"),
            {"schema": "1", "runId": "contract-run"},
        )
        globals_ = module["revalidate_after_acceptance"].__globals__
        original_validate = globals_["validate_candidate"]
        original_observe = globals_["observe_runtime"]
        calls: list[str] = []
        globals_["validate_candidate"] = lambda *_args: calls.append("candidate") or candidate
        globals_["observe_runtime"] = lambda value: calls.append("runtime") or {"candidate": value.digest}
        try:
            observation = module["revalidate_after_acceptance"](candidate)
            self.assertEqual(calls, ["candidate", "runtime"])
            self.assertEqual(observation, {"candidate": candidate.digest})

            changed = module["Candidate"](
                candidate.run_id,
                "sha256:" + "e" * 64,
                candidate.manifest,
                candidate.run_root,
                candidate.lab_root,
                candidate.install_root,
                candidate.readiness,
            )
            calls.clear()
            globals_["validate_candidate"] = lambda *_args: calls.append("candidate") or changed
            with self.assertRaisesRegex(module["AcceptanceFailure"], "changed during acceptance"):
                module["revalidate_after_acceptance"](candidate)
            self.assertEqual(calls, ["candidate"])
        finally:
            globals_["validate_candidate"] = original_validate
            globals_["observe_runtime"] = original_observe

        source = TARGET.read_text(encoding="utf-8")
        self.assertLess(
            source.index("revalidate_after_acceptance(candidate)"),
            source.index("publisher.publish(gate, payloads[gate])"),
        )

    def test_candidate_commit_seal_is_required_before_network_or_agent_work(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            run_root = Path(raw)
            run_root.chmod(0o700)
            manifest = self.manifest_fixture(run_root)
            payloads = {
                Path("candidate/native/nexus"): b"native\n",
                Path("candidate/npm/nexus.tgz"): b"nexus\n",
                Path("candidate/npm/nexus-cli.tgz"): b"cli\n",
                Path("candidate/npm/nexus-gateway.tgz"): b"gateway\n",
            }
            for relative, content in payloads.items():
                path = run_root / relative
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_bytes(content)
                path.chmod(0o555 if relative == Path("candidate/native/nexus") else 0o444)
            manifest["native"]["sha256"] = digest(payloads[Path("candidate/native/nexus")])
            for row in manifest["packages"]:
                relative = Path(row["tarball"]["path"])
                row["tarball"]["sha256"] = digest(payloads[relative])
            manifest_path = run_root / "manifest.json"
            manifest_path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
            manifest_path.chmod(0o400)

            payload_paths = (Path("manifest.json"), *payloads)
            tree = hashlib.sha256()
            for relative in sorted(payload_paths, key=lambda item: item.as_posix()):
                path = run_root / relative
                tree.update(
                    relative.as_posix().encode("utf-8")
                    + b"\0"
                    + str(path.stat().st_mode & 0o7777).encode("ascii")
                    + b"\0"
                    + digest(path.read_bytes()).encode("ascii")
                    + b"\0"
                )
            root_info = run_root.stat()
            seal_path = run_root / ".candidate-committed"
            seal_path.write_text(
                json.dumps(
                    {
                        "schemaVersion": 1,
                        "runId": "contract-run",
                        "device": root_info.st_dev,
                        "inode": root_info.st_ino,
                        "manifestSha256": digest(manifest_path.read_bytes()),
                        "treeSha256": tree.hexdigest(),
                    }
                )
                + "\n",
                encoding="utf-8",
            )
            seal_path.chmod(0o400)

            module["validate_candidate_commit_seal"](run_root, manifest, "contract-run")
            seal_path.unlink()
            with self.assertRaisesRegex(module["AcceptanceFailure"], "commit seal"):
                module["validate_candidate_commit_seal"](run_root, manifest, "contract-run")

    def test_candidate_only_main_returns_before_agent_or_network_work(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            evidence = root / "evidence"
            evidence.mkdir()
            candidate = module["Candidate"](
                "contract-run",
                "sha256:" + "d" * 64,
                {},
                evidence / "contract-run",
                root,
                root / "install",
            )
            globals_ = module["main"].__globals__
            globals_["validate_candidate"] = lambda *_args: candidate
            globals_["observe_runtime"] = lambda _candidate: object()
            globals_["candidate_verification_document"] = lambda *_args: {
                "status": "PASS",
                "readinessSha256": "a" * 64,
            }
            globals_["launch_live_agents"] = mock.Mock(
                side_effect=AssertionError("candidate-only mode launched agents")
            )
            output = type("BinaryStdout", (), {"buffer": io.BytesIO()})()
            with (
                mock.patch.dict(os.environ, {
                    "OCULAR_LAB": "1",
                    "NEXUS_LAB_ROOT": str(root),
                    "NEXUS_V015_RUN_ID": "contract-run",
                }, clear=False),
                mock.patch.object(sys, "stdout", output),
            ):
                status = module["main"]([
                    "--mode", "packed",
                    "--evidence-dir", str(evidence),
                    "--verify-candidate-only",
                ])
            self.assertEqual(status, 0)
            self.assertIn(b'"readinessSha256"', output.buffer.getvalue())
            globals_["launch_live_agents"].assert_not_called()

    def test_live_launcher_and_package_inventory_bindings_are_exact(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            target = root / "install" / "bin" / "nexus"
            target.parent.mkdir(parents=True)
            target.write_text("#!/bin/sh\n", encoding="utf-8")
            target.chmod(0o755)
            link = root / "nexus"
            link.symlink_to(target)
            module["validate_launcher_binding"](
                link,
                str(target),
                str(target.resolve()),
                digest(target.read_bytes()),
                root / "install",
                "Nexus launcher",
            )
            with self.assertRaisesRegex(module["AcceptanceFailure"], "target"):
                module["validate_launcher_binding"](
                    link,
                    str(target) + "-other",
                    str(target.resolve()),
                    digest(target.read_bytes()),
                    root / "install",
                    "Nexus launcher",
                )

            package = root / "package"
            package.mkdir()
            (package / "index.mjs").write_text("export const ok = true;\n", encoding="utf-8")
            tarball = root / "candidate.tgz"
            with tarfile.open(tarball, "w:gz") as archive:
                archive.add(package / "index.mjs", arcname="package/index.mjs")
            packed = module["tar_package_inventory"](tarball, "candidate")
            installed = module["installed_package_inventory"](package, "candidate")
            self.assertEqual(installed, packed)
            (package / "index.mjs").write_text("export const ok = false;\n", encoding="utf-8")
            self.assertNotEqual(
                module["installed_package_inventory"](package, "candidate"),
                packed,
            )

    def test_image_and_resource_binding_requires_the_release_shape(self) -> None:
        module = runpy.run_path(str(TARGET))
        manifest = {
            "image": {"digest": "sha256:" + "a" * 64},
            "container": {
                "limits": {"cpus": 6, "memoryBytes": 8589934592, "pids": 1024},
            },
        }
        module["validate_image_and_limits"](manifest)
        manifest["image"]["digest"] = "latest"
        with self.assertRaisesRegex(module["AcceptanceFailure"], "image"):
            module["validate_image_and_limits"](manifest)

    def test_live_agent_manifest_is_bound_to_the_exact_readiness_receipt(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            readiness = root / "lab" / "candidate-ready.v1"
            readiness.parent.mkdir(parents=True)
            readiness.write_bytes(b"schema=1\nrunId=contract-run\n")
            readiness_sha = digest(readiness.read_bytes())
            rows: dict[str, dict[str, str]] = {}
            for kind, version in (("codex", "codex 1.2.3"), ("claude", "claude 4.5.6")):
                executable = root / "harness" / kind
                executable.parent.mkdir(parents=True, exist_ok=True)
                executable.write_text(f"#!/bin/sh\necho '{version}'\n", encoding="utf-8")
                executable.chmod(0o755)
                workspace = root / "harness-workspaces" / kind
                workspace.mkdir(parents=True)
                rows[kind] = {
                    "name": f"v015-{kind}",
                    "agentId": f"a_{kind}",
                    "sessionId": f"s_{kind}",
                    "executable": str(executable),
                    "sha256": digest(executable.read_bytes()),
                    "version": version,
                    "workspace": str(workspace),
                }
            agent_manifest = {
                "version": 1,
                "runId": "contract-run",
                "readinessSha256": readiness_sha,
                "candidate": {
                    "runId": "contract-run",
                    "readinessSha256": readiness_sha,
                },
                "agents": rows,
            }
            agents_path = root / "lab" / "agents.json"
            agents_path.write_text(json.dumps(agent_manifest), encoding="utf-8")
            agents_path.chmod(0o600)
            candidate = module["Candidate"](
                "contract-run",
                "sha256:" + "d" * 64,
                {
                    "environment": {
                        "NEXUS_V015_READINESS_LEDGER": str(readiness),
                        "NEXUS_V015_READINESS_LEDGER_SHA256": readiness_sha,
                    }
                },
                root / "evidence" / "contract-run",
                root,
                root / "install",
            )
            agents = module["load_agents"](candidate)
            self.assertEqual(tuple(agent.kind for agent in agents), ("codex", "claude"))

            agent_manifest["readinessSha256"] = "f" * 64
            agents_path.write_text(json.dumps(agent_manifest), encoding="utf-8")
            agents_path.chmod(0o600)
            with self.assertRaisesRegex(module["AcceptanceFailure"], "readiness"):
                module["load_agents"](candidate)

    def test_packed_install_nonce_is_derived_from_the_nonce_scoped_prefix(self) -> None:
        module = runpy.run_path(str(TARGET))
        self.assertEqual(
            module["packed_install_nonce"](Path("/tmp/nexus-lab-install.Ab12")),
            "Ab12",
        )
        with self.assertRaisesRegex(module["AcceptanceFailure"], "nonce"):
            module["packed_install_nonce"](Path("/tmp/nexus-lab-install"))

    def test_atomic_publisher_emits_validator_compatible_results_once(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            run_root = Path(raw) / "run"
            run_root.mkdir()
            publisher = module["EvidencePublisher"](
                run_root,
                "contract-run",
                "sha256:" + "d" * 64,
            )
            for gate, names in module["RESULT_SPECS"].items():
                payloads = {
                    name: json.dumps({"gate": gate, "artifact": name}).encode("utf-8") + b"\n"
                    for name in names
                }
                path = publisher.publish(gate, payloads)
                document = json.loads(path.read_text(encoding="utf-8"))
                self.assertEqual(document["gate"], gate)
                self.assertEqual(document["runId"], "contract-run")
                self.assertEqual(document["candidateDigest"], "sha256:" + "d" * 64)
                self.assertEqual(document["status"], "PASS")
                self.assertEqual(document["failureCount"], 0)
                self.assertEqual(set(document["artifacts"]), set(names))
                self.assertEqual(path.stat().st_mode & 0o777, 0o400)
                self.assertEqual(path.stat().st_nlink, 1)
                self.assertEqual(path.parent.stat().st_mode & 0o777, 0o555)
                for name, record in document["artifacts"].items():
                    artifact = run_root / record["path"]
                    self.assertEqual(artifact.suffix, ".jsonl", name)
                    self.assertEqual(record["sha256"], digest(artifact.read_bytes()), name)
                    self.assertEqual(artifact.stat().st_mode & 0o777, 0o400)
                    self.assertEqual(artifact.stat().st_nlink, 1)
            with self.assertRaisesRegex(module["AcceptanceFailure"], "replace"):
                publisher.publish("B1", {name: b"again\n" for name in module["RESULT_SPECS"]["B1"]})

    def test_publisher_preserves_a_destination_created_in_the_rename_window(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            run_root = Path(raw) / "run"
            run_root.mkdir()
            publisher = module["EvidencePublisher"](
                run_root,
                "contract-run",
                "sha256:" + "d" * 64,
            )
            original_rename = module["rename_noreplace"]
            destination_bytes = b"foreign evidence\n"

            def race_destination(source: Path, destination: Path) -> None:
                destination.mkdir()
                (destination / "foreign.txt").write_bytes(destination_bytes)
                original_rename(source, destination)

            publisher_globals = module["EvidencePublisher"].publish.__globals__
            with mock.patch.dict(publisher_globals, {"rename_noreplace": race_destination}):
                with self.assertRaisesRegex(module["AcceptanceFailure"], "replace"):
                    publisher.publish(
                        "B1",
                        {
                            name: b"candidate evidence\n"
                            for name in module["RESULT_SPECS"]["B1"]
                        },
                    )

            destination = publisher.results / module["RESULT_DIRECTORIES"]["B1"]
            self.assertEqual((destination / "foreign.txt").read_bytes(), destination_bytes)
            self.assertFalse((destination / "result.json").exists())
            self.assertEqual(
                [path.name for path in publisher.results.iterdir()],
                [module["RESULT_DIRECTORIES"]["B1"]],
            )

    def test_published_results_pass_the_canonical_validator_schema(self) -> None:
        module = runpy.run_path(str(TARGET))
        validator_contract = runpy.run_path(str(SCRIPT_DIR / "test-nexus-v015-evidence-validate"))
        validator_module = runpy.run_path(str(SCRIPT_DIR / "nexus-v015-evidence-validate"))
        with tempfile.TemporaryDirectory() as raw:
            fixture = validator_contract["EvidenceFixture"](
                Path(raw)
                / "lab-root"
                / "evidence"
                / validator_contract["RUN_ID"]
            )
            fixture.run_seal_path.unlink()
            os.chmod(fixture.root / "results", 0o700)
            fixture_artifacts_root = fixture.root / "artifacts" / "results"
            os.chmod(fixture_artifacts_root, 0o700)
            for gate, leaf in module["RESULT_DIRECTORIES"].items():
                result_directory = fixture.result_paths[gate].parent
                for directory in sorted(
                    (path for path in result_directory.rglob("*") if path.is_dir()),
                    reverse=True,
                ):
                    os.chmod(directory, 0o700)
                os.chmod(result_directory, 0o700)
                shutil.rmtree(result_directory)
                fixture_artifacts = fixture.root / "artifacts" / "results" / gate
                if fixture_artifacts.exists():
                    for directory in sorted(
                        (path for path in fixture_artifacts.rglob("*") if path.is_dir()),
                        reverse=True,
                    ):
                        os.chmod(directory, 0o700)
                    os.chmod(fixture_artifacts, 0o700)
                    shutil.rmtree(fixture_artifacts)
            publisher = module["EvidencePublisher"](
                fixture.root,
                validator_contract["RUN_ID"],
                fixture.candidate_digest,
            )
            for gate, names in module["RESULT_SPECS"].items():
                publisher.publish(
                    gate,
                    {
                        name: json.dumps({"gate": gate, "artifact": name}).encode("utf-8") + b"\n"
                        for name in names
                    },
                )
            os.chmod(fixture_artifacts_root, 0o555)
            readiness_raw = fixture.readiness_path.read_bytes()
            readiness_rows = dict(
                line.split("=", 1)
                for line in readiness_raw.decode("utf-8").splitlines()
            )
            authority = validator_module["RunAuthority"](
                lab_root=fixture.lab_root,
                run_root=fixture.root,
                run_id=validator_contract["RUN_ID"],
                container_id=fixture.container_id,
                readiness_path=fixture.readiness_path,
                readiness_sha256=digest(readiness_raw),
                readiness_rows=readiness_rows,
                seal_root=fixture.seal_root,
                fixture=True,
            )
            validator = validator_module["Validator"](fixture.root, authority)
            validator_globals = validator_module["Validator"].revalidate_run_authority.__globals__
            try:
                with mock.patch.dict(
                    validator_globals,
                    {"resolve_run_authority": lambda _root: authority},
                ):
                    validator.validate(require_run_seal=False)
            finally:
                validator.close()

