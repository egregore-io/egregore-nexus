        with self.assertRaisesRegex(module["AcceptanceFailure"], "missing-header"):
            asyncio.run(backend.browser_mutation_security())

    def test_backend_failure_seam_aborts_the_real_run_before_payload_generation(self) -> None:
        module = runpy.run_path(str(TARGET))

        class FakeSoak:
            def __init__(self, *_args: object) -> None:
                self.closed = False

            async def close(self) -> None:
                self.closed = True

        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            candidate = module["Candidate"](
                "contract-run",
                "sha256:" + "d" * 64,
                {},
                root / "evidence" / "contract-run",
                root,
                root / "install",
            )
            agents = tuple(
                module["LiveAgent"](
                    kind,
                    f"v015-{kind}",
                    f"a_{kind}",
                    f"s_{kind}",
                    root / kind,
                    "a" * 64,
                    f"{kind} 1.0.0",
                    root / f"workspace-{kind}",
                )
                for kind in ("codex", "claude")
            )
            core = {
                "HttpClient": lambda *_args: object(),
                "Agent": lambda *args: args,
                "Candidate": lambda *args: args,
                "Soak": FakeSoak,
            }

            def fail_after_setup(name: str, _backend: object) -> None:
                if name == "setup":
                    raise module["AcceptanceFailure"]("injected setup boundary failure")

            backend = module["BackendAcceptance"](
                core,
                candidate,
                agents,
                failure_seam=fail_after_setup,
            )
            backend.setup = mock.AsyncMock()
            backend.stable_identity = mock.AsyncMock()
            backend.record_observations = mock.Mock(
                side_effect=AssertionError("payloads generated after failure")
            )
            with self.assertRaisesRegex(module["AcceptanceFailure"], "injected"):
                asyncio.run(backend.run())
            backend.setup.assert_awaited_once()
            backend.stable_identity.assert_not_awaited()
            backend.record_observations.assert_not_called()
            self.assertTrue(backend.soak.closed)

    def test_backend_run_drives_every_release_boundary_before_observation(self) -> None:
        module = runpy.run_path(str(TARGET))
        source = TARGET.read_text(encoding="utf-8")
        run_body = source.split("    async def run(self)", 1)[1].split(
            "    def record_observations", 1
        )[0]
        for required in (
            "browser_mutation_security",
            "concurrent_thread_subscribers",
            "straddle_gateway_restart",
            "straddle_daemon_restart",
            "RESTART_PLAN[1]",
            "RESTART_PLAN[3]",
            "queue_steer_compact_controls",
            "agent_session_backpressure_and_queue_full",
            "queue_authority_outage_recovery",
            "developer_backpressure",
            "record_observations",
        ):
            self.assertIn(required, run_body)
        self.assertNotIn("def result_payloads", source)
        self.assertNotIn('"cookieRetained": True', source)
        self.assertNotIn('"timerReads": 0', source)
        self.assertEqual(
            module["RESTART_PLAN"],
            ("gateway", "gateway", "daemon", "daemon"),
        )

    def test_exact_roster_rejects_stale_or_duplicate_rows(self) -> None:
        module = runpy.run_path(str(TARGET))
        agents = (
            type("Agent", (), {"agent_id": "a_codex", "name": "codex", "session_id": "s_c"})(),
            type("Agent", (), {"agent_id": "a_claude", "name": "claude", "session_id": "s_h"})(),
        )
        rows = [
            {"agentId": "a_codex", "name": "codex", "sessionId": "s_c", "status": "online"},
            {"agentId": "a_claude", "name": "claude", "sessionId": "s_h", "status": "active"},
        ]
        module["require_exact_roster"](rows, agents)
        with self.assertRaisesRegex(module["AcceptanceFailure"], "exact"):
            module["require_exact_roster"](
                [*rows, {"agentId": "a_stale", "name": "earl", "sessionId": "s_old", "status": "online"}],
                agents,
            )
        with self.assertRaisesRegex(module["AcceptanceFailure"], "duplicate"):
            module["require_exact_roster"]([rows[0], rows[0], rows[1]], agents)

    def test_rest_and_websocket_queue_snapshots_must_match_exactly(self) -> None:
        module = runpy.run_path(str(TARGET))
        rest = {
