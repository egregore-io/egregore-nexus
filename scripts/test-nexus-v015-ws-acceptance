    def test_runtime_observation_rejects_host_env_wrong_listener_and_process_identity(self) -> None:
        module = runpy.run_path(str(TARGET))
        with tempfile.TemporaryDirectory() as raw:
            root = Path(raw)
            install = root / "install"
            readiness = {
                "containerId": "a" * 64,
                "imageDigest": "sha256:" + "b" * 64,
                "installTreeSha256": "c" * 64,
                "nexusResolved": str(install / "bin" / "nexus.mjs"),
                "nativeResolved": str(install / "native" / "nexus"),
                "nativeSha256": "f" * 64,
                "gatewayResolved": str(install / "bin" / "nexus-gateway.mjs"),
                "gatewaySha256": "d" * 64,
                "lensRendererMode": "production",
                "lensApp": "/tmp/nexus-lens-app.contract",
                "lensMain": "/tmp/nexus-lens-app.contract/electron/main.cjs",
                "lensTreeSha256": "9" * 64,
            }
            candidate = module["Candidate"](
                "contract-run",
                "sha256:" + "e" * 64,
                {
                    "native": {"path": "candidate/native/nexus", "sha256": "f" * 64},
                    "image": {"digest": readiness["imageDigest"]},
                    "container": {
                        "limits": {"cpus": 6, "memoryBytes": 8589934592, "pids": 1024}
                    },
                    "environment": {
                        "HOME": str(root),
                        "NEXUS_HOME": str(root / "nexus"),
                        "NEXUS_V015_NATIVE_BIN": readiness["nativeResolved"],
                        "NEXUS_V015_NATIVE_BIN_SHA256": readiness["nativeSha256"],
                        "NEXUS_V015_LENS_RENDERER_MODE": "production",
                        "NEXUS_V015_LENS_APP": readiness["lensApp"],
                        "NEXUS_V015_LENS_MAIN": readiness["lensMain"],
                        "NEXUS_V015_LENS_TREE_SHA256": readiness["lensTreeSha256"],
                    },
                },
                root / "evidence" / "contract-run",
                root,
                install,
                readiness,
            )
            observation = module["RuntimeObservation"](
                container_id="a" * 12,
                image_digest=readiness["imageDigest"],
                cpu_max="600000 100000",
                memory_max="8589934592",
                memory_swap_max="0",
                pids_max="1024",
                home=str(root),
                nexus_home=str(root / "nexus"),
                install_tree_sha256=readiness["installTreeSha256"],
                daemon_pid=101,
                daemon_executable=readiness["nativeResolved"],
                daemon_executable_sha256="f" * 64,
                gateway_pid=202,
                gateway_url="http://127.0.0.1:4101",
                gateway_listener_owned=True,
                gateway_argv=("node", readiness["gatewayResolved"]),
                gateway_entrypoint=readiness["gatewayResolved"],
                gateway_entrypoint_sha256=readiness["gatewaySha256"],
                lens_pid=303,
                lens_renderer_mode="production",
                lens_app=readiness["lensApp"],
                lens_main=readiness["lensMain"],
                lens_tree_sha256=readiness["lensTreeSha256"],
                lens_argv=("electron", readiness["lensMain"]),
                lens_main_argument_bound=True,
                lens_cwd=readiness["lensApp"],
                lens_node_env="production",
                lens_vite_dev_server_url_present=False,
            )
            module["validate_runtime_observation"](candidate, observation)
            with self.assertRaisesRegex(module["AcceptanceFailure"], "HOME"):
                module["validate_runtime_observation"](
                    candidate,
                    dataclasses.replace(observation, home="/home/host-user"),
                )
            with self.assertRaisesRegex(module["AcceptanceFailure"], "listener"):
                module["validate_runtime_observation"](
                    candidate,
                    dataclasses.replace(observation, gateway_listener_owned=False),
                )
            with self.assertRaisesRegex(module["AcceptanceFailure"], "daemon"):
                module["validate_runtime_observation"](
                    candidate,
                    dataclasses.replace(
                        observation, daemon_executable_sha256="0" * 64
                    ),
                )
            with self.assertRaisesRegex(module["AcceptanceFailure"], "Lens"):
                module["validate_runtime_observation"](
                    candidate,
                    dataclasses.replace(observation, lens_renderer_mode="development"),
                )
            for changes in (
                {"lens_main": "/tmp/nexus-lens-app.contract/electron/other.cjs"},
                {"lens_main_argument_bound": False},
                {"lens_cwd": "/tmp"},
                {"lens_vite_dev_server_url_present": True},
                {"lens_tree_sha256": "8" * 64},
            ):
