    def test_browser_mutation_security_drives_exact_http_and_websocket_matrix(self) -> None:
        module = runpy.run_path(str(TARGET))
        backend = module["BackendAcceptance"].__new__(module["BackendAcceptance"])
        backend.candidate = type("Candidate", (), {"run_id": "contract-run"})()
        backend.http = type(
            "Http",
            (),
            {
                "cookie": "nexus_human=human-cookie; nexus_csrf=csrf-issued",
                "csrf": "csrf-issued",
            },
        )()
        backend.human_name = "human-operator"
        backend.unknown_cookie = {
            "status": 403,
            "marker": "unknown-marker",
            "acceptedRows": 0,
            "responseSha256": "a" * 64,
        }
        backend.soak = type("Soak", (), {"thread": "security-thread", "sessions": {}})()
        agent = type(
            "Agent",
            (),
            {"kind": "codex", "name": "v015-codex", "agent_id": "a_codex", "session_id": "s_codex"},
        )()
        backend.live_agents = (agent, object())

        accepted_rows: list[dict[str, object]] = []
        http_calls: list[dict[str, object]] = []

        def history(_path: str) -> list[dict[str, object]]:
            return list(accepted_rows)

        def http_attempt(
            case: str,
            marker: str,
            cookie: str,
            csrf_header: str | None,
        ) -> dict[str, object]:
            http_calls.append(
                {"case": case, "marker": marker, "cookie": cookie, "csrf": csrf_header}
            )
            accepted = cookie == backend.http.cookie and csrf_header == backend.http.csrf
            if accepted:
                accepted_rows.append(
                    {
                        "from": backend.human_name,
                        "body": marker,
                        "messageId": "m-http-positive",
                    }
                )
            return {
                "status": 201 if accepted else 403,
                "bodySha256": ("b" if accepted else "c") * 64,
                "messageId": "m-http-positive" if accepted else None,
            }

        ws_calls: list[str] = []

        async def rejected_ws(case: str, *_args: object, **_kwargs: object) -> dict[str, object]:
            ws_calls.append(case)
            return {
                "case": case,
                "status": 403,
                "accepted": False,
                "queueUnchanged": True,
            }

        class Lane:
            async def begin_prompt(self, marker: str, _timeout: float) -> object:
                return type(
                    "Attempt",
                    (),
                    {"marker": marker, "client_message_id": f"cm-{marker}", "command_id": "cmd-positive"},
                )()

            async def finish_prompt(self, attempt: object, _timeout: float) -> dict[str, object]:
                return {
                    "clientMessageId": attempt.client_message_id,
                    "commandId": attempt.command_id,
                    "assistantMarkerMatched": True,
                }

        backend.soak.sessions["codex"] = Lane()
        backend.history = history
        backend._http_mutation_attempt = http_attempt
        backend._rejected_ws_mutation = rejected_ws

        evidence = asyncio.run(backend.browser_mutation_security())

        self.assertEqual(
            [row["case"] for row in http_calls],
            ["missing-header", "mismatched-header", "missing-cookie-proof", "valid-pair"],
        )
        self.assertEqual(
            ws_calls,
            ["query-frame-header-forgery", "mismatched-protocol", "duplicate-protocol", "missing-cookie-proof"],
        )
        self.assertEqual(evidence["packedHttp"]["acceptedRows"], 1)
        self.assertTrue(evidence["packedWebsocket"]["positive"]["assistantMarkerMatched"])
        self.assertEqual(evidence["csrfMatrix"]["unknownCookie"]["acceptedRows"], 0)

    def test_browser_mutation_security_fails_on_negative_http_ingress(self) -> None:
        module = runpy.run_path(str(TARGET))
        backend = module["BackendAcceptance"].__new__(module["BackendAcceptance"])
        backend.candidate = type("Candidate", (), {"run_id": "contract-run"})()
