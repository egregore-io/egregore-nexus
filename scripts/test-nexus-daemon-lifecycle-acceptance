#!/usr/bin/env python3
"""Tests for scripts/nexus-daemon-lifecycle-acceptance."""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
SCRIPT = ROOT / "scripts" / "nexus-daemon-lifecycle-acceptance"


def run(args: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, str(SCRIPT), *args],
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def fake_nexus(body: str) -> tuple[Path, Path]:
    root = Path(tempfile.mkdtemp(prefix="nexus-daemon-acceptance-"))
    bin_path = root / "nexus"
    log_path = root / "calls.log"
    bin_path.write_text(body.replace("__CALLS__", str(log_path)))
    bin_path.chmod(0o755)
    return root, bin_path


def read_calls(root: Path) -> list[str]:
    log_path = root / "calls.log"
    if not log_path.exists():
        return []
    return log_path.read_text().splitlines()


def test_print_only_lists_every_lifecycle_verb_and_edge_case() -> None:
    result = run(["--print-only"])
    assert result.returncode == 0, result.stderr
    for verb in [
        "run",
        "start",
        "stop",
        "restart",
        "status",
        "logs",
        "doctor",
        "install",
        "uninstall",
    ]:
        assert f"nexus daemon {verb}" in result.stdout
    for phrase in [
        "already running",
        "not running",
        "stale pid",
        "operator-window only",
        "not executed by this script",
    ]:
        assert phrase in result.stdout


def test_readonly_dry_run_never_calls_control_verbs() -> None:
    root, bin_path = fake_nexus(
        """#!/usr/bin/env bash
printf '%s\\n' "$*" >> "__CALLS__"
case "$*" in
  "daemon --help")
    cat <<'HELP'
Commands:
  run
  start
  stop
  restart
  status
  logs
  doctor
  install
  uninstall
HELP
    ;;
  "daemon status")
    cat <<'STATUS'
daemon: running
supervisor: self (no crash restart)
pid: 123
binary: current=abc running=abc
gateway: live pid=456 url=http://127.0.0.1:4100
wedged_intents: 0
lanes:
  none
transport_pairs:
  none
STATUS
    ;;
  "daemon logs -n 1")
    echo "log line"
    ;;
  "daemon doctor")
    echo "daemon doctor: no issues found"
    ;;
  *)
    echo "unexpected command: $*" >&2
    exit 99
    ;;
esac
"""
    )
    try:
        result = run(["--nexus-bin", str(bin_path), "--check-readonly"])
        assert result.returncode == 0, result.stderr + result.stdout
        assert "PASS status.shape" in result.stdout
        assert "PASS logs.exit" in result.stdout
        assert "PASS doctor.output" in result.stdout
        calls = read_calls(root)
        assert calls == [
            "daemon --help",
            "daemon status",
            "daemon logs -n 1",
            "daemon doctor",
        ]
        forbidden = {"run", "start", "stop", "restart", "install", "uninstall"}
        for call in calls:
            assert not any(call == f"daemon {verb}" for verb in forbidden)
    finally:
        shutil.rmtree(root)


def test_malformed_status_reports_named_shape_failure() -> None:
    root, bin_path = fake_nexus(
        """#!/usr/bin/env bash
printf '%s\\n' "$*" >> "__CALLS__"
case "$*" in
  "daemon --help")
    echo "Commands: status logs doctor"
    ;;
  "daemon status")
    echo "daemon maybe"
    ;;
  "daemon logs -n 1")
    echo "log line"
    ;;
  "daemon doctor")
    echo "daemon doctor: no issues found"
    ;;
esac
"""
    )
    try:
        result = run(["--nexus-bin", str(bin_path), "--check-readonly"])
        assert result.returncode == 1
        assert "FAIL status.shape" in result.stdout
        assert "missing required status lines" in result.stdout
    finally:
        shutil.rmtree(root)


def main() -> int:
    tests = [
        test_print_only_lists_every_lifecycle_verb_and_edge_case,
        test_readonly_dry_run_never_calls_control_verbs,
        test_malformed_status_reports_named_shape_failure,
    ]
    for test in tests:
        test()
    print("nexus-daemon-lifecycle-acceptance tests passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
