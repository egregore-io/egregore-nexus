#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/nexus-pack-native-npm --binary PATH --output DIR [--target TARGET]
       [--version-output TEXT --expected-sha256 HEX]

Stage an already-built Nexus binary in an @egregore/nexus-cli package assembly.
This command never compiles source.

Cross-host packaging may supply the exact --version output and SHA-256 recorded
by the native validation host. Both evidence arguments are required together.
EOF
}

TARGET=linux-x64-gnu
BINARY=
OUTPUT=
VERSION_OUTPUT=
EXPECTED_SHA256=
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
"$ROOT/scripts/nexus-version" check >/dev/null
VERSION=$(tr -d '\n' < "$ROOT/VERSION")
while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --target) TARGET=${2:?missing value for --target}; shift 2 ;;
    --binary) BINARY=${2:?missing value for --binary}; shift 2 ;;
    --output) OUTPUT=${2:?missing value for --output}; shift 2 ;;
    --version-output) VERSION_OUTPUT=${2:?missing value for --version-output}; shift 2 ;;
    --expected-sha256) EXPECTED_SHA256=${2:?missing value for --expected-sha256}; shift 2 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

case "$TARGET" in
  linux-x64-gnu|linux-arm64-gnu|darwin-x64|darwin-arm64|win32-x64-msvc) ;;
  *) echo "unsupported native npm target: $TARGET" >&2; exit 2 ;;
esac
if [ -z "$BINARY" ] || [ ! -f "$BINARY" ]; then
  echo "--binary must name a Nexus binary file" >&2
  exit 2
fi
if [ -z "$OUTPUT" ]; then
  echo "--output is required" >&2
  exit 2
fi

if [ -n "$VERSION_OUTPUT" ] || [ -n "$EXPECTED_SHA256" ]; then
  if [ -z "$VERSION_OUTPUT" ] || [ -z "$EXPECTED_SHA256" ]; then
    echo "--version-output and --expected-sha256 are required together" >&2
    exit 2
  fi
  if [ "${#EXPECTED_SHA256}" -ne 64 ] \
    || [[ "$EXPECTED_SHA256" == *[!0-9A-Fa-f]* ]]; then
    echo "--expected-sha256 must be a 64-character hexadecimal digest" >&2
    exit 2
  fi
  if ! command -v sha256sum >/dev/null 2>&1; then
    echo "cross-host native packaging requires sha256sum" >&2
    exit 1
  fi
  ACTUAL_SHA256=$(sha256sum -- "$BINARY" | cut -d' ' -f1)
  if [ "${ACTUAL_SHA256,,}" != "${EXPECTED_SHA256,,}" ]; then
    echo "native binary SHA-256 does not match cross-host evidence" >&2
    exit 1
  fi
else
  if [ ! -x "$BINARY" ]; then
    echo "--binary must be executable when native version evidence is absent" >&2
    exit 2
  fi
  VERSION_OUTPUT=$("$BINARY" --version 2>&1) || {
    echo "native binary --version failed" >&2
    exit 1
  }
fi
EXPECTED_VERSION="nexus ${VERSION}"
if [ "$VERSION_OUTPUT" != "$EXPECTED_VERSION" ]; then
  echo "native binary does not report $EXPECTED_VERSION exactly: $VERSION_OUTPUT" >&2
  exit 1
fi

TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT
EXECUTABLE=nexus
[ "$TARGET" != win32-x64-msvc ] || EXECUTABLE=nexus.exe
cp "$BINARY" "$TMP/$EXECUTABLE"
chmod 755 "$TMP/$EXECUTABLE"

if [[ "$TARGET" == linux-* ]]; then
  STRIP_TOOL=strip
  OBJCOPY_TOOL=objcopy
  READELF_TOOL=readelf
  if [ "$TARGET" = linux-arm64-gnu ]; then
    case "$(uname -m)" in
      aarch64|arm64) ;;
      *)
        STRIP_TOOL=llvm-strip
        OBJCOPY_TOOL=llvm-objcopy
        READELF_TOOL=llvm-readelf
        ;;
    esac
  fi
  for tool in "$STRIP_TOOL" "$OBJCOPY_TOOL" "$READELF_TOOL"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Linux native npm packaging requires binary tool: $tool" >&2
      exit 1
    fi
  done

  "$STRIP_TOOL" --strip-all "$TMP/$EXECUTABLE"
  "$OBJCOPY_TOOL" --remove-section=.comment "$TMP/$EXECUTABLE"

  SECTIONS=$("$READELF_TOOL" -SW "$TMP/$EXECUTABLE")
  if printf '%s\n' "$SECTIONS" | grep -Eq '\.(symtab|debug_[^ ]*|comment)([[:space:]]|$)'; then
    echo "native npm binary retains symbol, debug, or comment sections after stripping" >&2
    exit 1
  fi
fi

if [[ "$TARGET" == darwin-* ]]; then
  MACHO_STRIP_TOOL=
  MACHO_NM_TOOL=
  MACHO_STRIP_ARGS=()
  APPLE_STRIP_CANDIDATE=
  APPLE_NM_CANDIDATE=
  if [ "$(uname -s 2>/dev/null || true)" = Darwin ] \
    && command -v xcrun >/dev/null 2>&1; then
    if APPLE_STRIP_CANDIDATE=$(xcrun --find strip 2>/dev/null) \
      && APPLE_NM_CANDIDATE=$(xcrun --find nm 2>/dev/null) \
      && [ -x "$APPLE_STRIP_CANDIDATE" ] \
      && [ -x "$APPLE_NM_CANDIDATE" ]; then
      MACHO_STRIP_TOOL=$APPLE_STRIP_CANDIDATE
      MACHO_NM_TOOL=$APPLE_NM_CANDIDATE
    fi
  fi
  if [ -n "$MACHO_STRIP_TOOL" ] && [ -x "$MACHO_STRIP_TOOL" ] \
    && [ -n "$MACHO_NM_TOOL" ] && [ -x "$MACHO_NM_TOOL" ]; then
    # Apple documents -u -r as the maximum safe stripping level for a
    # dynamically linked executable. Unlike -x, it does not preserve every
    # globally visible Rust implementation symbol.
    MACHO_STRIP_ARGS=(-u -r)
  elif command -v llvm-strip >/dev/null 2>&1 \
    && command -v llvm-nm >/dev/null 2>&1; then
    MACHO_STRIP_TOOL=llvm-strip
    MACHO_NM_TOOL=llvm-nm
    MACHO_STRIP_ARGS=(--strip-all)
  else
    echo "Darwin native npm packaging requires either Apple strip/nm on macOS or llvm-strip/llvm-nm" >&2
    exit 1
  fi

  if ! "$MACHO_STRIP_TOOL" "${MACHO_STRIP_ARGS[@]}" "$TMP/$EXECUTABLE"; then
    echo "Darwin native npm packaging failed to strip the staged Mach-O binary" >&2
    exit 1
  fi
  if ! MACHO_SYMBOLS=$("$MACHO_NM_TOOL" -a "$TMP/$EXECUTABLE" 2>&1); then
    echo "Darwin native npm packaging failed to inspect the stripped Mach-O binary" >&2
    exit 1
  fi
  RUST_SYMBOL_PATTERN='(^|[[:space:]])_*(ZN[^[:space:]]*17h[0-9A-Fa-f]{16}E|R[0-9A-Z][^[:space:]]*|rust(c)?[^[:space:]]*)($|[[:space:]])'
  if printf '%s\n' "$MACHO_SYMBOLS" | grep -Eq "$RUST_SYMBOL_PATTERN"; then
    echo "native npm Mach-O binary retains Rust symbol names after stripping" >&2
    exit 1
  else
    GREP_STATUS=$?
    if [ "$GREP_STATUS" -ne 1 ]; then
      echo "native npm binary inspection failed while checking Mach-O symbols" >&2
      exit 1
    fi
  fi
fi

if LC_ALL=C grep -aEq \
  '(/home/[^/[:space:]]+|/Users/[^/[:space:]]+)/(\.cargo|\.rustup|Projects)/|[A-Za-z]:[\\/]+Users[\\/]+[^\\/[:space:]]+[\\/]+(\.cargo|\.rustup|Projects)[\\/]' \
  "$TMP/$EXECUTABLE"; then
  echo "native binary exposes a private build-home path" >&2
  exit 1
else
  GREP_STATUS=$?
  if [ "$GREP_STATUS" -ne 1 ]; then
    echo "native npm binary inspection failed while checking private build paths" >&2
    exit 1
  fi
fi

if [ -z "$EXPECTED_SHA256" ]; then
  if ! "$TMP/$EXECUTABLE" --version 2>&1 | grep -Fxq "$VERSION_OUTPUT"; then
    echo "stripped native npm binary no longer reports the expected version" >&2
    exit 1
  fi
fi

DESTINATION="$OUTPUT/native/$TARGET"
mkdir -p "$DESTINATION"
cp "$TMP/$EXECUTABLE" "$DESTINATION/$EXECUTABLE"
chmod 755 "$DESTINATION/$EXECUTABLE"
printf '%s/%s\n' "$(cd "$DESTINATION" && pwd)" "$EXECUTABLE"
