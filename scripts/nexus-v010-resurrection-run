#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/nexus-v010-resurrection-run CANDIDATE [WARMUP_SECONDS]

Runs the twelve-variant active-traffic daemon resurrection fixture.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CANDIDATE=${1:?$(usage >&2)}
WARMUP_SECONDS=${2:-${NEXUS_RESURRECTION_WARMUP_SECONDS:-300}}

NEXUS_ENDURANCE_RUN_RESURRECTION=1
NEXUS_ENDURANCE_CONTAINER=${NEXUS_RESURRECTION_CONTAINER:-nexus-v010-resurrection}
NEXUS_ENDURANCE_HOST_PORT=${NEXUS_RESURRECTION_HOST_PORT:-4561}
NEXUS_ENDURANCE_WEBUI_HOST_PORT=${NEXUS_RESURRECTION_WEBUI_HOST_PORT:-4562}
NEXUS_ENDURANCE_THREAD_PREFIX=${NEXUS_RESURRECTION_THREAD_PREFIX:-resurrection-v010-final}
NEXUS_ENDURANCE_OUTPUT_PREFIX=${NEXUS_RESURRECTION_OUTPUT_PREFIX:-v010-resurrection-candidate}
NEXUS_ENDURANCE_EXPECT_CPUS=2000000000
NEXUS_ENDURANCE_EXPECT_MEMORY_BYTES=8589934592
NEXUS_ENDURANCE_EXPECT_PIDS=1024
NEXUS_ENDURANCE_REQUIRE_HOST_CAPACITY=${NEXUS_RESURRECTION_REQUIRE_HOST_CAPACITY:-0}

export NEXUS_ENDURANCE_RUN_RESURRECTION
export NEXUS_ENDURANCE_CONTAINER
export NEXUS_ENDURANCE_HOST_PORT
export NEXUS_ENDURANCE_WEBUI_HOST_PORT
export NEXUS_ENDURANCE_THREAD_PREFIX
export NEXUS_ENDURANCE_OUTPUT_PREFIX
export NEXUS_ENDURANCE_EXPECT_CPUS
export NEXUS_ENDURANCE_EXPECT_MEMORY_BYTES
export NEXUS_ENDURANCE_EXPECT_PIDS
export NEXUS_ENDURANCE_REQUIRE_HOST_CAPACITY

exec "$ROOT/scripts/nexus-v010-endurance-gate" "$CANDIDATE" "$WARMUP_SECONDS"
