#!/usr/bin/env bash
# The one-command green gate. "Suite green" means THIS passes — run it before
# every commit.
#
# Usage:
#   scripts/check              # everything: rust fmt + tests, gateway typecheck + tests
#   scripts/check rust         # rust only
#   scripts/check rust -p nexus-identity        # focused crate (args pass through)
#   scripts/check rust-workspace                # compile every Rust workspace test target
#   scripts/check acceptance                    # run the acceptance suite
#   scripts/check core-test-layout              # fail if core production source contains inline tests
#   scripts/check cargo-targets                 # fail if workspace binary target names collide
#   scripts/check release-identity              # v0.1 license/version/internal naming contract
#   scripts/check architecture                  # daemon/Gateway/WebUI ownership boundary
#   scripts/check boundaries                    # harness isolation boundary (shrink-only)
#   scripts/check gateway      # gateway only
#   scripts/check model-reporting              # eight native/adapter modes -> Gateway snapshots
#   scripts/check hooks-practical             # live Gateway message-hook boundary
#   scripts/check gateway useAgentSession       # focused vitest filter
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: scripts/check [all|rust|rust-workspace|acceptance|core-test-layout|cargo-targets|release-identity|architecture|boundaries|load|hooks-practical|gateway|model-reporting] [extra args]
EOF
}

case "${1:-}" in
  -h|--help|help) usage; exit 0 ;;
esac

cd "$(dirname "$0")/.."

MODE="${1:-all}"
shift || true

rust_gate() {
  echo "── rust: fmt ─────────────────────────────"
  (cd core && cargo fmt --all -- --check)
  echo "── rust: tests $* ────────────────────────"
  (cd core && cargo test "$@")
}

rust_workspace_compile_gate() {
  echo "── rust: workspace compile ───────────────"
  (cd core && cargo test --workspace --no-run)
}

acceptance_gate() {
  echo "── rust: acceptance ──────────────────────"
  (cd core && cargo test -p nexus-acceptance)
}

core_test_layout_gate() {
  echo "── rust: core test layout ────────────────"
  scripts/nexus-core-test-layout-gate
}

cargo_target_name_gate() {
  echo "── rust: Cargo target names ───────────────"
  scripts/nexus-cargo-target-name-gate
}

release_identity_gate() {
  echo "── release: v0.1 identity ─────────────────"
  scripts/nexus-v010-release-identity-gate
}

architecture_ownership_gate() {
  echo "── architecture: ownership ────────────────"
  scripts/nexus-architecture-ownership-gate
}

boundary_gate() {
  echo "── architecture: harness boundary ─────────"
  scripts/nexus-boundary-gate
}

gateway_gate() {
  echo "── gateway: typecheck ────────────────────"
  pnpm --dir gateway typecheck
  echo "── gateway: vitest $* ────────────────────"
  if (($#)); then
    pnpm --dir gateway test "$@"
  else
    pnpm --dir gateway test
  fi
}

model_reporting_gate() (
  # Empty unique artifacts, explicit run association, no access to an operator Nexus home.
  local original_home="$HOME"
  local run_home
  run_home="$(mktemp -d "${TMPDIR:-/tmp}/nexus-model-reporting.XXXXXX")"
  trap 'rm -rf -- "$run_home"' EXIT
  export CARGO_HOME="${CARGO_HOME:-$original_home/.cargo}"
  export RUSTUP_HOME="${RUSTUP_HOME:-$original_home/.rustup}"
  export HOME="$run_home/home" NEXUS_HOME="$run_home/nexus" XDG_CONFIG_HOME="$run_home/config"
  export NEXUS_MODEL_PROJECTION_FIXTURE_DIR="$run_home/artifacts"
  export NEXUS_MODEL_PROJECTION_RUN_ID="${run_home##*/}"
  mkdir -p "$HOME" "$NEXUS_MODEL_PROJECTION_FIXTURE_DIR"
  (cd core && cargo test -p egregore-nexus --test acp_adapter_model_reporting)
  (cd core && cargo test -p egregore-nexus --test codex_appserver_launch fresh_headed_codex_launch_persists_discovered_thread_in_resurrection_capsule)
  (cd core && cargo test -p egregore-nexus --lib headed_model_projection_)
  for mode in headless headed; do
    for harness in claude codex opencode hermes; do
      test -s "$NEXUS_MODEL_PROJECTION_FIXTURE_DIR/$harness.$mode.json" || {
        echo "Missing nonempty Rust projection artifact: $harness.$mode" >&2; exit 1;
      }
    done
  done
  node -e 'const fs=require("node:fs"),crypto=require("node:crypto"),path=require("node:path"); const dir=process.env.NEXUS_MODEL_PROJECTION_FIXTURE_DIR; for(const name of fs.readdirSync(dir).sort()) console.log(crypto.createHash("sha256").update(fs.readFileSync(path.join(dir,name))).digest("hex"),name);'
  (cd gateway && node node_modules/vitest/vitest.mjs run --config vitest.model-integration.config.ts)
)

case "$MODE" in
  rust)           rust_gate "$@" ;;
  rust-workspace) rust_workspace_compile_gate ;;
  acceptance)     acceptance_gate ;;
  core-test-layout) core_test_layout_gate ;;
  cargo-targets)    cargo_target_name_gate ;;
  release-identity) release_identity_gate ;;
  architecture)    architecture_ownership_gate ;;
  boundaries)      boundary_gate ;;
  model-reporting) model_reporting_gate ;;
  # Load-regression gate: full incident-replay run in the isolated docker env (phases 1-6,
  # ~10-15 min). NOT part of `all` — run before every deploy: scripts/check load
  load) python3 scripts/test-nexus-load-gate && exec python3 -u scripts/nexus-load-gate run --skip-docker-build "$@" ;;
  hooks-practical) scripts/test-nexus-hooks-practical-gate && exec scripts/nexus-hooks-practical-gate "$@" ;;
  gateway|front)  gateway_gate "$@" ;;
  all)            architecture_ownership_gate; boundary_gate; cargo_target_name_gate; rust_gate; gateway_gate ;;
  *) usage >&2; exit 64 ;;
esac
echo "── check: GREEN ──────────────────────────"
