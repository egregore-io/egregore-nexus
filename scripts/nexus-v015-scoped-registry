#!/usr/bin/env python3
"""Serve the exact v0.1.5 @egregore candidate set from local tarballs."""

from __future__ import annotations

import argparse
import base64
import hashlib
import http.server
import json
import os
import tarfile
import urllib.parse
from pathlib import Path


EXPECTED_PACKAGES = {
    "@egregore/nexus-cli": "nexus-cli.tgz",
    "@egregore/nexus-gateway": "nexus-gateway.tgz",
    "@egregore/nexus": "nexus.tgz",
}
EXPECTED_VERSION = "0.1.5"


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--ready-file", required=True, type=Path)
    parser.add_argument("--npmrc", required=True, type=Path)
    parser.add_argument("--package", action="append", default=[])
    return parser.parse_args()


def parse_packages(values: list[str]) -> dict[str, Path]:
    packages: dict[str, Path] = {}
    for value in values:
        name, separator, raw_path = value.partition("=")
        if not separator or not name or not raw_path or name in packages:
            raise SystemExit(f"invalid --package binding: {value}")
        packages[name] = Path(raw_path).resolve()
    if set(packages) != set(EXPECTED_PACKAGES):
        raise SystemExit("candidate registry requires exactly nexus, nexus-cli, and nexus-gateway")
    return packages


def package_document(name: str, tarball: Path) -> dict[str, object]:
    with tarfile.open(tarball, mode="r:gz") as archive:
        member = archive.extractfile("package/package.json")
        if member is None:
            raise SystemExit(f"candidate tarball has no package.json: {tarball}")
        document = json.load(member)
    if document.get("name") != name or document.get("version") != EXPECTED_VERSION:
        raise SystemExit(f"candidate tarball identity mismatch: {tarball}")
    return document


def atomic_write(path: Path, body: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp.{os.getpid()}")
    temporary.write_text(body, encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def main() -> None:
    args = parse_args()
    packages = parse_packages(args.package)
    documents = {
        name: package_document(name, tarball)
        for name, tarball in packages.items()
    }

    class Registry(http.server.BaseHTTPRequestHandler):
        def send_bytes(self, status: int, content_type: str, body: bytes) -> None:
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler API
            raw_path = self.path.split("?", 1)[0]
            path = urllib.parse.unquote(raw_path)
            if path == "/-/ping":
                self.send_bytes(200, "application/json", b"{}")
                return
            name = path.removeprefix("/")
            if name in packages:
                tarball = packages[name]
                data = tarball.read_bytes()
                version = dict(documents[name])
                version["dist"] = {
                    "tarball": (
                        f"http://127.0.0.1:{self.server.server_port}/tarballs/"
                        f"{EXPECTED_PACKAGES[name]}"
                    ),
                    "shasum": hashlib.sha1(data).hexdigest(),  # noqa: S324 - npm contract
                    "integrity": "sha512-"
                    + base64.b64encode(hashlib.sha512(data).digest()).decode("ascii"),
                }
                body = json.dumps(
                    {
                        "_id": name,
                        "name": name,
                        "dist-tags": {"latest": EXPECTED_VERSION},
                        "versions": {EXPECTED_VERSION: version},
                    },
                    separators=(",", ":"),
                ).encode("utf-8")
                self.send_bytes(200, "application/json", body)
                return
            if path.startswith("/tarballs/"):
                route = path.removeprefix("/tarballs/")
                for name, expected_route in EXPECTED_PACKAGES.items():
                    if route == expected_route:
                        self.send_bytes(
                            200,
                            "application/octet-stream",
                            packages[name].read_bytes(),
                        )
                        return
            self.send_bytes(404, "application/json", b'{"error":"not_found"}')

        def log_message(self, _format: str, *_args: object) -> None:
            return

    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Registry)
    registry_url = f"http://127.0.0.1:{server.server_port}"
    atomic_write(
        args.npmrc,
        f"@egregore:registry={registry_url}\nregistry=https://registry.npmjs.org/\n",
    )
    atomic_write(args.ready_file, registry_url)
    server.serve_forever()


if __name__ == "__main__":
    main()
