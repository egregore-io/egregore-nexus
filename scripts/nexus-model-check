#!/usr/bin/env python3
"""nexus-model-check — fleet model validator.

For every ONLINE session, report which model its harness is actually running,
and flag minis/unknowns. Stopgap until model-observability (#47) lands in the store.

Sources, best-effort in order:
  codex/claude (headed): tmux pane footer scrape on the session's deterministic socket
  claude (fallback):     last "model" field in the bridge hooks.jsonl (authoritative)
  opencode:              model fields in the session row of opencode.db
  hermes:                model fields in the session row of hermes db

Usage: scripts/nexus-model-check [--all] [--db PATH]   (--all includes offline sessions)
Exit code 1 if any ONLINE agent is on a mini/unknown model.
"""
import argparse
import json
import os
import re
import sqlite3
import subprocess
import sys
from pathlib import Path

DEFAULT_DB = os.path.expanduser("~/.nexus/nexus.db")
MODEL_RE = re.compile(
    r"(gpt-[0-9][\w.\-]*(?:\s+(?:minimal|low|medium|high|xhigh|default))?"
    r"|claude-[\w.\-]+|Fable\s?[\d.]*|Opus\s?[\d.]+|Sonnet\s?[\d.]*|Haiku\s?[\d.]*"
    r"|glm-[\w.\-]+|deepseek[\w.\-]*|o[134][\w.\-]*)",
    re.I,
)
MINI_RE = re.compile(r"mini|nano|haiku|glm-|minimal", re.I)


def pane_model(session_id: str):
    sock = f"/tmp/nexus-tmux-nexus-{session_id}.sock"
    if not os.path.exists(sock):
        return None
    try:
        out = subprocess.run(
            ["tmux", "-S", sock, "capture-pane", "-p"],
            capture_output=True, text=True, timeout=5,
        ).stdout
    except Exception:
        return None
    hits = [m.group(1).strip() for m in MODEL_RE.finditer(out)
            if "/" not in m.group(1) and "claude-1000" not in m.group(1)]
    return hits[-1] if hits else None


def claude_bridge_model(con, session_id: str):
    row = con.execute(
        "SELECT bridge_dir FROM claude_runtime_state WHERE runtime_id=?", (session_id,)
    ).fetchone()
    if not row or not row[0]:
        return None
    hooks = os.path.join(row[0], "hooks.jsonl")
    if not os.path.exists(hooks):
        return None
    model = None
    try:
        with open(hooks, errors="ignore") as f:
            for line in f:
                if '"model"' in line:
                    try:
                        model = json.loads(line)["payload"].get("model", model)
                    except Exception:
                        pass
    except Exception:
        return None
    return model


def db_session_model(path, session_key, table="session"):
    if not path or not session_key:
        return None
    try:
        oc = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        cols = [c[1] for c in oc.execute(f"PRAGMA table_info({table})")]
        if not cols:
            return None
        row = oc.execute(f"SELECT * FROM {table} WHERE id=?", (session_key,)).fetchone()
        if not row:
            return None
        data = dict(zip(cols, row))
        model = model_from_value(data.get("model"))
        if model:
            return model
        blob = json.dumps(data, default=str)
        m = re.findall(r'"model[^"]*"\s*:\s*"([^"]+)"', blob) or MODEL_RE.findall(blob)
        return (m[-1] if isinstance(m[-1], str) else m[-1][0]) if m else None
    except Exception:
        return None


def model_from_value(value):
    if not value:
        return None
    if isinstance(value, bytes):
        value = value.decode(errors="ignore")
    if not isinstance(value, str):
        value = str(value)
    try:
        parsed = json.loads(value)
    except Exception:
        parsed = None
    if isinstance(parsed, dict):
        model_id = parsed.get("id") or parsed.get("model")
        variant = parsed.get("variant")
        if model_id and variant and variant != "default":
            return f"{model_id} {variant}"
        if model_id:
            return str(model_id)
    hit = MODEL_RE.search(value)
    return hit.group(1).strip() if hit else None


def safe_path_component(value):
    safe = "".join(
        ch if ch.isalnum() or ch in "._-" else "_"
        for ch in str(value or "")
    )
    return safe or "_"


def opencode_acp_db_paths(cwd, project=None, name=None):
    if not cwd:
        return []
    root = Path(cwd).expanduser() / ".nexus" / "opencode"
    paths = []
    if project and name:
        paths.append(
            root
            / "acp"
            / safe_path_component(project)
            / safe_path_component(name)
            / "opencode.db"
        )
    paths.append(root / "opencode.db")
    return [str(path) for path in paths if path.exists()]


def table_columns(con, table):
    return [row[1] for row in con.execute(f"PRAGMA table_info({table})")]


def offline_exclusions(con):
    rows = con.execute(
        "SELECT name, agent FROM sessions WHERE presence = 'offline' ORDER BY name"
    ).fetchall()
    if not rows:
        return
    names = ", ".join(f"{name}/{agent or '-'}" for name, agent in rows[:12])
    suffix = "..." if len(rows) > 12 else ""
    print(
        f"NOTE: excluding {len(rows)} offline session(s) from verdict; use --all to inspect: {names}{suffix}"
    )


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--all", action="store_true", help="include offline sessions")
    parser.add_argument("--db", default=DEFAULT_DB, help="nexus.db path")
    args = parser.parse_args()

    con = sqlite3.connect(f"file:{os.path.expanduser(args.db)}?mode=ro", uri=True)
    session_cols = table_columns(con, "sessions")
    wanted = ["name", "session_id", "agent", "presence", "cwd", "project", "harness_session_id"]
    select_cols = [col for col in wanted if col in session_cols]
    q = f"SELECT {', '.join(select_cols)} FROM sessions"
    if not args.all:
        offline_exclusions(con)
    if not args.all:
        q += " WHERE presence != 'offline'"
    rows = [dict(zip(select_cols, row)) for row in con.execute(q + " ORDER BY name")]

    bad = 0
    print(f"{'NAME':<12} {'HARNESS':<9} {'PRESENCE':<9} {'MODEL':<28} {'SOURCE':<8} VERDICT")
    for row in rows:
        name = row.get("name")
        sid = row.get("session_id")
        harness = row.get("agent")
        presence = row.get("presence")
        model, source = pane_model(sid), "pane"
        if not model and (harness or "") == "claude":
            model, source = claude_bridge_model(con, sid), "bridge"
        if not model and (harness or "") == "opencode":
            r = con.execute(
                "SELECT opencode_db_path, opencode_session_id FROM opencode_runtime_state WHERE runtime_id=?",
                (sid,),
            ).fetchone()
            if r:
                model, source = db_session_model(r[0], r[1]), "oc-db"
            if not model:
                for db_path in opencode_acp_db_paths(
                    row.get("cwd"), row.get("project"), name
                ):
                    model = db_session_model(db_path, row.get("harness_session_id"))
                    if model:
                        source = "oc-acp"
                        break
        if not model and (harness or "") == "hermes":
            r = con.execute(
                "SELECT hermes_db_path, hermes_session_id FROM hermes_runtime_state WHERE runtime_id=?",
                (sid,),
            ).fetchone()
            if r:
                model, source = db_session_model(r[0], r[1], "sessions"), "hm-db"
        if not model:
            model, source = "UNKNOWN", "-"

        verdict = "OK"
        if model == "UNKNOWN":
            verdict, bad = "⚠ VERIFY MANUALLY", bad + (0 if presence == "offline" else 1)
        elif MINI_RE.search(model):
            verdict, bad = "🔴 MINI/SMALL — FLAG", bad + (0 if presence == "offline" else 1)
        print(f"{name:<12} {harness or '-':<9} {presence:<9} {model:<28} {source:<8} {verdict}")

    print(f"\n{'⚠ ' + str(bad) + ' online agent(s) need attention' if bad else '✅ all online agents on full models (or verified)'}")
    sys.exit(1 if bad else 0)


if __name__ == "__main__":
    main()
