#!/usr/bin/env python3
"""Wedge and exactly restore Lens's human credential in the v0.1.5 lab.

This hook is intentionally narrower than a general JSON editor. It operates on
one canonical Lens plugin storage file, preserves the CSRF twin, retains the
original storage inode through a hard-link rollback anchor, and binds every
state transition to the current run and readiness ledger. All participating
writers MUST serialize on this hook's lock. Protection against an uncooperative
same-UID/root process racing pathnames is explicitly outside this contract;
directory anchors detect replacement, but Python/POSIX does not provide an
atomic validate-and-unlink primitive for arbitrary hostile peer writers.
"""

from __future__ import annotations

import fcntl
import hashlib
import json
import os
import re
import secrets
import signal
import stat
import sys
import tempfile
from contextlib import contextmanager
from dataclasses import dataclass, replace
from pathlib import Path
from typing import Any, Iterator


USAGE = """Usage: lab-credential wedge|restore

Temporarily replace only Lens's stored humanCookie inside the isolated v0.1.5
lab. Run `restore` from the caller's finally block. The original storage inode,
bytes, ownership, and mode are restored exactly.
"""

CANONICAL_ROOT = Path("/tmp/nexus-lens-home")
CANONICAL_STATE_ROOT = Path("/tmp/nexus-v015-credential")
SAFE_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]{0,127}\Z")
SHA256 = re.compile(r"[0-9a-f]{64}\Z")
CONTAINER_ID = re.compile(r"[0-9a-f]{64}\Z")
MAX_LEDGER_BYTES = 128 * 1024
MAX_STORAGE_BYTES = 1024 * 1024
MAX_RECEIPT_BYTES = 256 * 1024
MAX_PLAN_BYTES = 128 * 1024

EXIT_CODES = {
    "LAB_CREDENTIAL_USAGE": 2,
    "LAB_CREDENTIAL_LAB_ONLY": 3,
    "LAB_CREDENTIAL_PATH_UNSAFE": 4,
    "LAB_CREDENTIAL_CANDIDATE_INVALID": 5,
    "LAB_CREDENTIAL_STORAGE_INVALID": 6,
    "LAB_CREDENTIAL_RECEIPT_INVALID": 7,
    "LAB_CREDENTIAL_REPLACED": 8,
    "LAB_CREDENTIAL_IO": 9,
}


class CredentialError(RuntimeError):
    def __init__(self, kind: str, message: str):
        self.kind = kind
        super().__init__(message)


class ReceiptPublishError(OSError):
    def __init__(self, message: str, *, state: str):
        if state not in {"rolled_back", "indeterminate"}:
            raise ValueError(f"invalid receipt publication state: {state}")
        self.state = state
        super().__init__(message)


@dataclass(frozen=True)
class OwnedFile:
    path: Path
    device: int
    inode: int
    size: int
    mode: int
    uid: int
    gid: int
    nlink: int
    mtime_ns: int
    sha256: str


@dataclass(frozen=True)
class DirectoryAnchor:
    path: Path
    descriptor: int
    device: int
    inode: int
    mode: int
    uid: int
    gid: int


@dataclass(frozen=True)
class LabPaths:
    root: Path
    lens: Path
    plugin: Path
    storage: Path
    metadata_lab: Path
    lab: Path
    readiness: Path
    receipt: Path
    plan: Path
    lock: Path
    lab_uid: int
    lab_gid: int
    authority_device: int
    authority_inode: int
    anchors: tuple[DirectoryAnchor, ...]


@dataclass(frozen=True)
class CandidateBinding:
    run_id: str
    readiness_sha256: str
    container_id: str
    mode: str


def fail(kind: str, message: str) -> None:
    raise CredentialError(kind, message)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def parse_command(arguments: list[str]) -> str | None:
    if arguments in (["--help"], ["-h"]):
        return None
    if len(arguments) != 1 or arguments[0] not in {"wedge", "restore"}:
        fail("LAB_CREDENTIAL_USAGE", "action must be wedge or restore")
    return arguments[0]


def is_relative_to(path: Path, root: Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def reject_symlink_chain(path: Path, label: str) -> None:
    if not path.is_absolute():
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"{label} must be an absolute path")
    current = Path(path.anchor)
    for part in path.parts[1:]:
        current /= part
        try:
            metadata = current.lstat()
        except FileNotFoundError:
            break
        except OSError as error:
            fail("LAB_CREDENTIAL_IO", f"cannot inspect {label} {current}: {error}")
        if stat.S_ISLNK(metadata.st_mode):
            fail(
                "LAB_CREDENTIAL_PATH_UNSAFE",
                f"{label} contains a symlink: {current}",
            )


def existing_directory(path: Path, label: str) -> Path:
    reject_symlink_chain(path, label)
    try:
        metadata = path.lstat()
        resolved = path.resolve(strict=True)
    except FileNotFoundError:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"{label} does not exist: {path}")
    except OSError as error:
        fail("LAB_CREDENTIAL_IO", f"cannot inspect {label} {path}: {error}")
    if not stat.S_ISDIR(metadata.st_mode):
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"{label} is not a directory: {path}")
    return resolved


def validate_state_root(
    path: Path,
    *,
    owner: int,
    group: int,
    canonical: bool,
) -> Path:
    resolved = existing_directory(path, "credential authority directory")
    try:
        metadata = resolved.lstat()
    except OSError as error:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"cannot inspect credential authority: {error}")
    if (
        metadata.st_uid != owner
        or metadata.st_gid != group
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        fail(
            "LAB_CREDENTIAL_PATH_UNSAFE",
            "credential authority directory must have the expected owner and mode 0700",
        )
    if canonical:
        if resolved != CANONICAL_STATE_ROOT:
            fail(
                "LAB_CREDENTIAL_LAB_ONLY",
                f"canonical credential authority must be {CANONICAL_STATE_ROOT}",
            )
        try:
            parent = resolved.parent.lstat()
        except OSError as error:
            fail("LAB_CREDENTIAL_PATH_UNSAFE", f"cannot inspect /tmp authority: {error}")
        if (
            not stat.S_ISDIR(parent.st_mode)
            or parent.st_uid != 0
            or not (stat.S_IMODE(parent.st_mode) & stat.S_ISVTX)
        ):
            fail(
                "LAB_CREDENTIAL_PATH_UNSAFE",
                "canonical credential authority requires a root-owned sticky /tmp parent",
            )
    return resolved


def expected_receipt_owner(root: Path, environment: dict[str, str]) -> int:
    if root == CANONICAL_ROOT:
        return 0
    return os.geteuid()


def expected_receipt_group(root: Path, environment: dict[str, str]) -> int:
    if root == CANONICAL_ROOT:
        return 0
    return os.getegid()


def expected_metadata_authority(
    root: Path, environment: dict[str, str]
) -> tuple[int, int, int]:
    """Owner/group/mode for the single, shared lab readiness directory."""
    if root == CANONICAL_ROOT:
        return 0, 0, 0o1777
    if environment.get("NEXUS_V015_ALLOW_FIXTURE_HOME") == "1":
        return os.geteuid(), os.getegid(), 0o700
    return 0, 0, 0o1777


def require_invoker_for_receipt(root: Path, environment: dict[str, str]) -> None:
    owner = expected_receipt_owner(root, environment)
    if os.geteuid() != owner:
        fail(
            "LAB_CREDENTIAL_LAB_ONLY",
            "canonical credential hook must run as root so its receipt is root-owned",
        )


def require_distinct_lens_authority(
    root: Path, *, lab_uid: int, receipt_owner: int
) -> None:
    if root == CANONICAL_ROOT and lab_uid == receipt_owner:
        fail(
            "LAB_CREDENTIAL_LAB_ONLY",
            "canonical Lens data owner must be distinct from the root credential authority",
        )


def open_directory_anchor(
    path: Path,
    *,
    owner: int,
    group: int,
    mode: int | None,
    label: str,
) -> DirectoryAnchor:
    reject_symlink_chain(path, label)
    flags = (
        os.O_RDONLY
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_DIRECTORY", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    try:
        before = path.lstat()
        descriptor = os.open(path, flags)
    except OSError as error:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"cannot anchor {label}: {error}")
    try:
        opened = os.fstat(descriptor)
        visible = path.lstat()
        observed_mode = stat.S_IMODE(opened.st_mode)
        if (
            not stat.S_ISDIR(opened.st_mode)
            or opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or visible.st_dev != opened.st_dev
            or visible.st_ino != opened.st_ino
            or opened.st_uid != owner
            or opened.st_gid != group
            or (mode is not None and observed_mode != mode)
            or (mode is None and observed_mode & 0o022)
        ):
            fail(
                "LAB_CREDENTIAL_PATH_UNSAFE",
                f"{label} ownership, mode, or inode is unsafe",
            )
        return DirectoryAnchor(
            path,
            descriptor,
            opened.st_dev,
            opened.st_ino,
            observed_mode,
            opened.st_uid,
            opened.st_gid,
        )
    except Exception:
        os.close(descriptor)
        raise


def validate_anchored_directories(paths: LabPaths) -> None:
    for anchor in paths.anchors:
        try:
            opened = os.fstat(anchor.descriptor)
            visible = anchor.path.lstat()
        except OSError as error:
            fail(
                "LAB_CREDENTIAL_PATH_UNSAFE",
                f"anchored directory changed: {anchor.path}: {error}",
            )
        if (
            not stat.S_ISDIR(opened.st_mode)
            or opened.st_dev != anchor.device
            or opened.st_ino != anchor.inode
            or visible.st_dev != anchor.device
            or visible.st_ino != anchor.inode
            or stat.S_IMODE(opened.st_mode) != anchor.mode
            or opened.st_uid != anchor.uid
            or opened.st_gid != anchor.gid
        ):
            fail(
                "LAB_CREDENTIAL_PATH_UNSAFE",
                f"anchored directory was replaced or changed: {anchor.path}",
            )


def close_lab_paths(paths: LabPaths) -> None:
    for anchor in reversed(paths.anchors):
        try:
            os.close(anchor.descriptor)
        except OSError:
            pass


def configured_lab_identity(environment: dict[str, str]) -> tuple[int, int]:
    values: list[int] = []
    for key in ("NEXUS_V015_LAB_UID", "NEXUS_V015_LAB_GID"):
        raw = environment.get(key, "")
        if not raw.isascii() or not raw.isdecimal():
            fail(
                "LAB_CREDENTIAL_LAB_ONLY",
                f"{key} must identify the configured lab UID/GID",
            )
        value = int(raw)
        if value < 0 or value > 2**31 - 1:
            fail("LAB_CREDENTIAL_LAB_ONLY", f"{key} is out of range")
        values.append(value)
    return values[0], values[1]


def validate_lens_authority_path(
    path: Path,
    owner: int,
    group: int,
    *,
    regular: bool,
    label: str,
) -> os.stat_result:
    reject_symlink_chain(path, label)
    try:
        metadata = path.lstat()
    except OSError as error:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"cannot inspect {label}: {error}")
    expected_kind = stat.S_ISREG if regular else stat.S_ISDIR
    if not expected_kind(metadata.st_mode):
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"{label} has the wrong file type")
    if metadata.st_uid != owner or metadata.st_gid != group:
        fail(
            "LAB_CREDENTIAL_PATH_UNSAFE",
            f"{label} is not owned by the configured lab UID:GID",
        )
    if stat.S_IMODE(metadata.st_mode) & 0o022:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"{label} is group/other writable")
    if regular and metadata.st_nlink != 1:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"{label} must have exactly one link")
    return metadata


def resolve_lab_paths(environment: dict[str, str]) -> LabPaths:
    if environment.get("OCULAR_LAB") != "1":
        fail("LAB_CREDENTIAL_LAB_ONLY", "refusing to run outside OCULAR_LAB=1")
    raw_root = environment.get("NEXUS_LAB_ROOT", "")
    raw_lens = environment.get("LENS_DATA_HOME", "")
    if not raw_root or not raw_lens:
        fail(
            "LAB_CREDENTIAL_LAB_ONLY",
            "NEXUS_LAB_ROOT and LENS_DATA_HOME are required",
        )
    root = existing_directory(Path(raw_root), "NEXUS_LAB_ROOT")
    fixture_mode = (
        root != CANONICAL_ROOT
        and environment.get("NEXUS_V015_ALLOW_FIXTURE_HOME") == "1"
    )
    if not fixture_mode and root != CANONICAL_ROOT:
        fail(
            "LAB_CREDENTIAL_LAB_ONLY",
            f"refusing non-canonical NEXUS_LAB_ROOT: {root}",
        )
    require_invoker_for_receipt(root, environment)
    lab_uid, lab_gid = configured_lab_identity(environment)
    owner = expected_receipt_owner(root, environment)
    group = expected_receipt_group(root, environment)
    require_distinct_lens_authority(
        root,
        lab_uid=lab_uid,
        receipt_owner=owner,
    )
    lens = existing_directory(Path(raw_lens), "LENS_DATA_HOME")
    expected_lens = root / "lens-data"
    if lens != expected_lens or not is_relative_to(lens, root):
        fail(
            "LAB_CREDENTIAL_PATH_UNSAFE",
            f"LENS_DATA_HOME must be the lab-owned path {expected_lens}",
        )
    metadata_lab = existing_directory(root / "lab", "lab metadata directory")
    plugins = existing_directory(lens / "plugins", "Lens plugins directory")
    plugin = existing_directory(
        plugins / "lens.nexus", "Lens Nexus plugin storage directory"
    )
    validate_lens_authority_path(
        lens, lab_uid, lab_gid, regular=False, label="LENS_DATA_HOME"
    )
    validate_lens_authority_path(
        plugins,
        lab_uid,
        lab_gid,
        regular=False,
        label="Lens plugins directory",
    )
    validate_lens_authority_path(
        plugin,
        lab_uid,
        lab_gid,
        regular=False,
        label="Lens Nexus plugin storage directory",
    )
    raw_state = environment.get("NEXUS_V015_CREDENTIAL_STATE_ROOT", "")
    if fixture_mode:
        if not raw_state:
            fail(
                "LAB_CREDENTIAL_LAB_ONLY",
                "fixture credential authority requires NEXUS_V015_CREDENTIAL_STATE_ROOT",
            )
        state_candidate = Path(raw_state)
        if is_relative_to(state_candidate, root):
            fail(
                "LAB_CREDENTIAL_PATH_UNSAFE",
                "credential authority must be outside the Lens-owned lab root",
            )
    else:
        if raw_state and Path(raw_state) != CANONICAL_STATE_ROOT:
            fail(
                "LAB_CREDENTIAL_LAB_ONLY",
                f"refusing non-canonical credential authority: {raw_state}",
            )
        state_candidate = CANONICAL_STATE_ROOT
    lab = validate_state_root(
        state_candidate, owner=owner, group=group, canonical=not fixture_mode
    )
    metadata_owner, metadata_group, metadata_mode = expected_metadata_authority(
        root, environment
    )
    anchors: list[DirectoryAnchor] = []
    try:
        anchors.append(
            open_directory_anchor(
                lens,
                owner=lab_uid,
                group=lab_gid,
                mode=None,
                label="LENS_DATA_HOME",
            )
        )
        anchors.append(
            open_directory_anchor(
                plugins,
                owner=lab_uid,
                group=lab_gid,
                mode=None,
                label="Lens plugins directory",
            )
        )
        anchors.append(
            open_directory_anchor(
                plugin,
                owner=lab_uid,
                group=lab_gid,
                mode=None,
                label="Lens Nexus plugin storage directory",
            )
        )
        anchors.append(
            open_directory_anchor(
                metadata_lab,
                owner=metadata_owner,
                group=metadata_group,
                mode=metadata_mode,
                label="lab metadata/readiness directory",
            )
        )
        anchors.append(
            open_directory_anchor(
                lab,
                owner=owner,
                group=group,
                mode=0o700,
                label="credential authority directory",
            )
        )
    except Exception:
        for anchor in reversed(anchors):
            os.close(anchor.descriptor)
        raise
    authority_metadata = lab.lstat()
    storage = plugin / "storage.json"
    # This is deliberately the one shared readiness authority.  Private
    # credential state contains no shadow candidate ledger.
    readiness = metadata_lab / "candidate-ready.v1"
    receipt = lab / "credential.v1.json"
    plan = lab / "credential.plan.v1.json"
    lock = lab / "credential.lock"
    for path, label in (
        (storage, "Lens Nexus credential storage"),
        (readiness, "candidate readiness ledger"),
        (receipt, "credential receipt"),
        (plan, "credential transaction plan"),
        (lock, "credential lock"),
    ):
        reject_symlink_chain(path, label)
    return LabPaths(
        root,
        lens,
        plugin,
        storage,
        metadata_lab,
        lab,
        readiness,
        receipt,
        plan,
        lock,
        lab_uid,
        lab_gid,
        authority_metadata.st_dev,
        authority_metadata.st_ino,
        tuple(anchors),
    )


def validate_authority_identity(paths: LabPaths) -> None:
    validate_anchored_directories(paths)
    try:
        metadata = paths.lab.lstat()
    except OSError as error:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"credential authority changed: {error}")
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_dev != paths.authority_device
        or metadata.st_ino != paths.authority_inode
    ):
        fail("LAB_CREDENTIAL_PATH_UNSAFE", "credential authority directory was replaced")


def _read_fd(descriptor: int, size: int) -> bytes:
    chunks: list[bytes] = []
    remaining = size
    while remaining:
        chunk = os.read(descriptor, min(remaining, 1024 * 1024))
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def read_owned_file(
    path: Path,
    label: str,
    error_kind: str,
    *,
    limit: int | None = None,
) -> tuple[OwnedFile, bytes]:
    reject_symlink_chain(path, label)
    try:
        before_visible = path.lstat()
    except FileNotFoundError:
        fail(error_kind, f"{label} is missing: {path}")
    except OSError as error:
        fail("LAB_CREDENTIAL_IO", f"cannot inspect {label} {path}: {error}")
    if not stat.S_ISREG(before_visible.st_mode):
        fail(error_kind, f"{label} is not a regular file: {path}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        fail(error_kind, f"cannot open {label} {path}: {error}")
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode):
            fail(error_kind, f"{label} is not a regular file: {path}")
        if limit is not None and before.st_size > limit:
            fail(error_kind, f"{label} exceeds {limit} bytes: {path}")
        data = _read_fd(descriptor, before.st_size)
        after = os.fstat(descriptor)
        visible = path.lstat()
    except CredentialError:
        raise
    except OSError as error:
        fail(error_kind, f"cannot read {label} {path}: {error}")
    finally:
        os.close(descriptor)
    if (
        before_visible.st_dev != before.st_dev
        or before_visible.st_ino != before.st_ino
        or before_visible.st_nlink != before.st_nlink
        or before.st_dev != after.st_dev
        or before.st_ino != after.st_ino
        or before.st_size != after.st_size
        or before.st_mtime_ns != after.st_mtime_ns
        or before.st_nlink != after.st_nlink
        or not stat.S_ISREG(visible.st_mode)
        or visible.st_dev != before.st_dev
        or visible.st_ino != before.st_ino
        or visible.st_size != before.st_size
        or visible.st_nlink != before.st_nlink
        or len(data) != before.st_size
    ):
        fail(error_kind, f"{label} changed while it was being read: {path}")
    return (
        OwnedFile(
            path=path,
            device=before.st_dev,
            inode=before.st_ino,
            size=before.st_size,
            mode=stat.S_IMODE(before.st_mode),
            uid=before.st_uid,
            gid=before.st_gid,
            nlink=before.st_nlink,
            mtime_ns=before.st_mtime_ns,
            sha256=sha256_bytes(data),
        ),
        data,
    )


def owned_to_json(owned: OwnedFile) -> dict[str, Any]:
    return {
        "path": str(owned.path),
        "device": owned.device,
        "inode": owned.inode,
        "size": owned.size,
        "mode": owned.mode,
        "uid": owned.uid,
        "gid": owned.gid,
        "nlink": owned.nlink,
        "mtimeNs": owned.mtime_ns,
        "sha256": owned.sha256,
    }


def owned_from_json(value: Any, expected_path: Path, label: str) -> OwnedFile:
    if not isinstance(value, dict):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", f"receipt {label} is not an object")
    required = {
        "path",
        "device",
        "inode",
        "size",
        "mode",
        "uid",
        "gid",
        "nlink",
        "mtimeNs",
        "sha256",
    }
    if set(value) != required or value.get("path") != str(expected_path):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", f"receipt {label} shape is invalid")
    integer_keys = (
        "device", "inode", "size", "mode", "uid", "gid", "nlink", "mtimeNs"
    )
    if any(not isinstance(value.get(key), int) or value[key] < 0 for key in integer_keys):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", f"receipt {label} metadata is invalid")
    if not isinstance(value.get("sha256"), str) or not SHA256.fullmatch(value["sha256"]):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", f"receipt {label} hash is invalid")
    return OwnedFile(
        path=expected_path,
        device=value["device"],
        inode=value["inode"],
        size=value["size"],
        mode=value["mode"],
        uid=value["uid"],
        gid=value["gid"],
        nlink=value["nlink"],
        mtime_ns=value["mtimeNs"],
        sha256=value["sha256"],
    )


def same_identity(left: OwnedFile, right: OwnedFile) -> bool:
    return (
        left.device == right.device
        and left.inode == right.inode
        and left.size == right.size
        and left.mode == right.mode
        and left.uid == right.uid
        and left.gid == right.gid
        and left.nlink == right.nlink
        and left.mtime_ns == right.mtime_ns
        and left.sha256 == right.sha256
    )


def same_identity_except_nlink(left: OwnedFile, right: OwnedFile) -> bool:
    return same_identity(replace(left, nlink=right.nlink), right)


def expected_nlink(owned: OwnedFile, count: int) -> OwnedFile:
    return replace(owned, nlink=count)


def visible_owned(path: Path) -> OwnedFile | None:
    try:
        owned, _ = read_owned_file(
            path, "managed credential file", "LAB_CREDENTIAL_REPLACED", limit=MAX_STORAGE_BYTES
        )
        return owned
    except CredentialError as error:
        if error.kind == "LAB_CREDENTIAL_REPLACED" and "is missing" in str(error):
            return None
        raise


def same_visible(expected: OwnedFile) -> bool:
    try:
        current = visible_owned(expected.path)
    except CredentialError:
        return False
    return current is not None and same_identity(current, expected)


def same_visible_inode(expected: OwnedFile) -> bool:
    try:
        metadata = expected.path.lstat()
    except FileNotFoundError:
        return False
    except OSError:
        return False
    return (
        stat.S_ISREG(metadata.st_mode)
        and metadata.st_dev == expected.device
        and metadata.st_ino == expected.inode
    )


def fsync_directory(path: Path) -> None:
    reject_symlink_chain(path, "directory fsync target")
    try:
        before = path.lstat()
        if not stat.S_ISDIR(before.st_mode):
            raise OSError(f"not a directory: {path}")
        descriptor = os.open(
            path,
            os.O_RDONLY
            | getattr(os, "O_CLOEXEC", 0)
            | getattr(os, "O_DIRECTORY", 0)
            | getattr(os, "O_NOFOLLOW", 0),
        )
    except OSError as error:
        raise OSError(f"cannot open directory for fsync {path}: {error}") from error
    try:
        opened = os.fstat(descriptor)
        os.fsync(descriptor)
        visible = path.lstat()
        if (
            opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or visible.st_dev != before.st_dev
            or visible.st_ino != before.st_ino
        ):
            raise OSError(f"directory changed during fsync: {path}")
    finally:
        os.close(descriptor)


def fixture_barrier(
    paths: LabPaths,
    environment: dict[str, str],
    point: str,
) -> None:
    if environment.get("NEXUS_V015_TEST_BARRIER") != point:
        return
    if (
        paths.root == CANONICAL_ROOT
        or environment.get("NEXUS_V015_ALLOW_FIXTURE_HOME") != "1"
    ):
        fail("LAB_CREDENTIAL_LAB_ONLY", "test barriers are fixture-only")
    raw = environment.get("NEXUS_V015_TEST_BARRIER_PATH", "")
    barrier = Path(raw)
    if not raw or barrier.parent != paths.lab:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", "test barrier must live in the lab directory")
    reject_symlink_chain(barrier, "test barrier")
    descriptor = os.open(
        barrier,
        os.O_WRONLY
        | os.O_CREAT
        | os.O_EXCL
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    try:
        os.write(descriptor, (point + "\n").encode())
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    fsync_directory(paths.lab)
    os.kill(os.getpid(), signal.SIGSTOP)


def fixture_fault(
    paths: LabPaths,
    environment: dict[str, str],
    point: str,
) -> None:
    if environment.get("NEXUS_V015_TEST_FAULT") != point:
        return
    if (
        paths.root == CANONICAL_ROOT
        or environment.get("NEXUS_V015_ALLOW_FIXTURE_HOME") != "1"
    ):
        fail("LAB_CREDENTIAL_LAB_ONLY", "test faults are fixture-only")
    raise OSError(f"injected fixture fault at {point}")


def parse_ledger(data: bytes, path: Path) -> dict[str, str]:
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError as error:
        fail("LAB_CREDENTIAL_CANDIDATE_INVALID", f"readiness is not UTF-8: {error}")
    fields: dict[str, str] = {}
    for number, line in enumerate(text.splitlines(), start=1):
        if not line or "=" not in line:
            fail(
                "LAB_CREDENTIAL_CANDIDATE_INVALID",
                f"readiness has an invalid line {number}: {path}",
            )
        key, value = line.split("=", 1)
        if not key or not value or key in fields:
            fail(
                "LAB_CREDENTIAL_CANDIDATE_INVALID",
                f"readiness has an invalid field {key!r}: {path}",
            )
        fields[key] = value
    required = {
        "schema",
        "containerId",
        "mode",
        "runId",
        "nexusSha256",
        "gatewaySha256",
        "webuiSha256",
    }
    missing = sorted(required - fields.keys())
    if missing:
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            f"readiness is missing fields: {', '.join(missing)}",
        )
    if fields["schema"] != "1" or fields["mode"] not in {"source", "packed"}:
        fail("LAB_CREDENTIAL_CANDIDATE_INVALID", "readiness schema or mode is invalid")
    if not CONTAINER_ID.fullmatch(fields["containerId"]):
        fail("LAB_CREDENTIAL_CANDIDATE_INVALID", "readiness containerId is invalid")
    if not SAFE_ID.fullmatch(fields["runId"]):
        fail("LAB_CREDENTIAL_CANDIDATE_INVALID", "readiness runId is invalid")
    for key in ("nexusSha256", "gatewaySha256", "webuiSha256"):
        if not SHA256.fullmatch(fields[key]):
            fail("LAB_CREDENTIAL_CANDIDATE_INVALID", f"readiness {key} is invalid")
    return fields


def load_candidate(
    paths: LabPaths, environment: dict[str, str], receipt_owner: int
) -> CandidateBinding:
    validate_authority_identity(paths)
    owned, data = read_owned_file(
        paths.readiness,
        "candidate readiness ledger",
        "LAB_CREDENTIAL_CANDIDATE_INVALID",
        limit=MAX_LEDGER_BYTES,
    )
    fixture_mode = (
        paths.root != CANONICAL_ROOT
        and environment.get("NEXUS_V015_ALLOW_FIXTURE_HOME") == "1"
    )
    if owned.uid != receipt_owner or owned.mode != 0o444 or owned.nlink != 1:
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "candidate readiness ledger ownership, mode, or link count is unsafe",
        )
    if not fixture_mode and (owned.uid != 0 or owned.gid != 0):
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "canonical readiness ledger must be root-owned",
        )
    digest = sha256_bytes(data)
    expected_digest = environment.get("NEXUS_V015_READINESS_LEDGER_SHA256", "")
    if not SHA256.fullmatch(expected_digest) or digest != expected_digest:
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "candidate readiness digest does not match the lab binding",
        )
    fields = parse_ledger(data, paths.readiness)
    run_id = environment.get("NEXUS_V015_RUN_ID", "")
    if not SAFE_ID.fullmatch(run_id) or fields["runId"] != run_id:
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "candidate readiness runId does not match NEXUS_V015_RUN_ID",
        )
    expected_mode = environment.get("NEXUS_LAB_MODE", "")
    if expected_mode not in {"source", "packed"} or fields["mode"] != expected_mode:
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "candidate readiness mode does not match NEXUS_LAB_MODE",
        )
    expected_container = environment.get("NEXUS_V015_CONTAINER_ID", "")
    if (
        not CONTAINER_ID.fullmatch(expected_container)
        or fields["containerId"] != expected_container
    ):
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "candidate readiness containerId does not match the running lab container",
        )
    return CandidateBinding(run_id, digest, fields["containerId"], fields["mode"])


def strict_object(data: bytes, label: str, error_kind: str) -> dict[str, Any]:
    def pairs(values: list[tuple[str, Any]]) -> dict[str, Any]:
        result: dict[str, Any] = {}
        for key, value in values:
            if key in result:
                raise ValueError(f"duplicate JSON key {key!r}")
            result[key] = value
        return result

    try:
        document = json.loads(data.decode("utf-8"), object_pairs_hook=pairs)
    except (UnicodeDecodeError, json.JSONDecodeError, ValueError) as error:
        fail(error_kind, f"{label} is malformed: {error}")
    if not isinstance(document, dict):
        fail(error_kind, f"{label} must be a JSON object")
    return document


def validate_storage(data: bytes) -> dict[str, Any]:
    document = strict_object(data, "Lens Nexus credential storage", "LAB_CREDENTIAL_STORAGE_INVALID")
    for key in ("humanCookie", "csrfToken"):
        value = document.get(key)
        if not isinstance(value, str) or not value:
            fail(
                "LAB_CREDENTIAL_STORAGE_INVALID",
                "Lens credential storage requires non-empty humanCookie and csrfToken twins",
            )
    return document


def unknown_cookie(binding: CandidateBinding, original: OwnedFile) -> str:
    material = (
        "nexus-v015-unknown-human-cookie\0"
        + binding.run_id
        + "\0"
        + binding.readiness_sha256
        + "\0"
        + original.sha256
    ).encode()
    return "v015-unknown-" + sha256_bytes(material)[:40]


def wedge_payload(
    document: dict[str, Any], binding: CandidateBinding, original: OwnedFile
) -> tuple[bytes, str]:
    cookie = unknown_cookie(binding, original)
    changed = dict(document)
    changed["humanCookie"] = cookie
    if changed.get("csrfToken") != document.get("csrfToken"):
        raise AssertionError("credential wedge changed the CSRF twin")
    payload = json.dumps(changed, ensure_ascii=False, indent=1).encode()
    return payload, cookie


def write_temporary(
    parent: Path,
    prefix: str,
    data: bytes,
    *,
    mode: int,
    uid: int,
    gid: int,
) -> OwnedFile:
    descriptor, raw_path = tempfile.mkstemp(prefix=prefix, dir=parent)
    path = Path(raw_path)
    initial = os.fstat(descriptor)
    placeholder = OwnedFile(
        path, initial.st_dev, initial.st_ino, initial.st_size,
        stat.S_IMODE(initial.st_mode), initial.st_uid, initial.st_gid,
        initial.st_nlink, initial.st_mtime_ns, sha256_bytes(b""),
    )
    try:
        os.fchmod(descriptor, mode)
        if initial.st_uid != uid or initial.st_gid != gid:
            os.fchown(descriptor, uid, gid)
        handle = os.fdopen(descriptor, "wb", closefd=True)
        descriptor = -1
        with handle:
            handle.write(data)
            handle.flush()
            os.fsync(handle.fileno())
        owned, visible = read_owned_file(path, "temporary credential file", "LAB_CREDENTIAL_IO")
        if visible != data or owned.mode != mode or owned.uid != uid or owned.gid != gid:
            raise OSError("temporary credential file did not preserve requested metadata")
        return owned
    except Exception:
        try:
            # A partial write changes size/mtime/hash, but ownership of the
            # temporary pathname is still established by its captured inode.
            if same_visible_inode(placeholder):
                path.unlink()
                try:
                    fsync_directory(parent)
                except OSError:
                    pass
        except Exception:
            pass
        raise
    finally:
        if descriptor >= 0:
            try:
                os.close(descriptor)
            except OSError:
                pass


def remove_exact(owned: OwnedFile, *, sync_parent: bool = False) -> bool:
    if not same_visible(owned):
        return False
    try:
        owned.path.unlink()
    except FileNotFoundError:
        return False
    if sync_parent:
        fsync_directory(owned.path.parent)
    return True


def hardlink_at_absent_name(
    source: Path,
    parent: Path,
    prefix: str,
    *,
    label: str,
    error_kind: str,
    limit: int,
) -> tuple[OwnedFile, bytes]:
    """Create a hard link without ever reserving an empty authority pathname."""
    for _ in range(128):
        path = parent / f"{prefix}{secrets.token_hex(16)}"
        try:
            os.link(source, path, follow_symlinks=False)
        except FileExistsError:
            continue
        except OSError as error:
            raise OSError(f"cannot create {label}: {error}") from error
        try:
            return read_owned_file(path, label, error_kind, limit=limit)
        except Exception:
            try:
                path.unlink()
                fsync_directory(parent)
            except OSError:
                pass
            raise
    raise OSError(f"cannot allocate an absent pathname for {label}")


def receipt_payload(document: dict[str, Any]) -> bytes:
    return (json.dumps(document, indent=2, sort_keys=True) + "\n").encode()


def binding_payload(binding: CandidateBinding) -> dict[str, str]:
    return {
        "runId": binding.run_id,
        "readinessSha256": binding.readiness_sha256,
        "containerId": binding.container_id,
        "mode": binding.mode,
    }


def binding_from_receipt(document: dict[str, Any]) -> CandidateBinding:
    return CandidateBinding(
        str(document["runId"]),
        str(document["readinessSha256"]),
        str(document["containerId"]),
        str(document["mode"]),
    )


def make_plan(
    paths: LabPaths,
    binding: CandidateBinding,
    original: OwnedFile,
    cookie: str,
    payload: bytes,
) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "state": "planned",
        **binding_payload(binding),
        "storagePath": str(paths.storage),
        "original": owned_to_json(original),
        "wedgeSha256": sha256_bytes(payload),
        "humanCookieSha256": sha256_bytes(cookie.encode()),
    }


def plan_payload(document: dict[str, Any]) -> bytes:
    return receipt_payload(document)


def plan_temporary_prefix(data: bytes) -> str:
    return f".credential.plan.v1.json.tmp-{sha256_bytes(data)[:32]}-"


def validate_plan_document(
    document: dict[str, Any], paths: LabPaths
) -> dict[str, Any]:
    required = {
        "schemaVersion",
        "state",
        "runId",
        "readinessSha256",
        "containerId",
        "mode",
        "storagePath",
        "original",
        "wedgeSha256",
        "humanCookieSha256",
    }
    if (
        set(document) != required
        or document.get("schemaVersion") != 1
        or document.get("state") != "planned"
        or document.get("storagePath") != str(paths.storage)
    ):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential plan shape is invalid")
    if (
        not SAFE_ID.fullmatch(str(document.get("runId", "")))
        or not SHA256.fullmatch(str(document.get("readinessSha256", "")))
        or not CONTAINER_ID.fullmatch(str(document.get("containerId", "")))
        or document.get("mode") not in {"source", "packed"}
        or not SHA256.fullmatch(str(document.get("wedgeSha256", "")))
        or not SHA256.fullmatch(str(document.get("humanCookieSha256", "")))
    ):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential plan binding is invalid")
    original = owned_from_json(document["original"], paths.storage, "plan original")
    if original.nlink != 1:
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential plan original link count is invalid")
    return document


def plan_binding(document: dict[str, Any]) -> CandidateBinding:
    return CandidateBinding(
        str(document["runId"]),
        str(document["readinessSha256"]),
        str(document["containerId"]),
        str(document["mode"]),
    )


def validate_plan_file(
    owned: OwnedFile, *, owner: int, group: int, allow_link_pair: bool = False
) -> None:
    allowed_links = {1, 2} if allow_link_pair else {1}
    if (
        owned.mode != 0o600
        or owned.uid != owner
        or owned.gid != group
        or owned.nlink not in allowed_links
    ):
        fail(
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            "credential plan ownership, mode, or link count is unsafe",
        )


def load_plan(
    paths: LabPaths,
    *,
    owner: int,
    group: int,
    optional: bool = False,
) -> dict[str, Any] | None:
    try:
        paths.plan.lstat()
    except FileNotFoundError:
        if optional:
            return None
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential plan is missing")
    owned, data = read_owned_file(
        paths.plan,
        "credential transaction plan",
        "LAB_CREDENTIAL_RECEIPT_INVALID",
        limit=MAX_PLAN_BYTES,
    )
    validate_plan_file(owned, owner=owner, group=group)
    document = strict_object(
        data, "credential transaction plan", "LAB_CREDENTIAL_RECEIPT_INVALID"
    )
    return validate_plan_document(document, paths)


def publish_plan(
    paths: LabPaths,
    document: dict[str, Any],
    *,
    owner: int,
    group: int,
) -> None:
    validate_authority_identity(paths)
    if paths.plan.exists() or paths.plan.is_symlink():
        fail("LAB_CREDENTIAL_REPLACED", "credential transaction plan already exists")
    data = plan_payload(document)
    temporary = write_temporary(
        paths.lab,
        plan_temporary_prefix(data),
        data,
        mode=0o600,
        uid=owner,
        gid=group,
    )
    linked = False
    try:
        validate_authority_identity(paths)
        os.link(temporary.path, paths.plan, follow_symlinks=False)
        linked = True
        plan_owned, plan_data = read_owned_file(
            paths.plan,
            "credential transaction plan",
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            limit=MAX_PLAN_BYTES,
        )
        temporary_pair, temporary_data = read_owned_file(
            temporary.path,
            "credential plan publication temporary",
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            limit=MAX_PLAN_BYTES,
        )
        validate_plan_file(plan_owned, owner=owner, group=group, allow_link_pair=True)
        if (
            plan_data != data
            or temporary_data != data
            or plan_owned.nlink != 2
            or not same_identity(plan_owned, replace(temporary_pair, path=paths.plan))
        ):
            raise OSError("credential transaction plan link pair is not exact")
        fsync_directory(paths.lab)
        if not remove_exact(temporary_pair, sync_parent=True):
            raise OSError("credential transaction plan temporary changed at cleanup")
        final, final_data = read_owned_file(
            paths.plan,
            "credential transaction plan",
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            limit=MAX_PLAN_BYTES,
        )
        validate_plan_file(final, owner=owner, group=group)
        if final_data != data:
            raise OSError("credential transaction plan changed after publication")
    except Exception:
        if not linked:
            try:
                remove_exact(temporary, sync_parent=True)
            except Exception:
                pass
        raise


def remove_plan(paths: LabPaths, *, owner: int, group: int) -> None:
    owned, _ = read_owned_file(
        paths.plan,
        "credential transaction plan",
        "LAB_CREDENTIAL_RECEIPT_INVALID",
        limit=MAX_PLAN_BYTES,
    )
    validate_plan_file(owned, owner=owner, group=group)
    validate_authority_identity(paths)
    if not remove_exact(owned, sync_parent=True):
        fail("LAB_CREDENTIAL_REPLACED", "credential transaction plan changed at cleanup")


def transaction_digest(
    paths: LabPaths,
    binding: CandidateBinding,
    original: OwnedFile,
) -> str:
    material = {
        "binding": binding_payload(binding),
        "storagePath": str(paths.storage),
        "original": owned_to_json(original),
    }
    return sha256_bytes(
        json.dumps(material, sort_keys=True, separators=(",", ":")).encode()
    )[:32]


def storage_backup_prefix(
    paths: LabPaths,
    binding: CandidateBinding,
    original: OwnedFile,
) -> str:
    return f".credential.storage.backup-{transaction_digest(paths, binding, original)}-"


def storage_temporary_prefix(
    paths: LabPaths,
    binding: CandidateBinding,
    original: OwnedFile,
    payload: bytes,
) -> str:
    return (
        f".credential.storage.tmp-{transaction_digest(paths, binding, original)}-"
        f"{sha256_bytes(payload)[:16]}-"
    )


def receipt_anchor_prefix(previous: OwnedFile, data: bytes) -> str:
    identity = owned_to_json(previous)
    identity.pop("path", None)
    identity.pop("nlink", None)
    authority = {
        "receipt": identity,
        "sha256": sha256_bytes(data),
    }
    digest = sha256_bytes(
        json.dumps(authority, sort_keys=True, separators=(",", ":")).encode()
    )[:32]
    return f".credential.v1.json.backup-{digest}-"


def receipt_restore_prefix(anchor: OwnedFile, data: bytes) -> str:
    identity = owned_to_json(anchor)
    identity.pop("path", None)
    identity.pop("nlink", None)
    authority = {
        "anchor": identity,
        "sha256": sha256_bytes(data),
    }
    digest = sha256_bytes(
        json.dumps(authority, sort_keys=True, separators=(",", ":")).encode()
    )[:32]
    return f".credential.v1.json.restore-{digest}-"


def receipt_temporary_prefix(data: bytes) -> str:
    return f".credential.v1.json.tmp-{sha256_bytes(data)[:32]}-"


def publish_receipt(
    paths: LabPaths,
    document: dict[str, Any],
    *,
    owner: int,
    group: int,
    environment: dict[str, str],
) -> OwnedFile:
    validate_authority_identity(paths)
    data = receipt_payload(document)
    previous: OwnedFile | None = None
    previous_data: bytes | None = None
    try:
        previous, previous_data = read_owned_file(
            paths.receipt,
            "credential receipt",
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            limit=MAX_RECEIPT_BYTES,
        )
        validate_receipt_file(previous, paths, owner, group)
    except CredentialError as error:
        if error.kind != "LAB_CREDENTIAL_RECEIPT_INVALID" or "is missing" not in str(error):
            raise
    temporary = write_temporary(
        paths.lab,
        receipt_temporary_prefix(data),
        data,
        mode=0o600,
        uid=owner,
        gid=group,
    )
    fixture_barrier(
        paths,
        environment,
        f"receipt-temp-fsynced-{document.get('state', 'unknown')}",
    )
    expected = OwnedFile(
        paths.receipt,
        temporary.device,
        temporary.inode,
        temporary.size,
        temporary.mode,
        temporary.uid,
        temporary.gid,
        temporary.nlink,
        temporary.mtime_ns,
        temporary.sha256,
    )
    anchor: OwnedFile | None = None
    preserve_anchor = False
    try:
        if previous is not None:
            fixture_barrier(
                paths,
                environment,
                f"before-receipt-anchor-link-{document.get('state', 'unknown')}",
            )
            anchor, anchor_data = hardlink_at_absent_name(
                paths.receipt,
                paths.lab,
                receipt_anchor_prefix(previous, previous_data or b""),
                label="prior credential receipt anchor",
                error_kind="LAB_CREDENTIAL_RECEIPT_INVALID",
                limit=MAX_RECEIPT_BYTES,
            )
            anchor_path = anchor.path
            current_anchor, anchor_data = read_owned_file(
                anchor.path,
                "prior credential receipt anchor",
                "LAB_CREDENTIAL_RECEIPT_INVALID",
                limit=MAX_RECEIPT_BYTES,
            )
            anchor = current_anchor
            if (
                previous_data != anchor_data
                or not same_identity_except_nlink(anchor, previous)
                or anchor.nlink != 2
            ):
                raise OSError("prior credential receipt anchor is not exact")
            fixture_barrier(
                paths,
                environment,
                f"receipt-anchor-linked-{document.get('state', 'unknown')}",
            )
            fsync_directory(paths.lab)
            fixture_barrier(
                paths,
                environment,
                f"receipt-anchor-fsynced-{document.get('state', 'unknown')}",
            )
        commit_error: Exception | None = None
        try:
            validate_authority_identity(paths)
            os.replace(temporary.path, paths.receipt)
        except Exception as error:
            if same_visible(expected):
                commit_error = error
            elif previous is not None and same_visible(expected_nlink(previous, 2)):
                raise
            else:
                commit_error = OSError(
                    f"credential receipt replace outcome is indeterminate: {error}"
                )
        if commit_error is None:
            try:
                visible, visible_data = read_owned_file(
                    paths.receipt,
                    "credential receipt",
                    "LAB_CREDENTIAL_RECEIPT_INVALID",
                    limit=MAX_RECEIPT_BYTES,
                )
                if not same_identity(visible, expected) or visible_data != data:
                    raise OSError("credential receipt changed at publication")
                fixture_barrier(
                    paths,
                    environment,
                    f"receipt-replaced-{document.get('state', 'unknown')}",
                )
                fixture_fault(
                    paths,
                    environment,
                    f"receipt-commit-after-replace-{document.get('state', 'unknown')}",
                )
                fsync_directory(paths.lab)
            except Exception as error:
                commit_error = error
        if commit_error is not None:
            rollback_error: Exception | None = None
            try:
                if anchor is not None and previous is not None:
                    current_anchor, anchor_data = read_owned_file(
                        anchor.path,
                        "prior credential receipt anchor",
                        "LAB_CREDENTIAL_RECEIPT_INVALID",
                        limit=MAX_RECEIPT_BYTES,
                    )
                    if (
                        anchor_data != previous_data
                        or not same_identity_except_nlink(current_anchor, previous)
                        or current_anchor.nlink != 1
                    ):
                        raise OSError("prior credential receipt anchor changed")
                    fixture_barrier(
                        paths,
                        environment,
                        f"before-receipt-rollback-link-{document.get('state', 'unknown')}",
                    )
                    restore_owned, _ = hardlink_at_absent_name(
                        anchor.path,
                        paths.lab,
                        receipt_restore_prefix(anchor, anchor_data),
                        label="credential receipt restore link",
                        error_kind="LAB_CREDENTIAL_RECEIPT_INVALID",
                        limit=MAX_RECEIPT_BYTES,
                    )
                    restore_path = restore_owned.path
                    try:
                        if (
                            not same_identity_except_nlink(restore_owned, previous)
                            or restore_owned.nlink != 2
                        ):
                            raise OSError("credential receipt restore link changed")
                        fixture_barrier(
                            paths,
                            environment,
                            "receipt-rollback-restore-linked-unflushed-"
                            f"{document.get('state', 'unknown')}",
                        )
                        fsync_directory(paths.lab)
                        fixture_barrier(
                            paths,
                            environment,
                            f"receipt-rollback-restore-linked-{document.get('state', 'unknown')}",
                        )
                        os.replace(restore_path, paths.receipt)
                        fixture_barrier(
                            paths,
                            environment,
                            f"receipt-rollback-replaced-{document.get('state', 'unknown')}",
                        )
                        restored, restored_data = read_owned_file(
                            paths.receipt,
                            "restored credential receipt",
                            "LAB_CREDENTIAL_RECEIPT_INVALID",
                            limit=MAX_RECEIPT_BYTES,
                        )
                        if (
                            restored_data != previous_data
                            or not same_identity_except_nlink(restored, previous)
                            or restored.nlink != 2
                        ):
                            raise OSError("credential receipt rollback is not exact")
                        fsync_directory(paths.lab)
                    finally:
                        try:
                            if restore_path.exists() and not restore_path.is_symlink():
                                restore_path.unlink()
                                fsync_directory(paths.lab)
                        except OSError:
                            pass
                    current_anchor, _ = read_owned_file(
                        anchor.path,
                        "prior credential receipt anchor",
                        "LAB_CREDENTIAL_RECEIPT_INVALID",
                        limit=MAX_RECEIPT_BYTES,
                    )
                    if not remove_exact(current_anchor, sync_parent=True):
                        raise OSError("could not remove prior receipt anchor after rollback")
                    anchor = None
                    final_previous, final_data = read_owned_file(
                        paths.receipt,
                        "restored credential receipt",
                        "LAB_CREDENTIAL_RECEIPT_INVALID",
                        limit=MAX_RECEIPT_BYTES,
                    )
                    if final_data != previous_data or not same_identity(
                        final_previous, previous
                    ):
                        raise OSError("credential receipt rollback did not restore one link")
                else:
                    current = visible_owned(paths.receipt)
                    if current is not None:
                        if not same_identity(current, expected):
                            raise OSError("new credential receipt changed before rollback")
                        if not remove_exact(current, sync_parent=True):
                            raise OSError("could not remove failed first credential receipt")
                    else:
                        fsync_directory(paths.lab)
            except Exception as error:
                rollback_error = error
            if rollback_error is None:
                raise ReceiptPublishError(
                    f"credential receipt publication rolled back: {commit_error}",
                    state="rolled_back",
                ) from commit_error
            preserve_anchor = anchor is not None
            raise ReceiptPublishError(
                "credential receipt publication is indeterminate: "
                f"{commit_error}; rollback failed: {rollback_error}",
                state="indeterminate",
            ) from commit_error
        if anchor is not None:
            current_anchor, _ = read_owned_file(
                anchor.path,
                "prior credential receipt anchor",
                "LAB_CREDENTIAL_RECEIPT_INVALID",
                limit=MAX_RECEIPT_BYTES,
            )
            if not remove_exact(current_anchor, sync_parent=True):
                raise OSError("prior credential receipt anchor changed before cleanup")
            anchor = None
        try:
            final, final_data = read_owned_file(
                paths.receipt,
                "credential receipt",
                "LAB_CREDENTIAL_RECEIPT_INVALID",
                limit=MAX_RECEIPT_BYTES,
            )
            if final_data != data or not same_identity(final, expected):
                raise OSError("credential receipt changed after commit cleanup")
            return final
        except Exception as error:
            # Publication and its directory fsync already committed. A later
            # observation failure must retain the storage backup/receipt rather
            # than let the caller treat this as a pre-publication failure.
            raise ReceiptPublishError(
                f"credential receipt committed but final observation failed: {error}",
                state="indeterminate",
            ) from error
    finally:
        try:
            remove_exact(temporary, sync_parent=True)
        except Exception:
            pass
        if anchor is not None and not preserve_anchor:
            try:
                current_anchor = visible_owned(anchor.path)
                if current_anchor is not None:
                    remove_exact(current_anchor, sync_parent=True)
            except Exception:
                pass


def validate_receipt_file(
    owned: OwnedFile, paths: LabPaths, owner: int, group: int
) -> None:
    if (
        owned.mode != 0o600
        or owned.uid != owner
        or owned.gid != group
        or owned.nlink != 1
    ):
        fail(
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            "credential receipt ownership, mode, or link count is unsafe",
        )


def validate_receipt_document(
    document: dict[str, Any],
    paths: LabPaths,
    binding: CandidateBinding | None,
) -> dict[str, Any]:
    required = {
        "schemaVersion",
        "state",
        "runId",
        "readinessSha256",
        "containerId",
        "mode",
        "storagePath",
        "original",
        "backup",
        "wedge",
        "humanCookieSha256",
    }
    if set(document) != required or document.get("schemaVersion") != 1:
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential receipt shape is invalid")
    if document.get("state") not in {"prepared", "wedged", "restored", "indeterminate"}:
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential receipt state is invalid")
    if document.get("storagePath") != str(paths.storage):
        fail(
            "LAB_CREDENTIAL_RECEIPT_INVALID",
            "credential receipt storage path is invalid",
        )
    if (
        not SAFE_ID.fullmatch(str(document.get("runId", "")))
        or not SHA256.fullmatch(str(document.get("readinessSha256", "")))
        or not CONTAINER_ID.fullmatch(str(document.get("containerId", "")))
        or document.get("mode") not in {"source", "packed"}
    ):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential receipt binding is invalid")
    if binding is not None and (
        document.get("runId") != binding.run_id
        or document.get("readinessSha256") != binding.readiness_sha256
        or document.get("containerId") != binding.container_id
        or document.get("mode") != binding.mode
    ):
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "credential receipt does not match the current run/readiness binding",
        )
    if not isinstance(document.get("humanCookieSha256"), str) or not SHA256.fullmatch(
        document["humanCookieSha256"]
    ):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "receipt cookie proof is invalid")
    backup_value = document.get("backup")
    if not isinstance(backup_value, dict) or not isinstance(backup_value.get("path"), str):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "receipt backup is invalid")
    backup_path = Path(backup_value["path"])
    original = owned_from_json(document["original"], paths.storage, "original")
    document_binding = binding_from_receipt(document)
    expected_backup_prefix = storage_backup_prefix(paths, document_binding, original)
    if backup_path.parent != paths.lab or not backup_path.name.startswith(
        expected_backup_prefix
    ):
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "receipt backup path is outside authority")
    reject_symlink_chain(backup_path, "credential backup")
    owned_from_json(document["backup"], backup_path, "backup")
    owned_from_json(document["wedge"], paths.storage, "wedge")
    return document


def load_receipt(
    paths: LabPaths,
    binding: CandidateBinding | None,
    *,
    owner: int,
    group: int,
    optional: bool = False,
) -> dict[str, Any] | None:
    try:
        paths.receipt.lstat()
    except FileNotFoundError:
        if optional:
            return None
        fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential receipt is missing")
    owned, data = read_owned_file(
        paths.receipt,
        "credential receipt",
        "LAB_CREDENTIAL_RECEIPT_INVALID",
        limit=MAX_RECEIPT_BYTES,
    )
    validate_receipt_file(owned, paths, owner, group)
    document = strict_object(data, "credential receipt", "LAB_CREDENTIAL_RECEIPT_INVALID")
    return validate_receipt_document(document, paths, binding)


def receipt_owned(document: dict[str, Any], key: str, paths: LabPaths) -> OwnedFile:
    if key == "backup":
        path = Path(document[key]["path"])
    else:
        path = paths.storage
    return owned_from_json(document[key], path, key)


def make_receipt(
    paths: LabPaths,
    binding: CandidateBinding,
    state: str,
    original: OwnedFile,
    backup: OwnedFile,
    wedge_file: OwnedFile,
    cookie: str,
) -> dict[str, Any]:
    return {
        "schemaVersion": 1,
        "state": state,
        "runId": binding.run_id,
        "readinessSha256": binding.readiness_sha256,
        "containerId": binding.container_id,
        "mode": binding.mode,
        "storagePath": str(paths.storage),
        "original": owned_to_json(original),
        "backup": owned_to_json(backup),
        "wedge": owned_to_json(wedge_file),
        "humanCookieSha256": sha256_bytes(cookie.encode()),
    }


@contextmanager
def acquire_lock(
    paths: LabPaths, *, owner: int, group: int
) -> Iterator[None]:
    validate_authority_identity(paths)
    flags = (
        os.O_RDWR
        | os.O_CREAT
        | getattr(os, "O_CLOEXEC", 0)
        | getattr(os, "O_NOFOLLOW", 0)
    )
    existed = False
    try:
        existing = paths.lock.lstat()
        existed = True
        if (
            not stat.S_ISREG(existing.st_mode)
            or existing.st_nlink != 1
            or existing.st_uid != owner
            or existing.st_gid != group
            or stat.S_IMODE(existing.st_mode) != 0o600
        ):
            fail("LAB_CREDENTIAL_PATH_UNSAFE", "existing credential lock is unsafe")
    except FileNotFoundError:
        pass
    try:
        descriptor = os.open(paths.lock, flags, 0o600)
    except OSError as error:
        fail("LAB_CREDENTIAL_PATH_UNSAFE", f"cannot open credential lock: {error}")
    try:
        metadata = os.fstat(descriptor)
        if not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1:
            fail("LAB_CREDENTIAL_PATH_UNSAFE", "credential lock is not a single regular file")
        if metadata.st_uid != owner or metadata.st_gid != group:
            if metadata.st_size == 0 and os.geteuid() == owner:
                os.fchown(descriptor, owner, group)
                metadata = os.fstat(descriptor)
            if metadata.st_uid != owner or metadata.st_gid != group:
                fail("LAB_CREDENTIAL_PATH_UNSAFE", "credential lock owner is unsafe")
        if stat.S_IMODE(metadata.st_mode) != 0o600 and not existed:
            os.fchmod(descriptor, 0o600)
        elif stat.S_IMODE(metadata.st_mode) != 0o600:
            fail("LAB_CREDENTIAL_PATH_UNSAFE", "existing credential lock mode is unsafe")
        fcntl.flock(descriptor, fcntl.LOCK_EX)
        visible = paths.lock.lstat()
        current = os.fstat(descriptor)
        if visible.st_dev != current.st_dev or visible.st_ino != current.st_ino:
            fail("LAB_CREDENTIAL_PATH_UNSAFE", "credential lock changed while acquiring it")
        validate_authority_identity(paths)
        yield
    finally:
        try:
            fcntl.flock(descriptor, fcntl.LOCK_UN)
        finally:
            os.close(descriptor)


def receipt_matches_environment(
    receipt: dict[str, Any], environment: dict[str, str]
) -> bool:
    return (
        receipt.get("runId") == environment.get("NEXUS_V015_RUN_ID")
        and receipt.get("readinessSha256")
        == environment.get("NEXUS_V015_READINESS_LEDGER_SHA256")
        and receipt.get("containerId") == environment.get("NEXUS_V015_CONTAINER_ID")
        and receipt.get("mode") == environment.get("NEXUS_LAB_MODE")
    )


def require_receipt_binding(
    receipt: dict[str, Any], binding: CandidateBinding
) -> None:
    if (
        receipt.get("runId") != binding.run_id
        or receipt.get("readinessSha256") != binding.readiness_sha256
        or receipt.get("containerId") != binding.container_id
        or receipt.get("mode") != binding.mode
    ):
        fail(
            "LAB_CREDENTIAL_CANDIDATE_INVALID",
            "credential receipt does not match the current run/readiness binding",
        )


def remove_receipt(paths: LabPaths, *, owner: int, group: int) -> None:
    validate_authority_identity(paths)
    owned, _ = read_owned_file(
        paths.receipt,
        "credential receipt",
        "LAB_CREDENTIAL_RECEIPT_INVALID",
        limit=MAX_RECEIPT_BYTES,
    )
    validate_receipt_file(owned, paths, owner, group)
    if not remove_exact(owned, sync_parent=True):
        fail("LAB_CREDENTIAL_REPLACED", "credential receipt changed before cleanup")


def recover_receipt_storage(
    paths: LabPaths,
    receipt: dict[str, Any],
    environment: dict[str, str],
) -> OwnedFile:
    validate_authority_identity(paths)
    original = receipt_owned(receipt, "original", paths)
    backup = receipt_owned(receipt, "backup", paths)
    wedge_file = receipt_owned(receipt, "wedge", paths)
    if same_visible(original):
        try:
            backup.path.lstat()
        except FileNotFoundError:
            # This may be a retry after restore rename became visible but the
            # caller died before the directory fsync/receipt transition.
            fsync_directory(paths.plugin)
            return original
        fail("LAB_CREDENTIAL_REPLACED", "restored credential still has an unexpected backup")
    if same_visible(expected_nlink(original, original.nlink + 1)):
        if not same_visible(expected_nlink(backup, backup.nlink + 1)):
            fail("LAB_CREDENTIAL_REPLACED", "prepared credential backup is not exact")
        current_backup, _ = read_owned_file(
            backup.path,
            "credential recovery backup",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_STORAGE_BYTES,
        )
        cleanup_backup(current_backup)
        final, _ = read_owned_file(
            paths.storage,
            "Lens Nexus credential storage",
            "LAB_CREDENTIAL_STORAGE_INVALID",
            limit=MAX_STORAGE_BYTES,
        )
        if not same_identity(final, original):
            fail("LAB_CREDENTIAL_REPLACED", "prepared recovery did not restore one link")
        return final
    if not same_visible(wedge_file):
        fail("LAB_CREDENTIAL_REPLACED", "credential storage does not match recovery receipt")
    if not same_visible(backup):
        fail("LAB_CREDENTIAL_REPLACED", "credential recovery backup is missing or replaced")
    install_restore(paths, original, backup, wedge_file, environment)
    fsync_directory(paths.plugin)
    fixture_barrier(paths, environment, "storage-fsynced-restored")
    final, _ = read_owned_file(
        paths.storage,
        "restored Lens Nexus credential storage",
        "LAB_CREDENTIAL_REPLACED",
        limit=MAX_STORAGE_BYTES,
    )
    if not same_identity(final, original):
        fail("LAB_CREDENTIAL_REPLACED", "credential recovery is not exact")
    return final


def reconcile_plan_publication(
    paths: LabPaths, *, owner: int, group: int
) -> None:
    temporaries = sorted(paths.lab.glob(".credential.plan.v1.json.tmp-*"), key=str)
    if len(temporaries) > 1:
        fail("LAB_CREDENTIAL_REPLACED", "multiple credential plan temporaries are ambiguous")
    plan_exists = paths.plan.exists() or paths.plan.is_symlink()
    if not plan_exists:
        if not temporaries:
            return
        temporary, data = read_owned_file(
            temporaries[0],
            "credential plan publication temporary",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_PLAN_BYTES,
        )
        validate_plan_file(temporary, owner=owner, group=group)
        document = strict_object(
            data,
            "credential plan publication temporary",
            "LAB_CREDENTIAL_REPLACED",
        )
        validate_plan_document(document, paths)
        if not temporary.path.name.startswith(plan_temporary_prefix(data)):
            fail("LAB_CREDENTIAL_REPLACED", "credential plan temporary is not content-bound")
        if not remove_exact(temporary, sync_parent=True):
            fail("LAB_CREDENTIAL_REPLACED", "credential plan temporary changed at cleanup")
        return

    plan_owned, plan_data = read_owned_file(
        paths.plan,
        "credential transaction plan",
        "LAB_CREDENTIAL_RECEIPT_INVALID",
        limit=MAX_PLAN_BYTES,
    )
    validate_plan_file(
        plan_owned,
        owner=owner,
        group=group,
        allow_link_pair=bool(temporaries),
    )
    plan_document = strict_object(
        plan_data, "credential transaction plan", "LAB_CREDENTIAL_RECEIPT_INVALID"
    )
    validate_plan_document(plan_document, paths)
    if not temporaries:
        return
    temporary, temporary_data = read_owned_file(
        temporaries[0],
        "credential plan publication temporary",
        "LAB_CREDENTIAL_REPLACED",
        limit=MAX_PLAN_BYTES,
    )
    validate_plan_file(temporary, owner=owner, group=group, allow_link_pair=True)
    if (
        temporary_data != plan_data
        or not temporary.path.name.startswith(plan_temporary_prefix(temporary_data))
        or temporary.nlink != 2
        or plan_owned.nlink != 2
        or not same_identity(temporary, replace(plan_owned, path=temporary.path))
    ):
        fail("LAB_CREDENTIAL_REPLACED", "credential plan publication pair is not exact")
    if not remove_exact(temporary, sync_parent=True):
        fail("LAB_CREDENTIAL_REPLACED", "credential plan temporary changed at cleanup")
    final, final_data = read_owned_file(
        paths.plan,
        "credential transaction plan",
        "LAB_CREDENTIAL_RECEIPT_INVALID",
        limit=MAX_PLAN_BYTES,
    )
    validate_plan_file(final, owner=owner, group=group)
    if final_data != plan_data:
        fail("LAB_CREDENTIAL_REPLACED", "credential plan changed after recovery")


def plan_matches_receipt(
    plan: dict[str, Any], receipt: dict[str, Any]
) -> bool:
    return (
        plan_binding(plan) == binding_from_receipt(receipt)
        and plan.get("storagePath") == receipt.get("storagePath")
        and plan.get("original") == receipt.get("original")
        and plan.get("wedgeSha256") == receipt.get("wedge", {}).get("sha256")
        and plan.get("humanCookieSha256") == receipt.get("humanCookieSha256")
    )


def reconcile_planned_transaction(
    paths: LabPaths,
    receipt: dict[str, Any] | None,
    *,
    owner: int,
    group: int,
) -> None:
    reconcile_plan_publication(paths, owner=owner, group=group)
    plan = load_plan(paths, owner=owner, group=group, optional=True)
    if plan is None:
        return
    if receipt is not None:
        if not plan_matches_receipt(plan, receipt):
            fail(
                "LAB_CREDENTIAL_REPLACED",
                "credential plan and receipt describe different transactions",
            )
        # A restored receipt is a durable tombstone for its completed
        # transaction.  A later wedge in the same run can publish a new plan
        # with the same deterministic payload proof before it creates a new
        # receipt.  If the tombstone's old backup is gone, the durable plan—not
        # the tombstone or the caller's newer run binding—owns reconciliation.
        prior_backup = receipt_owned(receipt, "backup", paths)
        historical_tombstone = (
            receipt.get("state") == "restored"
            and visible_owned(prior_backup.path) is None
        )
        if not historical_tombstone:
            remove_plan(paths, owner=owner, group=group)
            return

    transaction_binding = plan_binding(plan)
    original = owned_from_json(plan["original"], paths.storage, "plan original")
    backups = sorted(
        paths.lab.glob(storage_backup_prefix(paths, transaction_binding, original) + "*"),
        key=str,
    )
    all_backups = sorted(paths.lab.glob(".credential.storage.backup-*"), key=str)
    if backups != all_backups or len(backups) > 1:
        fail("LAB_CREDENTIAL_REPLACED", "credential plan backup set is ambiguous")
    temporaries = sorted(paths.plugin.glob(".credential.storage.tmp-*"), key=str)
    if len(temporaries) > 1:
        fail("LAB_CREDENTIAL_REPLACED", "credential plan temporary set is ambiguous")

    if not backups:
        if temporaries:
            fail("LAB_CREDENTIAL_REPLACED", "credential plan temporary has no backup")
        if not same_visible(original):
            fail("LAB_CREDENTIAL_REPLACED", "planned credential original was replaced")
        remove_plan(paths, owner=owner, group=group)
        return

    backup, original_data = read_owned_file(
        backups[0],
        "planned credential backup",
        "LAB_CREDENTIAL_REPLACED",
        limit=MAX_STORAGE_BYTES,
    )
    if (
        backup.nlink != original.nlink + 1
        or not same_identity_except_nlink(backup, original)
        or not same_visible(expected_nlink(original, original.nlink + 1))
    ):
        fail("LAB_CREDENTIAL_REPLACED", "planned credential backup is not exact")
    storage_document = validate_storage(original_data)
    expected_payload, expected_cookie = wedge_payload(
        storage_document, transaction_binding, original
    )
    if (
        plan.get("wedgeSha256") != sha256_bytes(expected_payload)
        or plan.get("humanCookieSha256") != sha256_bytes(expected_cookie.encode())
    ):
        fail("LAB_CREDENTIAL_REPLACED", "credential plan payload proof is invalid")
    if temporaries:
        temporary, temporary_data = read_owned_file(
            temporaries[0],
            "planned credential storage temporary",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_STORAGE_BYTES,
        )
        expected_prefix = storage_temporary_prefix(
            paths, transaction_binding, original, expected_payload
        )
        if (
            temporary_data != expected_payload
            or not temporary.path.name.startswith(expected_prefix)
            or temporary.mode != original.mode
            or temporary.uid != original.uid
            or temporary.gid != original.gid
            or temporary.nlink != 1
        ):
            fail("LAB_CREDENTIAL_REPLACED", "planned credential temporary is not exact")
        if not remove_exact(temporary, sync_parent=True):
            fail("LAB_CREDENTIAL_REPLACED", "planned credential temporary changed at cleanup")
    current_backup, _ = read_owned_file(
        backup.path,
        "planned credential backup",
        "LAB_CREDENTIAL_REPLACED",
        limit=MAX_STORAGE_BYTES,
    )
    cleanup_backup(current_backup)
    if not same_visible(original):
        fail("LAB_CREDENTIAL_REPLACED", "planned credential cleanup did not restore original")
    remove_plan(paths, owner=owner, group=group)


def reconcile_locked_context(
    paths: LabPaths,
    binding: CandidateBinding,
    *,
    owner: int,
    group: int,
    environment: dict[str, str],
) -> dict[str, Any] | None:
    validate_authority_identity(paths)
    # A prepared receipt temporary may belong to the durable transaction plan
    # from the prior run.  Reconcile/validate that plan before comparing any
    # receipt residue with the caller's current run binding.
    reconcile_plan_publication(paths, owner=owner, group=group)
    reconcile_receipt_publication(
        paths,
        binding,
        owner=owner,
        group=group,
        environment=environment,
    )
    receipt = load_receipt(
        paths, None, owner=owner, group=group, optional=True
    )
    reconcile_planned_transaction(
        paths,
        receipt,
        owner=owner,
        group=group,
    )
    reconcile_storage_temporaries(paths, receipt, binding)
    reconcile_storage_backups(paths, receipt, binding)
    return receipt


def create_backup(
    paths: LabPaths,
    original: OwnedFile,
    binding: CandidateBinding,
    environment: dict[str, str],
) -> OwnedFile:
    validate_authority_identity(paths)
    backup_path: Path | None = None
    try:
        backup, _ = hardlink_at_absent_name(
            paths.storage,
            paths.lab,
            storage_backup_prefix(paths, binding, original),
            label="credential backup",
            error_kind="LAB_CREDENTIAL_IO",
            limit=MAX_STORAGE_BYTES,
        )
        backup_path = backup.path
        expected = OwnedFile(
            backup_path,
            original.device,
            original.inode,
            original.size,
            original.mode,
            original.uid,
            original.gid,
            original.nlink + 1,
            original.mtime_ns,
            original.sha256,
        )
        if not same_identity(backup, expected) or not same_visible(
            expected_nlink(original, original.nlink + 1)
        ):
            raise OSError("credential backup does not match the original storage inode")
        fixture_barrier(paths, environment, "storage-backup-linked-unflushed")
        fsync_directory(paths.lab)
        validate_authority_identity(paths)
        fixture_barrier(paths, environment, "storage-backup-linked")
        return backup
    except Exception:
        try:
            if backup_path is not None:
                backup_path.unlink()
                fsync_directory(paths.lab)
        except OSError:
            pass
        raise


def cleanup_backup(backup: OwnedFile) -> None:
    if not remove_exact(backup, sync_parent=True):
        fail("LAB_CREDENTIAL_REPLACED", "credential backup changed before cleanup")


def safe_managed_file(
    path: Path,
    *,
    owner: int,
    group: int,
    mode: int | None,
    label: str,
    limit: int,
) -> OwnedFile:
    owned, _ = read_owned_file(path, label, "LAB_CREDENTIAL_REPLACED", limit=limit)
    if (
        owned.uid != owner
        or owned.gid != group
        or owned.nlink != 1
        or (mode is not None and owned.mode != mode)
        or (mode is None and owned.mode & 0o022)
    ):
        fail("LAB_CREDENTIAL_REPLACED", f"{label} has unsafe authority metadata")
    return owned


def reconcile_receipt_publication(
    paths: LabPaths,
    binding: CandidateBinding,
    *,
    owner: int,
    group: int,
    environment: dict[str, str],
) -> None:
    anchors = sorted(paths.lab.glob(".credential.v1.json.backup-*"), key=str)
    restores = sorted(paths.lab.glob(".credential.v1.json.restore-*"), key=str)
    if len(anchors) > 1:
        fail("LAB_CREDENTIAL_REPLACED", "multiple prior receipt anchors are ambiguous")
    if len(restores) > 1:
        fail("LAB_CREDENTIAL_REPLACED", "multiple receipt restore links are ambiguous")
    if restores and not anchors:
        fail("LAB_CREDENTIAL_REPLACED", "receipt restore link has no durable anchor")
    if anchors:
        anchor, anchor_data = read_owned_file(
            anchors[0],
            "prior credential receipt anchor",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_RECEIPT_BYTES,
        )
        if (
            anchor.uid != owner
            or anchor.gid != group
            or anchor.mode != 0o600
            or anchor.nlink not in {1, 2}
        ):
            fail("LAB_CREDENTIAL_REPLACED", "prior receipt anchor authority is unsafe")
        anchor_document = strict_object(
            anchor_data, "prior credential receipt anchor", "LAB_CREDENTIAL_REPLACED"
        )
        try:
            validate_receipt_document(anchor_document, paths, None)
        except CredentialError as error:
            fail(
                "LAB_CREDENTIAL_REPLACED",
                f"prior receipt anchor is not a complete transaction authority: {error}",
            )
        if not anchor.path.name.startswith(receipt_anchor_prefix(anchor, anchor_data)):
            fail(
                "LAB_CREDENTIAL_REPLACED",
                "prior receipt anchor name is not transaction-bound",
            )
        surviving_restore: OwnedFile | None = None
        if restores:
            surviving_restore, restore_data = read_owned_file(
                restores[0],
                "credential receipt restore link",
                "LAB_CREDENTIAL_REPLACED",
                limit=MAX_RECEIPT_BYTES,
            )
            if (
                restore_data != anchor_data
                or not same_identity_except_nlink(surviving_restore, anchor)
                or surviving_restore.nlink != anchor.nlink
                or surviving_restore.nlink != 2
                or not surviving_restore.path.name.startswith(
                    receipt_restore_prefix(anchor, anchor_data)
                )
            ):
                fail(
                    "LAB_CREDENTIAL_REPLACED",
                    "surviving receipt restore link is not the durable anchor pair",
                )
        # A surviving anchor means the prior receipt transition did not reach
        # its durable cleanup boundary. Roll back to that exact prior inode.
        receipt_is_anchor = False
        try:
            current_receipt, current_data = read_owned_file(
                paths.receipt,
                "credential receipt at recovery",
                "LAB_CREDENTIAL_REPLACED",
                limit=MAX_RECEIPT_BYTES,
            )
            receipt_is_anchor = (
                current_data == anchor_data
                and same_identity_except_nlink(current_receipt, anchor)
                and current_receipt.nlink == anchor.nlink == 2
            )
        except CredentialError as error:
            if "is missing" not in str(error):
                raise
        if not receipt_is_anchor:
            if surviving_restore is not None:
                restore_owned = surviving_restore
                restore_data = anchor_data
                restore = surviving_restore.path
            else:
                if anchor.nlink != 1:
                    fail("LAB_CREDENTIAL_REPLACED", "prior receipt anchor link set is ambiguous")
                fixture_barrier(
                    paths,
                    environment,
                    "before-receipt-recovery-restore-link",
                )
                restore_owned, restore_data = hardlink_at_absent_name(
                    anchor.path,
                    paths.lab,
                    receipt_restore_prefix(anchor, anchor_data),
                    label="credential receipt restore link",
                    error_kind="LAB_CREDENTIAL_REPLACED",
                    limit=MAX_RECEIPT_BYTES,
                )
                restore = restore_owned.path
                if (
                    restore_data != anchor_data
                    or not same_identity_except_nlink(restore_owned, anchor)
                    or restore_owned.nlink != 2
                ):
                    fail("LAB_CREDENTIAL_REPLACED", "receipt recovery link is not exact")
                fixture_barrier(
                    paths,
                    environment,
                    "receipt-recovery-restore-linked-unflushed",
                )
                fsync_directory(paths.lab)
                fixture_barrier(
                    paths,
                    environment,
                    "receipt-recovery-restore-linked",
                )
            os.replace(restore, paths.receipt)
            fixture_barrier(paths, environment, "receipt-recovery-replaced")
        restored, restored_data = read_owned_file(
            paths.receipt,
            "restored credential receipt",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_RECEIPT_BYTES,
        )
        if (
            restored_data != anchor_data
            or not same_identity_except_nlink(restored, anchor)
            or restored.nlink != 2
        ):
            fail("LAB_CREDENTIAL_REPLACED", "prior receipt rollback is not exact")
        fsync_directory(paths.lab)
        current_anchor, _ = read_owned_file(
            anchor.path,
            "prior credential receipt anchor",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_RECEIPT_BYTES,
        )
        if not remove_exact(current_anchor, sync_parent=True):
            fail("LAB_CREDENTIAL_REPLACED", "prior receipt anchor changed at cleanup")
        final, final_data = read_owned_file(
            paths.receipt,
            "restored credential receipt",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_RECEIPT_BYTES,
        )
        expected_final = replace(anchor, path=paths.receipt, nlink=1)
        if final_data != anchor_data or not same_identity(final, expected_final):
            fail("LAB_CREDENTIAL_REPLACED", "restored receipt link count is not exact")

    canonical_receipt = load_receipt(
        paths, None, owner=owner, group=group, optional=True
    )
    durable_plan = load_plan(paths, owner=owner, group=group, optional=True)
    for pattern, parent, expected_owner, expected_group, mode, limit in (
        (".credential.v1.json.tmp-*", paths.lab, owner, group, 0o600, MAX_RECEIPT_BYTES),
    ):
        for residual in sorted(parent.glob(pattern), key=str):
            owned = safe_managed_file(
                residual,
                owner=expected_owner,
                group=expected_group,
                mode=mode,
                label="managed credential temporary",
                limit=limit,
            )
            _, residual_data = read_owned_file(
                residual,
                "managed credential temporary",
                "LAB_CREDENTIAL_REPLACED",
                limit=limit,
            )
            try:
                document = strict_object(
                    residual_data,
                    "managed receipt temporary",
                    "LAB_CREDENTIAL_REPLACED",
                )
                validate_receipt_document(document, paths, None)
                if not residual.name.startswith(receipt_temporary_prefix(residual_data)):
                    raise ValueError("temporary receipt name is not content-bound")
                temporary_binding = binding_from_receipt(document)
                allowed = temporary_binding == binding
                if (
                    durable_plan is not None
                    and document.get("state") == "prepared"
                    and plan_matches_receipt(durable_plan, document)
                ):
                    allowed = True
                if canonical_receipt is not None:
                    same_transaction = all(
                        document.get(key) == canonical_receipt.get(key)
                        for key in (
                            "runId",
                            "readinessSha256",
                            "containerId",
                            "mode",
                            "storagePath",
                            "original",
                            "backup",
                            "wedge",
                            "humanCookieSha256",
                        )
                    )
                    allowed = allowed or same_transaction
                if not allowed:
                    raise ValueError("temporary receipt is bound to another transaction")
                temporary_backup = owned_from_json(
                    document["backup"], Path(document["backup"]["path"]), "backup"
                )
                original = owned_from_json(
                    document["original"], paths.storage, "original"
                )
                wedge_file = owned_from_json(
                    document["wedge"], paths.storage, "wedge"
                )
                backup_live = same_visible(temporary_backup) or (
                    document.get("state") == "prepared"
                    and same_visible(
                        expected_nlink(temporary_backup, temporary_backup.nlink + 1)
                    )
                )
                restored_without_backup = (
                    document.get("state") == "restored" and same_visible(original)
                )
                if not backup_live and not restored_without_backup:
                    raise ValueError("temporary receipt backup authority is absent")
                if not restored_without_backup and not (
                    same_visible(wedge_file)
                    or same_visible(expected_nlink(original, original.nlink + 1))
                ):
                    raise ValueError("temporary receipt storage identity is not live")
            except (CredentialError, ValueError) as error:
                fail(
                    "LAB_CREDENTIAL_REPLACED",
                    f"managed credential temporary is not attributable: {error}",
                )
            if not remove_exact(owned, sync_parent=True):
                fail("LAB_CREDENTIAL_REPLACED", "credential temporary changed at cleanup")


def reconcile_storage_temporaries(
    paths: LabPaths,
    receipt: dict[str, Any] | None,
    binding: CandidateBinding,
) -> None:
    temporaries = sorted(paths.plugin.glob(".credential.storage.tmp-*"), key=str)
    if not temporaries:
        return
    if len(temporaries) != 1:
        fail("LAB_CREDENTIAL_REPLACED", "multiple storage temporaries are ambiguous")
    temporary, data = read_owned_file(
        temporaries[0],
        "managed credential storage temporary",
        "LAB_CREDENTIAL_REPLACED",
        limit=MAX_STORAGE_BYTES,
    )
    if (
        temporary.uid != paths.lab_uid
        or temporary.gid != paths.lab_gid
        or temporary.mode & 0o022
        or temporary.nlink != 1
    ):
        fail("LAB_CREDENTIAL_REPLACED", "storage temporary authority is unsafe")
    try:
        validate_storage(data)
    except CredentialError as error:
        fail(
            "LAB_CREDENTIAL_REPLACED",
            f"storage temporary is not attributable: {error}",
        )
    if receipt is not None:
        transaction_binding = binding_from_receipt(receipt)
        original = receipt_owned(receipt, "original", paths)
        wedge_file = receipt_owned(receipt, "wedge", paths)
        expected_data_sha = wedge_file.sha256
        expected_mode = wedge_file.mode
        expected_uid = wedge_file.uid
        expected_gid = wedge_file.gid
    else:
        backups = sorted(paths.lab.glob(".credential.storage.backup-*"), key=str)
        if len(backups) != 1:
            fail(
                "LAB_CREDENTIAL_REPLACED",
                "storage temporary has no unique durable transaction backup",
            )
        backup, original_data = read_owned_file(
            backups[0],
            "credential transaction backup",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_STORAGE_BYTES,
        )
        transaction_binding = binding
        original = replace(backup, path=paths.storage, nlink=backup.nlink - 1)
        document = validate_storage(original_data)
        expected_payload, _ = wedge_payload(document, transaction_binding, original)
        expected_data_sha = sha256_bytes(expected_payload)
        expected_mode = original.mode
        expected_uid = original.uid
        expected_gid = original.gid
    prefix = storage_temporary_prefix(paths, transaction_binding, original, data)
    if (
        not temporary.path.name.startswith(prefix)
        or temporary.sha256 != expected_data_sha
        or temporary.mode != expected_mode
        or temporary.uid != expected_uid
        or temporary.gid != expected_gid
    ):
        fail(
            "LAB_CREDENTIAL_REPLACED",
            "storage temporary is not bound to the durable transaction",
        )
    if not remove_exact(temporary, sync_parent=True):
        fail("LAB_CREDENTIAL_REPLACED", "storage temporary changed at cleanup")


def reconcile_storage_backups(
    paths: LabPaths,
    receipt: dict[str, Any] | None,
    binding: CandidateBinding,
) -> None:
    backups = sorted(paths.lab.glob(".credential.storage.backup-*"), key=str)
    referenced = None if receipt is None else Path(str(receipt["backup"]["path"]))
    if receipt is not None:
        extras = [path for path in backups if path != referenced]
        if extras:
            original = receipt_owned(receipt, "original", paths)
            if (
                receipt.get("state") == "restored"
                and referenced not in backups
                and same_visible(expected_nlink(original, original.nlink + len(extras)))
            ):
                reconcile_storage_backups(paths, None, binding)
                return
            fail("LAB_CREDENTIAL_REPLACED", "unreferenced credential backups are ambiguous")
        return
    if not backups:
        return
    storage, _ = read_owned_file(
        paths.storage,
        "Lens Nexus credential storage",
        "LAB_CREDENTIAL_STORAGE_INVALID",
        limit=MAX_STORAGE_BYTES,
    )
    expected_links = len(backups) + 1
    if storage.nlink != expected_links:
        fail("LAB_CREDENTIAL_REPLACED", "orphan credential backup link count is unsafe")
    captured: list[OwnedFile] = []
    expected_prefix = storage_backup_prefix(
        paths, binding, replace(storage, nlink=storage.nlink - len(backups))
    )
    for path in backups:
        if not path.name.startswith(expected_prefix):
            fail(
                "LAB_CREDENTIAL_REPLACED",
                "orphan credential backup is not bound to the current transaction",
            )
        backup, _ = read_owned_file(
            path,
            "orphan credential backup",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_STORAGE_BYTES,
        )
        if (
            backup.nlink != expected_links
            or not same_identity_except_nlink(backup, storage)
        ):
            fail("LAB_CREDENTIAL_REPLACED", "orphan credential backup is not exact")
        captured.append(backup)
    for path in backups:
        current, _ = read_owned_file(
            path,
            "orphan credential backup",
            "LAB_CREDENTIAL_REPLACED",
            limit=MAX_STORAGE_BYTES,
        )
        if not same_identity_except_nlink(current, storage):
            fail("LAB_CREDENTIAL_REPLACED", "orphan credential backup changed")
        if not remove_exact(current, sync_parent=True):
            fail("LAB_CREDENTIAL_REPLACED", "orphan credential backup cleanup failed")
    final, _ = read_owned_file(
        paths.storage,
        "Lens Nexus credential storage",
        "LAB_CREDENTIAL_STORAGE_INVALID",
        limit=MAX_STORAGE_BYTES,
    )
    if not same_identity(final, expected_nlink(storage, 1)):
        fail("LAB_CREDENTIAL_REPLACED", "orphan cleanup did not restore one storage link")


def classify_storage(expected: OwnedFile) -> bool:
    try:
        return same_visible(expected)
    except CredentialError:
        return False


def install_wedge(
    paths: LabPaths,
    temporary: OwnedFile,
    original: OwnedFile,
    expected_wedge: OwnedFile,
) -> None:
    validate_authority_identity(paths)
    if not same_visible(expected_nlink(original, original.nlink + 1)) or not same_visible(
        temporary
    ):
        fail("LAB_CREDENTIAL_REPLACED", "credential storage changed before wedge")
    try:
        os.replace(temporary.path, original.path)
    except Exception:
        if classify_storage(expected_wedge):
            return
        if classify_storage(expected_nlink(original, original.nlink + 1)) and same_visible(
            temporary
        ):
            raise
        fail("LAB_CREDENTIAL_REPLACED", "credential wedge outcome is indeterminate")
    if not same_visible(expected_wedge):
        fail("LAB_CREDENTIAL_REPLACED", "credential storage changed at wedge boundary")
    validate_authority_identity(paths)


def begin_fresh_wedge(
    paths: LabPaths,
    binding: CandidateBinding,
    *,
    owner: int,
    group: int,
    environment: dict[str, str],
) -> dict[str, Any]:
    original, original_data = read_owned_file(
        paths.storage,
        "Lens Nexus credential storage",
        "LAB_CREDENTIAL_STORAGE_INVALID",
        limit=MAX_STORAGE_BYTES,
    )
    if (
        original.uid != paths.lab_uid
        or original.gid != paths.lab_gid
        or original.mode & 0o022
        or original.nlink != 1
    ):
        fail(
            "LAB_CREDENTIAL_PATH_UNSAFE",
            "Lens Nexus credential storage owner, mode, or link count is unsafe",
        )
    document = validate_storage(original_data)
    payload, cookie = wedge_payload(document, binding, original)
    plan = make_plan(paths, binding, original, cookie, payload)
    publish_plan(paths, plan, owner=owner, group=group)
    backup: OwnedFile | None = None
    temporary: OwnedFile | None = None
    prepared_published = False
    try:
        fixture_barrier(paths, environment, "before-storage-backup-link")
        backup = create_backup(paths, original, binding, environment)
        fixture_barrier(paths, environment, "after-backup-fsync")
        temporary = write_temporary(
            paths.plugin,
            storage_temporary_prefix(paths, binding, original, payload),
            payload,
            mode=original.mode,
            uid=original.uid,
            gid=original.gid,
        )
        fixture_barrier(paths, environment, "after-storage-temp-fsync")
        expected_wedge = OwnedFile(
            paths.storage,
            temporary.device,
            temporary.inode,
            temporary.size,
            temporary.mode,
            temporary.uid,
            temporary.gid,
            temporary.nlink,
            temporary.mtime_ns,
            temporary.sha256,
        )
        receipt_backup = expected_nlink(backup, original.nlink)
        prepared = make_receipt(
            paths,
            binding,
            "prepared",
            original,
            receipt_backup,
            expected_wedge,
            cookie,
        )
        publish_receipt(
            paths, prepared, owner=owner, group=group, environment=environment
        )
        prepared_published = True
        remove_plan(paths, owner=owner, group=group)
        if not same_visible(backup) or not same_visible(
            expected_nlink(original, original.nlink + 1)
        ):
            fail("LAB_CREDENTIAL_REPLACED", "credential changed after backup publication")
        install_wedge(paths, temporary, original, expected_wedge)
        fixture_barrier(paths, environment, "storage-replaced-wedged")
        fsync_directory(paths.plugin)
        fixture_barrier(paths, environment, "storage-fsynced-wedged")
        wedged = dict(prepared)
        wedged["state"] = "wedged"
        publish_receipt(
            paths, wedged, owner=owner, group=group, environment=environment
        )
        return {
            "status": "wedged",
            "runId": binding.run_id,
            "readinessSha256": binding.readiness_sha256,
            "storageSha256": expected_wedge.sha256,
        }
    except Exception as error:
        # Once the prepared receipt exists it is the recovery authority. Never
        # discard it or its exact original-inode anchor on an ambiguous error.
        preserve_recovery = isinstance(error, ReceiptPublishError) and error.state == "indeterminate"
        if not prepared_published and not preserve_recovery:
            cleanup_complete = True
            if temporary is not None:
                try:
                    remove_exact(temporary, sync_parent=True)
                    temporary = None
                except Exception:
                    cleanup_complete = False
            try:
                if backup is not None:
                    current_backup = visible_owned(backup.path)
                    if current_backup is not None:
                        cleanup_backup(current_backup)
            except Exception:
                cleanup_complete = False
            if cleanup_complete:
                try:
                    remove_plan(paths, owner=owner, group=group)
                except Exception:
                    pass
        raise
    finally:
        if temporary is not None:
            try:
                remove_exact(temporary, sync_parent=True)
            except Exception:
                pass


def normalize_existing_for_wedge(
    paths: LabPaths,
    binding: CandidateBinding,
    receipt: dict[str, Any],
    *,
    owner: int,
    group: int,
    environment: dict[str, str],
) -> dict[str, Any] | None:
    original = receipt_owned(receipt, "original", paths)
    backup = receipt_owned(receipt, "backup", paths)
    wedge_file = receipt_owned(receipt, "wedge", paths)
    if same_visible(wedge_file):
        if not same_visible(backup):
            fail("LAB_CREDENTIAL_REPLACED", "credential recovery backup is missing or replaced")
        if receipt["state"] == "prepared":
            updated = dict(receipt)
            updated["state"] = "wedged"
            publish_receipt(
                paths, updated, owner=owner, group=group, environment=environment
            )
        return {
            "status": "unchanged",
            "runId": binding.run_id,
            "readinessSha256": binding.readiness_sha256,
            "storageSha256": wedge_file.sha256,
        }
    recover_receipt_storage(paths, receipt, environment)
    restored = dict(receipt)
    restored["state"] = "restored"
    publish_receipt(
        paths, restored, owner=owner, group=group, environment=environment
    )
    return None


def wedge(environment: dict[str, str]) -> dict[str, Any]:
    paths = resolve_lab_paths(environment)
    try:
        owner = expected_receipt_owner(paths.root, environment)
        group = expected_receipt_group(paths.root, environment)
        with acquire_lock(paths, owner=owner, group=group):
            binding = load_candidate(paths, environment, owner)
            receipt = reconcile_locked_context(
                paths,
                binding,
                owner=owner,
                group=group,
                environment=environment,
            )
            if receipt is not None and not receipt_matches_environment(receipt, environment):
                recover_receipt_storage(paths, receipt, environment)
                remove_receipt(paths, owner=owner, group=group)
                receipt = None
                reconcile_storage_backups(paths, None, binding)
            if receipt is not None:
                require_receipt_binding(receipt, binding)
                existing = normalize_existing_for_wedge(
                    paths,
                    binding,
                    receipt,
                    owner=owner,
                    group=group,
                    environment=environment,
                )
                if existing is not None:
                    return existing
            return begin_fresh_wedge(
                paths,
                binding,
                owner=owner,
                group=group,
                environment=environment,
            )
    finally:
        close_lab_paths(paths)


def install_restore(
    paths: LabPaths,
    original: OwnedFile,
    backup: OwnedFile,
    wedge_file: OwnedFile,
    environment: dict[str, str],
) -> None:
    validate_authority_identity(paths)
    if not same_visible(wedge_file) or not same_visible(backup):
        fail("LAB_CREDENTIAL_REPLACED", "credential or recovery backup changed before restore")
    try:
        os.replace(backup.path, paths.storage)
    except Exception:
        if classify_storage(original):
            return
        if classify_storage(wedge_file) and same_visible(backup):
            raise
        fail("LAB_CREDENTIAL_REPLACED", "credential restore outcome is indeterminate")
    if not same_visible(original):
        fail("LAB_CREDENTIAL_REPLACED", "credential changed at restore boundary")
    validate_authority_identity(paths)
    fixture_barrier(paths, environment, "storage-replaced-restored")


def restore(environment: dict[str, str]) -> dict[str, Any]:
    paths = resolve_lab_paths(environment)
    try:
        owner = expected_receipt_owner(paths.root, environment)
        group = expected_receipt_group(paths.root, environment)
        with acquire_lock(paths, owner=owner, group=group):
            binding = load_candidate(paths, environment, owner)
            receipt = reconcile_locked_context(
                paths,
                binding,
                owner=owner,
                group=group,
                environment=environment,
            )
            if receipt is None:
                fail("LAB_CREDENTIAL_RECEIPT_INVALID", "credential receipt is missing")
            if not receipt_matches_environment(receipt, environment):
                already_restored = receipt["state"] == "restored" and same_visible(
                    receipt_owned(receipt, "original", paths)
                )
                final = recover_receipt_storage(paths, receipt, environment)
                if not already_restored:
                    tombstone = dict(receipt)
                    tombstone["state"] = "restored"
                    publish_receipt(
                        paths,
                        tombstone,
                        owner=owner,
                        group=group,
                        environment=environment,
                    )
                fixture_barrier(paths, environment, "stale-receipt-restored")
                # The retained restored receipt is a durable tombstone. A
                # retry in the new run authenticates against the current
                # readiness ledger yet can still prove the prior transaction
                # already restored its exact original inode.
                return {
                    "status": "unchanged" if already_restored else "restored",
                    "runId": binding.run_id,
                    "readinessSha256": binding.readiness_sha256,
                    "storageSha256": final.sha256,
                }
            require_receipt_binding(receipt, binding)
            assert receipt is not None
            original = receipt_owned(receipt, "original", paths)
            already_restored = receipt["state"] == "restored" and same_visible(original)
            final = recover_receipt_storage(paths, receipt, environment)
            if already_restored:
                return {
                    "status": "unchanged",
                    "runId": binding.run_id,
                    "readinessSha256": binding.readiness_sha256,
                    "storageSha256": final.sha256,
                }
            updated = dict(receipt)
            updated["state"] = "restored"
            publish_receipt(
                paths, updated, owner=owner, group=group, environment=environment
            )
            return {
                "status": "restored",
                "runId": binding.run_id,
                "readinessSha256": binding.readiness_sha256,
                "storageSha256": final.sha256,
            }
    finally:
        close_lab_paths(paths)


def main(arguments: list[str]) -> int:
    try:
        action = parse_command(arguments)
        if action is None:
            print(USAGE, end="")
            return 0
        result = wedge(dict(os.environ)) if action == "wedge" else restore(dict(os.environ))
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
        return 0
    except CredentialError as error:
        print(f"error[{error.kind}]: {error}", file=sys.stderr)
        if error.kind == "LAB_CREDENTIAL_USAGE":
            print(USAGE, file=sys.stderr, end="")
        return EXIT_CODES[error.kind]
    except (OSError, ValueError) as error:
        print(f"error[LAB_CREDENTIAL_IO]: {error}", file=sys.stderr)
        return EXIT_CODES["LAB_CREDENTIAL_IO"]


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
