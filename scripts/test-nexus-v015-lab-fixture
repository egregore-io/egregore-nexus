        self.assertEqual(backups[0].read_bytes(), manifest_before)

    def test_restore_link_is_revalidated_after_replace_before_rollback_commits(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        module = self.load_target_module()
        first = module.install("pactbin2-truncated", "fx-first", self.env)
        self.assertEqual(first["status"], "installed")
        manifest_before = self.manifest.read_bytes()
        attacker = b'{"owner":"attacker-after-validation"}\n'
        real_fsync_directory = module.fsync_directory
        real_replace = module.os.replace
        commit_failed = {"value": False}
        restore_swapped = {"value": False}

        def fail_commit_fsync(path):
            try:
                new_visible = "fx-restore-replace-swap" in self.manifest.read_text(
                    encoding="utf-8"
                )
            except (FileNotFoundError, UnicodeDecodeError):
                new_visible = False
            if path == self.lab_dir and new_visible and not commit_failed["value"]:
                commit_failed["value"] = True
                raise OSError("injected commit fsync")
            return real_fsync_directory(path)

        def swap_restore_immediately_before_replace(source, destination):
            source_path = Path(source)
            destination_path = Path(destination)
            if (
                source_path.name.startswith(".fixtures.json.restore-")
                and destination_path == self.manifest
            ):
                restore_swapped["value"] = True
                source_path.unlink()
                source_path.write_bytes(attacker)
            return real_replace(source, destination)

        with mock.patch.object(
            module,
            "fsync_directory",
            side_effect=fail_commit_fsync,
        ), mock.patch.object(
            module.os,
            "replace",
            side_effect=swap_restore_immediately_before_replace,
        ):
            with self.assertRaises(module.ManifestPublishError) as raised:
                module.install("pactbin2-bitflip", "fx-restore-replace-swap", self.env)

        self.assertEqual(raised.exception.state, "indeterminate")
        self.assertTrue(commit_failed["value"])
        self.assertTrue(restore_swapped["value"])
        self.assertEqual(self.manifest.read_bytes(), attacker)
        self.assertTrue(
            (self.sessions_root / "fx-restore-replace-swap" / "pact" / "session.pact").is_file()
        )
        backups = list(self.lab_dir.glob(".fixtures.json.backup-*"))
        self.assertEqual(len(backups), 1)
        self.assertEqual(backups[0].read_bytes(), manifest_before)

    def test_session_directory_is_fsynced_before_the_manifest_commit(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        module = self.load_target_module()
        events: list[tuple[str, str]] = []
        real_fsync_directory = module.fsync_directory
        real_replace = module.os.replace

        def record_fsync(path):
            events.append(("fsync", str(path)))
            return real_fsync_directory(path)

        def record_replace(source, destination):
            if Path(destination) == self.manifest:
                events.append(("replace-manifest", str(destination)))
            return real_replace(source, destination)

        with mock.patch.object(
            module,
            "fsync_directory",
            side_effect=record_fsync,
        ), mock.patch.object(module.os, "replace", side_effect=record_replace):
            result = module.install("pactbin2-truncated", "fx-order", self.env)

        self.assertEqual(result["status"], "installed")
        commit_index = events.index(("replace-manifest", str(self.manifest)))
        sessions_fsync_index = events.index(("fsync", str(self.sessions_root)))
        self.assertLess(sessions_fsync_index, commit_index)

    def test_cleanup_never_unlinks_an_adversarial_replacement(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        module = self.load_target_module()
        session_id = "fx-adversarial-replacement"
        pact = self.sessions_root / session_id / "pact" / "session.pact"
        meta = self.sessions_root / session_id / "meta.json"
        attacker_pact = b"operator-pact-replacement"
        attacker_meta = b'{"owner":"operator"}\n'

        def replace_then_fail(_path, _document):
            pact.unlink()
            pact.write_bytes(attacker_pact)
            meta.unlink()
            meta.write_bytes(attacker_meta)
            raise OSError("injected manifest failure after adversarial replacement")

        with mock.patch.object(module, "publish_manifest", side_effect=replace_then_fail):
            with self.assertRaises(Exception):
                module.install("pactbin2-truncated", session_id, self.env)

        self.assertEqual(pact.read_bytes(), attacker_pact)
        self.assertEqual(meta.read_bytes(), attacker_meta)
        self.assertTrue(pact.parent.parent.is_dir())
        self.assertFalse(self.manifest.exists())

    def test_cleanup_does_not_overwrite_a_dangling_symlink_replacement(self) -> None:
        module = self.load_target_module()
        managed = self.lab_dir / "managed-cleanup"
        managed.write_bytes(b"owned")
        captured = module.owned_path(managed)
        missing = self.lab_dir / "missing-referent"
        real_same_owned_path = module.same_owned_path
        replaced = {"value": False}

        def replace_destination_before_restore(owned):
            if owned.path.name.startswith(".managed-cleanup.unlink-"):
                managed.symlink_to(missing)
                replaced["value"] = True
                return False
            return real_same_owned_path(owned)

        with mock.patch.object(
            module,
            "same_owned_path",
            side_effect=replace_destination_before_restore,
        ):
            self.assertFalse(module.unlink_owned(captured))

        self.assertTrue(replaced["value"])
        self.assertTrue(managed.is_symlink())
        self.assertEqual(os.readlink(managed), str(missing))

    def test_directory_cleanup_preserves_a_replacement_inode(self) -> None:
        module = self.load_target_module()
        managed = self.lab_dir / "managed-directory"
        original = self.lab_dir / "managed-directory-original"
        managed.mkdir()
        captured = module.owned_directory(managed)
        managed.rename(original)
        managed.mkdir()

        module.remove_created([], [captured])

        self.assertTrue(managed.is_dir())
        self.assertTrue(original.is_dir())

    def test_directory_fsync_rejects_a_path_swap_before_open(self) -> None:
        module = self.load_target_module()
        managed = self.lab_dir / "fsync-directory"
        moved = self.lab_dir / "fsync-directory-original"
        managed.mkdir()
        real_open = module.os.open
        swapped = {"value": False}

        def swap_before_open(path, flags, *args, **kwargs):
            if Path(path) == managed and not swapped["value"]:
                managed.rename(moved)
                managed.mkdir()
                swapped["value"] = True
            return real_open(path, flags, *args, **kwargs)

        with mock.patch.object(module.os, "open", side_effect=swap_before_open):
            with self.assertRaisesRegex(OSError, "directory changed"):
                module.fsync_directory(managed)

        self.assertTrue(swapped["value"])
        self.assertTrue(managed.is_dir())
        self.assertTrue(moved.is_dir())

    def test_manifest_symlink_is_rejected_and_concurrent_installs_do_not_lose_entries(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        outside_manifest = self.temp / "outside-manifest.json"
        outside_manifest.write_text('{"owner":"operator"}\n', encoding="utf-8")
        self.manifest.symlink_to(outside_manifest)

        linked = self.install("pactbin2-truncated", "fx-linked-manifest")

        self.assertEqual(linked.returncode, 4)
        self.assertIn("error[LAB_FIXTURE_PATH_UNSAFE]", linked.stderr)
        self.assertEqual(outside_manifest.read_text(), '{"owner":"operator"}\n')

        self.manifest.unlink()
        if not TARGET.is_file():
            self.fail(f"implementation script is missing: {TARGET}")
        commands = [
            [str(TARGET), "install", "pactbin2-truncated", "--session", "fx-a"],
            [str(TARGET), "install", "pactbin2-bitflip", "--session", "fx-b"],
        ]
        processes = [
            subprocess.Popen(
                command,
                cwd=ROOT,
                env=self.env,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
            for command in commands
        ]
        results = [process.communicate(timeout=10) for process in processes]
        for process, (_stdout, stderr) in zip(processes, results):
            self.assertEqual(process.returncode, 0, stderr)
        document = json.loads(self.manifest.read_text())
        self.assertEqual(set(document["sessions"]), set(KINDS))
        expected_source = str(self.sessions_root / "source" / "pact" / "session.pact")
        self.assertEqual(
            {entry["sourcePactPath"] for entry in document["sessions"].values()},
            {expected_source},
        )


if __name__ == "__main__":
    unittest.main(verbosity=2)
