    def test_backup_creation_rejects_a_swapped_source_before_manifest_replace(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        module = self.load_target_module()
        first = module.install("pactbin2-truncated", "fx-first", self.env)
        self.assertEqual(first["status"], "installed")
        manifest_before = self.manifest.read_bytes()
        real_link = module.os.link
        attacker = b'{"owner":"attacker-backup"}\n'
        fired = {"value": False}

        def swap_new_backup(source, destination, *args, **kwargs):
            result = real_link(source, destination, *args, **kwargs)
            destination_path = Path(destination)
            if (
                not fired["value"]
                and destination_path.name.startswith(".fixtures.json.backup-")
            ):
                fired["value"] = True
                destination_path.unlink()
                destination_path.write_bytes(attacker)
            return result

        with mock.patch.object(module.os, "link", side_effect=swap_new_backup):
            with self.assertRaises(Exception):
                module.install("pactbin2-bitflip", "fx-backup-source-swap", self.env)

        self.assertTrue(fired["value"])
        self.assertEqual(self.manifest.read_bytes(), manifest_before)
        self.assertFalse((self.sessions_root / "fx-backup-source-swap").exists())
        backups = list(self.lab_dir.glob(".fixtures.json.backup-*"))
        self.assertEqual(len(backups), 1)
        self.assertEqual(backups[0].read_bytes(), attacker)

    def test_pre_restore_backup_swap_is_indeterminate_and_never_installs_attacker(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        module = self.load_target_module()
        first = module.install("pactbin2-truncated", "fx-first", self.env)
        self.assertEqual(first["status"], "installed")
        manifest_before = self.manifest.read_bytes()
        real_fsync_directory = module.fsync_directory
        attacker = b'{"owner":"attacker-restore"}\n'
        fired = {"value": False}

        def swap_backup_then_fail_commit(path):
            try:
                new_visible = "fx-pre-restore-swap" in self.manifest.read_text(
                    encoding="utf-8"
                )
            except (FileNotFoundError, UnicodeDecodeError):
                new_visible = False
            if path == self.lab_dir and new_visible and not fired["value"]:
                backup = next(iter(self.lab_dir.glob(".fixtures.json.backup-*")))
                backup.unlink()
                backup.write_bytes(attacker)
                fired["value"] = True
                raise OSError("injected commit fsync after backup swap")
            return real_fsync_directory(path)

        with mock.patch.object(
            module,
            "fsync_directory",
            side_effect=swap_backup_then_fail_commit,
        ):
            with self.assertRaises(module.ManifestPublishError) as raised:
                module.install("pactbin2-bitflip", "fx-pre-restore-swap", self.env)

        self.assertEqual(raised.exception.state, "indeterminate")
        self.assertTrue(fired["value"])
        self.assertNotEqual(self.manifest.read_bytes(), attacker)
        self.assertIn(b"fx-pre-restore-swap", self.manifest.read_bytes())
        self.assertTrue(
            (self.sessions_root / "fx-pre-restore-swap" / "pact" / "session.pact").is_file()
        )
        backups = list(self.lab_dir.glob(".fixtures.json.backup-*"))
        self.assertEqual(len(backups), 1)
        self.assertEqual(backups[0].read_bytes(), attacker)
        self.assertNotEqual(backups[0].read_bytes(), manifest_before)

    def test_restore_link_identity_is_checked_before_replacing_the_manifest(self) -> None:
        self.add_source("source", pact_bytes(b"source"))
        module = self.load_target_module()
        first = module.install("pactbin2-truncated", "fx-first", self.env)
        self.assertEqual(first["status"], "installed")
        manifest_before = self.manifest.read_bytes()
        real_fsync_directory = module.fsync_directory
        real_link = module.os.link
        commit_failed = {"value": False}
        restore_swapped = {"value": False}

        def fail_commit_fsync(path):
            try:
                new_visible = "fx-restore-link-swap" in self.manifest.read_text(
                    encoding="utf-8"
                )
            except (FileNotFoundError, UnicodeDecodeError):
                new_visible = False
            if path == self.lab_dir and new_visible and not commit_failed["value"]:
                commit_failed["value"] = True
                raise OSError("injected commit fsync")
            return real_fsync_directory(path)

        def swap_restore_link(source, destination, *args, **kwargs):
            result = real_link(source, destination, *args, **kwargs)
            destination_path = Path(destination)
            if destination_path.name.startswith(".fixtures.json.restore-"):
                restore_swapped["value"] = True
                destination_path.unlink()
                destination_path.write_bytes(b'{"owner":"attacker-restore-link"}\n')
            return result

        with mock.patch.object(
            module,
