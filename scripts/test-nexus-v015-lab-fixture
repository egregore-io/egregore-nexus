        def fail_backup_fsync(path):
            if (
                path == self.lab_dir
                and not fired["value"]
                and list(self.lab_dir.glob(".fixtures.json.backup-*"))
            ):
                fired["value"] = True
                raise OSError("injected backup directory fsync")
            return real_fsync_directory(path)

