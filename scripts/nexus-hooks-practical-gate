ROOT = Path(__file__).resolve().parent.parent
DEFAULT_CONTAINER = "nexus-v010-load51"
DEFAULT_OUTPUT = ROOT / "output" / "hooks-practical" / "gate.json"
CONTAINER_ROOT = Path("/work/egregore-nexus")
INSIDE_HOME = Path("/tmp/nexus-hooks-gate")
INSIDE_HOME_ASSIGNMENT = "NEXUS_HOME=/tmp/nexus-hooks-gate"
INSIDE_GATEWAY_PORT = 4195
NEXUS_BIN = Path("/tmp/nexus-target/debug/nexus")
PACKED_NEXUS_BIN = Path("/tmp/nexus-lab-bin/nexus")
PACKED_GATEWAY_BIN = Path("/tmp/nexus-lab-bin/nexus-gateway")
PACKED_CANDIDATE_VERIFIER = Path("/tmp/nexus-lab-bin/nexus-v015-ws-acceptance")
SAFE_RUN_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$")
SHA256 = re.compile(r"^[0-9a-f]{64}$")
PREFIXED_SHA256 = re.compile(r"^sha256:[0-9a-f]{64}$")
F2_ARTIFACTS = ("shell", "javascript", "python", "timing")

