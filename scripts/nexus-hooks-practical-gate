def usage() -> str:
    return """Usage: scripts/nexus-hooks-practical-gate [--container NAME] [--output PATH]
       scripts/nexus-hooks-practical-gate --packed-v015 --evidence-dir DIR --run-id ID

Runs the canonical message sources through live before_send and after_receipt hooks in the
single existing clamped Docker validator. It covers direct daemon RPC, CLI command intent,
Gateway REST, network MCP, notifications, and agent-origin sends, plus Gateway outage modes,
restart recovery, signed audit provenance, idempotency, delivery timing, and token stream
isolation. The validator uses a disposable Nexus home and never touches the operator runtime.

Options:
  --list            List scenario ids without running the gate.
  --container NAME  Sole validation container (default: nexus-v010-load51).
  --output PATH     JSON evidence path under this repository.
  --packed-v015     Run the manifest/readiness-bound packed F2 gate in the isolated lab.
  --evidence-dir    Canonical NEXUS_LAB_ROOT/evidence directory for packed F2 evidence.
  --run-id ID       Exact NEXUS_V015_RUN_ID for packed F2 evidence.
  -h, --help        Show this help without inspecting Docker or changing files.
"""


def parse_args(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--container", default=DEFAULT_CONTAINER)
    parser.add_argument("--output", type=Path, default=DEFAULT_OUTPUT)
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--inside", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--packed-v015", action="store_true")
    parser.add_argument("--evidence-dir", type=Path)
    parser.add_argument("--run-id")
    parser.add_argument("-h", "--help", action="store_true")
    args, unknown = parser.parse_known_args(argv)
    if unknown:
        raise SystemExit(f"error: unknown argument(s): {' '.join(unknown)}\n{usage()}")
    return args


def hook_programs() -> dict[str, str]:
    return {
        "hook-python.py": r'''#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import sys

MARKER = re.compile(
    r"^GATE\[(?P<source>[a-z0-9-]+)\|"
    r"(?P<timing>interrupt|yield_turn|after_tool_loop)\]\s*(?P<body>.*)$",
    re.DOTALL,
)

invocation = json.load(sys.stdin)
event = invocation.get("event")
invocation_id = invocation.get("invocationId")
if event == "before_send":
    message = invocation.get("message", {})
    metadata = message.get("metadata", {}) if isinstance(message, dict) else {}
    body = message.get("body", "") if isinstance(message, dict) else ""
    match = MARKER.match(body) if isinstance(body, str) else None
    if match:
        source = match.group("source")
        timing = match.group("timing")
        clean_body = match.group("body")
    else:
        source = metadata.get("gateSource") if isinstance(metadata, dict) else None
        timing = metadata.get("gateTiming") if isinstance(metadata, dict) else None
        clean_body = body
    if not isinstance(source, str) or timing not in {"interrupt", "yield_turn", "after_tool_loop"}:
        result = {}
    else:
        result = {
            "action": "continue",
            "message": {"body": f"[hook:{source}] {clean_body}"},
            "metadata": {
                "hookGate": {"beforeSend": True, "source": source},
                "f2Python": {"beforeSend": True, "invocationId": invocation_id},
            },
            "timing": timing,
        }
elif event == "after_receipt":
    message_id = invocation.get("receipt", {}).get("messageId")
    if not isinstance(message_id, str) or not message_id:
        raise SystemExit("after_receipt requires receipt.messageId")
    result = {
        "metadata": {
            "hookGate": {"afterReceipt": True, "receiptMessageId": message_id},
            "f2Python": {
                "afterReceipt": True,
                "invocationId": invocation_id,
                "receiptMessageId": message_id,
            },
        }
    }
else:
    result = {}
json.dump(result, sys.stdout, separators=(",", ":"))
''',
        "hook-javascript.mjs": r'''#!/usr/bin/env node
let input = "";
for await (const chunk of process.stdin) input += chunk;
const invocation = JSON.parse(input);
let result = {};
if (invocation?.event === "before_send") {
  result = {
    action: "continue",
    metadata: {
      f2Javascript: { beforeSend: true, invocationId: invocation.invocationId },
    },
  };
} else if (invocation?.event === "after_receipt") {
  const messageId = invocation?.receipt?.messageId;
  if (typeof messageId !== "string" || messageId.length === 0) {
    throw new Error("after_receipt requires receipt.messageId");
  }
  result = {
    metadata: {
      f2Javascript: {
        afterReceipt: true,
        invocationId: invocation.invocationId,
        receiptMessageId: messageId,
      },
    },
  };
}
process.stdout.write(JSON.stringify(result));
''',
        "hook-shell.sh": r'''#!/bin/sh
set -eu
input=$(cat)
event=$(printf '%s' "$input" | jq -er '.event')
case "$event" in
  before_send)
    printf '%s' "$input" | jq -c '{
      action:"continue",
      metadata:{f2Shell:{beforeSend:true,invocationId:.invocationId}}
    }'
    ;;
  after_receipt)
    printf '%s' "$input" | jq -e '(.receipt.messageId | type == "string") and (.receipt.messageId | length > 0)' >/dev/null
    printf '%s' "$input" | jq -c '{
      metadata:{f2Shell:{
        afterReceipt:true,
        invocationId:.invocationId,
        receiptMessageId:.receipt.messageId
      }}
    }'
    ;;
  *) printf '{}\n' ;;
esac
''',
    }


def command(
    args: list[str],
    *,
    env: dict[str, str] | None = None,
    input_text: str | None = None,
    capture: bool = True,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        env=env,
        input=input_text,
        text=True,
        capture_output=capture,
        check=check,
    )


def host_main(args: argparse.Namespace) -> int:
    validators = command(
        [
            "docker",
            "ps",
            "--filter",
            "label=egregore-nexus-test=true",
            "--format",
            "{{.Names}}",
        ]
    ).stdout.splitlines()
    if validators != [args.container]:
        raise GateFailure(
            "expected exactly one Nexus validation container; "
            f"found {len(validators)}: {', '.join(validators) if validators else 'none'}"
        )

    inspect = json.loads(command(["docker", "inspect", args.container]).stdout)[0]
    host_config = inspect["HostConfig"]
    nano_cpus = int(host_config.get("NanoCpus") or 0)
    memory = int(host_config.get("Memory") or 0)
    pids_limit = int(host_config.get("PidsLimit") or 0)
    if not (0 < nano_cpus <= 2000000000):
        raise GateFailure(f"validator CPU limit exceeds 2 CPUs: {nano_cpus}")
    if not (0 < memory <= 10737418240):
        raise GateFailure(f"validator memory limit exceeds 10 GiB: {memory}")
    if not (0 < pids_limit <= 1024):
        raise GateFailure(f"validator PID limit exceeds 1024: {pids_limit}")

    mounted = next(
        (
            item.get("Source")
            for item in inspect.get("Mounts", [])
            if item.get("Destination") == str(CONTAINER_ROOT)
        ),
        None,
    )
    if Path(mounted or "").resolve() != ROOT:
        raise GateFailure(f"validator mounts {mounted!r}, not {ROOT}")

    output = args.output.resolve()
    try:
        relative_output = output.relative_to(ROOT)
    except ValueError as error:
        raise GateFailure("--output must be inside the repository") from error
    output.parent.mkdir(parents=True, exist_ok=True)
    inside_output = CONTAINER_ROOT / relative_output
    uid_gid = f"{os.getuid()}:{os.getgid()}"

    build = command(
        [
            "docker",
            "exec",
            "--user",
            uid_gid,
            "-e",
            "CARGO_BUILD_JOBS=2",
            args.container,
            "bash",
            "-lc",
            "set -euo pipefail; "
            "export PATH=/usr/local/cargo/bin:/usr/local/bin:/usr/bin:/bin; "
            "cd /work/egregore-nexus/core; "
            "CARGO_BUILD_JOBS=2 cargo build -p egregore-nexus; "
            "cd /work/egregore-nexus/gateway; "
            "pnpm build:gateway-package",
        ],
        capture=False,
        check=False,
    )
    if build.returncode != 0:
        raise GateFailure("validator build failed")

    inside = command(
        [
            "docker",
            "exec",
            "--user",
            uid_gid,
            args.container,
            "python3",
            str(CONTAINER_ROOT / "scripts" / "nexus-hooks-practical-gate"),
            "--inside",
            "--output",
            str(inside_output),
        ],
        capture=False,
        check=False,
    )
    if inside.returncode != 0:
        raise GateFailure("live hook gate failed")
    if not output.is_file():
        raise GateFailure(f"live hook gate did not write {output}")
    print(f"PASS Gateway message hooks practical gate: {output}")
    return 0


class GateFailure(RuntimeError):
    pass


class LiveGate:
    def __init__(
        self,
        output: Path | None,
        *,
        home: Path = INSIDE_HOME,
        nexus_bin: Path = NEXUS_BIN,
        gateway_bin: Path = CONTAINER_ROOT / "gateway" / "scripts" / "nexus-gateway.mjs",
        packed: bool = False,
        resource_limits: dict[str, Any] | None = None,
    ):
        self.output = output
        self.home = home
        self.nexus_bin = nexus_bin
        self.gateway_bin = gateway_bin
        self.packed = packed
        self.resource_limits = resource_limits or {
            "cpus": 2,
            "memoryGiBMax": 10,
            "pidsMax": 1024,
        }
        self.gateway_url = f"http://127.0.0.1:{INSIDE_GATEWAY_PORT}"
        self.daemon: subprocess.Popen[str] | None = None
        self.gateway: subprocess.Popen[str] | None = None
        self.daemon_log: Any = None
        self.gateway_log: Any = None
        self.message_ids: dict[str, str] = {}
        self.scenario_status = {scenario: "pending" for scenario in SCENARIOS}
        self.language_artifacts: dict[str, dict[str, Any]] = {}
        self.timing_artifact: dict[str, Any] = {}
        self.started_at = time.time()

    def run(self) -> dict[str, Any]:
        self.prepare()
        try:
            self.start_daemon("optional")
            self.start_gateway()
            self.seed_identities_and_thread()
            self.exercise_sources()
            self.verify_canonical_results()
            self.verify_idempotent_retry()
            self.verify_gateway_restart()
            self.verify_outage_modes()
            self.verify_token_stream_isolation()
            report = self.report()
            if self.output is not None:
                self.output.parent.mkdir(parents=True, exist_ok=True)
                self.output.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
                print(json.dumps(report, indent=2))
            return report
        finally:
            self.cleanup_processes()

    def prepare(self) -> None:
        self.cleanup_stale_home()
        self.home.mkdir(parents=True, mode=0o700)
        (self.home / "operator-home").mkdir(mode=0o700)
        hooks = self.home / "gateway" / "hooks.d"
        hooks.mkdir(parents=True)
        for name, contents in hook_programs().items():
            target = hooks / name
            target.write_text(contents, encoding="utf-8")
            target.chmod(0o500)
        for hook_id, event, order, entry, runtime in HOOK_SPECS:
            (hooks / f"{order:02d}-{hook_id}.toml").write_text(
                "\n".join(
                    (
                        "version = 1",
                        f'id = "{hook_id}"',
                        f'event = "{event}"',
                        f"order = {order}",
                        "timeout_ms = 5000",
                        f'on_failure = "{"reject" if event == "before_send" else "continue"}"',
                        "",
                        "[handler]",
                        'kind = "local"',
                        f'entry = "{entry}"',
                        'entrypoint = "main"',
                        f'run = ["{runtime}", "{{entry}}"]',
                        "",
                    )
                ),
                encoding="utf-8",
            )

    def base_env(self, mode: str | None = None) -> dict[str, str]:
        env = os.environ.copy()
        env.update(
            {
                "NEXUS_HOME": str(self.home),
                "HOME": str(self.home / "operator-home"),
                "NEXUS_DB_PATH": str(self.home / "nexus.db"),
                "NEXUS_GATEWAY_DB": f"file:{self.home / 'gateway.db'}",
                "NEXUS_STREAM_DB_PATH": str(self.home / "stream.db"),
                "NEXUS_GATEWAY_BIND": "127.0.0.1",
                "NEXUS_GATEWAY_PORT": str(INSIDE_GATEWAY_PORT),
                "NEXUS_GATEWAY_BIN": str(self.gateway_bin),
                "NEXUS_WEB_AUTH_MODE": "local",
                "RUST_MIN_STACK": "33554432",
            }
        )
        if mode is not None:
            env["NEXUS_HOOK_GATEWAY_MODE"] = mode
        for key in ("NEXUS_NAME", "NEXUS_AGENT", "NEXUS_PROJECT", "NEXUS_CLIENT_KEY"):
            env.pop(key, None)
        return env

    def start_daemon(self, mode: str) -> None:
        if self.daemon and self.daemon.poll() is None:
            raise GateFailure("isolated daemon is already running")
        self.daemon_log = open(self.home / "daemon.log", "a", encoding="utf-8")
        self.daemon = subprocess.Popen(
            [str(self.nexus_bin), "daemon"],
            env=self.base_env(mode),
            stdin=subprocess.DEVNULL,
            stdout=self.daemon_log,
            stderr=subprocess.STDOUT,
            text=True,
            start_new_session=True,
        )
        self.wait_until(
            lambda: (self.home / "daemon-ipc-endpoint.json").is_file(),
            30,
            "daemon IPC endpoint",
        )

    def stop_daemon(self) -> None:
        self.stop_process(self.daemon)
        self.daemon = None
        if self.daemon_log:
            self.daemon_log.close()
            self.daemon_log = None
        for name in ("daemon-ipc-endpoint.json", "gateway-stream-endpoint.json"):
            (self.home / name).unlink(missing_ok=True)

    def start_gateway(self) -> None:
        if self.gateway and self.gateway.poll() is None:
            raise GateFailure("isolated Gateway is already running")
        self.gateway_log = open(self.home / "gateway.log", "a", encoding="utf-8")
        gateway_command = (
            [str(self.gateway_bin)]
            if self.packed
            else ["node", str(self.gateway_bin)]
        )
        self.gateway = subprocess.Popen(
            [*gateway_command, "--api-only", "--discovery=write"],
            env=self.base_env(),
            stdin=subprocess.DEVNULL,
            stdout=self.gateway_log,
            stderr=subprocess.STDOUT,
            text=True,
            start_new_session=True,
        )
        self.wait_until(self.gateway_healthy, 30, "Gateway health")
        hooks = self.http_json("GET", "/api/v1/hooks")
        ids = {hook["id"] for hook in hooks.get("hooks", [])}
        expected_ids = {spec[0] for spec in HOOK_SPECS}
        if ids != expected_ids:
            raise GateFailure(f"unexpected active hooks: {sorted(ids)}")

    def stop_gateway(self) -> None:
        self.stop_process(self.gateway)
        self.gateway = None
        if self.gateway_log:
            self.gateway_log.close()
            self.gateway_log = None
        (self.home / "gateway.json").unlink(missing_ok=True)
        time.sleep(0.5)

    def seed_identities_and_thread(self) -> None:
        self.register_agent("hook-recipient", "ck_hooks_recipient")
        self.register_agent("hook-agent", "ck_hooks_agent")
        self.cli(
            [
                "thread",
                "new",
                "hooks-practical",
                "--member",
                "hook-recipient",
                "--member",
                "hook-agent",
            ]
        )

    def register_agent(self, name: str, key: str) -> None:
        env = self.agent_env(name, key)
        self.cli(
            [
                "register",
                "--name",
                name,
                "--agent",
                "other",
                "--project",
                "default",
                "--client-key",
                key,
            ],
            env=env,
        )

    def agent_env(self, name: str, key: str) -> dict[str, str]:
        env = self.base_env()
        env.update(
            {
                "NEXUS_NAME": name,
                "NEXUS_AGENT": "other",
                "NEXUS_PROJECT": "default",
                "NEXUS_CLIENT_KEY": key,
            }
        )
        return env

    def exercise_sources(self) -> None:
        self.message_ids["direct-daemon-rpc"] = self.direct_send(
            "direct-daemon-rpc", "interrupt", "direct boundary", "hooks-direct-1"
        )
        self.scenario_status["direct-daemon-rpc"] = "pass"

        cli_result = self.cli_json(
            [
                "post",
                "hooks-practical",
                "-m",
                self.marker("cli-command-intent", "yield_turn", "CLI boundary"),
            ]
        )
        self.message_ids["cli-command-intent"] = required_message_id(cli_result)
        self.scenario_status["cli-command-intent"] = "pass"

        rest_result = self.http_json(
            "POST",
            "/api/v1/messages",
            {
                "to": {"verb": "post", "thread": "hooks-practical"},
                "body": self.marker("gateway-rest", "after_tool_loop", "REST boundary"),
                "idempotencyKey": "hooks-rest-1",
            },
        )
        self.message_ids["gateway-rest"] = required_message_id(rest_result)
        self.scenario_status["gateway-rest"] = "pass"

        token = self.http_json(
            "POST",
            "/api/v1/auth/operator-token",
            {"name": "hooks-mcp", "scopes": ["message:send"], "ttlMs": 300_000},
        )["accessToken"]
        mcp = self.http_json(
            "POST",
            "/api/mcp",
            {
                "jsonrpc": "2.0",
                "id": "hooks-mcp-1",
                "method": "tools/call",
                "params": {
                    "name": "post",
                    "arguments": {
                        "thread": "hooks-practical",
                        "message": self.marker("network-mcp", "interrupt", "MCP boundary"),
                    },
                },
            },
            {"authorization": f"Bearer {token}"},
        )
        tool_result = mcp.get("result", {})
        if tool_result.get("isError"):
            raise GateFailure(f"network MCP failed: {tool_result}")
        content = tool_result.get("content", [])
        self.message_ids["network-mcp"] = required_message_id(json.loads(content[0]["text"]))
        self.scenario_status["network-mcp"] = "pass"

        notification = self.cli_json(
            [
                "notify",
                "--target",
                "thread:hooks-practical",
                "--source",
                "hooks-practical",
                "--idempotency-key",
                "hooks-notification-1",
                self.marker("notification", "yield_turn", "notification boundary"),
            ]
        )
        self.message_ids["notification"] = required_message_id(notification)
        self.scenario_status["notification"] = "pass"

        agent_result = self.cli_json(
            [
                "post",
                "hooks-practical",
                "-m",
                self.marker("agent-origin", "after_tool_loop", "agent boundary"),
            ],
            env=self.agent_env("hook-agent", "ck_hooks_agent"),
        )
        self.message_ids["agent-origin"] = required_message_id(agent_result)
        self.scenario_status["agent-origin"] = "pass"

    def verify_canonical_results(self) -> None:
        expected_timing = {
            "direct-daemon-rpc": "interrupt",
            "cli-command-intent": "yield_turn",
            "gateway-rest": "after_tool_loop",
            "network-mcp": "interrupt",
            "notification": "yield_turn",
            "agent-origin": "after_tool_loop",
        }

        def ready() -> bool:
            with self.gateway_db() as db:
                placeholders = ",".join("?" for _ in self.message_ids)
                rows = db.execute(
                    f"SELECT message_id FROM hook_receipt_completion "
                    f"WHERE state = 'completed' AND message_id IN ({placeholders})",
                    list(self.message_ids.values()),
                ).fetchall()
                return len(rows) == len(self.message_ids)

        self.wait_until(ready, 30, "after_receipt completion")
        delivery_outcomes = self.daemon_export("delivery_outcomes")
        with self.gateway_db() as db:
            for source, message_id in self.message_ids.items():
                row = db.execute(
                    "SELECT body, metadata_json FROM bus_messages WHERE message_id = ?",
                    (message_id,),
                ).fetchone()
                if not row:
                    raise GateFailure(f"Gateway canonical message missing: {message_id}")
                body, raw_metadata = row
                if body != f"[hook:{source}] {self.payload_for(source)}":
                    raise GateFailure(f"unexpected transformed body for {source}: {body!r}")
                metadata = json.loads(raw_metadata)
                gate = metadata.get("hookGate", {})
                if gate.get("beforeSend") is not True or gate.get("source") != source:
                    raise GateFailure(f"before_send metadata missing for {source}: {metadata}")
                if gate.get("afterReceipt") is not True or gate.get("receiptMessageId") != message_id:
                    raise GateFailure(f"after_receipt metadata missing for {source}: {metadata}")
                for language, metadata_key in (
                    ("shell", "f2Shell"),
                    ("javascript", "f2Javascript"),
                    ("python", "f2Python"),
                ):
                    proof = metadata.get(metadata_key, {})
                    if (
                        proof.get("beforeSend") is not True
                        or proof.get("afterReceipt") is not True
                        or proof.get("receiptMessageId") != message_id
                    ):
                        raise GateFailure(
                            f"{language} before_send/after_receipt proof missing for {source}: {proof}"
                        )
                executions = metadata.get("_nexus", {}).get("hooks", {}).get("executedBy", [])
                if {item.get("hookId") for item in executions} != {spec[0] for spec in HOOK_SPECS}:
                    raise GateFailure(f"signed provenance missing for {source}: {executions}")
                timings = {
                    row.get("delivery_timing")
                    for row in delivery_outcomes
                    if row.get("message_id") == message_id
                }
                if timings != {expected_timing[source]}:
                    raise GateFailure(f"wrong timing for {source}: {sorted(timings)}")

        self.scenario_status["timing-interrupt"] = "pass"
        self.scenario_status["timing-yield-turn"] = "pass"
        self.scenario_status["timing-after-tool-loop"] = "pass"
        audit = self.http_json("GET", "/api/v1/hooks/audit?limit=100")
        audit_rows = audit.get("executions")
        if not isinstance(audit_rows, list) or not audit_rows or not all(
            isinstance(item, dict) and item.get("verified") is True for item in audit_rows
        ):
            raise GateFailure("hook audit contains an unverifiable execution")
        for language, hook_ids in HOOK_IDS_BY_LANGUAGE.items():
            language_rows = [row for row in audit_rows if row.get("hookId") in hook_ids]
            expected_count = len(self.message_ids) * len(hook_ids)
            if (
                len(language_rows) != expected_count
                or {row.get("hookId") for row in language_rows} != hook_ids
                or {row.get("event") for row in language_rows} != {"before_send", "after_receipt"}
                or any(row.get("outcome") != "completed" for row in language_rows)
            ):
                raise GateFailure(
                    f"{language} hook audit is incomplete: expected {expected_count}, "
                    f"observed {len(language_rows)}"
                )
            self.language_artifacts[language] = {
                "schemaVersion": 1,
                "language": language,
                "handlerIds": sorted(hook_ids),
                "events": ["before_send", "after_receipt"],
                "executionCount": len(language_rows),
                "executions": language_rows,
            }
        timing_rows = [
            row
            for row in delivery_outcomes
            if row.get("message_id") in set(self.message_ids.values())
        ]
        if not timing_rows:
            raise GateFailure("delivery timing evidence is empty")
        self.timing_artifact = {
            "schemaVersion": 1,
            "expectedBySource": expected_timing,
            "messageIds": self.message_ids.copy(),
            "deliveryOutcomes": sorted(
                timing_rows,
                key=lambda row: json.dumps(row, sort_keys=True, separators=(",", ":")),
            ),
        }
        public_key = self.http_json("GET", "/api/v1/hooks/public-key")
        if public_key.get("algorithm") != "ed25519" or "BEGIN PUBLIC KEY" not in public_key.get(
            "publicKey", ""
        ):
            raise GateFailure("hook public key is unavailable")
        self.scenario_status["after-receipt-signature"] = "pass"

    def verify_idempotent_retry(self) -> None:
        def hook_work_snapshot() -> tuple[list[tuple[Any, ...]], list[tuple[Any, ...]]]:
            with self.gateway_db() as db:
                evaluations = db.execute(
                    "SELECT * FROM hook_pipeline_evaluations ORDER BY rowid"
                ).fetchall()
                executions = db.execute(
                    "SELECT * FROM hook_handler_executions ORDER BY rowid"
                ).fetchall()
            return evaluations, executions

        request = {
            "to": {"verb": "post", "thread": "hooks-practical"},
            "body": self.marker("gateway-rest", "after_tool_loop", "REST boundary"),
            "idempotencyKey": "hooks-rest-1",
        }
        before = hook_work_snapshot()
        duplicate = self.http_json("POST", "/api/v1/messages", request)
        message_id = self.message_ids["gateway-rest"]
        if required_message_id(duplicate) != message_id:
            raise GateFailure("REST idempotent retry returned a different message")
        after = hook_work_snapshot()
        if after != before:
            raise GateFailure(
                "idempotent retry changed hook work: "
                f"evaluations={len(before[0])}->{len(after[0])}, "
                f"executions={len(before[1])}->{len(after[1])}"
            )
        self.scenario_status["idempotent-retry"] = "pass"

    def verify_gateway_restart(self) -> None:
        self.stop_gateway()
        self.start_gateway()
        duplicate = self.http_json(
            "POST",
            "/api/v1/messages",
            {
                "to": {"verb": "post", "thread": "hooks-practical"},
                "body": self.marker("gateway-rest", "after_tool_loop", "REST boundary"),
                "idempotencyKey": "hooks-rest-1",
            },
        )
        if required_message_id(duplicate) != self.message_ids["gateway-rest"]:
            raise GateFailure("Gateway restart lost idempotent message identity")
        self.scenario_status["gateway-restart-recovery"] = "pass"

    def verify_outage_modes(self) -> None:
        self.stop_gateway()
        optional_id = self.direct_send(
            "gateway-optional-outage", "interrupt", "optional bypass", "hooks-optional-outage-1"
        )
        message = next(
            (row for row in self.daemon_export("messages") if row.get("message_id") == optional_id),
            None,
        )
        body = message.get("body") if message else None
        if not str(body).startswith("GATE[gateway-optional-outage|interrupt]"):
            raise GateFailure("optional Gateway outage did not bypass the absent hook provider")
        self.scenario_status["gateway-optional-outage"] = "pass"

        self.stop_daemon()
        self.start_daemon("required")
        before_count = self.daemon_message_count()
        response = self.direct_rpc_response(
            "message.post.send",
            self.send_request(
                "gateway-required-outage", "interrupt", "required rejection", "hooks-required-1"
            ),
            "cmd_hooks_required_outage",
            "hooks-required-1",
        )
        error = response.get("error")
        if not error or "Gateway" not in str(error.get("message", "")):
            raise GateFailure(f"required outage did not return a typed Gateway error: {response}")
        if self.daemon_message_count() != before_count:
            raise GateFailure("required Gateway outage committed a message")
        self.scenario_status["gateway-required-outage"] = "pass"

        self.start_gateway()
        recovery_id = self.direct_send(
            "gateway-restart-recovery", "interrupt", "required recovery", "hooks-required-recovery-1"
        )
        self.message_ids["gateway-restart-recovery"] = recovery_id
        self.wait_until(
            lambda: self.receipt_completed(recovery_id), 30, "required-mode receipt recovery"
        )
        with self.gateway_db() as db:
            row = db.execute(
                "SELECT body FROM bus_messages WHERE message_id = ?", (recovery_id,)
            ).fetchone()
        if not row or row[0] != "[hook:gateway-restart-recovery] required recovery":
            raise GateFailure("required-mode Gateway recovery did not restore hooks")

    def verify_token_stream_isolation(self) -> None:
        with self.gateway_db() as db:
            events = {
                row[0]
                for row in db.execute("SELECT DISTINCT event FROM hook_pipeline_evaluations")
            }
        if not events or not events.issubset({"before_send", "after_receipt"}):
            raise GateFailure(f"non-message event entered hook pipeline: {sorted(events)}")
        if not self.packed:
            service_source = (
                CONTAINER_ROOT / "gateway" / "src" / "server" / "hooks" / "service.ts"
            ).read_text(encoding="utf-8")
            if 'new Set(["before_send", "after_receipt"])' not in service_source:
                raise GateFailure("hook service event allowlist no longer excludes token streams")
        self.scenario_status["token-stream-isolation"] = "pass"

    def report(self) -> dict[str, Any]:
        pending = [name for name, status in self.scenario_status.items() if status != "pass"]
        if pending:
            raise GateFailure(f"unsettled scenarios: {', '.join(pending)}")
        with self.gateway_db() as db:
            execution_count = db.execute(
                "SELECT COUNT(*) FROM hook_handler_executions WHERE outcome = 'completed'"
            ).fetchone()[0]
            receipt_count = db.execute(
                "SELECT COUNT(*) FROM hook_receipt_completion WHERE state = 'completed'"
            ).fetchone()[0]
        return {
            "schemaVersion": 1,
            "status": "pass",
            "durationSeconds": round(time.time() - self.started_at, 3),
            "nexusHome": str(self.home),
            "resourceLimits": self.resource_limits,
            "messages": self.message_ids,
            "completedHookExecutions": execution_count,
            "completedReceipts": receipt_count,
            "scenarios": [
                {"id": name, "status": self.scenario_status[name]} for name in SCENARIOS
            ],
        }

    def cli(
        self, args: list[str], *, env: dict[str, str] | None = None
    ) -> subprocess.CompletedProcess[str]:
        result = command([str(self.nexus_bin), *args], env=env or self.base_env(), check=False)
        if result.returncode != 0:
            raise GateFailure(
                f"nexus {' '.join(args)} failed rc={result.returncode}: "
                f"{result.stderr.strip() or result.stdout.strip()}"
            )
        return result

    def cli_json(self, args: list[str], *, env: dict[str, str] | None = None) -> dict[str, Any]:
        result = self.cli(["--json", *args], env=env)
        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError as error:
            raise GateFailure(f"invalid CLI JSON for {' '.join(args)}: {result.stdout!r}") from error

    def direct_send(
        self, source: str, timing: str, payload: str, idempotency_key: str
    ) -> str:
        response = self.direct_rpc_response(
            "message.post.send",
            self.send_request(source, timing, payload, idempotency_key),
            f"cmd_{source.replace('-', '_')}_{int(time.time() * 1000)}",
            idempotency_key,
        )
        if response.get("error"):
            raise GateFailure(f"direct daemon RPC failed: {response['error']}")
        return required_message_id(response.get("result", {}))

    def send_request(
        self, source: str, timing: str, payload: str, idempotency_key: str
    ) -> dict[str, Any]:
        return {
            "to": {"verb": "post", "thread": "hooks-practical"},
            "body": self.marker(source, timing, payload),
            "mention": [],
            "idempotencyKey": idempotency_key,
        }

    def direct_rpc_response(
        self,
        kind: str,
        params: dict[str, Any],
        command_id: str,
        idempotency_key: str,
    ) -> dict[str, Any]:
        request_id = f"rpc_{command_id}"
        return self.direct_ipc_response(
            request_id,
            {
                "mode": "command",
                "commandId": command_id,
                "kind": kind,
                "params": params,
                "idempotencyKey": idempotency_key,
            },
        )

    def direct_query_response(self, method: str, params: dict[str, Any]) -> dict[str, Any]:
        request_id = f"rpc_query_{time.time_ns()}"
        return self.direct_ipc_response(
            request_id,
            {"mode": "query", "method": method, "params": params},
        )

    def direct_ipc_response(
        self, request_id: str, call: dict[str, Any]
    ) -> dict[str, Any]:
        endpoint = json.loads(
            (self.home / "daemon-ipc-endpoint.json").read_text(encoding="utf-8")
        )
        request = {
            "version": 1,
            "token": endpoint["token"],
            "requestId": request_id,
            "caller": {
                "name": "hooks-operator",
                "project": "default",
                "sessionId": "local-operator",
                "runtimeId": "local-operator",
                "kind": "human",
                "tier": "admin",
            },
            "call": call,
        }
        payload = json.dumps(request, separators=(",", ":")).encode()
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(15)
            client.connect(endpoint["path"])
            client.sendall(struct.pack(">I", len(payload)) + payload)
            size = struct.unpack(">I", recv_exact(client, 4))[0]
            response = json.loads(recv_exact(client, size))
        if response.get("requestId") != request_id:
            raise GateFailure(f"daemon RPC response correlation mismatch: {response}")
        return response

    def daemon_export(self, kind: str) -> list[dict[str, Any]]:
        rows: list[dict[str, Any]] = []
        cursor: str | None = None
        while True:
            response = self.direct_query_response(
                "local.store.export",
                {"kind": kind, "cursor": cursor, "limit": 500},
            )
            if response.get("error"):
                raise GateFailure(f"daemon {kind} export failed: {response['error']}")
            result = response.get("result", {})
            page = result.get("rows")
            if not isinstance(page, list):
                raise GateFailure(f"daemon {kind} export returned invalid rows: {result}")
            rows.extend(row for row in page if isinstance(row, dict))
            cursor = result.get("nextCursor")
            if not cursor:
                return rows

    def http_json(
        self,
        method: str,
        path: str,
        body: dict[str, Any] | None = None,
        headers: dict[str, str] | None = None,
    ) -> dict[str, Any]:
        data = json.dumps(body).encode() if body is not None else None
        request_headers = {"content-type": "application/json", **(headers or {})}
        request = urllib.request.Request(
            f"{self.gateway_url}{path}",
            data=data,
            headers=request_headers,
            method=method,
        )
        try:
            with urllib.request.urlopen(request, timeout=15) as response:
                return json.loads(response.read())
        except urllib.error.HTTPError as error:
            raw = error.read().decode("utf-8", "replace")
            raise GateFailure(f"{method} {path} failed HTTP {error.code}: {raw}") from error

    def gateway_healthy(self) -> bool:
        try:
            result = self.http_json("GET", "/api/v1/health")
            return bool(result)
        except Exception:
            return False

    def receipt_completed(self, message_id: str) -> bool:
        try:
            with self.gateway_db() as db:
                row = db.execute(
                    "SELECT state FROM hook_receipt_completion WHERE message_id = ?",
                    (message_id,),
                ).fetchone()
            return bool(row and row[0] == "completed")
        except sqlite3.Error:
            return False

    def gateway_db(self) -> sqlite3.Connection:
        return sqlite3.connect(self.home / "gateway.db", timeout=5)

    def daemon_message_count(self) -> int:
        return len(self.daemon_export("messages"))

    def marker(self, source: str, timing: str, payload: str) -> str:
        return f"GATE[{source}|{timing}] {payload}"

    def payload_for(self, source: str) -> str:
        return {
            "direct-daemon-rpc": "direct boundary",
            "cli-command-intent": "CLI boundary",
            "gateway-rest": "REST boundary",
            "network-mcp": "MCP boundary",
            "notification": "notification boundary",
            "agent-origin": "agent boundary",
        }[source]

    def wait_until(self, predicate: Any, timeout: float, label: str) -> None:
        deadline = time.monotonic() + timeout
        while time.monotonic() < deadline:
            if predicate():
                return
            time.sleep(0.1)
        raise GateFailure(f"timed out waiting for {label}")

    def stop_process(self, process: subprocess.Popen[str] | None) -> None:
        if not process or process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        try:
            process.wait(timeout=8)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=3)

    def cleanup_processes(self) -> None:
        self.stop_gateway()
        self.stop_daemon()

    def cleanup_stale_home(self) -> None:
        if self.home.exists():
            for pid_file in (self.home / "gate-daemon.pid", self.home / "gate-gateway.pid"):
                try:
                    pid = int(pid_file.read_text(encoding="utf-8").strip())
                    os.kill(pid, signal.SIGTERM)
                except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
                    pass
            shutil.rmtree(self.home)


def verify_packed_candidate(evidence_dir: Path, run_id: str) -> dict[str, Any]:
    result = command(
        [
            str(PACKED_CANDIDATE_VERIFIER),
            "--mode",
            "packed",
            "--evidence-dir",
            str(evidence_dir),
            "--run-id",
            run_id,
            "--verify-candidate-only",
        ],
        check=False,
    )
    if result.returncode != 0:
        raise GateFailure(
            "packed candidate verification failed: "
            f"{result.stderr.strip() or result.stdout.strip()}"
        )
    try:
        document = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise GateFailure("packed candidate verifier emitted invalid JSON") from error
    expected_limits = {"cpus": 6, "memoryBytes": 8589934592, "pids": 1024}
    runtime = document.get("runtime")
    if (
        document.get("schemaVersion") != 1
        or document.get("status") != "PASS"
        or document.get("mode") != "packed"
        or document.get("runId") != run_id
        or PREFIXED_SHA256.fullmatch(str(document.get("candidateDigest", ""))) is None
        or SHA256.fullmatch(str(document.get("readinessSha256", ""))) is None
        or document.get("limits") != expected_limits
        or not isinstance(runtime, dict)
        or not isinstance(runtime.get("daemonExecutable"), str)
        or not isinstance(runtime.get("gatewayEntrypoint"), str)
    ):
        raise GateFailure("packed candidate verifier returned an incomplete F2 binding")
    return document


def canonical_json(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode("utf-8")


def fsync_directory(path: Path) -> None:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def atomic_write_new(path: Path, payload: bytes) -> tuple[int, int, str]:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    if path.is_symlink() or path.exists():
        raise GateFailure(f"refusing to replace existing F2 evidence: {path}")
    temporary = path.parent / f".{path.name}.{os.getpid()}.{secrets.token_hex(12)}.tmp"
    descriptor = os.open(
        temporary,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
        0o600,
    )
    linked = False
    try:
        view = memoryview(payload)
        while view:
            written = os.write(descriptor, view)
            if written <= 0:
                raise GateFailure(f"short write while publishing F2 evidence: {path}")
            view = view[written:]
        os.fchmod(descriptor, 0o400)
        os.fsync(descriptor)
        written_stat = os.fstat(descriptor)
        os.link(temporary, path, follow_symlinks=False)
        linked = True
        fsync_directory(path.parent)
        visible = path.stat(follow_symlinks=False)
        if (
            not stat.S_ISREG(visible.st_mode)
            or (visible.st_dev, visible.st_ino, visible.st_size)
            != (written_stat.st_dev, written_stat.st_ino, written_stat.st_size)
            or stat.S_IMODE(visible.st_mode) != 0o400
        ):
            raise GateFailure(f"published F2 evidence changed identity: {path}")
        digest = hashlib.sha256(payload).hexdigest()
        return visible.st_dev, visible.st_ino, digest
    except FileExistsError as error:
        raise GateFailure(f"refusing to replace existing F2 evidence: {path}") from error
    except BaseException:
        if linked:
            try:
                path.unlink()
                fsync_directory(path.parent)
            except OSError:
                pass
        raise
    finally:
        os.close(descriptor)
        try:
            temporary.unlink()
            fsync_directory(temporary.parent)
        except FileNotFoundError:
            pass


def publish_f2_result(
    run_root: Path,
    candidate: dict[str, Any],
    report: dict[str, Any],
    artifact_documents: dict[str, dict[str, Any]],
) -> Path:
    if set(artifact_documents) != set(F2_ARTIFACTS):
        raise GateFailure("F2 artifact set must be exactly shell, javascript, python, timing")
    result_dir = run_root / "results" / "F2-message-hooks"
    targets = {name: result_dir / f"{name}.json" for name in F2_ARTIFACTS}
    result_path = result_dir / "result.json"
    if any(path.exists() or path.is_symlink() for path in (*targets.values(), result_path)):
        raise GateFailure("canonical F2 evidence already exists")
    published: list[tuple[Path, int, int]] = []
    records: dict[str, dict[str, str]] = {}
    try:
        for name in F2_ARTIFACTS:
            document = {
                **artifact_documents[name],
                "runId": candidate["runId"],
                "candidateDigest": candidate["candidateDigest"],
                "readinessSha256": candidate["readinessSha256"],
            }
            payload = canonical_json(document)
            device, inode, digest = atomic_write_new(targets[name], payload)
            published.append((targets[name], device, inode))
            records[name] = {
                "path": targets[name].relative_to(run_root).as_posix(),
                "sha256": digest,
            }
        result = {
            "schemaVersion": 1,
            "gate": "F2",
            "runId": candidate["runId"],
            "candidateDigest": candidate["candidateDigest"],
            "status": "PASS",
            "error": None,
            "partial": False,
            "flaky": False,
            "skipped": False,
            "refused": False,
            "failureCount": 0,
            "requiredArtifacts": list(F2_ARTIFACTS),
            "artifacts": records,
            "summary": report,
        }
        device, inode, _digest = atomic_write_new(result_path, canonical_json(result))
        published.append((result_path, device, inode))
        return result_path
    except BaseException:
        for path, device, inode in reversed(published):
            try:
                visible = path.stat(follow_symlinks=False)
                if (visible.st_dev, visible.st_ino) == (device, inode):
                    path.unlink()
                    fsync_directory(path.parent)
            except FileNotFoundError:
                pass
        raise


def packed_main(args: argparse.Namespace) -> int:
    if os.environ.get("OCULAR_LAB") != "1" or os.environ.get("NEXUS_LAB_MODE") != "packed":
        raise GateFailure("packed F2 requires OCULAR_LAB=1 and NEXUS_LAB_MODE=packed")
    lab_root_raw = os.environ.get("NEXUS_LAB_ROOT")
    env_run_id = os.environ.get("NEXUS_V015_RUN_ID", "")
    run_id = args.run_id or env_run_id
    if not lab_root_raw or SAFE_RUN_ID.fullmatch(run_id or "") is None or run_id != env_run_id:
        raise GateFailure("packed F2 requires the exact safe NEXUS_V015_RUN_ID")
    lab_root = Path(os.path.abspath(lab_root_raw))
    evidence_dir = Path(os.path.abspath(args.evidence_dir or ""))
    if evidence_dir != lab_root / "evidence":
        raise GateFailure("--evidence-dir must be exactly NEXUS_LAB_ROOT/evidence")
    run_root = evidence_dir / run_id
    if not run_root.is_dir():
        raise GateFailure(f"packed candidate run root is missing: {run_root}")
    result_dir = run_root / "results" / "F2-message-hooks"
    result_targets = [result_dir / f"{name}.json" for name in F2_ARTIFACTS]
    result_targets.append(result_dir / "result.json")
    if any(path.exists() or path.is_symlink() for path in result_targets):
        raise GateFailure("canonical F2 evidence already exists")
    before = verify_packed_candidate(evidence_dir, run_id)
    expected_readiness = lab_root / "lab" / "candidate-ready.v1"
    if Path(before["readinessPath"]) != expected_readiness:
        raise GateFailure("packed candidate readiness path is not canonical")
    home = lab_root / "lab" / f"f2-message-hooks-{run_id}"
    gate = LiveGate(
        None,
        home=home,
        nexus_bin=PACKED_NEXUS_BIN,
        gateway_bin=PACKED_GATEWAY_BIN,
        packed=True,
        resource_limits=before["limits"],
    )
    try:
        report = gate.run()
        after = verify_packed_candidate(evidence_dir, run_id)
        if after != before:
            raise GateFailure("packed candidate/readiness/runtime changed during F2")
        artifact_documents = {
            **gate.language_artifacts,
            "timing": gate.timing_artifact,
        }
        result = publish_f2_result(run_root, before, report, artifact_documents)
    finally:
        gate.cleanup_stale_home()
    print(
        f"PASS F2 packed message hooks: run={run_id} "
        f"candidate={before['candidateDigest']} result={result}"
    )
    return 0


def required_message_id(value: dict[str, Any]) -> str:
    message_id = value.get("messageId")
    if not isinstance(message_id, str) or not message_id:
        raise GateFailure(f"message acknowledgement lacks messageId: {value}")
    return message_id


def recv_exact(client: socket.socket, length: int) -> bytes:
    chunks: list[bytes] = []
    remaining = length
    while remaining:
        chunk = client.recv(remaining)
        if not chunk:
            raise GateFailure("daemon RPC socket ended before a complete frame")
        chunks.append(chunk)
        remaining -= len(chunk)
    return b"".join(chunks)


def main(argv: list[str]) -> int:
    args = parse_args(argv)
    if args.help:
        print(usage(), end="")
        return 0
    if args.list:
        print("\n".join(SCENARIOS))
        return 0
    if args.packed_v015:
        if args.inside or args.evidence_dir is None:
            raise GateFailure("--packed-v015 requires --evidence-dir and cannot use --inside")
        return packed_main(args)
    if args.evidence_dir is not None or args.run_id is not None:
        raise GateFailure("--evidence-dir/--run-id require --packed-v015")
    if args.inside:
        LiveGate(args.output).run()
        return 0
    return host_main(args)


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except GateFailure as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(1)
