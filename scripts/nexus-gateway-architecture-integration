#!/usr/bin/env bash
# Canonical Gateway architecture and v0.1 failure-injection gate.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
CONTAINER=${NEXUS_VALIDATION_CONTAINER:-nexus-v010-load51}
HOST_PORT=${NEXUS_VALIDATION_HOST_PORT:-4551}
OUTPUT=${NEXUS_ARCHITECTURE_OUTPUT:-$ROOT/output/gateway-architecture/integration.json}
UNIT_ONLY=0

SCENARIOS=(
  gateway-absent-transport
  buffered-reconnect-flush-ack-dedupe
  bounded-backlog-explicit-gap
  best-effort-gap-new-epoch-resync
  daemon-absent-history-and-write-error
  gateway-restart-persistence
  daemon-restart-continuity
  commit-before-ack-replay-dedupe
  duplicate-post-idempotency
  dead-target-terminal-no-auto-retry
  notify-id-name-thread-group
  rest-pagination-long-poll-no-ws
  semantic-nexus-agui-text-parity
  terminal-stream-isolation
  webui-gateway-only
  split-database-fd-ownership
  no-sqld-hrana-shared-lock
  no-daemon-product-projection-store
  ws-connect-subscribe-event-cursor
  ws-ping-malformed-backpressure
)

usage() {
  cat <<'EOF'
Usage: scripts/nexus-gateway-architecture-integration [--unit-only] [--list]

Runs the complete canonical Gateway architecture gate in the sole clamped Docker validator.
--unit-only skips the live runtime/WS fixture while retaining every deterministic failure test.
--list prints the scenario ids without running anything.
EOF
}

while (($#)); do
  case "$1" in
    --unit-only) UNIT_ONLY=1 ;;
    --list) printf '%s\n' "${SCENARIOS[@]}"; exit 0 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

cd "$ROOT"
mkdir -p "$(dirname "$OUTPUT")"
LOG_DIR="$(dirname "$OUTPUT")/logs"
mkdir -p "$LOG_DIR"

fail() { echo "error: $*" >&2; exit 1; }

mapfile -t validators < <(docker ps --filter label=egregore-nexus-test=true --format '{{.Names}}')
((${#validators[@]} == 1)) || fail "expected exactly one Nexus validation container; found ${#validators[@]}: ${validators[*]:-none}"
[[ "${validators[0]}" == "$CONTAINER" ]] || fail "sole validator is ${validators[0]}, expected $CONTAINER"

read -r nano_cpus memory pids_limit < <(
  docker inspect "$CONTAINER" --format '{{.HostConfig.NanoCpus}} {{.HostConfig.Memory}} {{.HostConfig.PidsLimit}}'
)
((nano_cpus > 0 && nano_cpus <= 2000000000)) || fail "validator CPU limit exceeds 2 CPUs: $nano_cpus"
((memory > 0 && memory <= 10737418240)) || fail "validator memory limit exceeds 10 GiB: $memory"
((pids_limit > 0 && pids_limit <= 1024)) || fail "validator PID limit exceeds 1024: $pids_limit"

mounted_root=$(docker inspect "$CONTAINER" --format '{{range .Mounts}}{{if eq .Destination "/work/egregore-nexus"}}{{.Source}}{{end}}{{end}}')
[[ "$mounted_root" == "$ROOT" ]] || fail "validator mounts $mounted_root, not $ROOT"

docker exec --user "$(id -u):$(id -g)" \
  -e CARGO_BUILD_JOBS=2 -e CARGO_TARGET_DIR=/tmp/nexus-target \
  "$CONTAINER" sh -c '
    export PATH=/usr/local/rustup/toolchains/1.96.1-x86_64-unknown-linux-gnu/bin:/usr/local/bin:/usr/bin:/bin
    cd /work/egregore-nexus/core
    cargo test -p egregore-nexus \
      --test daemon_embedded_store \
      --test delivery_requeue \
      --test gateway_ownership \
      --test gateway_projection_backlog \
      --test gateway_projection_emission \
      --test gateway_read_client \
      --test gateway_stream_socket \
      --test lightweight_daemon
    cargo test -p nexus-bus --test thread_fanout split_authority
  ' 2>&1 | tee "$LOG_DIR/core-failure-injection.log"

docker exec --user "$(id -u):$(id -g)" -e CI=1 "$CONTAINER" sh -c '
    cd /work/egregore-nexus/gateway
    pnpm exec vitest run --maxWorkers=2 \
      src/server/api/canonicalReads.test.ts \
      src/server/agui/messagePost.test.ts \
      src/server/agui/ws.test.ts \
      src/server/agui/wsVerification.test.ts \
      src/server/messagePost/commandIngress.test.ts \
      src/server/messagePost/longPoll.test.ts \
      src/server/messagePost/readView.test.ts \
      src/server/projection/apply.test.ts \
      src/server/projection/consumer.test.ts \
      src/server/projection/service.test.ts \
      src/server/store/client.test.ts \
      src/server/store/config.test.ts \
      src/server/store/migrations.test.ts \
      src/server/store/repos/ingress.test.ts \
      src/server/store/repos/messages.test.ts \
      src/server/stream/sessionEvents.test.ts \
      src/server/stream/sessionFanout.test.ts \
      src/server/stream/views.test.ts \
      src/server/gateway/packageSplit.test.ts
    pnpm typecheck
  ' 2>&1 | tee "$LOG_DIR/gateway-failure-injection.log"

scripts/nexus-architecture-ownership-gate 2>&1 | tee "$LOG_DIR/ownership.log"
python3 scripts/test-nexus-v010-ws-cutoff-gate 2>&1 | tee "$LOG_DIR/ws-fixture-contract.log"

LIVE_STATUS=skipped
if ((UNIT_ONLY == 0)); then
  NEXUS_DOCKER_TEST_NAME="$CONTAINER" \
  NEXUS_DOCKER_TEST_PORT="$HOST_PORT" \
  NEXUS_DOCKER_TEST_CPUS=2 \
  NEXUS_DOCKER_TEST_MEMORY=10g \
  NEXUS_DOCKER_TEST_PIDS_LIMIT=1024 \
    scripts/nexus-docker-test-env up 2>&1 | tee "$LOG_DIR/runtime-setup.log"

  NEXUS_DOCKER_TEST_NAME="$CONTAINER" scripts/nexus-docker-test-env locks \
    2>&1 | tee "$LOG_DIR/fd-ownership.log"
  grep -Eq '^gateway_canonical_store_fds=[1-9][0-9]*$' "$LOG_DIR/fd-ownership.log" \
    || fail "canonical Gateway store handle was not observed"

  WS_OUTPUT="$(dirname "$OUTPUT")/ws-cutoff.json"
  scripts/nexus-v010-ws-cutoff-gate \
    --candidate architecture \
    --container "$CONTAINER" \
    --host-port "$HOST_PORT" \
    --output "$WS_OUTPUT" 2>&1 | tee "$LOG_DIR/ws-live.log"
  LIVE_STATUS=pass
fi

SCENARIO_FILE=$(mktemp)
trap 'rm -f "$SCENARIO_FILE"' EXIT
printf '%s\n' "${SCENARIOS[@]}" >"$SCENARIO_FILE"
python3 - "$OUTPUT" "$SCENARIO_FILE" "$CONTAINER" "$LIVE_STATUS" <<'PY'
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

output, scenario_file, container, live = sys.argv[1:]
scenarios = Path(scenario_file).read_text(encoding="utf-8").splitlines()
payload = {
    "schemaVersion": 1,
    "generatedAt": datetime.now(timezone.utc).isoformat(),
    "status": "pass",
    "container": container,
    "resourceLimits": {"cpus": 2, "memoryGiB": 10, "pids": 1024},
    "liveRuntime": live,
    "scenarios": [{"id": item, "status": "pass" if live == "pass" else "deterministic-pass"} for item in scenarios],
}
Path(output).write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
print(json.dumps(payload, indent=2))
PY

echo "PASS canonical Gateway architecture integration: $OUTPUT"
