#!/usr/bin/env python3
"""Static contract for the one-command canonical Gateway integration ritual."""

from __future__ import annotations

import subprocess
import unittest
from pathlib import Path


SCRIPT = Path(__file__).with_name("nexus-gateway-architecture-integration")
DOCKER_ENV = Path(__file__).with_name("nexus-docker-test-env")


class ArchitectureIntegrationScriptTests(unittest.TestCase):
    def test_script_is_valid_bash(self) -> None:
        subprocess.run(["bash", "-n", str(SCRIPT)], check=True)

    def test_complete_scenario_inventory_is_discoverable(self) -> None:
        listed = subprocess.run(
            [str(SCRIPT), "--list"],
            check=True,
            text=True,
            capture_output=True,
        ).stdout.splitlines()
        required = {
            "gateway-absent-transport",
            "buffered-reconnect-flush-ack-dedupe",
            "bounded-backlog-explicit-gap",
            "best-effort-gap-new-epoch-resync",
            "daemon-absent-history-and-write-error",
            "gateway-restart-persistence",
            "daemon-restart-continuity",
            "commit-before-ack-replay-dedupe",
            "duplicate-post-idempotency",
            "dead-target-terminal-no-auto-retry",
            "notify-id-name-thread-group",
            "rest-pagination-long-poll-no-ws",
            "semantic-nexus-agui-text-parity",
            "terminal-stream-isolation",
            "webui-gateway-only",
            "split-database-fd-ownership",
            "no-sqld-hrana-shared-lock",
            "no-daemon-product-projection-store",
            "ws-connect-subscribe-event-cursor",
            "ws-ping-malformed-backpressure",
        }
        self.assertEqual(set(listed), required)
        self.assertEqual(len(listed), len(required))

    def test_resource_and_single_container_guards_are_not_optional(self) -> None:
        source = SCRIPT.read_text(encoding="utf-8")
        self.assertIn("expected exactly one Nexus validation container", source)
        self.assertIn("nano_cpus <= 2000000000", source)
        self.assertIn("memory <= 10737418240", source)
        self.assertIn("pids_limit <= 1024", source)
        self.assertIn("CARGO_BUILD_JOBS=2", source)
        self.assertIn("cargo test -p nexus-bus --test thread_fanout split_authority", source)
        self.assertIn("--maxWorkers=2", source)

    def test_fd_gate_finds_the_packaged_gateway_and_requires_its_store_handle(self) -> None:
        docker_source = DOCKER_ENV.read_text(encoding="utf-8")
        self.assertIn("gateway/scripts/nexus-gateway.mjs", docker_source)
        self.assertIn("dist-gateway/headless.mjs", docker_source)

        architecture_source = SCRIPT.read_text(encoding="utf-8")
        self.assertIn("gateway_canonical_store_fds", architecture_source)
        self.assertIn("canonical Gateway store handle", architecture_source)


if __name__ == "__main__":
    unittest.main(verbosity=2)
