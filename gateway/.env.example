# Nexus Gateway — environment template. Copy to `.env` and fill in.
# The gateway is THIN: every canonical read and write crosses the boot-scoped
# daemon IPC endpoint. It never opens the durable store and needs no DB URL,
# file path, or store token. Tests inject in-process mocks via DI; that is never
# a runtime path.

# ── Daemon discovery ────────────────────────────────────────────────────────
# Must match the daemon's home. The gateway reads the boot-scoped IPC manifest
# here and fails loudly when the daemon is unavailable.
NEXUS_HOME=~/.nexus

# ── Optional ─────────────────────────────────────────────────────────────────
# Web-console auth mode. Default local mode is zero-login and stamps the local
# operator caller. Remote/public mode requires a valid `nexus_human` login cookie
# for human web/API routes. The gateway decides from server config only — never
# request headers.
NEXUS_WEB_AUTH_MODE=local
# Non-loopback binds or truthy allow-remote values switch to remote mode unless
# NEXUS_WEB_AUTH_MODE explicitly overrides them.
NEXUS_WEB_BIND=127.0.0.1:4100
NEXUS_WEB_ALLOW_REMOTE=
# Web console AG-UI transport. Default `sse` keeps the existing EventSource lane;
# `ws` opts panes into `/api/agui/ws` for bidirectional input + observe on one socket.
NEXUS_WEB_TRANSPORT=sse
# Mount the Nexus-as-MCP server (thin translator) for external MCP clients.
MCP_ENABLED=true

# Gateway service port. Leave unset to bind :4100, falling back through
# :4101-:4110 if earlier ports are occupied. Set this to require one exact port.
# The gateway writes ~/.nexus/gateway.json after bind; external clients should
# discover the active URL there instead of hardcoding a port.
NEXUS_GATEWAY_PORT=
