{
  "name": "@egregore/nexus-gateway",
  "version": "0.1.2",
  "private": false,
  "bin": {
    "nexus": "scripts/nexus.mjs",
    "nexus-gateway": "scripts/nexus-gateway.mjs",
    "nexus-webui": "webconsole/bin/nexus-webui.mjs"
  },
  "files": [
    "dist-gateway/headless.mjs",
    "scripts/gateway-serve-impl.mjs",
    "scripts/gateway-serve.mjs",
    "scripts/nexus-gateway.mjs",
    "scripts/nexus.mjs",
    "webconsole/bin/nexus-webui.mjs",
    "webconsole/lib/lifecycle.mjs",
    "webconsole/dist"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/egregore-io/egregore-nexus.git",
    "directory": "gateway"
  },
  "homepage": "https://github.com/egregore-io/egregore-nexus#readme",
  "bugs": {
    "url": "https://github.com/egregore-io/egregore-nexus/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Nexus headless REST, WebSocket, AG-UI, and MCP gateway.",
  "scripts": {
    "dev": "pnpm --dir gateway start:api",
    "build": "npm run build:gateway-package",
    "start": "pnpm --dir gateway start",
    "start:api": "pnpm --dir gateway start:api",
    "gateway:start": "pnpm --dir gateway start",
    "gateway:start:api": "pnpm --dir gateway start:api",
    "gateway:test": "pnpm --dir gateway test",
    "gateway:typecheck": "pnpm --dir gateway typecheck",
    "build:gateway-package": "esbuild src/server/gateway/headless.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-gateway/headless.mjs",
    "prepack": "npm run build:gateway-package && npm run webconsole:build",
    "postpack": "node -e \"const fs=require('node:fs'); for (const path of ['dist-gateway','webconsole/dist']) fs.rmSync(path,{recursive:true,force:true})\"",
    "webconsole:dev": "pnpm --dir webconsole dev",
    "webconsole:build": "node webconsole/build-webconsole.mjs",
    "webconsole:test": "pnpm --dir webconsole test",
    "webconsole:typecheck": "pnpm --dir webconsole typecheck",
    "smoke:mcp-reject": "node scripts/gateway-mcp-reject-smoke.mjs",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:contracts": "tsx scripts/gen-contracts.ts",
    "check:contracts": "npm run gen:contracts && git diff --exit-code -- src/shared/types/contracts.gen.ts",
    "db:pull": "drizzle-kit pull"
  },
  "dependencies": {
    "@egregore/nexus-cli": "0.1.2",
    "@ag-ui/client": "^0.0.57",
    "@ag-ui/encoder": "^0.0.57",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tanstack/react-router": "^1.170.16",
    "drizzle-orm": "^0.45.2",
    "react": "^19.2.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/react-virtual": "^3.14.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.7",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.21.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.80.0",
    "streamdown": "^2.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "tsx": "^4.22.4",
    "vite": "^7.3.5",
    "vitest": "^4.1.9",
    "zustand": "^5.0.14"
  }
}
